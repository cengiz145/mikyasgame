send_reliable(players[index].peer_id,amount+" comida",4);
}
else if (item=="dano_para_mina_rand")
{
double amount;
amount=1;
players[index].inv_add_item("mine_damage",amount);
send_packet(0,"play getstat.ogg "+players[index].x+" "+players[index].y+" "+players[index].map,players[index].map);
}
else if (item=="Health"||item=="velocidade")
{
double amount;
if (num<=0)
amount=random(1,5);
else
amount=num;
players[index].inv_add_item(item,amount);
send_packet(0,"play getstat.ogg "+players[index].x+" "+players[index].y+" "+players[index].map,players[index].map);
}
else if(item=="mina")
{
if (num==0)
num=random(1,5);
players[index].inv_add_item(item,num);
send_reliable(players[index].peer_id,"msgpegouitem "+num+" mina",0);
send_packet(0,"play getmina.ogg "+players[index].x+" "+players[index].y+" "+players[index].map,players[index].map);
}
else
{
if (num==0)
num=random(1,5);
players[index].inv_add_item(item,num);
send_packet(0,"play get"+item+".ogg "+players[index].x+" "+players[index].y+" "+players[index].map,players[index].map);
send_reliable(players[index].peer_id, "msgpegouitem "+num+" "+item, 0);
}
}
}
void spawn_obj(int x=random(0,200), int y=0, string what="knife", int amount=1,string map="", string who="", int delete_item=0)
{
obj obj1(x,y,what,amount,map, delete_item);
objs.insert_last(obj1);
int obj_index_ie3=objs.length()-1;
send_packet(0,"spawn_obj "+objs[obj_index_ie3].x+" "+objs[obj_index_ie3].y+" "+objs[obj_index_ie3].map+" "+objs[obj_index_ie3].item+" "+objs[obj_index_ie3].num,objs[obj_index_ie3].map);
}
void obj_loop()
{
netloop();
for (uint obj_index=0; obj_index<objs.length(); obj_index++)
{
if (objs[obj_index].delete==true)
{
send_packet(0,"getobj "+objs[obj_index].x+" "+objs[obj_index].y,objs[obj_index].map);
objs.remove_at(obj_index);
break;
}
if (objs[obj_index].timeouttimer.elapsed>=objs[obj_index].timeout&&objs[obj_index].obtainable&&(string_contains(objs[obj_index].map,"apartment",1)<0||objs[obj_index].map=="apartment_building")&&objs[obj_index].delete_flag==1)
{
objs[obj_index].delete=true;
}
string t=get_tile_at(objs[obj_index].x, objs[obj_index].y, objs[obj_index].map);
if(t==""){
objs[obj_index].y-=1;
}
}
}
bool item_exists(string name)
{
for (uint obj_index=0; obj_index<objs.length(); obj_index++)
{
if (objs[obj_index].item==name)
return true;
}
return false;
}
