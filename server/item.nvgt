obj@[] objs;
class obj
{
string player;
double num;
string item;
string map;
int timeout=random(50000, 60000);
int x,y;
timer timeouttimer;
bool delete=false,obtainable=true;
int delete_flag=0;
obj(int ox, int oy, string what, double amount, string m="",string who="", int obj_delete_flag=0)
{
player=who;
map=m;
if(ox==-1)
{
file f;
f.open("maps/"+map+".map", "rb");
string mdata=f.read();
f.close();
string[] p1=delinear(mdata);
for(uint i=0; i<p1.length(); i++)
{
if (string_contains(p1[i],"maxx",1)>-1)
{
string[] s=string_split(p1[i],":",false);
int maxx=string_to_number(s[1]);
ox=random(2,(maxx-1));
break;
}
}
}
x=ox;
y=oy;
item=what;
num=amount;
delete_flag=obj_delete_flag;
}
void get(int index)
{
if(item=="Watch"){
if(players[index].inv_item_number("watch")<=0){
players[index].inv_add_item("watch",1);
send_packet(0,"play getrelógio.ogg "+players[index].x+" "+players[index].y+" "+players[index].map,players[index].map);
send_reliable(players[index].peer_id, "msgpegouitem 1 relógio", 0);
}
}
else if(item=="gift"){
players[index].inv_add_item("gift", 1);
