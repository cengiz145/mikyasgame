// Gladiator wuula
wuula@[] wuulas;
class wuula
{
int x, y;
int min_damage=50;
int max_damage=100;
uint shots=1;
int health_points=3000;
string hit_by, map;
string weapon_name="espadahit.ogg";
timer wuulatimer, shoot_time, tsair;
int wuulatime=370;
bool flee_mode=false;
wuula(int cx, int cy, string cmap)
{
x=cx;
y=cy;
map=cmap;
}
}
void wuulaloop()
{
for(uint i=0; i<wuulas.length(); i++)
{
if(wuulas[i].flee_mode==false&&wuulas[i].shoot_time.elapsed>=20000){
wuulas[i].x-=2;
wuulas[i].flee_mode=true;
send_reliable(0,"play espadadraw.ogg "+wuulas[i].x+" "+wuulas[i].y+" "+wuulas[i].map,0);
}
if(wuulas[i].tsair.elapsed>=10000){
bool exit_game=true;
for(uint iz=0; iz<players.length(); iz++){
if(players[iz].map==wuulas[i].map){
exit_game=false;
}
}
if(exit_game==true){
wuulas.remove_at(i);
break;
}
else{
wuulas[i].tsair.restart();
}
}
if(wuulas[i].wuulatimer.elapsed>=wuulas[i].wuulatime&&wuulas[i].flee_mode==true)
{
wuulas[i].wuulatimer.restart();
for(uint i2=0; i2 < players.length(); i2++){
if(wuulas[i].x>players[i2].x+1&&players[i2].in_safe_zone==false&&players[i2].map==wuulas[i].map){
wuulas[i].x--;
string ss=get_tile_at(wuulas[i].x, wuulas[i].y, wuulas[i].map);
send_reliable(0,"play "+ss+"step"+random(1, 5)+".ogg "+wuulas[i].x+" "+wuulas[i].y+" "+wuulas[i].map,0);
wuulas[i].wuulatimer.restart();
}
else if(wuulas[i].x<players[i2].x-1&&players[i2].in_safe_zone==false&&wuulas[i].map==players[i2].map){
wuulas[i].x++;
string ss=get_tile_at(wuulas[i].x, wuulas[i].y, wuulas[i].map);
send_reliable(0,"play "+ss+"step"+random(1, 5)+".ogg "+wuulas[i].x+" "+wuulas[i].y+" "+wuulas[i].map,0);
wuulas[i].wuulatimer.restart();
}
if(get_wuula_distance(wuulas[i], players[i2])>-1&&get_wuula_distance(wuulas[i],players[i2])<=3&&wuulas[i].shoot_time.elapsed>=500&&wuulas[i].shots>0&&players[i2].in_safe_zone==false){
wuulas[i].shoot_time.restart();
send_packet(0,"play "+wuulas[i].weapon_name+" "+wuulas[i].x+" "+wuulas[i].y+" "+wuulas[i].map,wuulas[i].map);
players[i2].health-=random(wuulas[i].min_damage, wuulas[i].max_damage);
send_reliable(0,"inithurt "+players[i2].charname+" "+players[i2].x+" "+players[i2].y+" "+players[i2].voice+" "+players[i2].pitch+" "+players[i2].map,0);
players[i2].lasthit="wuula";
wuulas[i].shots--;
break;
}
if(wuulas[i].shots<=0){
wuulas[i].shots=1;
wuulas[i].shoot_time.restart();
}
if(wuulas[i].health_points<=0){
send_packet(0,"play corpo_caindo.ogg "+wuulas[i].x+" "+wuulas[i].y+" "+wuulas[i].map,wuulas[i].map);
send_reliable(0, "msganimal "+wuulas[i].hit_by+" matou_o_gladiador Wuula!", 0);
string hitter=wuulas[i].hit_by;
int xx=get_player_index_from(hitter);
if(xx>-1){
players[xx].inv_add_item("wuula_trident", 1);
gain_xp(players[xx].charname, random(3000, 3500));
}
wuulas.remove_at(i);
break;
}
}
}
}
}
void spawn_wuula(int x, int y, string map){
wuula c(x, y, map);
wuulas.insert_last(c);
}
