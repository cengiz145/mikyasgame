class mine_obj
{
int x,y,damage;
string id,owner,map;
mine_obj(string mid, int mx, int my, int md,string mo,string mm)
{
id=mid;
x=mx;
y=my;
damage=md;
owner=mo;
map=mm;
}
}
mine_obj@[] mine_objs;
void spawn_mine(int x, int y, int damage,string owner,string map)
{
string id;
bool breakit=false;
while(true)
{
id=random_string();
breakit=true;
for(uint i=0; i<mine_objs.length(); i++)
{
if(mine_objs[i].id==id) breakit=false;
}
if(breakit) break;
}
mine_obj m1(id,x,y,damage,owner,map);
mine_objs.insert_last(m1);
send_packet(0, "play mineplace.ogg "+x+" "+y, map);
}
void destroy_mine(string id)
{
for(uint i=0; i<mine_objs.length(); i++)
{
if(mine_objs[i].id==id)
{
mine_objs.remove_at(i);
continue;
}
}
}
class objmagnet
{
int x,y,dir,traveled;
bool collecting=true;
string owner,map;
timer speed_timer;
obj@[] collected;
string[] playernames;
string soundid;
bool dead=false;
int speed_value=30;
objmagnet(int mx, int my, int md, string mm, string mo)
{
x=mx;y=my;map=mm;dir=md;owner=mo;
soundid=spawn_moving_sound("item_magnet_loop.ogg",x,y,map);
send_packet(0,"play item_magnet_start.ogg "+x+" "+y,map);
}
void loop()
{
if(traveled>=100) {collecting=true;}
if(speed_timer.elapsed>=speed_value){
if(traveled<=100) x+=dir;
else x-=dir;
if(string_contains(get_tile_at(dir, y, map), "wall", 1)>-1)traveled=100;
traveled++;
update_moving_sound(soundid,x,y);
if(collecting)
{
for(uint i2=0;i2<players.length();i2++){
if(x==players[i2].x&&y==players[i2].y&&map==players[i2].map){
send_packet(0,"play spell_electrobomb_hit.ogg "+players[i2].x+" "+players[i2].y+" "+players[i2].map,players[i2].map);
send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
players[i2].health-=random(200, 300);
players[i2].lasthit="magnet_"+owner;
}
}
for(uint i2=0;i2<attack_dogs.length();i2++){
if(x==attack_dogs[i2].x&&y==attack_dogs[i2].y&&map==attack_dogs[i2].map){
send_packet(0,"play spell_electrobomb_hit.ogg "+attack_dogs[i2].x+" "+attack_dogs[i2].y+" "+attack_dogs[i2].map,attack_dogs[i2].map);
send_packet(0,"play cachorroapanhando"+random(1, 2)+".ogg "+attack_dogs[i2].x+" "+attack_dogs[i2].y+" "+attack_dogs[i2].map,attack_dogs[i2].map);
attack_dogs[i2].health_points-=random(200, 300);
attack_dogs[i2].hit_by="magnet_"+owner;
}
}
for(uint i2=0;i2<safe_guards.length();i2++){
if(x==safe_guards[i2].x&&y==safe_guards[i2].y&&map==safe_guards[i2].map){
send_packet(0,"play spell_electrobomb_hit.ogg "+safe_guards[i2].x+" "+safe_guards[i2].y+" "+safe_guards[i2].map,safe_guards[i2].map);
safe_guards[i2].health_points-=random(200, 300);
safe_guards[i2].hit_by="magnet_"+owner;
}
}
for(uint i2=0;i2<sequestradors.length();i2++){
if(x==sequestradors[i2].x&&y==sequestradors[i2].y&&map==sequestradors[i2].map){
send_packet(0,"play spell_electrobomb_hit.ogg "+sequestradors[i2].x+" "+sequestradors[i2].y+" "+sequestradors[i2].map,sequestradors[i2].map);
sequestradors[i2].health_points-=random(200, 300);
sequestradors[i2].hit_by="magnet_"+owner;
}
}
for(uint i2=0;i2<monkeys.length();i2++){
if(x==monkeys[i2].x&&y==monkeys[i2].y&&map==monkeys[i2].map){
send_packet(0,"play spell_electrobomb_hit.ogg "+monkeys[i2].x+" "+monkeys[i2].y+" "+monkeys[i2].map,monkeys[i2].map);
send_packet(0,"play macacoapanhando"+random(1, 3)+".ogg "+monkeys[i2].x+" "+monkeys[i2].y+" "+monkeys[i2].map,monkeys[i2].map);
monkeys[i2].health_points-=random(200, 300);
monkeys[i2].hit_by="magnet_"+owner;
}
}
for(uint i2=0;i2<wolves.length();i2++){
if(x==wolves[i2].x&&y==wolves[i2].y&&map==wolves[i2].map){
send_packet(0,"play spell_electrobomb_hit.ogg "+wolves[i2].x+" "+wolves[i2].y+" "+wolves[i2].map,wolves[i2].map);
send_packet(0,"play loboapanhando"+random(1, 2)+".ogg "+wolves[i2].x+" "+wolves[i2].y+" "+wolves[i2].map,wolves[i2].map);
wolves[i2].health_points-=random(200, 300);
wolves[i2].hit_by="magnet_"+owner;
}
}
for(uint i2=0;i2<bears.length();i2++){
if(x==bears[i2].x&&y==bears[i2].y&&map==bears[i2].map){
send_packet(0,"play spell_electrobomb_hit.ogg "+bears[i2].x+" "+bears[i2].y+" "+bears[i2].map,bears[i2].map);
bears[i2].health_points-=random(200, 300);
bears[i2].hit_by="magnet_"+owner;
}
}
for(uint i2=0;i2<mercenarios.length();i2++){
if(x==mercenarios[i2].x&&y==mercenarios[i2].y&&map==mercenarios[i2].map){
send_packet(0,"play spell_electrobomb_hit.ogg "+mercenarios[i2].x+" "+mercenarios[i2].y+" "+mercenarios[i2].map,mercenarios[i2].map);
mercenarios[i2].health_points-=random(200, 300);
mercenarios[i2].hit_by="magnet_"+owner;
}
}
for(uint i2=0;i2<dragonsauros.length();i2++){
if(x==dragonsauros[i2].x&&y==dragonsauros[i2].y&&map==dragonsauros[i2].map){
send_packet(0,"play spell_electrobomb_hit.ogg "+dragonsauros[i2].x+" "+dragonsauros[i2].y+" "+dragonsauros[i2].map,dragonsauros[i2].map);
send_packet(0,"play dragonsauroapanhando.ogg "+dragonsauros[i2].x+" "+dragonsauros[i2].y+" "+dragonsauros[i2].map,dragonsauros[i2].map);
dragonsauros[i2].health_points-=random(200, 300);
dragonsauros[i2].hit_by="magnet_"+owner;
}
}
for(uint i=0; i<objs.length(); i++)
{
if(x==objs[i].x&&y==objs[i].y&&map==objs[i].map&&string_contains(objs[i].item, "bandeira", 1)<0&&string_contains(objs[i].item, "-", 1)<0){
objs[i].obtainable=false;
send_packet(0,"play item_magnet_click.ogg "+x+" "+y+" "+map,map);
collected.insert_last(objs[i]);
objs[i].delete=true;
obj_loop();
}
}
}
speed_timer.restart();
}
if(traveled>=200)
{
destroy_moving_sound(soundid);
int ind=get_player_index_from(owner);
if(ind>-1) 
{
bool were=false;
string output="A total of ";
if(collected.length()==1) output+="1 item";
else output+=collected.length()+" items";
if(collected.length()!=1||playernames.length()!=1) were=true;
output+=were==true ? " coletou" : "was collected";
send_reliable(players[ind].peer_id,"Your item_magnético came back. "+output,2);
}
send_packet(0,"play item_magnet_deposit.ogg "+x+" "+y+" "+map,map);
for(uint i=0; i<collected.length(); i++)
{
collected[i].x=x;collected[i].y=y;collected[i].map=map;collected[i].obtainable=true;spawn_obj(collected[i].x,collected[i].y,collected[i].item,collected[i].num,collected[i].map,collected[i].player);
}
dead=true;
}
}
}
objmagnet@[] oms;
void spawn_magnetic_item(int x, int y, int dir, string map, string owner)
{
objmagnet om(x,y,dir,map,owner);
oms.insert_last(om);
}
void magnetic_item_loop(){
for(uint i=0; i<oms.length(); i++){
int went=0;
if(oms[i].dead){
oms.remove_at(i);
went=1;
break;
}
if(went==0)oms[i].loop();
}
}