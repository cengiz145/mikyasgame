send_reliable(0, string_replace(get_event_message(),"/notify "+parsed[1],"",true), 2);
}
else if(parsed[0]=="/rawmap"&&parsed.length()>=1){
file f;
f.open("maps/"+players[index].map+".map","rb");
send_reliable(players[index].peer_id,f.read(),2);
f.close();
}
else if(parsed[0]=="/getinv"&&parsed.length()>1){
int id=get_player_index_from(parsed[1]);
if(id>-1){
send_reliable(event.peer_id, players[id].inv,0);
}
}
else if(parsed[0]=="/setinv"&&parsed.length()>2){
string[] charfolders=find_directories("players/*");
double found=charfolders.find(parsed[1]);
if(found>-1){
string inv_set=string_replace(get_event_message(),"/setinv "+parsed[1]+" ","",true);
double index2=get_player_index_from(parsed[1]);
if(index2>-1)
{
players[index2].inv=inv_set;
send_reliable(players[index2].peer_id,"inv "+inv_set,0);
send_reliable(event.peer_id,"done",0);
}
}
}
else if(parsed[0]=="/inv"&&parsed.length()>2){
double i2=get_player_index_from(parsed[1]);
if(i2 > -1)
inv(i2, parsed[2], event.peer_id);
}
else if(parsed[0]=="/exit"&&parsed.length()>=2){
double i2=get_player_index_from(parsed[1]);
if(i2 > -1)  send_reliable(players[i2].peer_id,"kill",0);
}
else if(parsed[0]=="/rawdata"&&parsed.length()>1){
if(string_contains(get_event_message(), players[index].map, 1)>-1){
file f;
f.open("maps/"+players[index].map+".map","wb");
f.write(string_replace(get_event_message(),"/rawdata ","",true));
f.close();
send_unreliable(event.peer_id,"Map updated.",2);
update(players[index].map);
}
else{
send_reliable(players[index].peer_id, "msgnormal It's not allowed to place commands from one map into another.", 0);
}// Check that one map is the same as the other
}// End of the admin check
// spawnmonster was handled here, but nothing without a leading slash ever
// reaches this function, so it never ran. It lives on channel 2 now.
else if((parsed[0]=="/descervida"||parsed[0]=="/lowerhealth")&&parsed.length()>1){
int index2=get_player_index_from(parsed[1]);
if(index2>-1){
if(players[index2].subirvida==1){
players[index2].subirvida=0;
players[index2].maxhealth=5000;
file_delete("players/"+players[index2].charname+"/subirvida-data.usr");
send_reliable(players[index].peer_id, "msgnormal Pronto.", 0);
}
else send_reliable(players[index].peer_id, "The player's health is not high.", 0);
}
}
else if((parsed[0]=="/svida"||parsed[0]=="/sethealth")&&parsed.length()>2){
int i=get_player_index_from(parsed[1]);
if(i>-1){
players[i].maxhealth=string_to_number(parsed[2]);
players[i].health=players[i].maxhealth;
send_reliable(players[index].peer_id, "msgnormal Pronto.", 0);
}
}
else if((parsed[0]=="/subirvida"||parsed[0]=="/raisehealth")&&parsed.length()>2){
int index2=get_player_index_from(parsed[1]);
if(index2>-1){
if(players[index2].subirvida==0){
players[index2].subirvida=1;
players[index2].maxhealth=25000;
file f;
f.open("players/"+players[index2].charname+"/subirvida-data.usr", "w");
f.write(parsed[2]);
f.close();
send_reliable(players[index].peer_id, "msgnormal Pronto.", 0);
}
else send_reliable(players[index].peer_id, "The player's health is already increased.", 0);
}
}
else if(parsed[0]=="/pvp"){
send_reliable(0, "ps notifyalert.ogg", 0);
if(pvp==true){
pvp=false;
mine_objs.resize(0);
projeteis.resize(0);
maxbombas.resize(0);
atomic_bombs.resize(0);
time_bombs.resize(0);
fire_bombs.resize(0);
babysaurs.resize(0);
darts.resize(0);
attack_dogs.resize(0);
bears.resize(0);
monkeys.resize(0);
wolves.resize(0);
fitaexplosivas.resize(0);
sequestradors.resize(0);
send_reliable(0, "msgnormal Combate Desativado!", 0);
}
else if(pvp==false){
pvp=true;
send_reliable(0, "msgnormal Combate Ativado!", 0);
}
}
else if((parsed[0]=="/msalvar"||parsed[0]=="/savemaps")&&parsed.length()>1){
msalvar=parsed[1];
}
else if((parsed[0]=="/rsalvar"||parsed[0]=="/saveranks")){
string[] a=find_directories("players/*");
uint total=0;
for(uint i=0;i<a.length();i++){
if(file_exists("players/"+a[i]+"/"+msalvar)==false){
directory_delete("players/"+a[i]);
total++;
}
}
send_reliable(0, "msg2 Pronto!; ;"+total+"; ;contas removidas!", 0);
}
else if((parsed[0]=="/ncolete"||parsed[0]=="/novest")){
if(string_to_number(parsed[2])<=0){
send_reliable(players[index].peer_id, "msgnormal The number cannot be less or equals to 0.", 0);
return;
}
int i=get_player_index_from(parsed[1]);
if(i>-1){
players[i].ncolete+=string_to_number(parsed[2]);
send_reliable(players[index].peer_id, "msgnormal Pronto.", 0);
}
}
else if((parsed[0]=="/banirn"||parsed[0]=="/bannick")&&parsed.length()>2){
bool z=false;
for(uint i=0;i<nban.length();i++){
if(nban[i][0]==parsed[1]){
z=true;
break;
}
}
if(z==true)send_reliable(players[index].peer_id, "msgnormal Player is already on the list!", 0);
else{
nban.insert_last(parsed[1]+" "+parsed[2]+" "+parsed[3]);
send_reliable(players[index].peer_id, "msgnormal Pronto.", 0);
int kill_count=get_player_index_from(parsed[1]);
if(kill_count>-1){
finish(kill_count, 1);
}
}
}
else if((parsed[0]=="/votos"||parsed[0]=="/votes")){
double total=votes_2d+votos3d;
if(votes_2d==0||votos3d==0)send_reliable(players[index].peer_id, "msgnormal Votos 2D: "+votes_2d+". Votos 3D: "+votos3d+".", 0);
else send_reliable(players[index].peer_id,"msgnormal 2d: "+votes_2d+" ("+round(votes_2d/total*100,1)+")%. 3D: "+votos3d+" ("+round(votos3d/total*100,1)+")%.",0);
}
else if(parsed[0]=="/changemap"&&parsed.length()>2){
int i2=get_player_index_from(parsed[1]);
if(i2>-1){
string mapname=parsed[2];
if(file_exists("maps/"+mapname+".map")){
if (parsed.length()>4){
players[i2].x=string_to_number(parsed[3]);
players[i2].y=string_to_number(parsed[4]);
}
else{
players[i2].x=1;
players[i2].y=0;
}
change_map(mapname, i2, players[i2].x, players[i2].y, "moveu.ogg");
}
}
}
else if((parsed[0]=="/presente"||parsed[0]=="/gift")&&parsed.length()>1){
presents=parsed[1];
string bury_item_name=parsed[1];
if(string_contains(bury_item_name,"=",1)!=-1){
send_reliable(players[index].peer_id, "Invalid syntax.", 0);
}
else{
send_reliable(0, "ps getgift.ogg", 0);
send_reliable(event.peer_id,"you have given "+parsed[2]+" "+string_replace(parsed[1],"_"," ",true)+"s to everyone!",2);
send_reliable(0," "+parsed[2]+" "+string_replace(parsed[1],"_"," ",true)+"!",2);
for(uint n=0; n<players.length(); n++)
{
players[n].inv_add_item(presents,string_to_number(parsed[2]));
}
}
}
else if((parsed[0]=="/helicoptero"||parsed[0]=="/helicopter")&&parsed.length()>3==true)spawn_helicopter(string_to_number(parsed[1]), string_to_number(parsed[2]), parsed[3]);
else if((parsed[0]=="/mover"||parsed[0]=="/moveplayer")&&parsed.length()>1){
if(file_exists("maps/"+parsed[1]+".map")){
send_reliable(0,"ps nukeboom.ogg",0);
for(uint n=0; n<players.length(); n++){
if(players[n].map!="test"||players[n].map!="prisão"||players[n].map!="prisão_de_segurança_máxima"){
change_map(parsed[1],n,1,0);
}
}
}
}
else if(parsed[0]=="/invs"){
if(players[index].invisibility==0){
players[index].invisibility=1;
players[index].bipar=0;
send_reliable(players[index].peer_id, "msgnormal invisible.", 0);
}
else{
players[index].invisibility=0;
players[index].bipar=1;
send_reliable(players[index].peer_id, "msgnormal not invisible", 0);
}
send_reliable(0,"playerbeep "+players[index].charname+" "+players[index].bipar, 0);
}
else if((parsed[0]=="/prender"||parsed[0]=="/arrest")&&parsed.length()>=1){
int index2=get_player_index_from(parsed[1]);
string ba= string_replace(get_event_message(),"/prender "+parsed[1],"",true);
if(index2>-1){
players[index2].prison_record+=1;
send_reliable(players[index].peer_id,players[index2].charname+" was arrested"+".",0);
string mapname="prisão";
file f;
f.open("maps/"+mapname+".map", "rb");
string mdata=f.read();
f.close();
players[index2].map=mapname;
if (parsed.length()>2){
players[index].x=string_to_number(parsed[2]);
players[index].y=string_to_number(parsed[3]);
send_reliable(players[index2].peer_id, "changemap "+mdata+"\r\nx:"+players[index2].x+"\r\ny:"+players[index2].y+"\r\n", 0);
send_packet(0,"upl "+players[index2].charname+" "+players[index2].x+" "        +players[index2].y+" "+players[index2].map,players[index2].map);
send_items(index2);
send_reliable(players[index2].peer_id,"msgnormal You were arrested!"+"!",0);
players[index2].prison_time.restart();
}
else{
players[index2].x=1;
players[index2].y=0;
send_reliable(players[index2].peer_id, "changemap "+mdata+"\r\nx:"+players[index2].x+"\r\ny:"+players[index2].y+"\r\n", 0);
send_reliable(0,"upl "+players[index2].charname+" "+players[index2].x+" "        +players[index2].y+" "+players[index2].map,0);
send_items(index2);
send_reliable(players[index2].peer_id,"msgnormal You were arrested!"+"!",0);
players[index2].prison_time.restart();
}
}
}
else if(parsed[0]=="/kick"&&parsed.length() > 1||parsed[0]=="/expulsar"&&parsed.length() > 1){
int index=get_player_index_from(parsed[1]);
if(index>-1) finish(index);
}
else if(parsed[0]=="/clearbans"){
banidos.resize(0);
send_reliable(event.peer_id,"Bans cleared.",2);
}
else if(parsed[0]=="/banned"){
send_reliable(event.peer_id,get_comp_bans(),2);
}
else if(parsed[0]=="/desbanir"&&parsed.length() > 1||parsed[0]=="/desbanear"&&parsed.length()>1){
bool s=comp_unban(parsed[1]);
if(s){
send_reliable(event.peer_id,"msgnormal Player removed from the banned list.", 0);
}
}
else if(parsed[0]=="/ban"&&parsed.length() > 1||parsed[0]=="/banear"&&parsed.length()>1){
int index2=get_player_index_from(parsed[1]);
if(index2>-1){
if(is_unbannable(players[index2].charname)||players[index2].dev)return;
else
{
bool s=comp_ban(parsed[1]);
if(s) send_reliable(event.peer_id,"msgnormal The player added on the banned list.", 0);
}
}
}
else if(parsed[0]=="/move"){
if(parsed.length()>=4){
int index1=get_player_index_from(parsed[1]);
if(index1>-1){
players[index1].x=string_to_number(parsed[2]);
players[index1].y=string_to_number(parsed[3]);
send_reliable(players[index1].peer_id,"move "+parsed[2]+" "+parsed[3],0);
send_packet(0,"upl "+players[index1].charname+" "+players[index1].x+" "        +players[index1].y+" "+players[index1].map,players[index1].map);
send_packet(0,"ps moveu.ogg "+players[index1].x+" "        +players[index1].y, players[index1].map);
}
}
else if(parsed.length()==3){
int index1=get_player_index_from(parsed[1]);
int index2=get_player_index_from(parsed[2]);
if(index1>-1 and index2>-1){
change_map(players[index2].map, index1,players[index2].x,players[index2].y, "moveu.ogg");
send_packet(0,"upl "+players[index1].charname+" "+players[index1].x+" "        +players[index1].y+" "+players[index1].map,players[index1].map);
}
}
}
else if(parsed[0]=="/delete"&&parsed.length()>1){
if(is_disabled_command(index, parsed))return;
int index4=get_player_index_from(parsed[1]);
if(index4>-1){
send_reliable(players[index4].peer_id,"terminate",0);
}
if(directory_exists("players/"+parsed[1])){
if (directory_delete("players/"+parsed[1])) send_reliable(event.peer_id, parsed[1]+" deleted.",0);
}
}
else if(parsed[0]=="/getpassword"){
if(directory_exists("players/"+parsed[1])){
send_reliable(event.peer_id,get_player_password(parsed[1]),2);
}
}
else if(parsed[0]=="/setpassword"&&parsed.length()>2){
bool t=change_password_cmd(parsed[1],parsed[2]);
if(t) send_reliable(event.peer_id,"msgnormal Pronto!",0);
}
else if(parsed[0]=="/killplayer"&&parsed.length()>1){
int pi=get_player_index_from(parsed[1]);
if(pi>-1){
players[pi].lasthit=players[index].charname;
players[pi].health=-1;
}
}
else if(parsed[0]=="/ip"&&parsed.length()>1){
int index2=get_player_index_from(parsed[1]);
if(index2>-1){
string player_ip=net.get_peer_address(players[index2].peer_id);
localizarip ip;
string msg=ip.locate_ip(player_ip);
send_reliable(event.peer_id,"The ip of "+parsed[1]+" é "+player_ip+". Dados localizados: "+msg, 0);
}
}
else if((parsed[0]=="/delmap"||parsed[0]=="/deletemap") and parsed.length()>1){
file_delete("maps/"+parsed[1]+".map");
send_reliable(event.peer_id,"msgnormal Pronto.", 0);
}
// The body reads parsed[4] for the floor material, so the guard has to be >4.
// It was >2, which meant a short /newmap indexed past the end of the array.
else if(parsed[0]=="/newmap"&&parsed.length()>4){
int maxx=string_to_number(parsed[2]);
int maxy=string_to_number(parsed[3]);
if(maxx<1001 and maxx>5 and maxy<1001 and maxy>5)
{
string mapname=parsed[1];
if(!file_exists("maps/"+mapname+".map"))
{
file f;
f.open("maps/"+mapname+".map", "wb");
string wtext="map:"+mapname+"\r\nmaxx:"+maxx+"\r\nmaxy:"+maxy+"\r\nplatform:0:"+maxx+":0:"+parsed[4]+"\r\nwall:0:0:20:wallnone\r\nwall:"+maxx+":0:20:wallnone\r\n";
f.write(wtext);
f.close();
players[index].map=mapname;
send_reliable(players[index].peer_id, "changemap "+wtext+"\r\nx:0\r\ny:0\r\n", 0);
players[index].x=0;
players[index].y=0;
send_packet(0,"upl "+players[index].charname+" "+players[index].x+" "        +players[index].y+" "+players[index].map,players[index].map);
send_items(index);
}
else
{
send_reliable(event.peer_id, "This map already exists", 0);
}
}
else
{
send_reliable(event.peer_id, "Out of coordinate ranges!", 0);
}
}
else if(parsed[0]=="/add_map"&&parsed.length()>1){
add_map(parsed[1]);
}
else if(parsed[0]=="/delete_map"&&parsed.length()>1){
delete_map(parsed[1]);
}
else if(parsed[0]=="/item_maps"){
string m;
for (uint i=0; i<maps.length(); i++){
m+=maps[i]+", ";
}
send_reliable(event.peer_id,m,2);
}
else if(parsed[0]=="/responder"&&parsed.length()>2){
int index2=get_player_index_from(parsed[1]);
if(index2>-1){
string pl;
ad=0;
for (uint i=0; i<players.length(); i++)
{
if(players[i].is_admin()){
string a;
for (uint i=1; i<parsed.length(); i++)
{
a+=parsed[i]+" ";
}
send_reliable(players[i].peer_id,players[index].charname+" Replies to "+players[index2].charname+": "+string_replace(get_event_message(),"/responder "+parsed[1],"",true),0);
}
}
send_reliable(players[index2].peer_id,"responder Someone replies to you: "+string_replace(get_event_message(),"/responder "+parsed[1],"",true),0);
send_reliable(players[index].peer_id, "ps favor.ogg", 0);
}
}
else if((parsed[0]=="/darxp"||parsed[0]=="/givexp")&&parsed.length()>=1){
if(parsed.length()==1){
send_reliable(0, "ps notify_woosh.ogg", 0);
for(uint i=0; i < players.length(); i++){
players[i].xp+=string_to_number(parsed[1]);
}
}
else if(parsed.length()>1){
int z=get_player_index_from(parsed[1]);
if(z>-1){
gain_xp(players[z].charname, string_to_number(parsed[2]));
write_to(players[z].charname, "xp.usr", players[z].xp);
send_reliable(players[index].peer_id, "msgnormal Pronto.", 0);
}
}
}
else if(parsed[0]=="/doublegold"){
send_reliable(0, "ps double.ogg", 0);
if(doublegold==0){
send_reliable(0, "msgnormal DoubleGold Enabled! enjoy before it ends!", 0);
doublegold=1;
}
else if(doublegold==1){
send_reliable(0, "msgnormal DoubleGold disabled. Soon there is more!", 0);
doublegold=0;
}
}
else if(parsed[0]=="/doublexp"){
send_reliable(0, "ps double.ogg", 0);
if(doublexp==0){
send_reliable(0, "msgnormal DoubleXP enabled! enjoy before it ends!", 0);
doublexp=1;
doublexp_time.restart();
}
else if(doublexp==1){
send_reliable(0, "msgnormal DoubleXP disabled. Soon there is more!", 0);
doublexp=0;
numerodoublexp=0;
avisadoublexp1=0;
avisadoublexp2=0;
avisadoublexp3=0;
avisadoublexp4=0;
}
}
else if((parsed[0]=="/lmapas"||parsed[0]=="/listmaps")){
string[] a=find_files("maps/*.map");
string msg;
for(uint i=0;i<a.length();i++){
if(i<a.length()-1)msg+=string_replace(a[i], ".map", "", true)+"\r\n";
else if(i==a.length()) msg+=string_replace(a[i], ".map", "", true);
}
send_reliable(players[index].peer_id, msg, 0);
}
else if((parsed[0]=="/canhãod"||parsed[0]=="/cannondown")){
for(uint i=0;i<canhaos.length();i++){
destroy_moving_sound(canhaos[i].cannon_sound);
canhaos.remove_at(i);
}
}
else if((parsed[0]=="/canhão"||parsed[0]=="/cannon")&&parsed.length()>3)spawn_cannon(string_to_number(parsed[1]), string_to_number(parsed[2]), parsed[3], string_to_number(parsed[4]));
}
void lightning_play(){
int j=random(1, 100);
if(j<=30){
int m=random(0, mraio.length()-1);
for(uint i=0;i<players.length();i++){
if(players[i].map==mraio[m]&&players[i].mizuno_vest==0){
send_reliable(0, "msgdepois "+players[i].charname+" was hit"+" by a lightning bolt!", 0);
change_map(initial_map, i, 1, 0);
}
}
}
send_reliable(0, "pst thunder"+random(1, 19)+".ogg", 0);
if(raining==1){
for(uint i=0;i<players.length();i++){
if(players[i].flu_count==0&&string_contains(take_roof(players[i].map), "telha", 1)<0&&string_contains(take_roof(players[i].map), "telhado", 1)<0&&take_roof(players[i].map)!="none"){
int flu_roll=random(1, 100);
if(flu_roll<40){
players[i].flu_count=1;
players[i].tgripe.restart();
send_reliable(players[i].peer_id, "msgnormal You start to feel bad!", 0);
}
}
}
}
}
