maquinatempos[i].turned_on=0;
send_packet(0, "atumaquinatempo "+maquinatempos[i].id+" "+maquinatempos[i].turned_on, maquinatempos[i].map);
}
else if(maquinatempos[i].turned_on==0){
maquinatempos[i].turned_on=1;
send_packet(0, "atumaquinatempo "+maquinatempos[i].id+" "+maquinatempos[i].turned_on, maquinatempos[i].map);
}
}
}
if(players[index].map=="gunsmith_house"&&players[index].x==10&&players[index].y==0){
if(players[index].inv_item_number("broken_mp7")>1){
players[index].inv_add_item("broken_mp7", -2, false);
players[index].inv_add_item("mp7", 1);
send_reliable(players[index].peer_id, "msgnormal Using the usable parts of your damaged gun, Ithalo, the gunsmith, brings you a fixed new weapon", 0);
}
else if(players[index].inv_item_number("broken_galil")>1){
players[index].inv_add_item("broken_galil", -2, false);
players[index].inv_add_item("galil", 1);
send_reliable(players[index].peer_id, "msgnormal Using the usable parts of your damaged gun, Ithalo, the gunsmith, brings you a fixed new weapon", 0);
}
else if(players[index].inv_item_number("broken_bazooka")>1){
players[index].inv_add_item("broken_bazooka", -2, false);
players[index].inv_add_item("bazooka", 1);
send_reliable(players[index].peer_id, "msgnormal Using the usable parts of your damaged gun, Ithalo, the gunsmith, brings you a fixed new weapon", 0);
}
}
else if(players[index].map=="fander_room"&&players[index].x>=18&&players[index].x<=19&&players[index].inv_item_number("kidnapper_corpse")>0){
send_reliable(players[index].peer_id, "msg2 Fander, o delegado; ;diz:; ;Excelente trabalho;, "+players[index].charname+"! ;Honestly, with this amount of bodies, I doubt the gang has been dismantled... But, for your dedication in helping us, here is your reward:", 0);
double d=players[index].inv_item_number("kidnapper_corpse");
players[index].inv_add_item("kidnapper_corpse", -d, false);
give_item(players[index].charname, "reais", (10*d));
give_item(players[index].charname, "xp", (10*d));
}
else if(players[index].map=="constant_battle"){
if(players[index].x==79){
if(players[index].equipedesafio==1)change_map("constant_battle", index, 81, 0, "moveu.ogg");
else send_reliable(players[index].peer_id, "msgnormal Get out of here, you can't get in here!", 0);
}
else if(players[index].x==21){
if(players[index].mortal_team==1)change_map("constant_battle", index, 19, 0, "moveu.ogg");
else send_reliable(players[index].peer_id, "msgnormal Get out of here, you can't get in here!", 0);
}
}
for(uint i=0;i<fonteaguas.length();i++){
if(fonteaguas[i].x==players[index].x&&fonteaguas[i].y==players[index].y&&fonteaguas[i].map_data==players[index].map){
if(players[index].nsede>0){
send_packet10(0, players[index].charname, players[index].charname, "bebendoagua.ogg "+players[index].x+" "+players[index].y, players[index].map);
players[index].nsede-=20;
}
else send_reliable(players[index].peer_id, "msgnormal But you are too full!"+"!", 0);
break;
}
}
string message_text=string_replace(get_event_message(), "zsa ", "", false);
if(message_text=="An old desktop"&&players[index].map=="teachers_room")send_reliable(players[index].peer_id, "msgnormal Impressivelly, this desktop PC is working properly, and, if you aproach your eyes more nearby, you will see some small letters, that says: \"We need 250 olives to stuff the pizzas that we must prepare for our students!\"", 0);
else if(players[index].map=="principals_office"&&message_text=="Principal's desk"&&players[index].inv_item_number("olive")>=250){
send_reliable(players[index].peer_id, "msgnormal Somebody said: thank you, your contribution, it's really useful to continue this project, as a reward for your help, we 'll give you a reward.", 0);
players[index].inv_add_item("olive", -250, false);
players[index].inv_add_item("teleporter_pack", 1);
send_reliable(players[index].peer_id, "msgpegouitem 1 pacote_de_teleporters", 0);
}
else if(message_text=="Lanchonete."&&players[index].map=="fishing_spot"){
int p=players[index].inv_item_number("caught_fish");
if(p>=10&&p<30){
send_reliable(players[index].peer_id, "msgnormal Toninho, the clerk, says: \"You're pretty good man, thanks for the fishes.", 0);
players[index].inv_add_item("caught_fish", -10, false);
players[index].inv_add_item("reais", 50);
send_reliable(players[index].peer_id, "msgpegouitem 50 reais", 0);
if(doublegold==1){
send_reliable(players[index].peer_id, "msgyougainmore 50", 0);
players[index].inv_add_item("reais",50);
}
gain_xp(players[index].charname, 100, 0, true);
}
else if(p>=30&&p<50){
send_reliable(players[index].peer_id, "msg2 Toninho, the clerk, says: \"Wow! impressive, you're one of the better fisherman in the world, thanks for the fishes\".", 0);
players[index].inv_add_item("caught_fish", -30, false);
players[index].inv_add_item("reais", 150);
send_reliable(players[index].peer_id, "msgpegouitem 150 reais", 0);
if(doublegold==1){
send_reliable(players[index].peer_id, "msgyougainmore 150", 0);
players[index].inv_add_item("reais",150);
}
gain_xp(players[index].charname, 300, 0, true);
}
else if(p>=50){
send_reliable(players[index].peer_id, "msg2 Toninho, the clerk, says: \"Wow dude, you catch 50 fishes! i never catched this ammount of fish, you are being really helpful right here man, i can't believe this.", 0);
players[index].inv_add_item("caught_fish", -50, false);
players[index].inv_add_item("reais", 300);
send_reliable(players[index].peer_id, "msgpegouitem 300 reais", 0);
if(doublegold==1){
send_reliable(players[index].peer_id, "msgyougainmore 300", 0);
players[index].inv_add_item("reais",300);
}
gain_xp(players[index].charname, 600, 0, true);
}
else if(p<10)send_reliable(players[index].peer_id, "msgnormal Toninho, the clerk, says: \"if you catch some fishes for us, i can give you a lil cash, just work for me, and than, i pay\".", 0);
}
else if(message_text=="Toilet"&&players[index].centado==false){
send_packet(0, "play dando_descarga.ogg "+players[index].x+" "+players[index].y, players[index].map);
send_reliable(players[index].peer_id, "stopmoving", 0);
players[index].tmaquina.restart();
for(uint i=0;i<bathroom_zones.length();i++){
if(players[index].map==bathroom_zones[i].map) bathroom_zones[i].descarga=0;
}
}
else if(message_text=="Cornelius, The Wizard, is standing here, preparing his potions."&&players[index].terminouquestritual==0&&players[index].ritual_quest==1){
if(players[index].inv_item_number("dog_corpse")>=25&&players[index].inv_item_number("monkey_corpse")>=20&&players[index].inv_item_number("wolf_corpse")>=15&&players[index].inv_item_number("bear_corpse")>=10&&players[index].inv_item_number("shark_corpse")>=4&&players[index].inv_item_number("dragonsaurus_corpse")>=1){
send_reliable(players[index].peer_id, "msg2 Witch; ;Sais,; ;Congratulations! You got what I wanted, to create the midnight ritual and dominate this world, for the wickedness and disaster of humans ... Thank you! Here are your rewards:; ;50 ;dart;, 50 ;Poisoned_dart; ;and; 100 ;explosive_tape;.", 0);
players[index].inv_add_item("dog_corpse", -25, false);
players[index].inv_add_item("monkey_corpse", -20, false);
players[index].inv_add_item("wolf_corpse", -15, false);
players[index].inv_add_item("bear_corpse", -10, false);
players[index].inv_add_item("shark_corpse", -4, false);
players[index].terminouquestritual=1;
players[index].inv_add_item("explosive_tape", 100, false);
players[index].inv_add_item("dart", 50, false);
players[index].inv_add_item("poisoned_dart", 50, false);
players[index].inv_add_item("dragonsaurus_corpse",1);
}
}
else if(message_text=="Cornelius, The Wizard, is standing here, preparing his potions."&&players[index].inv_item_number("rabbit_fur")>=35){
players[index].inv_add_item("rabbit_fur", -35, false);
players[index].inv_add_item("mana_pack", 1);
send_reliable(players[index].peer_id, "msg2 Cornelius, the Warlock; ;Sais,; ;Thank you so much for the rabbit pelts! They will serve for a great little thing...", 0);
}
/*
else if(msga=="Nadando nas águas frias do mar."&&players[index].inv_item_number("gift")>=20){
players[index].inv_add_item("gift", -20);
send_reliable(players[index].peer_id, "mbonus", 0);
}
*/
else if(message_text=="A large table, with chairs upholstered around, intended for reading."&&players[index].inv_item_number("gift")>=10){
players[index].inv_add_item("gift", -10);
players[index].inv_add_item("christmas_pack", 1);
send_packet10(0, players[index].charname, players[index].charname, "cfeliz.ogg "+players[index].x+" "+players[index].y, players[index].map);
}
else if(message_text=="Guarda-roupa."&&players[index].map=="medieval_castle"){
if(players[index].x==x_castelo&&players[index].y==y_castelo){
players[index].maptraveltimer.restart();
change_map("chicken_coop", index, 1, 0);
}
else change_map("medieval_world", index, 1, 0);
}
else if(message_text=="A large wooden chest. It looks locked."){
for(uint i=0;i<apartment_zones.length();i++){
if(apartment_zones[i].map==players[index].map){
bool t=false;
for(uint i2=0;i2<computadors.length();i2++){
if(computadors[i2].map==players[index].map){
if(computadors[i2].abau==0&&string_contains(string_to_upper_case(players[index].dalison2), string_to_upper_case(players[index].map), 1)<0){
send_reliable(players[index].peer_id, "msgnormal This wooden chest is locked and you don't have permission to open it.", 0);
return;
}
}
}
if(t)return;
for(uint i2=0;i2<computadors.length();i2++){
if(computadors[i2].map==players[index].map){
if(apartment_zones[i].apartment_inv==""){
send_reliable(players[index].peer_id, "msg2 That chest is empty!", 0);
return;
}
else{
send_reliable(players[index].peer_id, "lapartamento", 0);
send_packet(0, "play abaú.ogg "+players[index].x+" "+players[index].y, players[index].map);
computadors[i2].close_chest_flag=1;
break;
}
}
}
}
}
}
else if(message_text=="Ticket booth"&&players[index].map=="port_of_mortalandia"||message_text=="Ticket booth"&&players[index].map=="port"){
string[] add;
add.insert_last("Choose which place you want the ticket for.:cpassagemporto");
add.insert_last("Cruise to Mortalândia:passagem_de_cruzeiro_para_mortalândia");
add.insert_last("Cruise to Copa Cabana:passagem_de_cruzeiro_para_copa_cabana");
send_reliable(players[index].peer_id, "mnormal "+linear(add), 0);
}
else if(message_text=="service Desk"&&players[index].map=="bank"){
if(players[index].contabancaria==1)send_reliable(players[index].peer_id, "msgnormal You already have a bank account!", 0);
else if(players[index].inv_item_number("reais")<50)send_reliable(players[index].peer_id, "msgnormal You need at least 50 reais to open your account.", 0);
else{
players[index].inv_add_item("reais", -50);
players[index].balance=50;
send_reliable(players[index].peer_id, "stopmoving", 0);
send_packet(0, "play impressora.ogg "+players[index].x+" "+players[index].y, players[index].map);
players[index].tmaquina.restart();
}
}
else if(message_text=="cash machine"){
if(players[index].contabancaria==0){send_reliable(players[index].peer_id, "msgnormal You don't have a bank account.", 0);return;}
string[] add;
add.insert_last("Belick 's Bank, here you are more!:int caixa_eletrônico");
add.insert_last("Check your balance:csaldo");
add.insert_last("Sacar:sac");
add.insert_last("Depositar:dep");
add.insert_last("Deposit into another account:dep2");
send_reliable(players[index].peer_id, "mnormal "+linear(add), 0);
}
netloop();
}
void buy_house(int index){
if(string_contains(players[index].dalison2, "apartment", 1)>-1) send_reliable(players[index].peer_id, "msgnormal You already own a apartment!", 0);
else if(players[index].inv_item_number("reais")<10000) send_reliable(players[index].peer_id, "msgyoudonthave2 10000 reais", 0);
