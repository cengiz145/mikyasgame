bool is_apartment_admin(string char_name_nome, string map_data){
string n1=string_to_upper_case(char_name_nome);
string n2=string_to_upper_case(map_data);
n1=string_replace(n1, "apartamento_de_", "", true);
n2=string_replace(n2, "apartamento_de_", "", true);
n1=string_replace(n1, "\r\n", "", true);
n2=string_replace(n2, "\r\n", "", true);
if(n1==n2||n1=="smurphies"||n1=="suspeito")return true;
return false;
}
bool is_equal(string n1, string n2){
if(string_to_lower_case(n1)==string_to_lower_case(n2))return true;
return false;
}
void give_item(string char_name_nome, string item, double amount_value){
double index=get_player_index_from(char_name_nome);
if(index<0)return;
if(item!="xp"){
players[index].inv_add_item(char_name_nome, amount_value);
send_reliable(players[index].peer_id, "msgpegouitem "+amount_value+" "+item, 0);
if(doublegold==1){
if(item=="reais"||item=="coins"){
players[index].inv_add_item(item, amount_value);
 send_reliable(players[index].peer_id, "msgyougainmore "+amount_value, 0);
}
}
}
else if(item=="xp"){
players[index].xp+=amount_value;
send_reliable(players[index].peer_id, "msgyouwon "+amount_value, 0);
if(doublexp==1){
players[index].xp+=amount_value;
send_reliable(players[index].peer_id, "msgyouwon2 "+amount_value, 0);
}
}
}
string take_speedboat(double index){
//if(players[index].nalancha==0)return "";
string[] dd=string_split(players[index].inv, "\r\n", false);
for(double i=0;i<dd.length();i++){
string[] d=string_split(dd[i], "=", false);
if(string_contains(d[0], "speedboat_key_of_", 1)>-1){
string it=string_replace(d[0], "speedboat_key_of_", "", false);
return it;
}
}
return "";
}
void connect_time_ctime(int index){
string uptime_string;
if (uptime_weeks==1)
uptime_string+="one week, ";
if (uptime_weeks==2)
uptime_string+="duas semanas, ";
if (uptime_weeks>2)
uptime_string+=uptime_weeks+" semanas, ";
if (uptime_days==1)
uptime_string+="one day, ";
if (uptime_days==2)
uptime_string+="dois dias, ";
if (uptime_days>2)
uptime_string+=uptime_days+" dias, ";
if (uptime_hours==1)
uptime_string+="one hour, ";
if (uptime_hours==2)
uptime_string+="duas horas, ";
if (uptime_hours>2)
uptime_string+=uptime_hours+" horas, ";
if (uptime_minutes==1)
uptime_string+="one minute, ";
if (uptime_minutes>1)
uptime_string+=uptime_minutes+" minutos, ";
if (uptime_seconds==1)
uptime_string+="one second";
if (uptime_seconds>1)
uptime_string+=uptime_seconds+" segundos";
send_reliable(event.peer_id, "msgservidorativo "+uptime_string+".",0);
}
void send_to_admins(string msg){
msgadm.insert_at(0, msg);
for(uint i=0;i<players.length();i++){
if(players[i].is_admin()){
send_reliable(players[i].peer_id, "ps notify_startrek_pa.ogg", 0);
send_reliable(players[i].peer_id, "msg2 "+msg, 0);
}
		if(players[i].moderator==true){
			send_reliable(players[i].peer_id, "ps notify_startrek_pa.ogg", 0);
			send_reliable(players[i].peer_id, "msg2 "+msg, 0);
		}
	}
}
void option_command(int index, string[] parsed){
string msg=string_replace(get_event_message(), parsed[0]+" "+parsed[1]+" ", "", false);
if(parsed[1]=="ideia"){
if(msg.length()<120)send_reliable(players[index].peer_id, "msgnormal The message is too short.", 0);
else{
send_reliable(players[index].peer_id, "msgnormal Ideia enviada!", 0);
send_to_admins("Idea from "+players[index].charname+": "+msg);
}
}
}
bool is_disabled_command(int index, string[] parsed){
string v=string_replace(parsed[0], "/", "", false);
if(file_exists("qcomandos/"+v+".md")){
file f;
f.open("qcomandos/"+v+".md", "r");
string[] vv=string_split(f.read(), "\r\n", false);
f.close();
bool r=false;
for(uint i=0;i<vv.length();i++){
if(string_to_lower_case(vv[i])==string_to_lower_case(players[index].charname)){
r=true;
break;
}
}
if(r)return true;
else return false;
}
return false;
}
void died(int index, string[] parsed){
send_reliable(0, "msg2 "+players[index].charname+"; ;morreu; ;"+string_replace(get_event_message(), parsed[0]+" ", "", false), 0);
change_map("tunnel", index, 1, 0);
players[index].health=players[index].maxhealth;
players[index].centado=false;
if(players[index].inv_item_number("mountain_sand")>0){
players[index].inv_add_item("mountain_sand", -1);
send_reliable(players[index].peer_id, "ps notify_died.ogg", 0);
}
if(players[index].cloaked)
{
players[index].cloaked=false;
players[index].cloakhiding=false;
send_reliable(players[index].peer_id,"stopcloak",0);
send_packet(0,"play spell_cloak_powerdown.ogg "+players[index].x+" "+players[index].y+" "+players[index].map,players[index].map);
}
players[index].envenenado=false;
players[index].nveneno=0;
players[index].paralyzed_count=0;
players[index].paralyzed=false;
players[index].paralyzed_timer.force(0);
players[index].paralyzed_timer.pause();
players[index].afking=false;
players[index].afk=false;
send_reliable(players[index].peer_id, "fimnovato", 0);
if(players[index].invisibility==0){
send_reliable(0,"playerbeep "+players[index].charname+" 1",0);
players[index].bipar=1;
}
if(game_stopped==false)send_reliable(players[index].peer_id,"startmoving",0);
}
void deposit3(int index, string[] parsed){
string nn=parsed[1];
double n=string_to_number(players[index].vconta);
file f;
f.open("players/"+nn+"/contabancaria.usr", "r");
int t=string_to_number(f.read());
f.close();
if(is_equal(nn, players[index].charname))return;
if(t<=0)send_reliable(players[index].peer_id, "msgnormal Inexistent account", 0);
else if(n<=0)send_reliable(players[index].peer_id, "msgnormal Invalid value.", 0);
else if(n>players[index].inv_item_number("reais"))send_reliable(players[index].peer_id, "msgnormal You don't have all that money!", 0);
else{
players[index].inv_add_item("reais", -n);
send_reliable(players[index].peer_id, "msg2 You transfer; ;"+n+"; ;reais in account of; ;"+nn+".", 0);
file f;
f.open("players/"+nn+"/saldo.usr", "r");
int balance=string_to_number(f.read());
f.close();
f.open("players/"+nn+"/saldo.usr", "w");
f.write(n+balance);
f.close();
}
}
void spawn_animal(double index, string[] parsed){
double amount_value=string_to_number(parsed[2]);
if(amount_value>3)amount_value=3;
if(amount_value<=0)amount_value=1;
string animal_kind=parsed[1];
for(double i=0;i<amount_value;i++){
if(animal_kind=="dragonsauro")spawn_dragonsaur(1, 0, players[index].map);
if(animal_kind=="urso")spawn_bear(1, 0, players[index].map);
if(animal_kind=="sequestrador")spawn_kidnapper(1, 0, players[index].map);
if(animal_kind=="guarda")spawn_guard(1, 0, players[index].map);
if(animal_kind=="guardacofre")spawn_safe_guard(1, 0, players[index].map);
if(animal_kind=="prensadeira")spawn_crusher(1, 0, players[index].map);
if(animal_kind=="amon_ra")spawn_amon_ra(1, 0, players[index].map);
if(animal_kind=="god")spawn_god(1, 0, players[index].map);
if(animal_kind=="dragon")spawn_god(1, 0, players[index].map);

if(animal_kind=="irroadium")spawn_irroadium(1, 0, players[index].map);
if(animal_kind=="fantozaur")spawn_fantozaur(1, 0, players[index].map);
if(animal_kind=="deciced")spawn_deciced(1, 0, players[index].map);
if(animal_kind=="tabalus")spawn_tabalus(1, 0, players[index].map);
if(animal_kind=="gato")spawn_cat(1, 0, players[index].map);
if(animal_kind=="dragon_blanco")spawn_dragon_blanco(1, 0, players[index].map);
if(animal_kind=="mercenario")spawn_mercenary(1, 0, players[index].map);
}
send_reliable(players[index].peer_id, "Pronto.", 0);
}
void give(double index, string[] parsed){
double i2=get_player_index_from(parsed[1]);
if(i2>-1)
{
double amount=string_to_number(parsed[3]);
if(players[index].no_items==1)
{
send_reliable(players[index].peer_id,"msgnormal You can't give items.",0);
}
else if (parsed[2]=="broken_leg")
{
send_reliable(event.peer_id, "msgnormal No, you can't cut off your legs and give them to someone!",0);
}
else if(parsed[2]=="glock"||parsed[2]=="desert_eagle"||parsed[2]=="knife"){
send_reliable(players[index].peer_id, "msgnormal You cannot give this item", 0);
return;
}
else
{
if(amount<=players[index].inv_item_number(parsed[2]) and amount>0)
{
players[index].inv_add_item(parsed[2],0-amount);
players[i2].inv_add_item(parsed[2],amount);
send_reliable(players[i2].peer_id,"msglhedeu "+players[index].charname+" "+amount+" "+parsed[2],0);
send_reliable(players[index].peer_id,"msgyougave "+amount+" "+parsed[2]+" "+players[i2].charname,0);
send_packet(0,"play gift.ogg "+players[i2].x+" "+players[i2].y+" "+players[i2].map,players[i2].map);
}
else
{
send_reliable(players[index].peer_id,"msgyoudonthave", 0);
}
}
}
else
{
send_reliable(players[index].peer_id,"msgplayernotfound",0);
}
}
void is_apartment(int index, string[] parsed){
int code=string_to_number(parsed[1]);
string map=players[index].map;
file f;
f.open("maps/"+map+".map", "r");
string mdata=f.read();
f.close();
string[] p1=delinear(mdata);
for(uint i=0; i<p1.length(); i++){
string[] parsed=string_split(p1[i], ":", true);
if(parsed[0]=="travelpoint"&&parsed.length()>8){
int minx=string_to_number(parsed[1]);
int maxx=string_to_number(parsed[2]);
int miny=string_to_number(parsed[3]);
int maxy=string_to_number(parsed[4]);
int newx=string_to_number(parsed[5]);
int newy=string_to_number(parsed[6]);
string newmap=parsed[7];
string newmap2=parsed[7];
string text=parsed[8];
string sec="";
if(parsed.length()>9) sec=parsed[9];
string[] tmpout;
if(minx<=players[index].x and maxx>=players[index].x and miny<=players[index].y and maxy>=players[index].y){
for(uint i2=0;i2<computadors.length();i2++){
if(computadors[i2].map==newmap){
if(code!=computadors[i2].house_code||code==0){
if(computadors[i2].safe==1){
players[index].health=-1;
players[index].lasthit="eletrocutado_"+string_replace(computadors[i2].map, "_apartment", "", false);
send_packet(0, "play eletrocutado.ogg "+players[index].x+" "+players[index].y, players[index].map);
return;
}
else if(computadors[i2].safe==0&&computadors[i2].alarm_timer==0){
computadors[i2].alarm_timer=1;
computadors[i2].salarme=spawn_moving_sound("alarm5.ogg", players[index].x, players[index].y, players[index].map);
computadors[i2].salarme2=spawn_moving_sound("alarm5.ogg", 1, 0, computadors[i2].map);
return;
}
}
else if(code==computadors[i2].house_code){
change_map(computadors[i2].map, index, 1, 0, "eapartamento.ogg");
return;
}
}
}
}
}
}
}
void drop(double index, double amount_value, string nomeitem){
if(amount_value<=players[index].inv_item_number(nomeitem) and amount_value>0)
{
bool has=false;
if(players[index].no_items==1) send_reliable(players[index].peer_id,"msgnormal You can't drop items.",0);
else if(nomeitem=="bazooka"||nomeitem=="wand"||nomeitem=="galil"||nomeitem=="mp7"||nomeitem=="parachute"||nomeitem=="explosive_tape_controller"||nomeitem=="life_vest"||nomeitem=="bulletproof_vest"||nomeitem=="knife")return;
else
{
players[index].inv_add_item(nomeitem,0-amount_value);
for(uint i=0;i<apartment_zones.length();i++){
if(apartment_zones[i].map==players[index].map&&string_contains(get_zone_at(players[index].x, players[index].y, players[index].map), "A large wooden chest. It looks locked.", 1)>-1){
apartment_zones[i].inv_add_item(nomeitem, amount_value);
has=true;
break;
}
}
if(nomeitem=="kidnapper_corpse"&&players[index].map=="fander_room"&&players[index].questdesaparecida==1&&players[index].terminouquestdesaparecida==0){
send_reliable(players[index].peer_id, "msgnormal Finally! After your incessant search and willpower, you arrive at your final destination, bringing what Fander, a federal police and Kinder delegate, the father of the missing girl so much sought. \"You did a great job,\" Fander says. -Thank you very much for the help, it's thanks to people like you that Belick, despite having many thieves, is advancing and still prevails over evil, continues Kinder. \"I have a reward for you.\" It is not much, but it will certainly help you in many situations, complete Jader, President of Belick.", 0);
players[index].inv_add_item("police_helmet", 1);
players[index].inv_add_item("reais", random(100, 200));
players[index].terminouquestdesaparecida=1;
}
else if(has==false){
if(string_contains(nomeitem, "_nsumir", 1)>-1){
nomeitem=string_replace(nomeitem, "_nsumir", "", true);
spawn_obj(players[index].x,players[index].y,nomeitem,amount_value,players[index].map, 0);
}
else spawn_obj(players[index].x,players[index].y,nomeitem,amount_value,players[index].map);
}
}
}
}
void getversion(int index){
	if(file_exists("players/"+players[index].charname+"/mod.md"))players[index].moderator=true;
	if(players[index].peaceful==1)send_reliable(players[index].peer_id,"ininovato", 0);
file ff;
if(file_exists("players/"+players[index].charname+"/saldo.md")){
ff.open("players/"+players[index].charname+"/saldo.md", "r");
players[index].balance=string_to_number(ff.read());
ff.close();
}
ff.open("players/"+players[index].charname+"/inv.md", "r");
string inventory_string=ff.read();
ff.close();
inventory_string=string_replace(inventory_string, " ", "", true);
players[index].inv=inventory_string;
string[] invsec;
if(players[index].inv_item_number("fishing_rod")>0)invsec.insert_last("fishing_rod");
if(players[index].inv_item_number("gasoline_can")>0)invsec.insert_last("Fuel");
if(players[index].inv_item_number("dart")>0)invsec.insert_last("dart");
if(players[index].inv_item_number("poisoned_dart")>0)invsec.insert_last("poisoned_dart");
if(players[index].inv_item_number("gasoline_can")>0)invsec.insert_last("Fuel");
if(players[index].inv_item_number("explosive_tape")>0)invsec.insert_last("explosive_tape");
send_reliable(players[index].peer_id, "inv "+players[index].inv, 0);
if(invsec.length()>0)send_reliable(players[index].peer_id, "invsec "+linear(invsec), 0);
if(file_exists("players/"+players[index].charname+"/seguro.txt"))send_reliable(players[index].peer_id, "seguro", 0);
if(players[index].sapatomagnetico==1)send_reliable(players[index].peer_id, "asapato", 0);
if(players[index].is_admin()==true){
send_reliable(players[index].peer_id, "djogador", 0);
players[index].wand_energy=1000000;
players[index].nsede=0;players[index].nfome=0;players[index].flu_count=0;
}
	if(players[index].moderator==true){
		send_reliable(players[index].peer_id, "dmoderador", 0);
		players[index].wand_energy=100;
		players[index].nsede=0;players[index].nfome=0;players[index].flu_count=0;
	}
send_reliablen(0, players[index].charname, "p "+players[index].charname+" "+players[index].x+" "+players[index].y,0);
send_reliablen(0, players[index].charname, "playerbeep "+players[index].charname+" "+players[index].bipar, 0);
send_reliablen(0,players[index].charname, "upl "+players[index].charname+" "+players[index].x+" "+players[index].y+" "+players[index].map,0);
send_reliablen(0, players[index].charname, "pp "+players[index].charname+" "+players[index].peaceful, 0);
for (uint i=0; i<players.length(); i++){
send_reliable(players[index].peer_id,"p "+players[i].charname+" "+players[i].x+" "+players[i].y,0);
send_reliable(players[index].peer_id, "playerbeep "+players[i].charname+" "+players[i].bipar, 0);
send_reliable(players[index].peer_id,"upl "+players[i].charname+" "+players[i].x+" "+players[i].y+" "+players[i].map,0);
send_reliable(players[index].peer_id, "pp "+players[i].charname+" "+players[i].peaceful, 0);
}
for(uint i=0;i<apartment_zones.length();i++){if(apartment_zones[i].map==players[index].map)send_reliable(players[index].peer_id, "apartamentoinv "+apartment_zones[i].apartment_inv,0);}
for(uint i=0;i<computadors.length();i++){
if(computadors[i].map==players[index].map){
send_reliable(players[index].peer_id,"spawncomputador "+computadors[i].id+" "+computadors[i].x+" "+computadors[i].y+" "+computadors[i].map+" "+computadors[i].turned_on,0);
string pc_options="Exibir estatísticas=status\r\nAlternar modo de segurança entre choque e alarme=segurança\r\nImprimir um documento=imprimir\r\nEnviar ideia=ideia";
pc_options+="\r\n"+(computadors[i].clock==0?"Disable":"Enable")+" watch=relógio";
if(computadors[i].alarm_timer==1)pc_options+="\r\nDesativar alarme=alarme";
if(is_apartment_admin(players[index].dalison2, computadors[i].map)){
pc_options+="\r\n"+(computadors[i].abau==0? "not allowing":"permitindo")+" others to open your chest";
if(computadors[i].close_chest_flag==1)pc_options+="\r\nFechar baú=fecharbaú";
if(computadors[i].tabrir.elapsed<=0)pc_options+="\r\nAbrir porta por 5 segundos=porta";
pc_options+="\r\nRemove players from your apartment=expulsar";
pc_options+="\r\nTrocar código de acesso=mcod";
}
if(players[index].is_admin())pc_options+="\r\nLer mensagens administrativas=administrativas";
send_reliable(players[index].peer_id, "opcoespc "+pc_options, 0);
break;
}
}
for(uint i=0; i<maquinatempos.length(); i++){
send_reliable(players[index].peer_id,"spawnmaquinatempo "+maquinatempos[i].id+" "+maquinatempos[i].x+" "+maquinatempos[i].y+" "+maquinatempos[i].map+" "+maquinatempos[i].turned_on,0);
}
for(uint iba=0; iba<msounds.length(); iba++){
if(msounds[iba].map==players[index].map)send_reliable(players[index].peer_id,"cm "+msounds[iba].id+" "+msounds[iba].soundloop+" "+msounds[iba].x+" "+msounds[iba].y+" "+msounds[iba].map, 0);
}
send_packet(0,"upl "+players[index].charname+" "+players[index].x+" "	+players[index].y+" "+players[index].map,players[index].map);
send_items(index);
if(raining==1){
send_reliable(players[index].peer_id, "volumechuva "+rain_volume, 0);
send_reliable(players[index].peer_id, "chuvaativa", 0);
}
if(players[index].wearing_life_vest==1)send_reliable(players[index].peer_id, "usarcolete", 0);
string ms="motd Bem-welcome"+" "+version+" ";
if(players[index].chat_language=="pt")ms+=msg_pt;
else if(players[index].chat_language=="en")ms+=msgen;
else if(players[index].chat_language=="es")ms+=msges;
else if(players[index].chat_language=="fr")ms+=msgfr;
send_reliable(players[index].peer_id, ms, 0);
for(uint i=0;i<ambientesmapa.length();i++){
string[] z=string_split(ambientesmapa[i], ":", false);
if(players[index].map==z[0]){
if(hour_value<6||hour_value>=18) send_reliable(players[index].peer_id, "addambiente 1 200 0 200 "+z[1], 0);
else if(hour_value>=6||hour_value<18) send_reliable(players[index].peer_id, "addambiente 1 200 0 200 "+z[2], 0);
}
}
if(TIME_HOUR==16)send_reliable(players[index].peer_id, "msg2 Event in progress:; ;Massacre of the kidnappers' gang;.", 0);
if(TIME_HOUR==18)send_reliable(players[index].peer_id, "msg2 Event in progress:; ;War helicopter;.", 0);
if(TIME_HOUR==20)send_reliable(players[index].peer_id, "msg2 Event in progress:; ;The Belick's security van;.", 0);
int rand=random(0, servidornomes.length()-1);
send_reliable(players[index].peer_id, "msg2 This connection is sponsored by; ;"+servidornomes[rand]+".", 0);
if(game_stopped) 
{
send_reliable(players[index].peer_id,"stopmoving",0);
send_reliable(players[index].peer_id,"msgnormal The game is frozen.",0);
}
send_reliable(players[index].peer_id, "ps ding1.ogg", 0);
players[index].conectou=1;
netloop();
}
void whoonline(int index){
onthis=0;
onother=0;
string send_message;
for (uint i=0; i<players.length(); i++){
if(players[i].map==players[index].map&&players[i].afk==false&&players[i].invisibility==0)onthis+=1;
else if(players[i].map!=players[index].map&&players[i].afk==false&&players[i].invisibility==0)onother+=1;
}
if (onother>0&&onthis>0)send_message=(onthis+onother)+" online. "+onthis+" here, "+onother+" somewhere else.";
else if(onthis<=0&&onother>0)send_message=onother+" online. "+onother+" somewhere else.";
else if (onother==0&&onthis>1)send_message=(onthis+onother)+" online. "+onthis+" here.";
else if (onother==0&&onthis==1){
for(uint i=0;i<players.length();i++){
if(players[i].map==players[index].map&&players[i].invisibility==0&&players[i].afk==false)send_message="Apenas "+players[i].title+" "+players[i].charname+" in the game.";
}
}
send_reliable(players[index].peer_id, "msgonlines "+send_message,0);
netloop();
}
void pc(int index){
string m=string_replace(get_event_message(), "pc ", "", false);
if(string_contains(m, "safety", 1)>-1){
for(uint i=0;i<computadors.length();i++){
if(computadors[i].map==players[index].map){
if(computadors[i].safe==0){
computadors[i].safe=1;
send_packet(0, "play schoque.ogg "+computadors[i].x+" "+computadors[i].y, computadors[i].map);
}
else if(computadors[i].safe==1){
computadors[i].safe=0;
send_packet(0, "play salarme.ogg "+computadors[i].x+" "+computadors[i].y, computadors[i].map);
}
break;
}
}
}
else if(string_contains(m, "documento", 1)>-1) send_reliable(players[index].peer_id, "mtext What do you want to write on the flyer?:imprimir", 0);
else if(string_contains(string_to_lower_case(m), "access", 1)>-1) send_reliable(players[index].peer_id, "mtext What is the new access code for your apartment?:mudcod", 0);
else if(string_contains(string_to_lower_case(m), "enviar ideia", 1)>-1) send_reliable(players[index].peer_id, "mtext Type your idea (at least 120 letters). It will be sent to the administrators.:opc ideia", 0);
else if(string_contains(m, "Exibir", 1)>-1)send_reliable(players[index].peer_id, "msg2 You are in the level; "+players[index].level+", ;and in the patent; ;"+string_trim_right(players[index].title, 1)+";. ;Your experience is; "+players[index].xp+", ;And, to reach the next level, you will need more; ;"+(players[index].xprequerida-players[index].xp)+". ;You're with; "+players[index].nfome+"% ;of hunger, and;"+players[index].nsede+"% ;of thirst.", 0);
else if(string_contains(m, "mensagens administrativas", 1)>-1){
string[] add;
add.insert_last("Available messages:"+bell2+"z");
for(uint i=0;i<msgadm.length();i++){
add.insert_last(msgadm[i]+bell2+"z");
}
send_reliable(players[index].peer_id, "mnormal2 "+linear(add), 0);
}
else if(string_contains(m, "let others open your chest", 1)>-1){
for(uint i=0;i<computadors.length();i++){
if(computadors[i].map==players[index].map){
if(computadors[i].abau==0)computadors[i].abau=1;
else if(computadors[i].abau==1)computadors[i].abau=0;
}
}
}
else if(string_contains(m, "Close chest", 1)>-1){
for(uint i=0;i<computadors.length();i++){
if(computadors[i].map==players[index].map){
computadors[i].close_chest_flag=0;
send_packet(0, "fbau", computadors[i].map);
send_packet(0, "play fbaú.ogg 6 21", computadors[i].map);
}
}
}
else if(string_contains(m, "Watch", 1)>-1){
for(uint i=0;i<computadors.length();i++){
if(computadors[i].map==players[index].map){
if(computadors[i].clock==0){
computadors[i].clock=1;
if(computadors[i].srelogio!="")destroy_moving_sound(computadors[i].srelogio);
}
else if(computadors[i].clock==1){
computadors[i].clock=0;
if(computadors[i].srelogio!="")destroy_moving_sound(computadors[i].srelogio);
computadors[i].srelogio=spawn_moving_sound("clock.ogg", 1, 4, computadors[i].map);
}
}
}
}
else if(string_contains(m, "Open door for 5 seconds.", 1)>-1){
for(uint i=0;i<computadors.length();i++){
if(computadors[i].map==players[index].map){
file f;
f.open("maps/"+players[index].map+".map", "r");
string[] linhas=delinear(f.read());
f.close();
int x=1000, y=0;
for(uint i2=0;i2<linhas.length();i2++){
string[] l=string_split(linhas[i2], ":", false);
if(l[0]=="travelpoint"){
x=string_to_number(l[5]);
y=string_to_number(l[6]);
}
}
send_packet(0, "play door12open.ogg "+x+" "+y, "apartment_building");
computadors[i].tabrir.restart();
}
}
}
else if(string_contains(m, "Kick players from your apartment.", 1)>-1){
for(uint i=0;i<computadors.length();i++){
if(computadors[i].map==players[index].map){
file f;
f.open("maps/"+players[index].map+".map", "r");
string[] linhas=delinear(f.read());
f.close();
int x=1, y=0;
for(uint i2=0;i2<linhas.length();i2++){
string[] l=string_split(linhas[i2], ":", false);
if(l[0]=="travelpoint"){
x=string_to_number(l[5]);
y=string_to_number(l[6]);
}
}
for(uint i2=0;i2<players.length();i2++){
if(players[i2].charname!=players[index].charname&&players[i2].map==players[index].map){
change_map("apartment_building", i2, x, y);
send_reliable(players[i2].peer_id, "msg2 You have been kicked off from apartment of; "+players[index].charname+"!", 0);
}
}
send_reliable(players[index].peer_id, "msgnormal Pronto.", 0);
}
}
}
else if(string_contains(m, "Disable alarm", 1)>-1){
for(uint i=0;i<computadors.length();i++){
if(computadors[i].map==players[index].map){
computadors[i].alarm_timer=0;
destroy_moving_sound(computadors[i].salarme);
destroy_moving_sound(computadors[i].salarme2);
break;
}
}
}
for(uint i=0;i<computadors.length();i++){
if(computadors[i].map==players[index].map){
string pc_options="Exibir estatísticas=status\r\nAlternar modo de segurança entre choque e alarme=segurança\r\nImprimir um documento=imprimir\r\nEnviar ideia=ideia";
pc_options+="\r\n"+(computadors[i].clock==0?"Disable":"Enable")+" watch=relógio";
if(computadors[i].alarm_timer==1)pc_options+="\r\nDesativar alarme=alarme";
if(is_apartment_admin(players[index].dalison2, computadors[i].map)){
pc_options+="\r\n"+(computadors[i].abau==0? "not allowing":"permitindo")+" others to open your chest";
if(computadors[i].close_chest_flag==1)pc_options+="\r\nFechar baú=fecharbaú";
if(computadors[i].tabrir.elapsed<=0)pc_options+="\r\nAbrir porta por 5 segundos=porta";
pc_options+="\r\nRemove players from your apartment=expulsar";
pc_options+="\r\nTrocar código de acesso=mcod";
}
if(players[index].is_admin())pc_options+="\r\nLer mensagens administrativas=administrativas";
send_packet(0, "opcoespc "+pc_options, computadors[i].map);
break;
}
}
netloop();
}
void zsa1(int index){
bool has=false, avisou=false;
string pc_options;
for(uint i=0;i<computadors.length();i++){
if(players[index].x==computadors[i].x&&players[index].y==computadors[i].y&&computadors[i].map==players[index].map&&players[index].centado){
for(uint i2=0;i2<players.length();i2++){
if(players[i2].centado==true&&players[index].x==players[i2].x&&players[index].y==players[i2].y&&players[index].map==players[i2].map&&players[i2].charname!=players[index].charname){
has=true;
break;
}
}
if(computadors[i].starting_engine==true&&computadors[i].iniciado==false){
send_reliable(players[index].peer_id, "msgnormal Iniciando o Sistema DM...", 0);
avisou=true;
break;
}
if(has==true&&avisou==false)send_reliable(players[index].peer_id, "msgnormal Someone is already on the computer!", 0);
else if(has==false&&avisou==false&&computadors[i].turned_on==1){
pc_options="Exibir estatísticas=status\r\nAlternar modo de segurança entre choque e alarme=segurança\r\nImprimir um documento=imprimir\r\nEnviar ideia=ideia";
pc_options+="\r\n"+(computadors[i].clock==0?"Disable":"Enable")+" watch=relógio";
if(computadors[i].alarm_timer==1)pc_options+="\r\nDesativar alarme=alarme";
if(is_apartment_admin(players[index].dalison2, computadors[i].map)){
pc_options+="\r\n"+(computadors[i].abau==0? "not allowing":"permitindo")+" others to open your chest";
if(computadors[i].close_chest_flag==1)pc_options+="\r\nFechar baú=fecharbaú";
if(computadors[i].tabrir.elapsed<=0)pc_options+="\r\nAbrir porta por 5 segundos=porta";
pc_options+="\r\nRemove players from your apartment=expulsar";
pc_options+="\r\nTrocar código de acesso=mcod";
}
if(players[index].is_admin())pc_options+="\r\nLer mensagens administrativas=administrativas";
send_reliable(players[index].peer_id, "opcoespc "+pc_options, 0);
send_reliable(players[index].peer_id, "ucomputador", 0);
}
}
}
for(uint i=0;i<objs.length();i++){
if(objs[i].item=="challenge_flag"&&players[index].x==objs[i].x&&players[index].y==objs[i].y&&players[index].inv_item_number("mortal_flag")>0){
send_reliable(0, "msgnormal The Desafio team won!", 0);
for(uint i2=0;i2<players.length();i2++){
if(players[i2].equipedesafio==1||players[i2].mortal_team==1)
change_map("airport", i2, 1, 10, "moveu.ogg");
if(players[i2].equipedesafio==1)send_reliable(players[i2].peer_id, "ps g_quest.ogg", 0);
players[i2].equipedesafio=0;
}
players[index].inv_add_item("mortal_flag", -1);
break;
}
if(objs[i].item=="mortal_flag"&&players[index].x==objs[i].x&&players[index].y==objs[i].y&&players[index].inv_item_number("challenge_flag")>0){
send_reliable(0, "msgnormal The Mortal team won!", 0);
for(uint i2=0;i2<players.length();i2++){
if(players[i2].equipedesafio==1||players[i2].mortal_team==1)change_map("airport", i2, 1, 10, "moveu.ogg");
if(players[i2].mortal_team==1)send_reliable(players[i2].peer_id, "ps g_quest.ogg", 0);
players[i2].mortal_team=0;
}
players[index].inv_add_item("challenge_flag", -1);
break;
}
}
for(uint i=0;i<maquinatempos.length();i++){
if(maquinatempos[i].x==players[index].x&&maquinatempos[i].y==players[index].y&&maquinatempos[i].map==players[index].map){
