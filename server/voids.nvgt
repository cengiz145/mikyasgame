void interact_menu(int index){
string t=get_tile_at(players[index].x, players[index].y, players[index].map);
string tt=get_zone_at(players[index].x, players[index].y, players[index].map);
if(players[index].map=="fishing_spot"&&string_contains(get_tile_at(players[index].x, players[index].y, players[index].map), "shallow", 1)>-1&&players[index].is_fishing){
if(players[index].fish_count>0){
players[index].fish_count--;
players[index].tppeixe.restart();
if(players[index].fish_count<0)players[index].fish_count=0;
if(players[index].ppeixe==1)send_packet10(0, players[index].charname, players[index].charname, "molinete2.ogg "+players[index].x+" "+players[index].y, players[index].map);
else{
send_packet10(0, players[index].charname, players[index].charname, "molinete1.ogg "+players[index].x+" "+players[index].y, players[index].map);
players[index].plinha=1;
}
//if(players[index].ppeixe==0)players[index].npescar=0;
if(players[index].fish_count==0){
players[index].tppeixe.force(0);players[index].tppeixe.pause();
if(players[index].ppeixe==1)players[index].inv_add_item("caught_fish", 1);
players[index].ppeixe=0;
players[index].plinha=0;
}
}
else if(players[index].fish_count<=0){
players[index].fish_count=1;
players[index].npescando=0;
players[index].tppeixe.restart();
players[index].fish_count=random(3, 9);
if(players[index].inv_item_number("earthworm")>0){
players[index].inv_add_item("earthworm", -1);
players[index].fish_count=random(3, 9);
players[index].npescando=1;
}
send_packet10(0, players[index].charname, players[index].charname, "lanzol.ogg "+players[index].x+" "+players[index].y, players[index].map);
}
return;
}
else if(players[index].map=="fishing_spot"&&tt=="A large lake"){
if(string_contains(players[index].inv, "speedboat_key_of_", 1)<=0){
send_reliable(players[index].peer_id, "msgnormal You don't have any boat's key", 0);
return;
}
string[] d=string_split(players[index].inv, "\r\n", false);
for(uint i=0;i<d.length();i++){
if(string_contains(d[i], "speedboat_key_of_", 1)>-1){
string[] dd=string_split(d[i], "=", false);
string it=string_replace(dd[0], "speedboat_key_of_", "", false);
file f;
f.open("lanchas/"+it+".md", "r");
double n=string_to_number(f.read());
f.close();
if(n<=20){
send_reliable(players[index].peer_id, "msgnormal There's no enough fuel in this boat.", 0);
return;
}
send_reliable(players[index].peer_id, "lanchaliga", 0);
}// end of the contains-key check
}//for
return;
}// end of the boat
else if(string_contains(t, "water2", 1)>-1||string_contains(t, "shallow", 1)>-1){
if(string_contains(players[index].draw, "fire_extinguisher", 1)<0)return;
if(players[index].extintor<10){
send_packet(0, "play recarregar_extintor.ogg "+players[index].x+" "+players[index].y, players[index].map);
players[index].extintor+=1;
return;
}
}
for(uint i=0;i<gold_mine_objs.length();i++){
if(gold_mine_objs[i].x==players[index].x&&gold_mine_objs[i].y==players[index].y&&gold_mine_objs[i].map==players[index].map){
gold_mine_objs[i].quantoscavar--;
send_packet(0, "play c_mina.ogg "+gold_mine_objs[i].x+" "+gold_mine_objs[i].y, gold_mine_objs[i].map);
send_packet(0, "play t_ouro"+random(1, 2)+".ogg "+gold_mine_objs[i].x+" "+gold_mine_objs[i].y, gold_mine_objs[i].map);
if(gold_mine_objs[i].quantoscavar<=0){
send_packet(0, "play d_mina.ogg "+gold_mine_objs[i].x+" "+gold_mine_objs[i].y, gold_mine_objs[i].map);
spawn_obj(players[index].x,players[index].y,"gold",gold_mine_objs[i].quantosouro,players[index].map);
gold_mine_objs.remove_at(i);
}
break;
}
}
for(uint i=0;i<pias.length();i++){
if(pias[i].x==players[index].x&&pias[i].y==players[index].y&&pias[i].map==players[index].map&&pias[i].is_open==false){
send_packet(0, "play atorneira.ogg "+pias[i].x+" "+pias[i].y, pias[i].map);
pias[i].fechando.restart();
pias[i].close_door.restart();
send_packet(0, "play lavando_mãos.ogg "+pias[i].x+" "+pias[i].y, pias[i].map);
pias[i].is_open=true;
send_reliable(players[index].peer_id, "stopmoving", 0);
break;
}
}
for(uint i=0;i<horses.length();i++){
if(horses[i].x==players[index].x&&players[index].map==horses[i].map_data){
if(players[index].horse==false){
players[index].horse=true;
send_reliable(players[index].peer_id, "stopmoving", 0);
players[index].y=1;
send_reliable(players[index].peer_id,"move "+players[index].x+" "+players[index].y,0);
send_packet(0,"upl "+players[index].charname+" "+players[index].x+" "        +players[index].y+" "+players[index].map,players[index].map);
}
else if(players[index].horse==true){
players[index].horse=false;
send_reliable(players[index].peer_id, "startmoving", 0);
players[index].y=2;
send_reliable(players[index].peer_id,"move "+players[index].x+" "+players[index].y,0);
send_packet(0,"upl "+players[index].charname+" "+players[index].x+" "        +players[index].y+" "+players[index].map,players[index].map);
}
}
}
for(uint i=0;i<bathroom_zones.length();i++){
if(bathroom_zones[i].x==players[index].x&&bathroom_zones[i].y==players[index].y&&bathroom_zones[i].map==players[index].map){
if(players[index].centado==false){
if(bathroom_zones[i].toilet_open==false&&tt!="mystique"){
bathroom_zones[i].toilet_open=true;
send_packet(0, "play avaso.ogg "+players[index].x+" "+players[index].y, players[index].map);
}
else if(bathroom_zones[i].toilet_open==true&&tt!="mystique"){
bathroom_zones[i].toilet_open=false;
send_packet(0, "play fvaso.ogg "+players[index].x+" "+players[index].y, players[index].map);
}
else if(tt=="mystique"){
if(players[index].nurina>0){
send_reliable(players[index].peer_id, "stopmoving", 0);
players[index].nurina-=40;
if(players[index].nurina<0)players[index].nurina=0;
send_packet(0, "play mijando.ogg "+players[index].x+" "+players[index].y, players[index].map);
players[index].tmaquina.restart();
players[index].sujo+=2.5;
}
}
}
else if(players[index].centado==true){
if(bathroom_zones[i].toilet_open==false)send_reliable(players[index].peer_id, "msgnormal But you are sitting down!"+" on the toilet lid!", 0);
else{
if(players[index].nurina>0){
players[index].nurina-=40;
if(players[index].nurina<0)players[index].nurina=0;
send_packet(0, "play mijando.ogg "+players[index].x+" "+players[index].y, players[index].map);
players[index].sujo+=1.5;
}
else if(players[index].ncoco>0&&tt!="mystique"){
players[index].ncoco-=5;
if(players[index].ncoco<0)players[index].ncoco=0;
send_packet(0, "play cagando"+random(1, 2)+".ogg "+players[index].x+" "+players[index].y, players[index].map);
players[index].sujo+=1.5;
}
bathroom_zones[i].descarga=1;
}
}
return;
}
}
for(uint i=0;i<computadors.length();i++){
if(computadors[i].x==players[index].x&&computadors[i].y==players[index].y&&computadors[i].map==players[index].map&&players[index].centado==true){
if(computadors[i].turned_on==1){
computadors[i].turned_on=0;
send_packet(0, "atucomputador "+computadors[i].id+" "+computadors[i].turned_on, computadors[i].map);
send_packet(0, "pcdesliga "+computadors[i].id, computadors[i].map);
computadors[i].iniciado=false;
computadors[i].starting_engine=false;
}
else if(computadors[i].turned_on==0){
computadors[i].turned_on=1;
send_packet(0, "atucomputador "+computadors[i].id+" "+computadors[i].turned_on, computadors[i].map);
computadors[i].ignition_timer.restart();
computadors[i].starting_engine=true;
}
}
}
}
