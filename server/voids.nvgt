void afk(int index){
bool found_flag=false;
for(uint i=0;i<atomic_bombs.length();i++){
if(atomic_bombs[i].char_name_nome==players[index].charname){
found_flag=true;
break;
}
}
for(uint i=0; i<fire_bombs.length(); i++){
if(fire_bombs[i].char_name_nome==players[index].charname){
found_flag=true;
break;
}
}
for(uint i=0;i<maxbombas.length();i++){
if(maxbombas[i].char_name_nome==players[index].charname){
found_flag=true;
break;
}
}
if(nuclear_bombs.length()>0)found_flag=true;
for(uint i=0;i<players.length();i++){
if(players[i].tmeteoro.elapsed>0){
found_flag=true;
break;
}
}
if(players[index].afk)
{
players[index].afk=false;
send_reliable(0,"playerbeep "+players[index].charname+" 1",0);
send_reliable(0,"ps afkoff.ogg",0);
send_reliable(0, "msgdepois "+players[index].charname+" is back!",0);
send_reliable(players[index].peer_id,"startmoving",0);
send_reliable(players[index].peer_id, "fimnovato", 0);
send_reliable(players[index].peer_id, "ausente0", 0);
players[index].bipar=1;
}
else if(players[index].paralyzed==true||players[index].paralisado2==true||game_stopped==true||found_flag==true){
return;
}
else
{
send_reliable(players[index].peer_id, "ininovato", 0);
players[index].afking=true;
players[index].afksecondtimer.restart();
players[index].afkseconds=11;
send_reliable(players[index].peer_id,"msgnormal Iniciando AFK...", 0);
send_reliable(players[index].peer_id, "ausente1", 0);
}
}
void use_drink_heal(int index, string char_name_nome, double amount_value){
string zone_name=get_zone_at(players[index].x,players[index].y,players[index].map);
if(zone_name=="Fight area"||players[index].peaceful==1||players[index].health<=0)return;
else if(players[index].inv_item_number(char_name_nome)>=amount_value){
uint total=0;
for(uint i=0;i<players[index].nomesequipe.length();i++){
int z=get_player_index_from(players[index].nomesequipe[i]);
if(z>-1){
if(get_player_distance(players[index],players[z])>-1&&get_player_distance(players[index],players[z])<=5){
if(players[z].peaceful==0&&players[z].newbie==false&&players[z].afk==false){
total++;
}
}
}
}
if(total==0)return;
double heal=(amount_value*100/total);
for(uint i=0;i<players[index].nomesequipe.length();i++){
int z=get_player_index_from(players[index].nomesequipe[i]);
if(z>-1){
if(get_player_distance(players[index],players[z])>-1&&get_player_distance(players[index],players[z])<=5){
if(players[z].peaceful==0&&players[z].newbie==false&&players[z].afk==false){
players[z].health+=heal;
if(players[z].health>players[z].maxhealth)players[z].health=players[z].maxhealth;
}
}
}
}
players[index].inv_add_item(char_name_nome,-amount_value);
}
}
void admin_commands(int index, string[] parsed){
if((parsed[0]=="/fechar"||parsed[0]=="/closegame")){
send_reliable(players[index].peer_id, "msgnormal Servidor cerrado.", 0);
exit();
}
else if(parsed[0] == "/mdebug") {
    if(monsters.length() == 0) {
        send_reliable(players[index].peer_id, "msg No monsters in memory at all!", 0);
    }
    for(uint i = 0; i < monsters.length(); i++) {
        send_reliable(players[index].peer_id, "msg Szörny: " + monsters[i].name + " Pos: " + monsters[i].x + "," + monsters[i].y + " Map: " + monsters[i].map_name, 0);
    }
}
else if(parsed[0]=="/credit" && parsed.length()>2) {
if(players[index].is_admin() == true) {
int target = get_player_index_from(parsed[1]);
if(target > -1) {
            players[target].credits1 = string_to_number(parsed[2]);
            send_reliable(players[index].peer_id, "msg2 done. " + players[target].charname + " new balance: " + players[target].credits1 + " credit.", 0);
            
            send_reliable(players[target].peer_id, "msg2 an administrator has given you credit! new balance: " + players[target].credits1 + " credit.", 0);
        } else {
            send_reliable(players[index].peer_id, "msg2 error, the player not found", 0);
        }
    } else {
        send_reliable(players[index].peer_id, "msg2 not are you admin", 0);
    }
}
else if(parsed[0]=="/gamestop"&&game_stopped==false){
if(is_disabled_command(index, parsed))return;
send_reliable(0,"stopmoving",0);
send_reliable(0,"ps gamestop.ogg",0);
send_reliable(0,"msgnormal The game has been frozen!", 0);
game_stopped=true;
}
else if(parsed[0]=="/openarena"){
for(uint k=0; k<parsed.length(); k++){
txt+=parsed[k]+" ";
}
for(uint j=0; j<players.length(); j++){
if(players[j].is_admin()==true){
}
}
txt="";
arena_waiting=true;
arena3=1;
arena2=1;
arena1=1;
//counterarena=0;
}
else if((parsed[0]=="/quantos"||parsed[0]=="/howmany")&&parsed.length()>1){
string[] t=find_directories("players/*");
double amount_value=0;
string[] item_list_itens;
for(uint i=0;i<t.length();i++){
if(file_exists("players/"+t[i]+"/inv.md")){
file f;
f.open("players/"+t[i]+"/inv.md", "r");
string[] tt=string_split(f.read(), "\r\n", false);
f.close();
for(uint i2=0;i2<tt.length();i2++){
if(string_contains(tt[i2], parsed[1], 1)>-1){
string[] ttt=string_split(tt[i2], "=", false);
item_list_itens.insert_last(t[i]+" with "+ttt[1]);
amount_value+=string_to_number(ttt[1]);
}
}
}
}
send_reliable(players[index].peer_id, "msgnormal "+amount_value+" "+parsed[1]+": "+linear(item_list_itens), 0);
}
else if((parsed[0]=="/lcoisas"||parsed[0]=="/listthings")){
string[] m;
m.insert_last(players.length()+" jogadores");
m.insert_last(objs.length()+" objetos");
m.insert_last(attack_dogs.length()+" cachorros");
m.insert_last(gatos.length()+" gatos");
m.insert_last(amon_ras.length()+" amon_ras");
m.insert_last(gods.length()+" gods");
m.insert_last(dragons.length()+" dragons");
m.insert_last(tempocaiu.length()+" for people to fall");
m.insert_last(fitaexplosivas.length()+" fitas explosivas");
m.insert_last(rats.length()+" ratos");
m.insert_last(babysaurs.length()+" bebessauros");
m.insert_last(bullets.length()+" bullets in motion");
m.insert_last(guards_walk.length()+" guards at the medieval castle");
m.insert_last(horses.length()+" cavalos");
m.insert_last(computadors.length()+" computadores");
m.insert_last(apartment_zones.length()+" apartamentos");
m.insert_last(walls.length()+" breakable walls");
m.insert_last(fire_bombs.length()+" fire bomb");
m.insert_last(atomic_bombs.length()+" atomic bomb");
m.insert_last(fogos.length()+" wizard fires");
m.insert_last(fogoqueimars.length()+" active fires from fire bomb");
m.insert_last(wolves.length()+" lobos");
m.insert_last(cocos.length()+" cocos");
m.insert_last(sharks.length()+" sharks");
m.insert_last(monkeys.length()+" macacos");
