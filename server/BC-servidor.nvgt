void move(int index, int x, int y, int bike=0, int n=0){
if(players[index].paralyzed==true||players[index].paralisado2==true||players[index].afk)return;
players[index].x=x;
players[index].y=y;
send_packet3(0,"upl "+players[index].charname+" "+players[index].x+" "+players[index].y+" "+players[index].map,players[index].map);
string l=get_zone_at(players[index].x, players[index].y, players[index].map);
if(players[index].starsoundid!="") update_moving_sound(players[index].starsoundid,players[index].x,players[index].y);
if(players[index].map=="city1"||players[index].map=="city2") players[index].chegoucidade=1;
if(players[index].map=="city1"||players[index].map=="city2"||players[index].map=="forest"||players[index].map=="school") players[index].cidadenatal="city1";
else if(players[index].map=="belick_city"||players[index].map=="belick_international_airport") players[index].cidadenatal="belick_city";
if(players[index].in_speedboat==1){
string char_name_nome=take_speedboat(index);
if(char_name_nome!=""){
file f;
f.open("lanchas/"+char_name_nome+".md", "r");
double n=string_to_number(f.read());
f.close();
n-=0.2;
if(n<=0){
n=0;
send_reliable(players[index].peer_id, "ldf", 0);
}
f.open("lanchas/"+char_name_nome+".md", "w");
f.write(n);
f.close();
}
}
if(!players[index].cloakhiding&&players[index].invisibility==0&&players[index].jumping==0&&n==0){
for(uint za=0; za<players.length(); za++){
if(players[za].hear_footsteps==1&&players[za].map==players[index].map&&bike==1)send_reliable(players[za].peer_id, "sb "+players[index].charname+" "+players[index].x+" "+players[index].y+" "+players[index].map, 0);
else if(players[za].hear_footsteps==1&&players[za].map==players[index].map&&bike==0)send_reliable(players[za].peer_id, "s "+players[index].charname+" "+players[index].x+" "+players[index].y+" "+players[index].map, 0);
}
if(mine_objs.length()>0){
for(uint i=0; i<mine_objs.length(); i++){
if(mine_objs[i].x==players[index].x&&mine_objs[i].y==players[index].y&&mine_objs[i].owner!=players[index].charname&&mine_objs[i].map==players[index].map){
if(!players[index].newbie){
send_packet(0,"impact mineexplode.ogg "+players[index].x+" "+players[index].y,players[index].map);
send_packet(0,"inithurt "+players[index].voice+" "+players[index].x+" "+players[index].y, players[index].map);
players[index].lasthit=mine_objs[i].owner+"'s mina";
players[index].health-=mine_objs[i].damage;
destroy_mine(mine_objs[i].id);
break;
}
}
}
}
}
// Mountain quest
if(l=="O topo!"&&players[index].map=="mountain"&&players[index].mountain_quest==1&&players[index].terminouquestmontanha==0&&players[index].inv_item_number("mountain_sand")<=0){
send_reliable(players[index].peer_id, "msgnormal After so many difficulties, barriers and everything that appeared before you, with determination and effort you reach the top, the highest and most incredible place in Mortalandia. It's amazing how things are up here. Everything looks tiny before your eyes. Cars, people and animals look like little ants to you. Thanks to this achievement, you receive a valuable prize that will be very useful down below.", 0);
send_reliable(players[index].peer_id, "ps up_found.ogg", 0);
players[index].inv_add_item("mountain_sand", 1);
}
// Check the mountain base
if(l=="Mountain base"&&players[index].mountain_quest==1&&players[index].terminouquestmontanha==0&&players[index].inv_item_number("mountain_sand")>0){
send_reliable(players[index].peer_id, "msgnormal Great job! After climbing, spotting the animals looking like ants, taking many risks you arrive at your final destination. His long work results in a very warm fur coat that will surely help you in some situation.", 0);
send_reliable(players[index].peer_id, "ps up_found.ogg", 0);
players[index].inv_add_item("mountain_sand", -1);
players[index].inv_add_item("tailor_letter", 1);
players[index].inv_add_item("fur_coat", 1);
players[index].terminouquestmontanha=1;
}
netloop();
}
void shoot(int index, int side, int arma){
if(side==Back&&players[index].jumping==1){
return;
}
else if(players[index].in_safe_zone==false&&players[index].peaceful==0&&players[index].newbie==false&&players[index].map!="tunnel"&&players[index].paralyzed==false&&players[index].paralisado2==false&&game_stopped==false&&players[index].afk==false&&players[index].afking==false){
int weapon2=(arma-1);
if(weapon2<0)weapon2=0;
string[] armp=string_split(weapons[weapon2], ":", false);
if(armp.length()<2)return;
string shot_sound=armp[0];
players[index].weapon_sound_tarma=shot_sound;
int damage_value=string_to_number(armp[2]);
int distance_value=string_to_number(armp[1]);
int weapon_sound=string_to_number(armp[3]);
int speed_value=1;
string lsound="";
if(shot_sound!=""){
if(shot_sound!="galil.ogg"&&shot_sound!="galils.ogg")send_packet3(0, "f "+shot_sound+" "+players[index].x+" "+players[index].y, players[index].map);
else if(string_contains(shot_sound, "galil", 1)>-1)send_packet3(0, "f2 "+players[index].charname+" "+shot_sound+" "+players[index].x+" "+players[index].y, players[index].map);
}
weapon2+=1;
if(weapon2==3)
players[index].inv_add_item("12mm",-1, false);
else if(weapon2==4)
players[index].inv_add_item("9mm",-1, false);
else if(weapon2==5)
players[index].inv_add_item("9mm",-1, false);
else if(weapon2==6)
players[index].inv_add_item("arrow",-1, false);
else if(weapon2==7)
players[index].inv_add_item("5.56mm",-1, false);
else if(weapon2==8)
players[index].inv_add_item("7.62mm",-5, false);
else if(weapon2==9)players[index].inv_add_item("grenade",-1);
else if(weapon2==10)
players[index].inv_add_item("5.56mm",-1, false);
else if(weapon2==11)
players[index].inv_add_item("12mm",-1, false);
else if(weapon2==12)
players[index].inv_add_item("laser",-1, false);
else if(weapon2==13)
players[index].inv_add_item("missile",-1, false);
else if(weapon2==14)
players[index].inv_add_item("grenade",-1, false);
else if(weapon2==15)
players[index].inv_add_item("7.62mm",-1, false);
else if(weapon2==16)
players[index].inv_add_item("9mm",-1, false);
else if(weapon2==17)
players[index].inv_add_item("9mm",-1, false);
else if(weapon2==18)
players[index].inv_add_item("5.56mm",-1, false);
else if(weapon2==19)
players[index].inv_add_item("7.62mm",-5, false);
else if(weapon2==21)
players[index].inv_add_item("30mm",-1, false);
else if(weapon2==22)
players[index].inv_add_item("12mm",-2, false);
else if(weapon2==23)
players[index].inv_add_item("7.62mm",-10, false);
else if(weapon2==24)
players[index].inv_add_item("5.56mm",-1, false);
else if(weapon2==25)
players[index].inv_add_item("5.56mm",-1, false);
else if(weapon2==26)
players[index].inv_add_item("7.62mm",-1, false);
else if(weapon2==27){
players[index].taser_shots--;
}
else if(weapon2==31)
players[index].inv_add_item("9mm",-1, false);
else if(weapon2==32)
players[index].inv_add_item("5.56mm",-1, false);
else if(weapon2==33)players[index].inv_add_item("laser",-1, false);
else if(weapon2==34)
players[index].inv_add_item("molotov", -1);
else if(weapon2==35){
if(players[index].extintor>0){
players[index].extintor--;
send_packet(0, "play extintor.ogg "+players[index].x+" "+players[index].y, players[index].map);
}
else send_packet(0, "play descarregado_extintor.ogg "+players[index].x+" "+players[index].y, players[index].map);
}
else if(weapon2==36)players[index].inv_add_item("7.62mm",-1, false);
else if(weapon2==37)players[index].inv_add_item("7.62mm",-1, false);
else if(weapon2==39)players[index].inv_add_item("7.62mm",-1, false);
if(players[index].map=="prehistory"){
damage_value=40;
if(weapon2==1)damage_value=random(100, 150);
else if(weapon2==2)damage_value=random(300, 350);
else if(weapon2==20)damage_value=random(440, 480);
else if(weapon2==28)damage_value=random(150, 200);
else if(weapon2==30)damage_value=random(350, 388);
}
if(players[index].cave==1){
damage_value=(damage_value*3);
send_packet10(0, players[index].charname, players[index].charname, "arcorico.ogg "+players[index].x+" "+players[index].y, players[index].map);
}
if(weapon2==35&&players[index].extintor>0||weapon2!=35)spawn_bullet(damage_value, distance_value,players[index].x,players[index].y,side, players[index].charname, weapon2,players[index].map,speed_value,weapon_sound, lsound);
}
}
void shoot2(int index, int side, int arma){
if(side==Back&&players[index].jumping==1){
return;
}
else if(players[index].in_safe_zone==false&&players[index].peaceful==0&&players[index].newbie==false&&players[index].map!="tunnel"&&players[index].paralyzed==false&&players[index].paralisado2==false&&game_stopped==false&&players[index].afk==false&&players[index].afking==false){
int weapon2=(arma-1);
string[] armp=string_split(weapons2[weapon2], ":", false);
if(armp.length()<2)return;
string shot_sound=armp[0];
players[index].weapon_sound_tarma=shot_sound;
int damage_value=string_to_number(armp[2]);
int distance_value=string_to_number(armp[1]);
int weapon_sound=string_to_number(armp[3]);
int speed_value=1;
string lsound="";
if(shot_sound!=""){
if(shot_sound!="galil.ogg"&&shot_sound!="galils.ogg")send_packet3(0, "f "+shot_sound+" "+players[index].x+" "+players[index].y, players[index].map);
else if(string_contains(shot_sound, "galil", 1)>-1)send_packet3(0, "f2 "+players[index].charname+" "+shot_sound+" "+players[index].x+" "+players[index].y, players[index].map);
}
weapon2+=1;
if(weapon2==9)lsound="granadaloop.ogg";
if(weapon2==6){
players[index].inv_add_item("poisoned_arrow",-1, false);
players[index].arrow=1;
}
if(weapon2==9)players[index].inv_add_item("grenade",-1);
if(weapon2==11){
players[index].inv_add_item("12mm",-1, false);
}
if(weapon2==16){
players[index].inv_add_item("9mm",-1, false);
}
if(weapon2==18){
players[index].inv_add_item("5.56mm",-3, false);
players[index].burst=1;
}
if(weapon2==24){
players[index].inv_add_item("5.56mm",-1, false);
}
if(weapon2==25){
players[index].inv_add_item("5.56mm",-1, false);
}
if(weapon2==26){
players[index].inv_add_item("7.62mm",-5, false);
players[index].burst=1;
}
else if(weapon2==36)players[index].inv_add_item("7.62mm",-1, false);
spawn_bullet(damage_value, distance_value,players[index].x,players[index].y,side, players[index].charname, weapon2, players[index].map,speed_value,weapon_sound, lsound);
}
}
void finish(int index, int j=0, int speak_message=0, int no_save=0){
send_reliable(0, "off "+players[index].charname+" "+speak_message+" 0", 0);
if(players[index].starsoundid!="") destroy_moving_sound(players[index].starsoundid);
if(players[index].teleporter_field_id!="")destroy_moving_sound(players[index].teleporter_field_id);
if(players[index].bipar==0)players[index].bipar=1;
if(players[index].vmap!=""){
players[index].map=players[index].vmap;
players[index].x=players[index].vx;
players[index].y=players[index].vy;
players[index].bipar=players[index].saved_beep;players[index].invisibility=players[index].vinvs;
}
if(no_save==0)send_configs(index);
players.remove_at(index);
}
void bar_phrases(int index, int no_sound, string nsom2){
string l=get_zone_at(players[index].x, players[index].y, players[index].map);
send_packet(0, "draw "+players[index].charname+" "+nsom2+" "+players[index].x+" "+players[index].y, players[index].map);
if(no_sound=="1"&&l=="Cornelius, The Wizard, is standing here, preparing his potions."){
if(players[index].inv_item_number("coins")>=players[index].inv_item_number("arrow")){
int a=players[index].inv_item_number("arrow");
players[index].inv_add_item("coins", -players[index].inv_item_number("arrow"));
players[index].inv_add_item("arrow", -players[index].inv_item_number("arrow"));
players[index].inv_add_item("poisoned_arrow", a);
send_reliable(players[index].peer_id, "msgnormal Cornelius, the wizard delivers his arrows, now poisoned, capable of kill anyone.", 0);
}
else{
send_reliable(players[index].peer_id, "msgnormal You don't have enough money", 0);
}
}
for(uint i=0;i<pajes.length();i++){
if(no_sound=="1"&&players[index].anotado==""&&pajes[i].x==players[index].x&&players[index].y==pajes[i].y&&players[index].map==pajes[i].map){
string[] r;
r.insert_last("arrow");
r.insert_last("poisoned_arrow");
r.insert_last("soda");
r.insert_last("energy drink");
int a=random(0, r.length()-1);
players[index].anotado=r[a];
players[index].chegoucidade=0;
send_reliable(players[index].peer_id, "msgpaje "+players[index].anotado, 0);
}
}
}
