players[i2].inv_add_item("coins", arena_prize);
change_map(players[i2].arena_map, i2, players[i2].x, players[i2].y, players[i2].map);
arena_waiting=true;
arena1=1;
arena2=1;
arena3=1;
arena_counter=0;
arena_prize=0;
arena.restart();
arena_playing=false;
}
}
}
else {
battle_counter=0;
}
}
}
else{
