bool player_timer(string char_name_nome){
for(uint i=0;i<players.length();i++){
if(players[i].map==char_name_nome)return true;
}
return false;
}
bool suffocated(int index){
	string map=players[index].map;
	file f;
	f.open("maps/"+map+".map", "r");
	string mdata=f.read();
	f.close();
	string[] p1=delinear(mdata);
	for(uint i=0; i<p1.length(); i++){
		string[] parsed=string_split(p1[i], ":", true);
		if(parsed[0]=="suffocate"&&parsed.length()>4){
			int minx=string_to_number(parsed[1]);
			int maxx=string_to_number(parsed[2]);
			int miny=string_to_number(parsed[3]);
			int maxy=string_to_number(parsed[4]);
			if(minx<=players[index].x&&maxx>=players[index].x&&miny<=players[index].y&&maxy>=players[index].y)return true;
		}
	}
	return false;
}
bool froze(int index){
string map=players[index].map;
file f;
f.open("maps/"+map+".map", "r");
string mdata=f.read();
f.close();
string[] p1=delinear(mdata);
for(uint i=0; i<p1.length(); i++){
string[] parsed=string_split(p1[i], ":", true);
if(parsed[0]=="freeze"&&parsed.length()>4){
int minx=string_to_number(parsed[1]);
int maxx=string_to_number(parsed[2]);
int miny=string_to_number(parsed[3]);
int maxy=string_to_number(parsed[4]);
if(minx<=players[index].x&&maxx>=players[index].x&&miny<=players[index].y&&maxy>=players[index].y)return true;
}
}
return false;
}
void give_reais(string char_name_nome, int reais, bool peaceful=true){
int zz=get_player_index_from(char_name_nome);
if(zz>-1){
int r=0;
for(uint i=0;i<players[zz].nomesequipe.length();i++){
int z=get_player_index_from(players[zz].nomesequipe[i]);
if(z>-1){
if(players[z].peaceful==0&&players[z].afk==false||players[z].afk==false&&peaceful)r+=1;
}
}
if(r==0)return;
int total=(reais/r);
if(total<=0)return;
for(uint i=0;i<players[zz].nomesequipe.length();i++){
int z=get_player_index_from(players[zz].nomesequipe[i]);
if(z>-1){
if(players[z].peaceful==0&&players[z].afk==false||players[z].afk==false&&peaceful){
players[z].inv_add_item("reais", total);
send_reliable(players[z].peer_id, "msgpegouitem "+total+" reais", 0);
if(doublegold==1){
z=get_player_index_from(players[zz].nomesequipe[i]);
if(z>-1){
players[z].inv_add_item("reais", total);
send_reliable(players[z].peer_id, "msgyougainmore "+total, 0);
}
}
}
}
}
}
}
void loops2(){
if(misseisguiados.length()>0)guided_missile_loop();
if(projeteis.length()>0)projectile_loop();
if(oms.length()>0)magnetic_item_loop();
if(canhaos.length()>0)cannon_loop();
}



