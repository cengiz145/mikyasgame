void use(double index, string item_number){
if(players[index].peaceful==0&&get_safezone_at(players[index].x, players[index].y, players[index].map)==false&&players[index].newbie==false){
if(get_tile_at(players[index].x, players[index].y, players[index].map)==""&&item_number!="teleporter"&&item_number!="r2"&&item_number!="evlilik_yuzugu")return;
if(item_number=="explosive_tape"&&players[index].map!="arena"&&players[index].inv_item_number("explosive_tape")>0){
if(fitaativa==true){
for(uint i=0;i<players.length();i++){
if(get_player_distance(players[index], players[i])>-1&&get_player_distance(players[index], players[i])<2&&!in_team(players[index].charname, players[i].charname)){
players[index].inv_add_item("explosive_tape", -1);
place_tape(players[i].charname, players[index].charname);
send_packet10(0, players[index].charname, players[i].charname, "fexplo.ogg "+players[i].x+" "+players[i].y, players[i].map);
break;
}
}
}
else send_reliable(players[index].peer_id, "msgnormal Explosive tapes are not being allowed at the moment.", 0);
}
else if(item_number=="evlilik_yuzugu"&&players[index].inv_item_number("evlilik_yuzugu")>0){
    if(players[index].spouse == "") { send_reliable(players[index].peer_id, "msgnormal Zaten evli degilsin.", 0); return; }
    int target_idx = get_player_index_from(players[index].spouse);
    if(target_idx < 0) { send_reliable(players[index].peer_id, "msgnormal Esin su an cevrimici degil.", 0); return; }
    players[index].x = players[target_idx].x;
    players[index].y = players[target_idx].y;
    players[index].map = players[target_idx].map;
    send_reliable(players[index].peer_id, "msgnormal Yuzugunuzu kullanarak esinizin yanina isinlandiniz.", 0);
    send_reliable(players[target_idx].peer_id, "msgnormal Esiniz yuzugunu kullanarak yaniniza isinlandi.", 0);
}
else if(item_number=="dragonsaurus_egg"&&get_tile_at(players[index].x, players[index].y, players[index].map)!=""&&players[index].inv_item_number("dragonsaurus_egg")>0){
players[index].inv_add_item("dragonsaurus_egg", -1);
int d=random(1, 100);
if(d<=15){
spawn_babysaur(players[index].x, players[index].y, players[index].map);
}
}
else if(item_number=="guided missile"&&players[index].inv_item_number("guided_missile")>0)send_reliable(players[index].peer_id, "sjog 0 Choose a player:;missil", 0);
else if(item_number=="fire_bomb"&&players[index].inv_item_number("fire_bomb")>0){
if(bomb_active==true){
bool t=false;
if(players[index].map=="arena"){
t=true;
}
if(t)return;
players[index].inv_add_item("fire_bomb", -1);
spawn_fire_bomb(players[index].x, players[index].y, players[index].map, players[index].charname);
}
else send_reliable(players[index].peer_id, "msgnormal Bombs are not being allowed at the moment.", 0);
}
else if(item_number=="Time_bomb"&&players[index].inv_item_number("time_bomb")>0){
if(bomb_active==true){
bool t=false;
if(players[index].map=="arena"){
t=true;
}
if(t)return;
spawn_time_bomb(players[index].x, players[index].y, players[index].map, players[index].charname);
players[index].inv_add_item("time_bomb", -1);
}
else send_reliable(players[index].peer_id, "msgnormal Bombs are not being allowed at the moment.", 0);
}
else if(item_number=="max_bomb"&&players[index].inv_item_number("max_bomb")>0){
if(bomb_active==true){
bool t=false;
if(players[index].map=="arena"){
t=true;
}
if(t)return;
spawn_maxbomb(players[index].x, players[index].y, players[index].map, players[index].charname);
players[index].inv_add_item("max_bomb", -1);
}
else send_reliable(players[index].peer_id, "msgnormal Bombs are not being allowed at the moment.", 0);
}
else if(item_number=="remote_bomb"&&players[index].inv_item_number("remote_bomb")>0){
if(bomb_active==true){
bool t=false;
if(players[index].map=="arena"){
t=true;
}
if(t)return;
spawn_remote_bomb(players[index].x, players[index].y, players[index].map, players[index].charname);
players[index].inv_add_item("remote_bomb", -1);
}
else send_reliable(players[index].peer_id, "msgnormal Bombs are not being allowed at the moment.", 0);
}
else if(item_number=="Atomic_bomb"&&players[index].inv_item_number("atomic_bomb")>0){
if(bomb_active==true){
bool t=false;
for(uint i=0;i<atomic_bombs.length();i++){
if(atomic_bombs[i].char_name_nome==players[index].charname){
t=true;
break;
}
}
if(players[index].map=="arena"){
t=true;
}
if(t)return;
spawn_atomic_bomb(players[index].x, players[index].y, players[index].map, players[index].charname);
players[index].inv_add_item("atomic_bomb", -1);
}
else send_reliable(players[index].peer_id, "msgnormal Bombs are not being allowed at the moment.", 0);
}
else if(item_number=="nuclear_bomb"&&players[index].inv_item_number("nuclear_bomb")>0){
if(bomb_active==true){
