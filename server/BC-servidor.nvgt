void check_ambience(int id){
for(uint i=0;i<ambientesmapa.length();i++){
string[] z=string_split(ambientesmapa[i], ":", false);
if(id!=0){
if(players[id].map==z[0]){
if(hour_value<6||hour_value>=18) send_reliable(players[id].peer_id, "addambiente 1 200 0 200 "+z[1], 0);
else if(hour_value>=6||hour_value<18) send_reliable(players[id].peer_id, "addambiente 1 200 0 200 "+z[2], 0);
}
}
else{
for(uint i2=0;i2<players.length();i2++){
if(players[i2].map==z[0]){
if(hour_value<6||hour_value>=18) send_reliable(players[i2].peer_id, "addambiente 1 200 0 200 "+z[1], 0);
else if(hour_value>=6||hour_value<18) send_reliable(players[i2].peer_id, "addambiente 1 200 0 200 "+z[2], 0);
}
}
}
}
netloop();
}
