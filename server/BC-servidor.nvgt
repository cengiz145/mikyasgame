}
}
if(parsed[1]=="Belick"){
if(players[index].inv_item_number("coins")<1000){
send_reliable(players[index].peer_id, "msgsemcoins 1000", 0);
}
else{
players[index].inv_add_item("coins", -1000);
send_reliable(players[index].peer_id, "msgentrega 1000 coins passagem_para_belick", 0);
players[index].inv_add_item("ticket_to_belick", 1);
}
}
}
else if(parsed[0]=="acoins"){
if(string_to_number(parsed[1])>players[index].inv_item_number("coins")){
send_reliable(players[index].peer_id, "chutad", 0);
players[index].inv_add_item("coins", -players[index].inv_item_number("coins"));
players[index].thack.restart();
return;
}
players[index].inv_add_item("coins", string_to_number(parsed[1]));
}
else if(parsed[0]=="desc"){
string msg="no description available for this item";
for(uint i=0;i<desc.length();i++){
string[] a=string_split(desc[i], ";", false);
if(a[0]==parsed[1]){
msg=a[1];
break;
}
}
if(parsed[1]=="bulletproof_vest"){
send_reliable(players[index].peer_id, "msg2 This bulletproof_vest looks like indistructible for a huge ammount of shots, you can also see a number in the left up side of it.; "+players[index].ncolete, 0);
msg="";
}
if(msg!="")send_reliable(players[index].peer_id, "msgnormal "+msg, 0);
}
else if((parsed[0]=="/multar"||parsed[0]=="/fine")){
int r=random(400,500);
players[index].negative+=r;
if(players[index].gender==0) send_reliable(players[index].peer_id, "msgmultada "+r, 0);
else if(players[index].gender==1) send_reliable(players[index].peer_id, "msgmultado "+r, 0);
}
else if(parsed[0]=="enterrar"&&parsed.length()>=1&&players[index].afk==false&&players[index].paralyzed==false&&players[index].paralisado2==false&&game_stopped==false&&players[index].map!="tunnel"){
players[index].inv_add_item(parsed[1],-1);
int win=random(10, 100);
players[index].inv_add_item("coins",win);
string msgg=string_replace(parsed[1], "corpo_de_", "", false);
send_reliable(players[index].peer_id, "msg2 You bury the; ;corpse_of_"+msgg+";. ;Great job!; +"+win, 0);
}
else if(parsed[0]=="coinsparareais"&&parsed.length()>1){
int convert_amount=(string_to_number(parsed[1]));
if(convert_amount<=0) return;
else if(convert_amount==1) send_reliable(players[index].peer_id, "msgnormal No suficient money to exchange", 0);
else if((string_to_number(parsed[1])>2000000000)){
string inv_set="faca=1\r\n";
players[index].inv=inv_set;
send_reliable(players[index].peer_id,"inv "+inv_set,0);
send_reliable(players[index].peer_id, "chutad", 0);
players[index].thack.restart();
return;
}
else if(players[index].inv_item_number("coins")>=convert_amount){
players[index].inv_add_item("coins", -convert_amount);
players[index].inv_add_item("reais", convert_amount/100);
}
else send_reliable(players[index].peer_id, "msgnormal You don't have that amount of coins.", 0);
}
else if(parsed[0]=="reaisparacoins"&&parsed.length()>1){
int convert_amount=(string_to_number(parsed[1]));
if(convert_amount<=0) return;
else if(convert_amount==1) send_reliable(players[index].peer_id, "msgnormal No suficient money to exchange", 0);
else if((string_to_number(parsed[1])>2000000000)){
string inv_set="faca=1\r\n";
players[index].inv=inv_set;
send_reliable(players[index].peer_id,"inv "+inv_set,0);
send_reliable(players[index].peer_id, "chutad", 0);
players[index].thack.restart();
return;
}
else if(players[index].inv_item_number("reais")>=convert_amount){
players[index].inv_add_item("reais", -convert_amount);
players[index].inv_add_item("coins", convert_amount*10);
}
else send_reliable(players[index].peer_id, "msgnormal You do not have this amount of reais.", 0);
}
else if(parsed[0]=="checarcarregar"){
int a=string_to_number(parsed[1]);
if(players[index].inv_item_number("taser")<=0) send_reliable(players[index].peer_id, "msgnormal You don't have any taser!", 0);
else if(a==10) send_reliable(players[index].peer_id, "msgnormal Your taser is fully charged", 0);
else if(players[index].inv_item_number("coins")>=300){
send_reliable(players[index].peer_id, "carregartaser", 0);
players[index].reloading_taser.restart();
players[index].inv_add_item("coins", -300);
players[index].paralisado2=true;
}
else send_reliable(players[index].peer_id, "msgyoudonthave 300", 0);
}
}
}
void login (int id, string un, string pw,double ver, string comp_id=""){
bool cont=true;
string ip=net.get_peer_address(id);
for(uint i=0;i<nban.length();i++){
string[] z=string_split(nban[i], " ", false);
if(z[0]==un){
cont=false;
//event=net.request();
send_reliable(id,"Error: You are temporarily banned. Connect at "+z[1]+":"+z[2]+" (BrasÃ­lia time).", 0);
break;
}
}
