void netloop(){
if(bullets.length()>0)bullet_loop();
event=net.request();
if(event.type==event_disconnect){
int index=get_player_index(event.peer_id);
if(index>-1){
send_reliable(0, "msg2 The connection of; "+players[index].charname+" ;caiu.", 0);
place_fall_time(players[index].charname);
send_reliable(0, "off "+players[index].charname+" 1 0", 0);
finish(index, 0, 1);
}
net.disconnect_peer_forcefully(event.peer_id);
}
else if(event.type==event_receive and event.channel==0)
{
int index=get_player_index(event.peer_id);
string[] parsed=string_split(get_event_message()," ",true);
if(parsed[0]=="cria"&&parsed.length()>4)create(parsed[1],parsed[2],parsed[3], string_to_number(parsed[4]), event.peer_id);
else if(parsed[0]=="loz"&&parsed.length()>3)login(event.peer_id, parsed[1],parsed[2],string_to_number(parsed[3]),parsed[4]);
if(index>-1&&index<players.length()){
if(parsed[0]=="a"&&pvp)shoot(index, string_to_number(parsed[1]), string_to_number(parsed[2]));
else if(parsed[0]=="a2"&&pvp)shoot2(index, string_to_number(parsed[1]), string_to_number(parsed[2]));
else if(parsed[0]=="close"){
int id=get_player_index(event.peer_id);
if(id>-1){
for(uint i=0;i<time_bombs.length();i++){
if(time_bombs[i].char_name_nome==players[id].charname)time_bombs.remove_at(i);
}
for(uint i=0;i<atomic_bombs.length();i++){
if(atomic_bombs[i].char_name_nome==players[id].charname)atomic_bombs.remove_at(i);
}
for(uint i=0;i<remote_bombs.length();i++){
if(remote_bombs[i].char_name_nome==players[id].charname)remote_bombs.remove_at(i);
}
for(uint i=0;i<fire_bombs.length();i++){
if(fire_bombs[i].char_name_nome==players[id].charname){
destroy_splay(fire_bombs[i].spa);
fire_bombs.remove_at(i);
}
}
for(uint i=0;i<projeteis.length();i++){
if(projeteis[i].char_name_nome==players[id].charname){
destroy_moving_sound(projeteis[i].projectile_sound);
projeteis.remove_at(i);
}
}
players[id].killed=0;
players[id].maxhealth=5000;
players[id].health=5000;
finish(id, 1);
}
}
else if(parsed[0]=="getversion")getversion(index);
else if(parsed[0]=="ping")send_reliable(event.peer_id,"pong",0);
else if(parsed[0]=="s")players[index].in_safe_zone=true;
else if(parsed[0]=="sn")players[index].in_safe_zone=false;
else if(parsed[0]=="double"&&parsed.length()>2)iitem(index, parsed[1], parsed[2]);
else if(parsed[0]=="uitem"&&parsed.length()>1&&players[index].afk==false&&players[index].paralyzed==false&&players[index].paralisado2==false&&game_stopped==false&&players[index].map!="tunnel")use(index, parsed[1]);
else if(parsed[0]=="retirar"&&parsed.length()>1)remove(index, parsed[1]);
else if(parsed[0]=="missil"&&parsed.length()>1&&players[index].inv_item_number("guided_missile")>0){
double n=get_player_index_from(parsed[1]);
if(n<0)return;
if(players[n].peaceful==1||players[n].afk)return;
players[index].inv_add_item("guided_missile", -1);
create_missile(players[index].x, players[index].y, players[index].map, players[index].charname, players[n].charname);
}
else if((parsed[0]=="/vestindo"||parsed[0]=="/wearing"))wearing(index, true);
else if(parsed[0]=="comprarcasa")buy_house(index);
else if(parsed[0]=="/pacifista"&&players[index].afk==false){
players[index].auto_pacifist_seconds=5;
players[index].atpacifista=true;
players[index].atpacifistatempo.restart();
}
else if(parsed[0]=="/afk")afk(index);
else if(parsed[0]=="frasesbarra"&&parsed.length()>2)bar_phrases(index, string_to_number(parsed[1]), parsed[2]);
else if(parsed[0]=="idiomachat"&&parsed.length()>1)players[index].chat_language=parsed[1];
else if(parsed[0]=="mtester" and parsed.length()>1){
string mapname=parsed[1];
if(file_exists("maps/"+mapname+".map"))change_map(mapname, index, 1, 0);
}
else if(parsed[0]=="sanimal"&&parsed.length()>2)spawn_animal(index, parsed);
// The client builds these keys at runtime as "use"+drinking, so the handler
// name has to track the item name. This read "userefrigerante" and broke when
// the item became "soda" - the key is assembled by concatenation, so there was
// no literal for the translation pass to find.
// beer and energy_drink are also offered by the client but had no handler at
// all, in the Portuguese original too; they now work like soda.
else if(parsed[0]=="usesoda"&&parsed.length()>1)use_drink_heal(index, "soda", string_to_number(parsed[1]));
else if(parsed[0]=="usebeer"&&parsed.length()>1)use_drink_heal(index, "beer", string_to_number(parsed[1]));
else if(parsed[0]=="useenergy_drink"&&parsed.length()>1)use_drink_heal(index, "energy_drink", string_to_number(parsed[1]));
else if(parsed[0]=="dpassos")players[index].hear_footsteps=0;
else if(parsed[0]=="ndor")players[index].mdor=0;
else if(parsed[0]=="smaquina"&&parsed.length()>1){
send_reliable(players[index].peer_id, "stopmoving", 0);
players[index].tmaquina.restart();
players[index].paralisado2=true;
send_reliable(players[index].peer_id, "ps maquinadotempo.ogg", 0);
if(parsed[1]=="-1"||parsed[1]==-1){
string[] maqs;
maqs.reserve(4);
maqs.insert_last("prehistory");
maqs.insert_last("antiquity");
maqs.insert_last("house");
maqs.insert_last("medieval_world");
parsed[1]=maqs[random(0, maqs.length()-1)];
}
players[index].dmaquina=parsed[1];
players[index].namaquina=1;
}
else if(parsed[0]=="imenu"&&players[index].afk==false&&players[index].paralyzed==false&&players[index].paralisado2==false)interact_menu(index);
else if(parsed[0]=="zsa"&&parsed.length()>1)zsa1(index);
else if(parsed[0]=="chutad2"){
players[index].thack.restart();
send_reliable(players[index].peer_id, "stopmoving", 0);
}
else if(parsed[0]=="dep_r"){
int n=string_to_number(parsed[1]);
if(n<0)send_reliable(players[index].peer_id, "msgnormal Invalid value.", 0);
