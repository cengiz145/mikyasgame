if(players[i].chat_language==players[index].chat_language&&players[i].map!="tunnel"&&players[i].has_muted(players[index].charname)==false) send_reliable(players[i].peer_id, send_message, 1);
}
}
}
}
else if(event.type==event_receive&&event.channel==2){
int index=get_player_index(event.peer_id);
if(index<0)return;
string[] parsed=string_split(get_event_message()," ",true);
// Builder packets. These have to live here rather than in admin_commands(),
// because that function is only ever called from inside the "message starts
// with a slash" branch of channel 1 - a packet without a slash is treated as
// chat and broadcast, which is what happened to maplist and spawnmonster.
// Channel 2 has no admin gate of its own, so each one checks is_admin here.
if(parsed[0]=="maplist"||parsed[0]=="mapsrc"||parsed[0]=="mapsave"||parsed[0]=="spawnmonster"){
if(players[index].is_admin()==false)return;
// Every map on the server, tagged so the client can offer it as a menu to
// pick from rather than printing it into the chat. /listmaps is untouched.
if(parsed[0]=="maplist"){
string[] a=find_files("maps/*.map");
string msg="maplist ";
for(uint i=0;i<a.length();i++){
msg+=string_replace(a[i], ".map", "", true);
if(i<a.length()-1) msg+="\r\n";
}
send_reliable(players[index].peer_id, msg, 0);
}
// The raw text of the map the admin is standing on, tagged so the client
// opens it in the line editor. /rawmap still answers as before.
else if(parsed[0]=="mapsrc"){
file f;
f.open("maps/"+players[index].map+".map","rb");
string src=f.read();
f.close();
send_reliable(players[index].peer_id, "mapsrc "+players[index].map+"\r\n"+src, 0);
}
// Save the edited lines back. The map name travels with the body and has to
// match the map the admin is on, so one map's code can never overwrite
// another's - the same rule /rawdata already applies.
else if(parsed[0]=="mapsave"){
// Both cuts are by length rather than by replacing text. A replace-all would
// strip every later copy too, and the map name occurs again in the map's own
// "map:<name>" header - deleting that fuses the header with the next line.
string body=string_trim_left(get_event_message(), 8);
int cut=string_contains(body, "\r\n", 1);
if(cut<0){
send_reliable(players[index].peer_id, "msgnormal The map was empty, nothing was saved.", 0);
return;
}
string target=string_left(body, cut);
string src=string_trim_left(body, cut+2);
if(target!=players[index].map){
send_reliable(players[index].peer_id, "msgnormal It's not allowed to place commands from one map into another.", 0);
return;
}
file f;
f.open("maps/"+players[index].map+".map","wb");
f.write(src);
f.close();
send_reliable(players[index].peer_id, "msgnormal Map saved.", 0);
update(players[index].map);
}
else if(parsed[0]=="spawnmonster"&&parsed.length()>=12){
spawn_custom_monster(parsed[1], string_to_number(parsed[2]), string_to_number(parsed[3]), parsed[4], string_to_number(parsed[5]), string_to_number(parsed[6]), string_to_number(parsed[7]), string_to_number(parsed[8]), string_to_number(parsed[9]), parsed[10]=="1", parsed[11]=="1");
send_reliable(players[index].peer_id, "msgnormal Monster created.", 0);
}
}
else if(parsed[0]=="passagemo"){
string[] add;
add.reserve(3);
add.insert_last("Choose which destination you want the ticket for.:cpassagemo");
add.insert_last("Bus ticket to terminal mar:passagem_de_Ã´nibus_para_terminal_mar");
add.insert_last("Bus ticket to belick:passagem_de_Ã´nibus_para_belick");
send_reliable(players[index].peer_id, "mnormal "+linear(add), 0);
}
else if(parsed[0]=="passagemb"&&parsed.length()>1){
if(parsed[1]=="santa_bertalina"){
if(players[index].inv_item_number("reais")<3){
send_reliable(players[index].peer_id, "msgyoudonthave2 3 reais", 0);
}
else{
players[index].inv_add_item("reais", -3);
send_reliable(players[index].peer_id, "msgentrega 3 reais passagem_de_trem_para_santa_bertalina", 0);
players[index].inv_add_item("train_ticket_to_santa_bertalina", 1);
}
}
else if(parsed[1]=="Belick"){
if(players[index].inv_item_number("reais")<3){
send_reliable(players[index].peer_id, "msgyoudonthave2 3 reais", 0);
}
else{
players[index].inv_add_item("reais", -3);
send_reliable(players[index].peer_id, "msgentrega 3 reais passagem_de_trem_para_belick", 0);
players[index].inv_add_item("train_ticket_to_belick", 1);
}
}
}
else if(parsed[0]=="passagema"&&parsed.length()>1){
if(parsed[1]=="Mortalandia"){
if(players[index].inv_item_number("coins")<1000){
send_reliable(players[index].peer_id, "msgsemcoins 1000", 0);
}
else{
players[index].inv_add_item("coins", -1000);
send_reliable(players[index].peer_id, "msgentrega 1000 coins passagem_para_mortalÃ¢ndia", 0);
