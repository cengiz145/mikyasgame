bullet@[] bullets;
class bullet{
int distance;
string owner, somarma, mapname, loopid, loopsound;
int sx, sy, weapon, x, y, facing, range, damage_value, speed_value;
bullet(int d, int r, int s1, int s2,int fa, string own,int weap,string map,int spee=2, string weapon_sound_sarm="", string lsound=""){
this.speed_value=spee;
this.loopid=lsound;
mapname=map;
facing=fa;
sx=s1;
sy=s2;
x=s1;
y=s2;
if(this.loopid!="") this.loopid=spawn_moving_sound(this.loopid,this.x,this.y,this.mapname);
damage_value=d;
range=r;
owner=own;
weapon=weap;
somarma=weapon_sound_sarm;
}
}
void bullet_loop(){
if(!pvp)return;
if(canhaos.length()>0)cannon_loop();
for(uint ie5=0;ie5<bullets.length();ie5++){
if (bullets[ie5].facing==Left){
bullets[ie5].x-=1;
bullets[ie5].distance+=1;
if(bullets[ie5].loopid!="") update_moving_sound(bullets[ie5].loopid,bullets[ie5].x, bullets[ie5].y);
if (bullets[ie5].damage_value>2) bullets[ie5].damage_value-=3;
bullet_check(ie5);
}
else if (bullets[ie5].facing==Right){
bullets[ie5].x+=1;
bullets[ie5].distance+=1;
if(bullets[ie5].loopid!="") update_moving_sound(bullets[ie5].loopid,bullets[ie5].x, bullets[ie5].y);
if (bullets[ie5].damage_value>2)bullets[ie5].damage_value-=3;
bullet_check(ie5);
}
else if (bullets[ie5].facing==Forward){
bullets[ie5].y+=1;
bullets[ie5].distance+=1;
if(bullets[ie5].loopid!="") update_moving_sound(bullets[ie5].loopid,bullets[ie5].x, bullets[ie5].y);
if (bullets[ie5].damage_value>2)bullets[ie5].damage_value-=3;
bullet_check(ie5);
}
else if (bullets[ie5].facing==Back){
bullets[ie5].y-=1;
bullets[ie5].distance+=1;
if(bullets[ie5].loopid!="") update_moving_sound(bullets[ie5].loopid,bullets[ie5].x, bullets[ie5].y);
if (bullets[ie5].damage_value>2)bullets[ie5].damage_value-=3;
bullet_check(ie5);
}
}
}
void bullet_check(int b){
string surface=get_tile_at(bullets[b].x,bullets[b].y,bullets[b].mapname);
string loc=get_zone_at(bullets[b].x,bullets[b].y,bullets[b].mapname);
int ba2=get_player_index_from(bullets[b].owner);
string ricochet_sound;
if (string_contains(loc,"safe",1)>-1||bullets[b].distance>=bullets[b].range||ba2<0||players[ba2].map=="t nel"||players[ba2].peaceful==1){
if(bullets[b].loopid!="") destroy_moving_sound(bullets[b].loopid);
bullets.remove_at(b);
return;
}
if (bullets[b].weapon==1||bullets[b].weapon==0)
{
ricochet_sound="chuterico.ogg";
}
else if (bullets[b].weapon==2)
{
ricochet_sound="kniferico.ogg";
}
else if (bullets[b].weapon==6)
{
ricochet_sound="arcorico.ogg";
}
else if (bullets[b].weapon==8)
{
ricochet_sound="m240rico.ogg";
}
else if (bullets[b].weapon==9)
{
ricochet_sound="rocketmiss.ogg";
}
else if (bullets[b].weapon==12)
{
ricochet_sound="laserrico.ogg";
}
else if (bullets[b].weapon==13)
{
ricochet_sound="bazucarico.ogg";
}
else if (bullets[b].weapon==14)
{
ricochet_sound="grenaderico.ogg";
}
else if (bullets[b].weapon==15)
{
ricochet_sound="sniperrico.ogg";
}
else if (bullets[b].weapon==18){
if(players[ba2].burst==1){
players[ba2].burst=0;
ricochet_sound="ricothree.ogg";
}
else ricochet_sound="rico"+random(1, 7)+".ogg";
}
else if (bullets[b].weapon==26){
if(players[ba2].burst==1){
players[ba2].burst=0;
ricochet_sound="ricofive.ogg";
}
else ricochet_sound="rico"+random(1, 7)+".ogg";
}
else if (bullets[b].weapon==19)
{
ricochet_sound="m60rico.ogg";
}
else if (bullets[b].weapon==20||bullets[b].weapon==29||bullets[b].weapon==30)
{
ricochet_sound="espadarico.ogg";
}
else if (bullets[b].weapon==21)
{
ricochet_sound="remingtonrico.ogg";
}
else if (bullets[b].weapon==22)
{
ricochet_sound="dozerico.ogg";
}
else if (bullets[b].weapon==23)
{
ricochet_sound="vulcanrico.ogg";
}
else if (bullets[b].weapon==28)
{
ricochet_sound="chuterico.ogg";
}
else if(bullets[b].weapon==34)ricochet_sound="molotovexplode.ogg";
else if(bullets[b].weapon==35)ricochet_sound="";
else
{
ricochet_sound="rico"+random(1,7)+".ogg";
}
int damage_value=bullets[b].damage_value;
for(uint bu=0; bu < torre_de_babels.length(); bu++){
if(bullets[b].x==torre_de_babels[bu].x&&torre_de_babels[bu].map==bullets[b].mapname){
if(bullets[b].y==0)torre_de_babels[bu].health_points-=damage_value;
if(ricochet_sound!="")send_packet3(0, "play "+ricochet_sound+" "+bullets[b].x+" "+bullets[b].y, bullets[b].mapname);
if(bullets[b].loopid!="") destroy_moving_sound(bullets[b].loopid);
bullets.remove_at(b);
return;
}
}
for(uint bu=0; bu < walls.length(); bu++){
if(bullets[b].x==walls[bu].x&&walls[bu].map==bullets[b].mapname){
if(bullets[b].y==0)walls[bu].health_points-=damage_value;
if(ricochet_sound!="")send_packet3(0, "play "+ricochet_sound+" "+bullets[b].x+" "+bullets[b].y, bullets[b].mapname);
if(bullets[b].loopid!="") destroy_moving_sound(bullets[b].loopid);
bullets.remove_at(b);
return;
}
}
