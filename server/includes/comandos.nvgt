attack_dog@[] attack_dogs;
class attack_dog
{
bool y_up=true, y_down=true; // y_up: may follow UP the Y axis; y_down: may follow DOWN. false on either still allows X movement.
int x, y, ladoandar=2;
uint shots=1;
