string map_data, hit_by, njogador;
timer walk_timer, tmorreu, sound_timer;
zombie(int zx, int zy, string m){
x=zx;
y=zy;
map_data=m;
tmorreu.force(0);
tmorreu.pause();
}
}
void place_zombie(int x, int y, string m){
zombie z(x, y, m);
zumbis.insert_last(z);
}
void zombie_loop(){
for(uint i=0;i<zumbis.length();i++){
if(zumbis[i].died==0&&zumbis[i].health_points<=0){
send_packet(0, "play m_zumbi.ogg "+zumbis[i].x+" "+zumbis[i].y, zumbis[i].map_data);
zumbis[i].tmorreu.restart();
zumbis[i].died=1;
}
if(zumbis[i].health_points<=0&&zumbis[i].died==1&&zumbis[i].tmorreu.elapsed>=990){
send_packet(0, "play "+get_tile_at(zumbis[i].x, zumbis[i].y, zumbis[i].map_data)+"harland.ogg "+zumbis[i].x+" "+zumbis[i].y, zumbis[i].map_data);
string hitter=zumbis[i].hit_by;
send_reliable(0, "msg2 "+hitter+"; ;killed a; ;Zoombie;!", 3);
int xx=get_player_index_from(hitter);
if(xx>-1){
gain_xp(players[xx].charname, random(50, 100), random(1000, 3000));
}
int n=random(1, 100);
if(n<=15){
for(uint i=0;i<=random(1, 2);i++){
place_zombie(random(32, 300), 0, "safe_zone");
}
}
zumbis.remove_at(i);
break;
}
if(zumbis[i].sound_timer.elapsed>=zumbis[i].no_sound&&zumbis[i].morrendo==0&&zumbis[i].died==0){
zumbis[i].no_sound=random(2000, 6200);
send_packet(0, "play zumbi"+random(1, 2)+".ogg "+zumbis[i].x+" "+zumbis[i].y, zumbis[i].map_data);
zumbis[i].sound_timer.restart();
}
if(zumbis[i].walk_timer.elapsed>=210&&zumbis[i].morrendo==0&&zumbis[i].died==0){
zumbis[i].walk_timer.restart();
int i2=get_player_index_from(zumbis[i].njogador);
if(i2>-1){
if(players[i2].peaceful==1||get_safezone_at(players[i2].x, players[i2].y, players[i2].map)==true||players[i2].afk||players[i2].map!=zumbis[i].map_data)i2=-1;
}
if(i2<0)zumbis[i].njogador=select_player_menu(zumbis[i].map_data);
i2=get_player_index_from(zumbis[i].njogador);
if(i2>-1){
if(players[i2].peaceful==1||get_safezone_at(players[i2].x, players[i2].y, players[i2].map)==true||players[i2].afk||players[i2].map!=zumbis[i].map_data)i2=-1;
}
if(i2<0)break;
int walk=1;
if(g_zombie(zumbis[i], players[i2])>-1&&g_zombie(zumbis[i], players[i2])<=2&&players[i2].afk==false&&players[i2].peaceful==0&&get_safezone_at(players[i2].x, players[i2].y,
players[i2].map)==false){
walk=0;
int r=reflect_damage(i2, "zumbi", zumbis[i].x, zumbis[i].y, random(300, 400));
if(r>0){zumbis[i].health_points-=r;zumbis[i].hit_by=players[i2].charname;break;}
players[i2].health-=random(300, 400);
players[i2].lasthit="zumbi";
send_packet(0, "play z_bater"+random(1, 2)+".ogg "+players[i2].x+" "+players[i2].y, players[i2].map);
}
if(zumbis[i].y!=players[i2].y&&players[i2].jumping==0){
int _cd=climb_dir(zumbis[i].map_data, zumbis[i].x, zumbis[i].y, players[i2].x, players[i2].y, zumbis[i].y_up, zumbis[i].y_down);
if(_cd==3&&get_tile_at(zumbis[i].x, zumbis[i].y+1, zumbis[i].map_data)!=""&&string_contains(get_tile_at(zumbis[i].x, zumbis[i].y+1, zumbis[i].map_data), "wall", 1)<0){zumbis[i].y++;send_packet(0,"play "+get_tile_at(zumbis[i].x, zumbis[i].y, zumbis[i].map_data)+"step"+random(1, 5)+".ogg "+zumbis[i].x+" "+zumbis[i].y, zumbis[i].map_data);break;}
else if(_cd==4&&get_tile_at(zumbis[i].x, zumbis[i].y-1, zumbis[i].map_data)!=""&&string_contains(get_tile_at(zumbis[i].x, zumbis[i].y-1, zumbis[i].map_data), "wall", 1)<0){zumbis[i].y--;send_packet(0,"play "+get_tile_at(zumbis[i].x, zumbis[i].y, zumbis[i].map_data)+"step"+random(1, 5)+".ogg "+zumbis[i].x+" "+zumbis[i].y, zumbis[i].map_data);break;}
else if(_cd==1&&get_tile_at(zumbis[i].x-1, zumbis[i].y, zumbis[i].map_data)!=""&&string_contains(get_tile_at(zumbis[i].x-1, zumbis[i].y, zumbis[i].map_data), "wall", 1)<0){zumbis[i].x--;send_packet(0,"play "+get_tile_at(zumbis[i].x, zumbis[i].y, zumbis[i].map_data)+"step"+random(1, 5)+".ogg "+zumbis[i].x+" "+zumbis[i].y, zumbis[i].map_data);break;}
else if(_cd==2&&get_tile_at(zumbis[i].x+1, zumbis[i].y, zumbis[i].map_data)!=""&&string_contains(get_tile_at(zumbis[i].x+1, zumbis[i].y, zumbis[i].map_data), "wall", 1)<0){zumbis[i].x++;send_packet(0,"play "+get_tile_at(zumbis[i].x, zumbis[i].y, zumbis[i].map_data)+"step"+random(1, 5)+".ogg "+zumbis[i].x+" "+zumbis[i].y, zumbis[i].map_data);break;}
}
if(zumbis[i].x>players[i2].x-1&&!players[i2].afk&&string_contains(get_tile_at(zumbis[i].x-1, zumbis[i].y, zumbis[i].map_data), "wall", 1)<0&&walk==1&&players[i2].x>31){
zumbis[i].x--;
send_packet(0, "play "+get_tile_at(zumbis[i].x, zumbis[i].y, zumbis[i].map_data)+"step"+random(1, 5)+".ogg "+zumbis[i].x+" "+zumbis[i].y, zumbis[i].map_data);
walk=0;
break;
}
else if(zumbis[i].x<players[i2].x+1&&!players[i2].afk&&string_contains(get_tile_at(zumbis[i].x+1, zumbis[i].y, zumbis[i].map_data), "wall", 1)<0&&walk==1&&players[i2].x>31){
zumbis[i].x++;
send_packet(0, "play "+get_tile_at(zumbis[i].x, zumbis[i].y, zumbis[i].map_data)+"step"+random(1, 5)+".ogg "+zumbis[i].x+" "+zumbis[i].y, zumbis[i].map_data);
walk=0;
break;
}
}
}
}
boladefogo@[]boladefogos;
class boladefogo{
string char_name_nome, map_data, s;
int side, x, y;
timer walk_timer, tremover;
boladefogo(string n, int l, string change_map_cmd, int bx, int by){
char_name_nome=n;
side=l;
map_data=change_map_cmd;
x=bx;
y=by;
s=spawn_moving_sound("boladefogo.ogg", x, y, map_data);
}
}
void place_fireball(string char_name_nome, int side, string map_data, int x, int y){
boladefogo b(char_name_nome, side, map_data, x, y);
boladefogos.insert_last(b);
}
void fireball_loop(){
for(uint i=0;i<boladefogos.length();i++){
if(boladefogos[i].tremover.elapsed>=50000){
destroy_moving_sound(boladefogos[i].s);
boladefogos.remove_at(i);
break;
}
if(string_contains(get_tile_at(boladefogos[i].x, boladefogos[i].y, boladefogos[i].map_data), "wall", 1)>-1){
send_packet(0, "play boobytraphit1.ogg "+boladefogos[i].x+" "+boladefogos[i].y, boladefogos[i].map_data);
destroy_moving_sound(boladefogos[i].s);
boladefogos.remove_at(i);
break;
}
if(boladefogos[i].walk_timer.elapsed>=50){
boladefogos[i].walk_timer.restart();
if(boladefogos[i].side==Right)boladefogos[i].x++;
else if(boladefogos[i].side==Left)boladefogos[i].x--;
else if(boladefogos[i].side==Back)boladefogos[i].y--;
else if(boladefogos[i].side==Forward)boladefogos[i].y++;
update_moving_sound(boladefogos[i].s, boladefogos[i].x, boladefogos[i].y);
for(uint i2=0;i2<players.length();i2++){
if(players[i2].x==boladefogos[i].x&&boladefogos[i].y==players[i2].y&&players[i2].map==boladefogos[i].map_data&&players[i2].peaceful==0&&players[i2].afk==false&&!in_team(boladefogos[i].char_name_nome, players[i2].charname)){
send_packet(0,"play molotovatinge.ogg "+players[i2].x+" "+players[i2].y, players[i2].map);
players[i2].health-=2000;
players[i2].lasthit="boladefogo_"+boladefogos[i].char_name_nome;
send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
if(players[i2].health>0)place_stuck_fire(boladefogos[i].char_name_nome, players[i2].charname);
destroy_moving_sound(boladefogos[i].s);
boladefogos.remove_at(i);
break;
}
}
}
}
}
// Stuck fire
fogogrudado@[]fogosgrudados;
class fogogrudado{
string char_name_nome, alvo;
timer t, tt;
fogogrudado(string cname, string calvo){
char_name_nome=cname;
alvo=calvo;
}
}
void place_stuck_fire(string char_name_nome, string alvo){
fogogrudado f(char_name_nome, alvo);
fogosgrudados.insert_last(f);
}
void stuck_fire_loop(){
for(uint i=0;i<fogosgrudados.length();i++){
if(fogosgrudados[i].tt.elapsed>=30000){
fogosgrudados.remove_at(i);
break;
}
if(fogosgrudados[i].t.elapsed>=1000){
fogosgrudados[i].t.restart();
for(uint i2=0;i2<players.length();i2++){
if(players[i2].charname==fogosgrudados[i].alvo){
string s=get_tile_at(players[i2].x, players[i2].y, players[i2].map);
if(string_contains(s, "water", 1)<0&&string_contains(s, "shallow", 1)<0){
players[i2].health-=random(200, 400);
players[i2].lasthit="boladefogo_"+fogosgrudados[i].char_name_nome;
players[i2].nsede+=0.5;
send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
}
else{
send_packet10(0, players[i2].charname, players[i2].charname, "waterhardland.ogg "+players[i2].x+" "+players[i2].y, players[i2].map);
fogosgrudados.remove_at(i);
break;
}
}
}
}
}
}
// duck
pato@[] patos;
class pato{
int x, y, nandar=random(1000, 3000);
string map_data, sound_name;
timer walk_timer, tvoar;
pato(int px, int py, string pm){
x=px;
y=py;
map_data=pm;
sound_name=spawn_moving_sound("pato_loop.ogg", x, y, map_data);
}
}
void place_duck(int x, int y, string map_data){
pato p(x, y, map_data);
patos.insert_last(p);
}
void duck_loop(){
for(uint i=0;i<patos.length();i++){
if(patos[i].tvoar.elapsed>=1200){
for(uint i2=0;i2<players.length();i2++){
if(patos[i].x<players[i2].x&&get_duck_distance(patos[i], players[i2])<10&&players[i2].afk==false&&players[i2].map==patos[i].map_data&&players[i2].starsoundid!=""){
send_packet3(0, "play pato_voando"+random(1, 2)+".ogg "+patos[i].x+" "+patos[i].y, patos[i].map_data);
patos[i].x-=random(30, 40);
}
else if(patos[i].x>players[i2].x&&get_duck_distance(patos[i], players[i2])<10&&players[i2].afk==false&&players[i2].map==patos[i].map_data&&players[i2].starsoundid!=""){
send_packet3(0, "play pato_voando"+random(1, 2)+".ogg "+patos[i].x+" "+patos[i].y, patos[i].map_data);
patos[i].x+=random(30, 40);
}
}
patos[i].tvoar.restart();
}
if(patos[i].walk_timer.elapsed>=patos[i].nandar){
patos[i].nandar=random(1000, 1500);
patos[i].walk_timer.restart();
if(patos[i].x<200)patos[i].x+=random(5, 9);
if(patos[i].x>400)patos[i].x-=random(5, 9);
update_moving_sound(patos[i].sound_name, patos[i].x, patos[i].y);
}
if(patos[i].x<180){
patos[i].x=180+random(4, 15);
update_moving_sound(patos[i].sound_name, patos[i].x, patos[i].y);
}
if(patos[i].x>400){
patos[i].x=400-random(3, 15);
update_moving_sound(patos[i].sound_name, patos[i].x, patos[i].y);
}
}
}
// Nuclear bomb
nuclear_bomb@[] nuclear_bombs;
class nuclear_bomb{
int x, y;
string map, char_name_nome;
timer atomic_bomb_timer, tbipar1, tbipar2;
int atomic_bomb_time=60000;
nuclear_bomb(int cx, int cy, string cmap, string cname){
x=cx;
y=cy;
map=cmap;
char_name_nome=cname;
}
}
void nuclear_bomb_loop(){
for(uint i=0; i<nuclear_bombs.length(); i++){
if(nuclear_bombs[i].tbipar1.elapsed>=10000&&nuclear_bombs[i].atomic_bomb_timer.elapsed<50000){
nuclear_bombs[i].tbipar1.restart();
nuclear_bombs[i].tbipar2.restart();
send_packet(0,"play timebombbeep.ogg "+nuclear_bombs[i].x+" "+nuclear_bombs[i].y, nuclear_bombs[i].map);
}
if(nuclear_bombs[i].tbipar2.elapsed>=1000&&nuclear_bombs[i].atomic_bomb_timer.elapsed>=50000){
send_packet(0,"play timebombbeep.ogg "+nuclear_bombs[i].x+" "+nuclear_bombs[i].y, nuclear_bombs[i].map);
nuclear_bombs[i].tbipar2.restart();
}
if(nuclear_bombs[i].atomic_bomb_timer.elapsed>=nuclear_bombs[i].atomic_bomb_time){
send_reliable(0,"ps nuclear.ogg", 0);
for(uint i2=0; i2 < players.length(); i2++){
if(players[i2].map!="arena"&&players[i2].afk==false&&players[i2].is_admin()==false&&players[i2].peaceful==0){
players[i2].health=-1;
players[i2].lasthit="bombanuclear_"+nuclear_bombs[i].char_name_nome;
}
}
for(uint i2=0;i2<sharks.length();i2++){
send_reliable(0, "msg2 Dog; ;all your whole body was transposed by the diabolical destruction of; "+nuclear_bombs[i].char_name_nome+".", 3);
int xx=get_player_index_from(nuclear_bombs[i].char_name_nome);
if(xx>-1)gain_xp(players[xx].charname, random(10, 20));
sharks.remove_at(i2);
}
while(zumbis.length()>0){
for(uint i2=0;i2<zumbis.length();i2++){
send_reliable(0, "msg2 Zoombie; ;all your whole body was transposed by the diabolical destruction of; "+nuclear_bombs[i].char_name_nome+".", 3);
int xx=get_player_index_from(nuclear_bombs[i].char_name_nome);
if(xx>-1)gain_xp(players[xx].charname, random(50, 100));
zumbis.remove_at(i2);
}
}
	for(uint i2=0;i2<gatos.length();i2++){
