bool in_team(string char_name_nome, string alvo){
bool was_found=false;
int n=get_player_index_from(char_name_nome);
int nb=get_player_index_from(alvo);
if(n<0||nb<0)return true;
else if(n>-1&&nb>-1){
if(players[n].nomesequipe.find(alvo)>-1||players[nb].afk==true||players[nb].peaceful==1||get_safezone_at(players[nb].x, players[nb].y, players[nb].map)==true)return true;
else return false;
}
return true;
}

double get_duck_distance(pato@ m1, player@ p2){
if(m1.map_data!=p2.map) return -1;
int dx,dy;
if(m1.x<=p2.x) dx=p2.x-m1.x;
else dx=m1.x-p2.x;
if(m1.y<=p2.y) dy=p2.y-m1.y;
else dy=m1.y-p2.y;
return dx+dy;
}
