// Dragonsaur
dragonsauro@[] dragonsauros;
class dragonsauro
{
bool y_up=true, y_down=true; // y_up: may follow UP the Y axis; y_down: may follow DOWN. false on either still allows X movement.
int x;
int y, nbotar=random(600000, 1200000);
uint shots=1;
int health_points;
string hit_by;
string map;
timer dragonsaur_timer, tbotar;
timer shoot_time;
timer sound_timer;
int sound_interval=4000;
int dragonsaur_time=999;
bool flee_mode=false;
dragonsauro(int cx, int cy, string cmap, int cvida)
{
x=cx;
y=cy;
map=cmap;
health_points=cvida;
}
}
void dragonsaur_loop()
{
for(uint i=0; i<dragonsauros.length(); i++)
{
if(dragonsauros[i].health_points<=0){
uint total=0;
send_packet(0,"play m_dragonsauro.ogg "+dragonsauros[i].x+" "+dragonsauros[i].y+" "+dragonsauros[i].map,dragonsauros[i].map);
string hitter=dragonsauros[i].hit_by;
if(string_contains(hitter, "magnet_", 1)>-1){
hitter=string_replace(hitter, "magnet_", "", true);
send_reliable(0, "msg2 one; ;dragonsaur; ;morreu no; ;Magnetic_item; ;From; ;"+hitter+";!", 3);
}
else{
send_reliable(0, "msg2 "+hitter+"; ;killed a; ;dragonsaur;!", 3);
}
int xx=get_player_index_from(hitter);
if(xx>-1){
players[xx].inv_add_item("dragonsaurus_corpse", 1);
for(uint zi=0;zi<players[xx].nomesequipe.length();zi++){
int member_index=get_player_index_from(players[xx].nomesequipe[zi]);
if(member_index>-1){
if(players[member_index].peaceful==0&&players[member_index].afk==false&&players[member_index].newbie==false) total++;
}
}
if(total==0)return;
int give_xp=(random(1500, 2000)/total);
for(uint zi=0;zi<players[xx].nomesequipe.length();zi++){
int member_index=get_player_index_from(players[xx].nomesequipe[zi]);
if(member_index>-1){
if(players[member_index].peaceful==0&&players[member_index].afk==false&&players[member_index].newbie==false){
players[member_index].xp+=give_xp;
send_reliable(players[member_index].peer_id, "msgyouwon "+give_xp, 0);
if(doublexp==1){
players[member_index].xp+=give_xp;
send_reliable(players[member_index].peer_id, "msgyouwon2 "+give_xp, 0);
}
}
}
}
}
dragonsauros.remove_at(i);
break;
}
if(dragonsauros[i].tbotar.elapsed>=dragonsauros[i].nbotar){
dragonsauros[i].tbotar.restart();
if(item_exists("dragonsaurus_egg")==false)spawn_obj(dragonsauros[i].x,dragonsauros[i].y,"dragonsaurus_egg",1,dragonsauros[i].map);
dragonsauros[i].nbotar=random(600000, 1200000);
}
if(dragonsauros[i].sound_timer.elapsed>=dragonsauros[i].sound_interval+random(1000, 2000)){
dragonsauros[i].sound_timer.restart();
string ss="dragonsauro"+random(1, 3)+".ogg";
send_packet(0,"play "+ss+" "+dragonsauros[i].x+" "+dragonsauros[i].y+" "+dragonsauros[i].map,dragonsauros[i].map);
}
if(dragonsauros[i].dragonsaur_timer.elapsed>=dragonsauros[i].dragonsaur_time)
{
dragonsauros[i].dragonsaur_timer.restart();
for(uint i2=0; i2 < players.length(); i2++){
if(dragonsauros[i].y!=players[i2].y&&players[i2].jumping==0){
int _cd=climb_dir(dragonsauros[i].map, dragonsauros[i].x, dragonsauros[i].y, players[i2].x, players[i2].y, dragonsauros[i].y_up, dragonsauros[i].y_down);
if(_cd==3&&get_tile_at(dragonsauros[i].x, dragonsauros[i].y+1, dragonsauros[i].map)!=""&&string_contains(get_tile_at(dragonsauros[i].x, dragonsauros[i].y+1, dragonsauros[i].map), "wall", 1)<0){dragonsauros[i].y++;send_packet(0,"play "+get_tile_at(dragonsauros[i].x, dragonsauros[i].y, dragonsauros[i].map)+"step"+random(1, 5)+".ogg "+dragonsauros[i].x+" "+dragonsauros[i].y, dragonsauros[i].map);break;}
else if(_cd==4&&get_tile_at(dragonsauros[i].x, dragonsauros[i].y-1, dragonsauros[i].map)!=""&&string_contains(get_tile_at(dragonsauros[i].x, dragonsauros[i].y-1, dragonsauros[i].map), "wall", 1)<0){dragonsauros[i].y--;send_packet(0,"play "+get_tile_at(dragonsauros[i].x, dragonsauros[i].y, dragonsauros[i].map)+"step"+random(1, 5)+".ogg "+dragonsauros[i].x+" "+dragonsauros[i].y, dragonsauros[i].map);break;}
else if(_cd==1&&get_tile_at(dragonsauros[i].x-1, dragonsauros[i].y, dragonsauros[i].map)!=""&&string_contains(get_tile_at(dragonsauros[i].x-1, dragonsauros[i].y, dragonsauros[i].map), "wall", 1)<0){dragonsauros[i].x--;send_packet(0,"play "+get_tile_at(dragonsauros[i].x, dragonsauros[i].y, dragonsauros[i].map)+"step"+random(1, 5)+".ogg "+dragonsauros[i].x+" "+dragonsauros[i].y, dragonsauros[i].map);break;}
else if(_cd==2&&get_tile_at(dragonsauros[i].x+1, dragonsauros[i].y, dragonsauros[i].map)!=""&&string_contains(get_tile_at(dragonsauros[i].x+1, dragonsauros[i].y, dragonsauros[i].map), "wall", 1)<0){dragonsauros[i].x++;send_packet(0,"play "+get_tile_at(dragonsauros[i].x, dragonsauros[i].y, dragonsauros[i].map)+"step"+random(1, 5)+".ogg "+dragonsauros[i].x+" "+dragonsauros[i].y, dragonsauros[i].map);break;}
}
if(dragonsauros[i].x>players[i2].x+3&&players[i2].in_safe_zone==false&&players[i2].map==dragonsauros[i].map&&players[i2].newbie==false&&players[i2].afk==false&&players[i2].peaceful==0&&dragonsauros[i].flee_mode==false){
dragonsauros[i].x--;
string ss=get_tile_at(dragonsauros[i].x, dragonsauros[i].y, dragonsauros[i].map);
send_packet(0,"play "+ss+" "+dragonsauros[i].x+" "+dragonsauros[i].y+" "+dragonsauros[i].map,dragonsauros[i].map);
dragonsauros[i].dragonsaur_timer.restart();
}
else if(dragonsauros[i].x<players[i2].x-3&&players[i2].in_safe_zone==false&&dragonsauros[i].map==players[i2].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&dragonsauros[i].flee_mode==false){
dragonsauros[i].x++;
string ss=get_tile_at(dragonsauros[i].x, dragonsauros[i].y, dragonsauros[i].map);
send_packet(0,"play "+ss+" "+dragonsauros[i].x+" "+dragonsauros[i].y+" "+dragonsauros[i].map,dragonsauros[i].map);
dragonsauros[i].dragonsaur_timer.restart();
}
if(get_dragonsaur_distance(dragonsauros[i], players[i2])>-1&&get_dragonsaur_distance(dragonsauros[i],players[i2])<=7&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&dragonsauros[i].shoot_time.elapsed>=500&&dragonsauros[i].shots>0){
dragonsauros[i].shoot_time.restart();
send_packet(0,"play dragonsaurobater.ogg "+dragonsauros[i].x+" "+dragonsauros[i].y+" "+dragonsauros[i].map,dragonsauros[i].map);
int r=reflect_damage(i2, "dragonsauro", dragonsauros[i].x, dragonsauros[i].y, random(800, 2800));
if(r>0){dragonsauros[i].health_points-=r;dragonsauros[i].hit_by=players[i2].charname;break;}
players[i2].health-=random(800, 2800);
send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
players[i2].lasthit="dragonsauro";
dragonsauros[i].shots--;
break;
}
if(dragonsauros[i].shots<=0){
dragonsauros[i].shots=1;
dragonsauros[i].shoot_time.restart();
}
}
}
}
netloop();
}
void spawn_dragonsaur(int x, int y, string map, int health_points=random(300000, 800000)){
if(!pvp)return;
dragonsauro c(x, y, map, health_points);
dragonsauros.insert_last(c);
}
// bears
bear@[] bears;
class bear
{
bool y_up=true, y_down=true; // y_up: may follow UP the Y axis; y_down: may follow DOWN. false on either still allows X movement.
int x;
int y;
int obj_count=370;
uint shots=1;
int health_points=3000;
string hit_by;
string map;
timer bear_timer, tobjs;
timer shoot_time;
int bear_time=187;
bool flee_mode=false;
bear(int cx, int cy, string cmap)
{
x=cx;
y=cy;
map=cmap;
}
}
void bear_loop(){
for(uint i=0; i<bears.length(); i++){
if(bears[i].health_points<=0){
send_packet(0,"play m_urso.ogg "+bears[i].x+" "+bears[i].y+" "+bears[i].map,bears[i].map);
send_reliable(0, "msg2 "+bears[i].hit_by+"; ;killed a; ;Bear;!", 3);
string hitter=bears[i].hit_by;
int xx=get_player_index_from(hitter);
if(xx>-1){
players[xx].inv_add_item("bear_corpse", 1);
gain_xp(players[xx].charname, random(100, 200));
}
bears.remove_at(i);
break;
}
if(bears[i].bear_timer.elapsed>=bears[i].bear_time){
bears[i].bear_timer.restart();
for(uint i2=0; i2 < players.length(); i2++){
if(bears[i].y!=players[i2].y&&players[i2].jumping==0){
int _cd=climb_dir(bears[i].map, bears[i].x, bears[i].y, players[i2].x, players[i2].y, bears[i].y_up, bears[i].y_down);
if(_cd==3&&get_tile_at(bears[i].x, bears[i].y+1, bears[i].map)!=""&&string_contains(get_tile_at(bears[i].x, bears[i].y+1, bears[i].map), "wall", 1)<0){bears[i].y++;send_packet(0,"play "+get_tile_at(bears[i].x, bears[i].y, bears[i].map)+"step"+random(1, 5)+".ogg "+bears[i].x+" "+bears[i].y, bears[i].map);break;}
else if(_cd==4&&get_tile_at(bears[i].x, bears[i].y-1, bears[i].map)!=""&&string_contains(get_tile_at(bears[i].x, bears[i].y-1, bears[i].map), "wall", 1)<0){bears[i].y--;send_packet(0,"play "+get_tile_at(bears[i].x, bears[i].y, bears[i].map)+"step"+random(1, 5)+".ogg "+bears[i].x+" "+bears[i].y, bears[i].map);break;}
else if(_cd==1&&get_tile_at(bears[i].x-1, bears[i].y, bears[i].map)!=""&&string_contains(get_tile_at(bears[i].x-1, bears[i].y, bears[i].map), "wall", 1)<0){bears[i].x--;send_packet(0,"play "+get_tile_at(bears[i].x, bears[i].y, bears[i].map)+"step"+random(1, 5)+".ogg "+bears[i].x+" "+bears[i].y, bears[i].map);break;}
else if(_cd==2&&get_tile_at(bears[i].x+1, bears[i].y, bears[i].map)!=""&&string_contains(get_tile_at(bears[i].x+1, bears[i].y, bears[i].map), "wall", 1)<0){bears[i].x++;send_packet(0,"play "+get_tile_at(bears[i].x, bears[i].y, bears[i].map)+"step"+random(1, 5)+".ogg "+bears[i].x+" "+bears[i].y, bears[i].map);break;}
}
if(bears[i].x>players[i2].x+1&&players[i2].in_safe_zone==false&&players[i2].map==bears[i].map&&players[i2].newbie==false&&players[i2].afk==false&&players[i2].peaceful==0&&bears[i].flee_mode==false){
bears[i].x--;
string ss=get_tile_at(bears[i].x, bears[i].y, bears[i].map);
send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+bears[i].x+" "+bears[i].y, bears[i].map);
break;
}
else if(bears[i].x<players[i2].x-1&&players[i2].in_safe_zone==false&&bears[i].map==players[i2].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&bears[i].flee_mode==false){
bears[i].x++;
string ss=get_tile_at(bears[i].x, bears[i].y, bears[i].map);
send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+bears[i].x+" "+bears[i].y,bears[i].map);
break;
}
if(get_bear_distance(bears[i], players[i2])>-1&&get_bear_distance(bears[i],players[i2])<=2&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&bears[i].shoot_time.elapsed>=500&&bears[i].shots>0&&players[i2].in_safe_zone==false){
bears[i].shoot_time.restart();
send_packet(0,"play ursobater.ogg "+bears[i].x+" "+bears[i].y,bears[i].map);
int r=reflect_damage(i2, "urso", bears[i].x, bears[i].y, random(150, 200));
if(r>0){bears[i].health_points-=r;bears[i].hit_by=players[i2].charname;break;}
players[i2].health-=random(150, 200);
send_packet(0,"inithurt "+players[i2].charname+" "+players[i2].x+" "+players[i2].y+" "+players[i2].voice+" "+players[i2].pitch+" "+players[i2].map,players[i2].map);
players[i2].lasthit="urso";
bears[i].shots--;
break;
}
if(bears[i].shots<=0){
bears[i].shots=1;
bears[i].shoot_time.restart();
}
}
}
}
}
void spawn_bear(int x, int y, string map){
if(!pvp)return;
bear c(x, y, map);
bears.insert_last(c);
}
// Guard
guard@[] guards;
class guard
{
int x, y;
uint shots=30;
int health_points=5000;
string hit_by;
string map;
timer guard_timer;
timer shoot_time;
timer reload_time_tempoc;
int guard_time=500;
guard(int cx, int cy, string cmap)
{
x=cx;
y=cy;
map=cmap;
}
}
void guard_loop()
{
for(uint i=0; i<guards.length(); i++)
{
if(guards[i].guard_timer.elapsed>=guards[i].guard_time)
{
string l=get_zone_at(guards[i].x, guards[i].y, guards[i].map);
for(uint i2=0; i2 < players.length(); i2++){
string ll=get_zone_at(players[i2].x, players[i2].y, players[i2].map);
if(guards[i].shoot_time.elapsed>=450&&guards[i].shots>0&&players[i2].in_safe_zone==false&&guards[i].reload_time_tempoc.elapsed>=1600){
if(players[i2].inv_item_number("gold_trophy")<8||players[i2].inv_item_number("gold_medal")<8){
if(string_contains(ll, "frente", 1)>-1||string_contains(ll,"gate", 1)>-1||string_contains(ll, l, 1)>-1){
guards[i].shoot_time.restart();
send_packet(0,"play helicopteroarma"+random(1, 3)+".ogg "+guards[i].x+" "+guards[i].y+" "+guards[i].map,guards[i].map);
players[i2].health-=random(100, 130);
send_reliable(0,"inithurt "+players[i2].charname+" "+players[i2].x+" "+players[i2].y+" "+players[i2].voice+" "+players[i2].pitch+" "+players[i2].map,0);
players[i2].lasthit="guarda";
guards[i].shots--;
break;
}
}
}
if(guards[i].shots<=0){
guards[i].shots=30;
guards[i].reload_time_tempoc.restart();
guards[i].shoot_time.restart();
send_packet(0,"play carregar_m60.ogg "+guards[i].x+" "+guards[i].y+" "+guards[i].map,guards[i].map);
}
}
}
}
}
void spawn_guard(int x, int y, string map){
if(!pvp)return;
guard c(x, y, map);
guards.insert_last(c);
}
