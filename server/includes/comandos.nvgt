// Horse
horse@[] horses;
class horse{
int x, y, nandar=410, walking=2;
timer walk_timer;
string map_data;
horse(int cx, int cy, string cmapa){
x=cx;
y=cy;
map_data=cmapa;
}
}
void new_horse(int x, int y, string map_data){
horse c(x, y, map_data);
horses.insert_last(c);
}
void horse_loop(){
for(uint i=0;i<horses.length();i++){
if(horses[i].walk_timer.elapsed>=horses[i].nandar){
horses[i].walk_timer.restart();
if(horses[i].walking==2)horses[i].x++;
else if(horses[i].walking==1)horses[i].x--;
if(players.length()>0)send_packet(0, "play cavaloloop.ogg "+horses[i].x+" "+horses[i].y, horses[i].map_data);
for(uint i2=0;i2<players.length();i2++){
if(horses[i].x==players[i2].x&&horses[i].y==players[i2].y&&horses[i].map_data==players[i2].map&&players[i2].horse==false){
players[i2].health-=random(4000, 4700);
send_packet(0, "play cavalocoice.ogg "+players[i2].x+" "+players[i2].y, players[i2].map);
players[i2].lasthit="Cavalo";
break;
}
}
for(uint i2=0;i2<players.length();i2++){
if(players[i2].map==horses[i].map_data&&players[i2].horse==true){
players[i2].x=horses[i].x;
players[i2].y=(horses[i].y+1);
send_packet(0,"update_player2 "+players[i2].charname+" "+players[i2].x+" "        +players[i2].y+" "+players[i2].map,players[i2].map);
}
}
if(horses[i].walking==2&&string_contains(get_tile_at(horses[i].x+1, horses[i].y, horses[i].map_data), "wall", 1)>-1)horses[i].walking=1;
else if(horses[i].walking==1&&string_contains(get_tile_at(horses[i].x-1, horses[i].y, horses[i].map_data), "wall", 1)>-1)horses[i].walking=2;
}
}
}
// Computer
class computador
{
int alarm_timer=0, close_chest_flag=0;
int x,y, abau=0, clock=0;
string id,map, salarme, salarme2, srelogio;
int turned_on=0, safe=0, house_code;// alarm mode
bool starting_engine=false, iniciado=false;
timer ignition_timer, tabrir;
computador(string mid, int mx, int my,string mm, int c_code, int c_safe, int c_chest, int crelogio){
id=mid;
x=mx;
y=my;
map=mm;
house_code=c_code;
safe=c_safe;
abau=c_chest;
tabrir.force(0);tabrir.pause();
clock=crelogio;
if(crelogio==0)srelogio=spawn_moving_sound("clock.ogg", 1, 4, map);
}
}
computador@[] computadors;
void computer_loop(){
for(uint i=0;i<computadors.length();i++){
if(computadors[i].tabrir.elapsed>=5000){
computadors[i].tabrir.force(0);
computadors[i].tabrir.pause();
file f;
f.open("maps/"+computadors[i].map+".map", "r");
string[] linhas=delinear(f.read());
f.close();
int x=1000, y=0;
for(uint i2=0;i2<linhas.length();i2++){
string[] l=string_split(linhas[i2], ":", false);
if(l[0]=="travelpoint"){
x=string_to_number(l[5]);
y=string_to_number(l[6]);
}
}
send_packet(0, "play door12close.ogg "+x+" "+y, "apartment_building");
}
if(computadors[i].ignition_timer.elapsed>=20000&&computadors[i].turned_on==1){
send_packet(0, "pcliga", computadors[i].map);
computadors[i].iniciado=true;
computadors[i].ignition_timer.force(0);
computadors[i].ignition_timer.pause();
}
}
}
void spawn_computer(int x, int y, string map, int code, int safe, int chest, int clock)
{
string id;
bool breakit=false;
while(true)
{
id=random_string();
breakit=true;
for(uint i=0; i<computadors.length(); i++)
{
if(computadors[i].id==id) breakit=false;
}
if(breakit) break;
}
computador m1(id,x,y,map, code, safe, chest, clock);
computadors.insert_last(m1);
send_packet(0,"spawncomputador "+id+" "+x+" "+y+" "+map,map);
}
void destroy_computer(string id)
{
for(uint i=0; i<computadors.length(); i++)
{
if(computadors[i].id==id)
{
send_reliable(0,"destroycomputador "+id, 0);
computadors.remove_at(i);
continue;
}
}
}
// apartments
apartment_zone@[]apartment_zones;
class apartment_zone{
string apartment_inv;
string map;
apartment_zone(string cm, string ci){
map=cm;
apartment_inv=ci;
}
void inv_add_item(string itemname, double itemvalue, bool send=true)
{
string content=apartment_inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] values;
for(uint i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
if(inv_item_exists(itemname))
{
double orgval;
if(inv_item(itemname) > -1)
{
orgval=string_to_number(values[inv_item(itemname)]);
}
else
{
return;
}
if(orgval+itemvalue < 1)
{
inv_delete_item(itemname);
}
else
{
values[inv_item(itemname)]=(orgval+itemvalue);
string tempinv;
for(uint i=0; i<peramitors.length(); i++)
{
tempinv+=peramitors[i]+"="+values[i]+"\r\n";
}
apartment_inv=tempinv;
}
}
else
{
if(itemvalue > 0)
{
apartment_inv+=itemname+"="+itemvalue+"\r\n";
}
}
send_packet(0, "apartamentoinv "+apartment_inv, map);
//write_to(charname, "inv.usr", inv);
}
bool inv_item_exists(string itemname)
{
string content=apartment_inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] values;
for(double i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
for(double i=0; i<peramitors.length(); i++)
{
if(peramitors[i]==itemname)
{
return true;
}
}
return false;
}
double inv_item_number(string itemname)
{
string content=apartment_inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] values;
for(double i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
for(double i=0; i<peramitors.length(); i++)
{
if(peramitors[i]==itemname)
{
return string_to_number(values[i]);
}
}
return 0;
}
double inv_item(string itemname)
{
string content=apartment_inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] values;
for(double i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
for(double i=0; i<peramitors.length(); i++)
{
if(peramitors[i]==itemname)
{
return i;
}
}
return -1;
}
void inv_delete_item(string itemname)
{
string content=apartment_inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] values;
for(double i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
for(double i=0; i<peramitors.length(); i++)
{
if(peramitors[i]==itemname)
{
apartment_inv=string_replace(apartment_inv, itemname+"="+values[i]+"\r\n", "", false);
}
}
}
}
void place_apartment(string map, string item_list_itens=""){
apartment_zone c(map, item_list_itens);
apartment_zones.insert_last(c);
}
void at_apartment(string map, string item_list_itens){
for(double i=0;i<apartment_zones.length();i++){
if(apartment_zones[i].map==map){
apartment_zones[i].apartment_inv=item_list_itens;
send_packet(0, "apartamentoinv "+apartment_zones[i].apartment_inv, apartment_zones[i].map);
break;
}
}
}
torre_de_babel@[]torre_de_babels;
class torre_de_babel{
int x, miny=0, maxy=50, health_points=1000000;
string map;
torre_de_babel(int cx, string cmap, int cvida){
x=cx;
map=cmap;
health_points=cvida;
}
}
void place_tower_of_babel(int x, string map, int health_points=1000000){
file z;
z.open("maps/"+map+".map", "r");
string[] m=string_split(z.read(), "\r\n", false);
z.close();
m.insert_last("pwall:"+x+":0:50:wallbarricada");
z.open("maps/"+map+".map", "w");
z.write(linear(m));
z.close();
update(map);
torre_de_babel c(x, map, health_points);
torre_de_babels.insert_last(c);
}
void tower_of_babel_loop(){
for(uint i=0;i<torre_de_babels.length();i++){
if(torre_de_babels[i].health_points<=0){
if(torre_de_babels[i].map=="antiquity")tmina2.restart();
remove_tower_of_babel(torre_de_babels[i].map, torre_de_babels[i].x);
break;
}
}
}
void remove_tower_of_babel(string map, int x){
file z;
z.open("maps/"+map+".map", "r");
string[] m=string_split(z.read(), "\r\n", false);
z.close();
for(uint i=0;i<torre_de_babels.length();i++){
if(torre_de_babels[i].map==map&&torre_de_babels[i].x==x){
while(true){
bool t=false;
for(uint i2=0;i2<m.length();i2++){
if(string_contains(m[i2], "ptorre_de_babel", 1)>-1){
string[] bla=string_split(m[i2], ":", false);
if(string_to_number(bla[1])==x){
t=true;
m.remove_at(i2);
}
}
}
if(!t)break;
}
send_packet(0, "play boobytraphit1.ogg "+torre_de_babels[i].x+" "+torre_de_babels[i].miny, torre_de_babels[i].map);
torre_de_babels.remove_at(i);
z.open("maps/"+map+".map", "w");
z.write(linear(m));
z.close();
update2(map);
}
}
}
wall@[]walls;
class wall{
int x, miny=0, maxy=50, health_points=600000;
string map;
wall(int cx, string cmap, int cvida){
x=cx;
map=cmap;
health_points=cvida;
}
}
void place_wall(int x, string map, int health_points=600000){
file z;
z.open("maps/"+map+".map", "r");
string[] m=string_split(z.read(), "\r\n", false);
z.close();
m.insert_last("pwall:"+x+":0:50:wallnone");
z.open("maps/"+map+".map", "w");
z.write(linear(m));
z.close();
update(map);
wall c(x, map, health_points);
walls.insert_last(c);
}
void wall_loop(){
for(uint i=0;i<walls.length();i++){
if(walls[i].health_points<=0){
if(walls[i].map=="cave")tmina2.restart();
remove_wall(walls[i].map, walls[i].x);
break;
}
}
}
void remove_wall(string map, int x){
file z;
z.open("maps/"+map+".map", "r");
string[] m=string_split(z.read(), "\r\n", false);
z.close();
for(uint i=0;i<walls.length();i++){
if(walls[i].map==map&&walls[i].x==x){
while(true){
bool t=false;
for(uint i2=0;i2<m.length();i2++){
if(string_contains(m[i2], "pwall", 1)>-1){
string[] bla=string_split(m[i2], ":", false);
if(string_to_number(bla[1])==x){
t=true;
m.remove_at(i2);
}
}
}
if(!t)break;
}
send_packet(0, "play dparede.ogg "+walls[i].x+" "+walls[i].miny, walls[i].map);
walls.remove_at(i);
z.open("maps/"+map+".map", "w");
z.write(linear(m));
z.close();
update2(map);
}
}
}
// Sinks
