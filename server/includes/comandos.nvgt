				else if(_cd==4&&get_tile_at(deciceds[i].x, deciceds[i].y-1, deciceds[i].map)!=""&&string_contains(get_tile_at(deciceds[i].x, deciceds[i].y-1, deciceds[i].map), "wall", 1)<0){deciceds[i].y--;send_packet(0,"play "+get_tile_at(deciceds[i].x, deciceds[i].y, deciceds[i].map)+"step"+random(1, 5)+".ogg "+deciceds[i].x+" "+deciceds[i].y, deciceds[i].map);break;}
				else if(_cd==1&&get_tile_at(deciceds[i].x-1, deciceds[i].y, deciceds[i].map)!=""&&string_contains(get_tile_at(deciceds[i].x-1, deciceds[i].y, deciceds[i].map), "wall", 1)<0){deciceds[i].x--;send_packet(0,"play "+get_tile_at(deciceds[i].x, deciceds[i].y, deciceds[i].map)+"step"+random(1, 5)+".ogg "+deciceds[i].x+" "+deciceds[i].y, deciceds[i].map);break;}
				else if(_cd==2&&get_tile_at(deciceds[i].x+1, deciceds[i].y, deciceds[i].map)!=""&&string_contains(get_tile_at(deciceds[i].x+1, deciceds[i].y, deciceds[i].map), "wall", 1)<0){deciceds[i].x++;send_packet(0,"play "+get_tile_at(deciceds[i].x, deciceds[i].y, deciceds[i].map)+"step"+random(1, 5)+".ogg "+deciceds[i].x+" "+deciceds[i].y, deciceds[i].map);break;}
				}
				if(deciceds[i].x>players[i2].x+2&&players[i2].in_safe_zone==false&&players[i2].map==deciceds[i].map&&players[i2].newbie==false&&players[i2].afk==false&&players[i2].peaceful==0){
					deciceds[i].x-=2;
					string ss=get_tile_at(deciceds[i].x, deciceds[i].y, deciceds[i].map);
					send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+deciceds[i].x+" "+deciceds[i].y+" "+deciceds[i].map,deciceds[i].map);
					deciceds[i].decicedtimer.restart();
					break;
				}
				else if(deciceds[i].x<players[i2].x-2&&players[i2].in_safe_zone==false&&deciceds[i].map==players[i2].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false){
					deciceds[i].x+=2;
					string ss=get_tile_at(deciceds[i].x, deciceds[i].y, deciceds[i].map);
					send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+deciceds[i].x+" "+deciceds[i].y+" "+deciceds[i].map,deciceds[i].map);
					deciceds[i].decicedtimer.restart();
					break;
				}
				if(get_deciced_distance(deciceds[i], players[i2])>-1&&get_deciced_distance(deciceds[i],players[i2])<=2&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&deciceds[i].shoot_time.elapsed>=500&&deciceds[i].shots>0){
					deciceds[i].shoot_time.restart();
			string ss="decicedbater"+random(1, 4)+".ogg";
			send_packet(0,"play "+ss+" "+deciceds[i].x+" "+deciceds[i].y+" "+deciceds[i].map,deciceds[i].map);
					int r=reflect_damage(i2, "deciced", deciceds[i].x, deciceds[i].y, random(300, 500));
					if(r>0){deciceds[i].health_points-=r;deciceds[i].hit_by=players[i2].charname;break;}
					players[i2].health-=random(30000, 50000);
					send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
					players[i2].lasthit="deciced";
					deciceds[i].shots--;
					break;
				}
				if(deciceds[i].shots<=0){
					deciceds[i].shots=1;
					deciceds[i].shoot_time.restart();
				}
			}
		}
	}
	netloop();
}
void spawn_deciced(int x, int y, string map){
	deciced c(x, y, map);
	deciceds.insert_last(c);
}
