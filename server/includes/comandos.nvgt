if(_cd==3&&get_tile_at(amon_ras[i].x, amon_ras[i].y+1, amon_ras[i].map)!=""&&string_contains(get_tile_at(amon_ras[i].x, amon_ras[i].y+1, amon_ras[i].map), "wall", 1)<0){amon_ras[i].y++;send_packet(0,"play "+get_tile_at(amon_ras[i].x, amon_ras[i].y, amon_ras[i].map)+"step"+random(1, 5)+".ogg "+amon_ras[i].x+" "+amon_ras[i].y, amon_ras[i].map);break;}
else if(_cd==4&&get_tile_at(amon_ras[i].x, amon_ras[i].y-1, amon_ras[i].map)!=""&&string_contains(get_tile_at(amon_ras[i].x, amon_ras[i].y-1, amon_ras[i].map), "wall", 1)<0){amon_ras[i].y--;send_packet(0,"play "+get_tile_at(amon_ras[i].x, amon_ras[i].y, amon_ras[i].map)+"step"+random(1, 5)+".ogg "+amon_ras[i].x+" "+amon_ras[i].y, amon_ras[i].map);break;}
else if(_cd==1&&get_tile_at(amon_ras[i].x-1, amon_ras[i].y, amon_ras[i].map)!=""&&string_contains(get_tile_at(amon_ras[i].x-1, amon_ras[i].y, amon_ras[i].map), "wall", 1)<0){amon_ras[i].x--;send_packet(0,"play "+get_tile_at(amon_ras[i].x, amon_ras[i].y, amon_ras[i].map)+"step"+random(1, 5)+".ogg "+amon_ras[i].x+" "+amon_ras[i].y, amon_ras[i].map);break;}
else if(_cd==2&&get_tile_at(amon_ras[i].x+1, amon_ras[i].y, amon_ras[i].map)!=""&&string_contains(get_tile_at(amon_ras[i].x+1, amon_ras[i].y, amon_ras[i].map), "wall", 1)<0){amon_ras[i].x++;send_packet(0,"play "+get_tile_at(amon_ras[i].x, amon_ras[i].y, amon_ras[i].map)+"step"+random(1, 5)+".ogg "+amon_ras[i].x+" "+amon_ras[i].y, amon_ras[i].map);break;}
}
if(amon_ras[i].x>players[i2].x+1&&players[i2].in_safe_zone==false&&players[i2].map==amon_ras[i].map&&players[i2].newbie==false&&players[i2].afk==false&&players[i2].peaceful==0&&amon_ras[i].flee_mode==false){
amon_ras[i].x--;
string ss=get_tile_at(amon_ras[i].x, amon_ras[i].y, amon_ras[i].map);
send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+amon_ras[i].x+" "+amon_ras[i].y, amon_ras[i].map);
break;
}
else if(amon_ras[i].x<players[i2].x-1&&players[i2].in_safe_zone==false&&amon_ras[i].map==players[i2].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&amon_ras[i].flee_mode==false){
amon_ras[i].x++;
string ss=get_tile_at(amon_ras[i].x, amon_ras[i].y, amon_ras[i].map);
send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+amon_ras[i].x+" "+amon_ras[i].y,amon_ras[i].map);
break;
}
if(get_amon_ra_distance(amon_ras[i], players[i2])>-1&&get_amon_ra_distance(amon_ras[i],players[i2])<=2&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&amon_ras[i].shoot_time.elapsed>=500&&amon_ras[i].shots>0&&players[i2].in_safe_zone==false){
amon_ras[i].shoot_time.restart();
send_packet(0,"play animales_diosbater"+random(1, 3)+".ogg "+amon_ras[i].x+" "+amon_ras[i].y,amon_ras[i].map);
int r=reflect_damage(i2, "amon_ra", amon_ras[i].x, amon_ras[i].y, random(150, 200));
if(r>0){amon_ras[i].health_points-=r;amon_ras[i].hit_by=players[i2].charname;break;}
players[i2].health-=random(350, 600);
send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
players[i2].lasthit="amon_ra";
amon_ras[i].shots--;
break;
}
if(amon_ras[i].shots<=0){
amon_ras[i].shots=1;
amon_ras[i].shoot_time.restart();
}
}
}
}
}
void spawn_amon_ra(int x, int y, string map){
if(!pvp)return;
amon_ra c(x, y, map);
amon_ras.insert_last(c);
}
//irroadium
irroadium@[] irroadiums;
class irroadium{
bool y_up=true, y_down=true; // y_up: may follow UP the Y axis; y_down: may follow DOWN. false on either still allows X movement.
	int x, y, ladoandar=2;
	uint shots=1;
	int health_points=random(2000000, 2300000);
	string hit_by;
	string map;
	timer irroadiumtimer;
	timer shoot_time;
	timer sound_timer;
	int sound_interval=4000;
	int irroadiumtime=1000;
	irroadium(int cx, int cy, string cmap){
		x=cx;
		y=cy;
		map=cmap;
	}
}
void irroadiumloop(){
	for(uint i=0; i<irroadiums.length(); i++){
		if(irroadiums[i].health_points<=0){
			uint total=0;
			send_packet(0,"play m_irroadium.ogg "+irroadiums[i].x+" "+irroadiums[i].y+" "+irroadiums[i].map,irroadiums[i].map);
			string hitter=irroadiums[i].hit_by;
			if(string_contains(hitter, "magnet_", 1)>-1){
				hitter=string_replace(hitter, "magnet_", "", true);
				send_reliable(0, "msg2 one; ;irroadium; ;morreu no; ;Magnetic_item; ;From; ;"+hitter+";!", 3);
			}
			else{
				send_reliable(0, "msg2 "+hitter+"; ;ha derrotado al poderoso irroadium!", 3);
			}
			int xx=get_player_index_from(hitter);
			if(xx>-1){
				players[xx].inv_add_item("irroadium_corpse", 1);
				players[xx].inv_add_item("coins", 5239);
				players[xx].inv_add_item("reais", 493);
				gain_xp(players[xx].charname, random(100000, 200000));
			}
			irroadiums.remove_at(i);
			break;
		}
		if(irroadiums[i].sound_timer.elapsed>=irroadiums[i].sound_interval+random(1000, 3200)){
			irroadiums[i].sound_timer.restart();
			string ss="irroadiumnervoso.ogg";
			send_packet(0,"play "+ss+" "+irroadiums[i].x+" "+irroadiums[i].y+" "+irroadiums[i].map,irroadiums[i].map);
		}
		if(irroadiums[i].irroadiumtimer.elapsed>=irroadiums[i].irroadiumtime){
			irroadiums[i].irroadiumtimer.restart();
			for(uint i2=0; i2 < players.length(); i2++){
				if(irroadiums[i].y!=players[i2].y&&players[i2].jumping==0){
				int _cd=climb_dir(irroadiums[i].map, irroadiums[i].x, irroadiums[i].y, players[i2].x, players[i2].y, irroadiums[i].y_up, irroadiums[i].y_down);
				if(_cd==3&&get_tile_at(irroadiums[i].x, irroadiums[i].y+1, irroadiums[i].map)!=""&&string_contains(get_tile_at(irroadiums[i].x, irroadiums[i].y+1, irroadiums[i].map), "wall", 1)<0){irroadiums[i].y++;send_packet(0,"play "+get_tile_at(irroadiums[i].x, irroadiums[i].y, irroadiums[i].map)+"step"+random(1, 5)+".ogg "+irroadiums[i].x+" "+irroadiums[i].y, irroadiums[i].map);break;}
				else if(_cd==4&&get_tile_at(irroadiums[i].x, irroadiums[i].y-1, irroadiums[i].map)!=""&&string_contains(get_tile_at(irroadiums[i].x, irroadiums[i].y-1, irroadiums[i].map), "wall", 1)<0){irroadiums[i].y--;send_packet(0,"play "+get_tile_at(irroadiums[i].x, irroadiums[i].y, irroadiums[i].map)+"step"+random(1, 5)+".ogg "+irroadiums[i].x+" "+irroadiums[i].y, irroadiums[i].map);break;}
				else if(_cd==1&&get_tile_at(irroadiums[i].x-1, irroadiums[i].y, irroadiums[i].map)!=""&&string_contains(get_tile_at(irroadiums[i].x-1, irroadiums[i].y, irroadiums[i].map), "wall", 1)<0){irroadiums[i].x--;send_packet(0,"play "+get_tile_at(irroadiums[i].x, irroadiums[i].y, irroadiums[i].map)+"step"+random(1, 5)+".ogg "+irroadiums[i].x+" "+irroadiums[i].y, irroadiums[i].map);break;}
				else if(_cd==2&&get_tile_at(irroadiums[i].x+1, irroadiums[i].y, irroadiums[i].map)!=""&&string_contains(get_tile_at(irroadiums[i].x+1, irroadiums[i].y, irroadiums[i].map), "wall", 1)<0){irroadiums[i].x++;send_packet(0,"play "+get_tile_at(irroadiums[i].x, irroadiums[i].y, irroadiums[i].map)+"step"+random(1, 5)+".ogg "+irroadiums[i].x+" "+irroadiums[i].y, irroadiums[i].map);break;}
				}
				if(irroadiums[i].x>players[i2].x+2&&players[i2].in_safe_zone==false&&players[i2].map==irroadiums[i].map&&players[i2].newbie==false&&players[i2].afk==false&&players[i2].peaceful==0){
					irroadiums[i].x-=2;
					string ss=get_tile_at(irroadiums[i].x, irroadiums[i].y, irroadiums[i].map);
					send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+irroadiums[i].x+" "+irroadiums[i].y+" "+irroadiums[i].map,irroadiums[i].map);
					irroadiums[i].irroadiumtimer.restart();
					break;
				}
				else if(irroadiums[i].x<players[i2].x-2&&players[i2].in_safe_zone==false&&irroadiums[i].map==players[i2].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false){
					irroadiums[i].x+=2;
					string ss=get_tile_at(irroadiums[i].x, irroadiums[i].y, irroadiums[i].map);
					send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+irroadiums[i].x+" "+irroadiums[i].y+" "+irroadiums[i].map,irroadiums[i].map);
					irroadiums[i].irroadiumtimer.restart();
					break;
				}
				if(get_irroadium_distance(irroadiums[i], players[i2])>-1&&get_irroadium_distance(irroadiums[i],players[i2])<=2&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&irroadiums[i].shoot_time.elapsed>=500&&irroadiums[i].shots>0){
					irroadiums[i].shoot_time.restart();
			string ss="irroadiumbater"+random(1, 4)+".ogg";
			send_packet(0,"play "+ss+" "+irroadiums[i].x+" "+irroadiums[i].y+" "+irroadiums[i].map,irroadiums[i].map);
					int r=reflect_damage(i2, "irroadium", irroadiums[i].x, irroadiums[i].y, random(300, 500));
					if(r>0){irroadiums[i].health_points-=r;irroadiums[i].hit_by=players[i2].charname;break;}
					players[i2].health-=random(3000, 5000);
					send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
					players[i2].lasthit="irroadium";
					irroadiums[i].shots--;
					break;
				}
				if(irroadiums[i].shots<=0){
					irroadiums[i].shots=1;
					irroadiums[i].shoot_time.restart();
				}
			}
		}
	}
	netloop();
}
void spawn_irroadium(int x, int y, string map){
	irroadium c(x, y, map);
	irroadiums.insert_last(c);
}
