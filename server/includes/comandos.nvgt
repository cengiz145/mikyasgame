double g_dist(guard_walk@ m1, player@ p2)
{
if(m1.map_data!=p2.map) return -1;
int dx,dy;
if(m1.x<=p2.x) dx=p2.x-m1.x;
else dx=m1.x-p2.x;
if(m1.y<=p2.y) dy=p2.y-m1.y;
else dy=m1.y-p2.y;
return dx+dy;
}
double get_remote_bomb_distance(remote_bomb@ m1, player@ p2)
{
if(m1.map!=p2.map) return -1;
int dx,dy;
if(m1.x<=p2.x) dx=p2.x-m1.x;
else dx=m1.x-p2.x;
if(m1.y<=p2.y) dy=p2.y-m1.y;
else dy=m1.y-p2.y;
return dx+dy;
}
double get_bomb_distance(maxbomba@ m1, player@ p2)
{
if(m1.map!=p2.map) return -1;
int dx,dy;
if(m1.x<=p2.x) dx=p2.x-m1.x;
else dx=m1.x-p2.x;
if(m1.y<=p2.y) dy=p2.y-m1.y;
else dy=m1.y-p2.y;
return dx+dy;
}
