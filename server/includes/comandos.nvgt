}
void rabbit_loop(){
for(uint i=0;i<rabbits.length();i++){
if(rabbits[i].health_points<=0){
send_packet(0, "play m_coelho.ogg "+rabbits[i].x+" "+rabbits[i].y, rabbits[i].map_data);
string hitter=rabbits[i].hit_by;
