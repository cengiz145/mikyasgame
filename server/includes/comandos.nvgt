int fire_time_fogoti=540;
bool right_side=false;
fogo(int cx, int cy, string cmap)
{
x=cx;
y=cy;
map=cmap;
soundfogo=spawn_moving_sound("boladefogo.ogg",x,y,map);
}
}
void fire_loop(){
for(uint i=0; i<fogos.length(); i++){
if(fogos[i].fire_timer.elapsed>=fogos[i].fire_time_fogoti){
if(fogos[i].right_side==false){
fogos[i].x--;
string l=get_tile_at(fogos[i].x, fogos[i].y, fogos[i].map);
if(string_contains(l, "wall", 1)>-1)fogos[i].right_side=true;
}
else if(fogos[i].right_side==true){
fogos[i].x++;
string l=get_tile_at(fogos[i].x, fogos[i].y, fogos[i].map);
if(string_contains(l, "wall", 1)>-1)fogos[i].right_side=false;
}
update_moving_sound(fogos[i].soundfogo,fogos[i].x,fogos[i].y);
fogos[i].fire_timer.restart();
for(uint i2=0; i2<players.length(); i2++){
if(players[i2].x==fogos[i].x&&players[i2].y<=fogos[i].y&&players[i2].map==fogos[i].map&&players[i2].suppressed_heat==false&&players[i2].is_admin()==false){
if(players[i2].map=="wizard_house"&&players[i2].y>=15||players[i2].map!="wizard_house"){
players[i2].lasthit="ondadefogo";
players[i2].health=-1;}
}
}
}
}
}
