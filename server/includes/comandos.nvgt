rat@[] rats;
class rat
{
bool y_up=true, y_down=true; // y_up: may follow UP the Y axis; y_down: may follow DOWN. false on either still allows X movement.
int x, y, sound_interval=2000;
uint shots=1;
int health_points=300;
string hit_by;
string map;
timer rat_timer, sound_timer;
timer shoot_time;
int rat_time=200;
bool flee_mode=false;
rat(int cx, int cy, string cmap)
{
x=cx;
y=cy;
map=cmap;
}
}
void rat_loop()
{
for(uint i=0; i<rats.length(); i++)
{
if(rats[i].health_points<=0){
send_packet(0,"play m_rato.ogg "+rats[i].x+" "+rats[i].y,rats[i].map);
string hitter=rats[i].hit_by;
send_reliable(0, "msg2 "+hitter+"; ;killed a; ;Mouse;!", 3);
int xx=get_player_index_from(hitter);
if(xx>-1){
players[xx].inv_add_item("rat_corpse", 1);
gain_xp(players[xx].charname, random(5, 10));
}
rats.remove_at(i);
break;
}
if(rats[i].sound_timer.elapsed>=rats[i].sound_interval+random(1000, 2000)){
rats[i].sound_timer.restart();
string ss="rato.ogg";
send_packet(0,"play "+ss+" "+rats[i].x+" "+rats[i].y,rats[i].map);
}
if(rats[i].rat_timer.elapsed>=rats[i].rat_time)
{
rats[i].rat_timer.restart();
for(uint i2=0; i2 < players.length(); i2++){
if(rats[i].y!=players[i2].y&&players[i2].jumping==0){
int _cd=climb_dir(rats[i].map, rats[i].x, rats[i].y, players[i2].x, players[i2].y, rats[i].y_up, rats[i].y_down);
if(_cd==3&&get_tile_at(rats[i].x, rats[i].y+1, rats[i].map)!=""&&string_contains(get_tile_at(rats[i].x, rats[i].y+1, rats[i].map), "wall", 1)<0){rats[i].y++;send_packet(0,"play "+get_tile_at(rats[i].x, rats[i].y, rats[i].map)+"step"+random(1, 5)+".ogg "+rats[i].x+" "+rats[i].y, rats[i].map);break;}
else if(_cd==4&&get_tile_at(rats[i].x, rats[i].y-1, rats[i].map)!=""&&string_contains(get_tile_at(rats[i].x, rats[i].y-1, rats[i].map), "wall", 1)<0){rats[i].y--;send_packet(0,"play "+get_tile_at(rats[i].x, rats[i].y, rats[i].map)+"step"+random(1, 5)+".ogg "+rats[i].x+" "+rats[i].y, rats[i].map);break;}
else if(_cd==1&&get_tile_at(rats[i].x-1, rats[i].y, rats[i].map)!=""&&string_contains(get_tile_at(rats[i].x-1, rats[i].y, rats[i].map), "wall", 1)<0){rats[i].x--;send_packet(0,"play "+get_tile_at(rats[i].x, rats[i].y, rats[i].map)+"step"+random(1, 5)+".ogg "+rats[i].x+" "+rats[i].y, rats[i].map);break;}
else if(_cd==2&&get_tile_at(rats[i].x+1, rats[i].y, rats[i].map)!=""&&string_contains(get_tile_at(rats[i].x+1, rats[i].y, rats[i].map), "wall", 1)<0){rats[i].x++;send_packet(0,"play "+get_tile_at(rats[i].x, rats[i].y, rats[i].map)+"step"+random(1, 5)+".ogg "+rats[i].x+" "+rats[i].y, rats[i].map);break;}
}
if(rats[i].x>players[i2].x+1&&players[i2].in_safe_zone==false&&players[i2].map==rats[i].map&&players[i2].newbie==false&&players[i2].afk==false){
rats[i].x--;
string ss=get_tile_at(rats[i].x, rats[i].y, rats[i].map);
send_packet(0,"play "+ss+" "+rats[i].x+" "+rats[i].y+" "+rats[i].map,rats[i].map);
rats[i].rat_timer.restart();
break;
}
else if(rats[i].x<players[i2].x-1&&players[i2].in_safe_zone==false&&rats[i].map==players[i2].map&&players[i2].afk==false&&players[i2].newbie==false){
rats[i].x++;
string ss=get_tile_at(rats[i].x, rats[i].y, rats[i].map);
send_packet(0,"play "+ss+" "+rats[i].x+" "+rats[i].y+" "+rats[i].map,rats[i].map);
rats[i].rat_timer.restart();
break;
}
if(get_rat_distance(rats[i], players[i2])>-1&&get_rat_distance(rats[i],players[i2])<=2&&players[i2].afk==false&&players[i2].newbie==false&&rats[i].shoot_time.elapsed>=1500&&rats[i].shots>0&&players[i2].in_safe_zone==false){
rats[i].shoot_time.restart();
send_packet(0,"play ratobater1.ogg "+rats[i].x+" "+rats[i].y+" "+rats[i].map,rats[i].map);
int sick_chance=random(1, 100);
if(sick_chance>60){
players[i2].health-=random(50, 100);
players[i2].sick+=random(1, 5);;
players[i2].tdoente2.restart();
send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
players[i2].lasthit="rato";
players[i2].tdoente2.restart();
rats[i].shots--;
break;
}
}
if(rats[i].shots<=0){
rats[i].shots=1;
rats[i].shoot_time.restart();
}
}
}
}
netloop();
}
void spawn_rat(int x, int y, string map){
if(!pvp)return;
rat c(x, y, map);
rats.insert_last(c);
}
