// kidnappers (sequestradors)
sequestrador@[] sequestradors;
class sequestrador
{
int x;
int y;
uint shots=30;
int health_points=5000;
string hit_by;
string map;
timer kidnapper_timer;
timer shoot_time;
int kidnapper_time=500;
sequestrador(int cx, int cy, string cmap)
{
x=cx;
y=cy;
map=cmap;
}
}
void kidnapper_loop()
{
for(uint i=0; i<sequestradors.length(); i++)
{

if(sequestradors[i].health_points<=0){
send_reliable(0, "msg2 "+sequestradors[i].hit_by+" ;Killed a kidnapper!", 3);
int xx=get_player_index_from(sequestradors[i].hit_by);
if(xx>-1){
players[xx].inv_add_item("kidnapper_corpse", 1);
}
spawn_obj(sequestradors[i].x, sequestradors[i].y, "m4a1", 1, sequestradors[i].map);
sequestradors.remove_at(i);
break;
}
if(sequestradors[i].kidnapper_timer.elapsed>=sequestradors[i].kidnapper_time)
{
for(uint i2=0; i2 < players.length(); i2++){
bool walked=false;
if(sequestradors[i].shots<=0){
sequestradors[i].shots=30;
sequestradors[i].shoot_time.restart();
send_packet(0,"play carregar_m4a1.ogg "+sequestradors[i].x+" "+sequestradors[i].y+" "+sequestradors[i].map,sequestradors[i].map);
}
if(get_kidnapper_distance(sequestradors[i], players[i2])>-1&&get_kidnapper_distance(sequestradors[i],players[i2])<=15&&players[i2].afk==false&&players[i2].newbie==false&&sequestradors[i].shoot_time.elapsed>=500&&players[i2].newbie==false&&sequestradors[i].shoot_time.elapsed>=500&&sequestradors[i].shots>0&&players[i2].in_safe_zone==false){
sequestradors[i].shoot_time.restart();
send_packet(0,"play m4a1.ogg "+sequestradors[i].x+" "+sequestradors[i].y+" "+sequestradors[i].map,sequestradors[i].map);
int r=reflect_damage(i2, "sequestrador", sequestradors[i].x, sequestradors[i].y, random(50, 100));
if(r>0){sequestradors[i].health_points-=r;sequestradors[i].hit_by=players[i2].charname;break;}
players[i2].health-=random(50, 100);
send_packet(0,"inithurt "+players[i2].charname+" "+players[i2].x+" "+players[i2].y+" "+players[i2].voice+" "+players[i2].pitch+" "+players[i2].map,players[i2].map);
players[i2].lasthit="sequestrador";
sequestradors[i].shots--;
walked=true;
break;
}
if(sequestradors[i].x>players[i2].x+3&&players[i2].in_safe_zone==false&&players[i2].map==sequestradors[i].map&&players[i2].newbie==false&&players[i2].afk==false&&walked==false){
sequestradors[i].x--;
string ss=get_tile_at(sequestradors[i].x, sequestradors[i].y, sequestradors[i].map);
send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+sequestradors[i].x+" "+sequestradors[i].y+" "+sequestradors[i].map,sequestradors[i].map);
sequestradors[i].kidnapper_timer.restart();
walked=true;
}
else if(sequestradors[i].x<players[i2].x-3&&players[i2].in_safe_zone==false&&sequestradors[i].map==players[i2].map&&players[i2].afk==false&&players[i2].newbie==false&&walked==false){
sequestradors[i].x++;
string ss=get_tile_at(sequestradors[i].x, sequestradors[i].y, sequestradors[i].map);
send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+sequestradors[i].x+" "+sequestradors[i].y+" "+sequestradors[i].map,sequestradors[i].map);
sequestradors[i].kidnapper_timer.restart();
walked=true;
}
else if(sequestradors[i].y>players[i2].y+3&&sequestradors[i].map==players[i2].map&&players[i2].afk==false&&players[i2].newbie==false&&players[i2].in_safe_zone==false&&walked==false){
sequestradors[i].y--;
string ss=get_tile_at(sequestradors[i].x, sequestradors[i].y, sequestradors[i].map);
send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+sequestradors[i].x+" "+sequestradors[i].y+" "+sequestradors[i].map,sequestradors[i].map);
sequestradors[i].kidnapper_timer.restart();
walked=true;
}
else if(sequestradors[i].y<players[i2].y-3&&sequestradors[i].map==players[i2].map&&players[i2].afk==false&&players[i2].newbie==false&&players[i2].in_safe_zone==false&&walked==false){
sequestradors[i].y++;
string ss=get_tile_at(sequestradors[i].x, sequestradors[i].y, sequestradors[i].map);
send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+sequestradors[i].x+" "+sequestradors[i].y+" "+sequestradors[i].map,sequestradors[i].map);
sequestradors[i].kidnapper_timer.restart();
walked=true;
}
}
}
}
}
