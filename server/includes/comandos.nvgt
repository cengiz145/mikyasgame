players[xx].inv_add_item("kidnapper_corpse", 1, false);
players[xx].inv_add_item(sequestrador2s[i].tipoarma[sequestrador2s[i].narma], 1);
}
sequestrador2s.remove_at(i);
has_left=1;
return;
}
if(has_left==1)break;
else if(sequestrador2s[i].died==0&&sequestrador2s[i].health_points<=0){
send_packet(0, "play v1morte1.ogg "+sequestrador2s[i].x+" "+sequestrador2s[i].y, sequestrador2s[i].map_data);
sequestrador2s[i].tmorreu.restart();
sequestrador2s[i].died=1;
}
/*
if(sequestrador2s[i].tsom.elapsed>=sequestrador2s[i].nsom&&sequestrador2s[i].morrendo==0&&sequestrador2s[i].morreu==0){
sequestrador2s[i].nsom=random(2000, 6200);
send_packet(0, "play sequestrador2"+random(1, 2)+".ogg "+sequestrador2s[i].x+" "+sequestrador2s[i].y, sequestrador2s[i].mapa);
sequestrador2s[i].tsom.restart();
}
*/
if(has_left==1)break;
int walk=1;
if(sequestrador2s[i].tatirar.elapsed>=sequestrador2s[i].natirar&&sequestrador2s[i].died==0){
sequestrador2s[i].tatirar.restart();
int i2=get_player_index_from(sequestrador2s[i].njogador);
if(i2>-1){
if(players[i2].peaceful==1||get_safezone_at(players[i2].x, players[i2].y, players[i2].map)==true||players[i2].afk||players[i2].map!=sequestrador2s[i].map_data)i2=-1;
}
if(i2<0)sequestrador2s[i].njogador=select_player_menu(sequestrador2s[i].map_data);
i2=get_player_index_from(sequestrador2s[i].njogador);
if(i2>-1){
if(players[i2].peaceful==1||get_safezone_at(players[i2].x, players[i2].y, players[i2].map)==true||players[i2].afk||players[i2].map!=sequestrador2s[i].map_data)i2=-1;
}
if(i2<0)break;
if(g_kidnapper2(sequestrador2s[i], players[i2])>-1&&g_kidnapper2(sequestrador2s[i], players[i2])<=sequestrador2s[i].ndist&&players[i2].afk==false&&players[i2].peaceful==0&&get_safezone_at(players[i2].x,
players[i2].y,players[i2].map)==false){
walk=0;
send_reliable(0, "play "+sequestrador2s[i].tipoarma[sequestrador2s[i].narma]+".ogg "+sequestrador2s[i].x+" "+sequestrador2s[i].y, 0);
send_packet(0, "play "+sequestrador2s[i].tipoarma[sequestrador2s[i].narma]+".ogg "+sequestrador2s[i].x+" "+sequestrador2s[i].y, sequestrador2s[i].map_data);
players[i2].health-=sequestrador2s[i].ndano;
players[i2].lasthit="sequestrador";
send_packet(0, "play body"+random(1, 7)+".ogg "+players[i2].x+" "+players[i2].y, players[i2].map);
break;
}
}
if(sequestrador2s[i].walk_timer.elapsed>=210&&sequestrador2s[i].morrendo==0&&sequestrador2s[i].died==0&&walk==1&&sequestrador2s[i].narma<3){
sequestrador2s[i].walk_timer.restart();
int i2=get_player_index_from(sequestrador2s[i].njogador);
if(i2>-1){
if(players[i2].peaceful==1||get_safezone_at(players[i2].x, players[i2].y, players[i2].map)==true||players[i2].afk||players[i2].map!=sequestrador2s[i].map_data)i2=-1;
}
if(i2<0)sequestrador2s[i].njogador=select_player_menu(sequestrador2s[i].map_data);
i2=get_player_index_from(sequestrador2s[i].njogador);
if(i2>-1){
if(players[i2].peaceful==1||get_safezone_at(players[i2].x, players[i2].y, players[i2].map)==true||players[i2].afk||players[i2].map!=sequestrador2s[i].map_data)i2=-1;
}
if(i2<0)break;
if(sequestrador2s[i].y!=players[i2].y&&players[i2].jumping==0){
int _cd=climb_dir(sequestrador2s[i].map_data, sequestrador2s[i].x, sequestrador2s[i].y, players[i2].x, players[i2].y, sequestrador2s[i].y_up, sequestrador2s[i].y_down);
if(_cd==3&&get_tile_at(sequestrador2s[i].x, sequestrador2s[i].y+1, sequestrador2s[i].map_data)!=""&&string_contains(get_tile_at(sequestrador2s[i].x, sequestrador2s[i].y+1, sequestrador2s[i].map_data), "wall", 1)<0){sequestrador2s[i].y++;send_packet(0,"play "+get_tile_at(sequestrador2s[i].x, sequestrador2s[i].y, sequestrador2s[i].map_data)+"step"+random(1, 5)+".ogg "+sequestrador2s[i].x+" "+sequestrador2s[i].y, sequestrador2s[i].map_data);break;}
else if(_cd==4&&get_tile_at(sequestrador2s[i].x, sequestrador2s[i].y-1, sequestrador2s[i].map_data)!=""&&string_contains(get_tile_at(sequestrador2s[i].x, sequestrador2s[i].y-1, sequestrador2s[i].map_data), "wall", 1)<0){sequestrador2s[i].y--;send_packet(0,"play "+get_tile_at(sequestrador2s[i].x, sequestrador2s[i].y, sequestrador2s[i].map_data)+"step"+random(1, 5)+".ogg "+sequestrador2s[i].x+" "+sequestrador2s[i].y, sequestrador2s[i].map_data);break;}
else if(_cd==1&&get_tile_at(sequestrador2s[i].x-1, sequestrador2s[i].y, sequestrador2s[i].map_data)!=""&&string_contains(get_tile_at(sequestrador2s[i].x-1, sequestrador2s[i].y, sequestrador2s[i].map_data), "wall", 1)<0){sequestrador2s[i].x--;send_packet(0,"play "+get_tile_at(sequestrador2s[i].x, sequestrador2s[i].y, sequestrador2s[i].map_data)+"step"+random(1, 5)+".ogg "+sequestrador2s[i].x+" "+sequestrador2s[i].y, sequestrador2s[i].map_data);break;}
else if(_cd==2&&get_tile_at(sequestrador2s[i].x+1, sequestrador2s[i].y, sequestrador2s[i].map_data)!=""&&string_contains(get_tile_at(sequestrador2s[i].x+1, sequestrador2s[i].y, sequestrador2s[i].map_data), "wall", 1)<0){sequestrador2s[i].x++;send_packet(0,"play "+get_tile_at(sequestrador2s[i].x, sequestrador2s[i].y, sequestrador2s[i].map_data)+"step"+random(1, 5)+".ogg "+sequestrador2s[i].x+" "+sequestrador2s[i].y, sequestrador2s[i].map_data);break;}
}
if(sequestrador2s[i].x>players[i2].x-1&&!players[i2].afk&&string_contains(get_tile_at(sequestrador2s[i].x-1, sequestrador2s[i].y, sequestrador2s[i].map_data), "wall", 1)<0&&walk==1){
sequestrador2s[i].x--;
send_packet(0, "play "+get_tile_at(sequestrador2s[i].x, sequestrador2s[i].y, sequestrador2s[i].map_data)+"step"+random(1, 5)+".ogg "+sequestrador2s[i].x+" "+sequestrador2s[i].y, sequestrador2s[i].map_data);
walk=0;
break;
}
else if(sequestrador2s[i].x<players[i2].x+1&&!players[i2].afk&&string_contains(get_tile_at(sequestrador2s[i].x+1, sequestrador2s[i].y, sequestrador2s[i].map_data), "wall", 1)<0&&walk==1){
sequestrador2s[i].x++;
send_packet(0, "play "+get_tile_at(sequestrador2s[i].x, sequestrador2s[i].y, sequestrador2s[i].map_data)+"step"+random(1, 5)+".ogg "+sequestrador2s[i].x+" "+sequestrador2s[i].y, sequestrador2s[i].map_data);
walk=0;
break;
}
}
for(uint i2=0;i2<players.length();i2++){
if(players[i2].map==sequestrador2s[i].map_data&&players[i2].afk==false&&players[i2].peaceful==0&&g_kidnapper2(sequestrador2s[i], players[i2])>-1&&g_kidnapper2(sequestrador2s[i], players[i2])<=sequestrador2s[i].ndist){
sequestrador2s[i].njogador=players[i2].charname;
break;
}
}
}
}
