}
robo_coletores.remove_at(i);
break;
}
if(robo_coletores[i].sound_timer.elapsed>=robo_coletores[i].no_sound&&robo_coletores[i].morrendo==0&&robo_coletores[i].died==0){
robo_coletores[i].no_sound=random(2000, 6200);
