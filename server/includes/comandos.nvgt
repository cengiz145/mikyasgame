// Atomic bomb
atomic_bomb@[] atomic_bombs;
class atomic_bomb{
int x, y;
string map, char_name_nome;
timer atomic_bomb_timer;
int atomic_bomb_time=60000;
atomic_bomb(int cx, int cy, string cmap, string cname){
x=cx;
y=cy;
map=cmap;
char_name_nome=cname;
}
}
void atomic_bomb_loop(){
for(uint i=0; i<atomic_bombs.length(); i++){
if(atomic_bombs[i].atomic_bomb_timer.elapsed>=atomic_bombs[i].atomic_bomb_time){
send_packet(0,"play bombaatomicaexplode.ogg "+atomic_bombs[i].x+" "+atomic_bombs[i].y+" "+atomic_bombs[i].map,atomic_bombs[i].map);
for(uint i2=0; i2 < players.length(); i2++){
if(players[i2].map==atomic_bombs[i].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false){
players[i2].health=0;
players[i2].lasthit="bombaatomica_"+atomic_bombs[i].char_name_nome;
wait(5);
}
}
for(uint i3=0; i3<objs.length(); i3++){
if(atomic_bombs[i].map==objs[i3].map){
objs[i3].obtainable=false;
objs[i3].delete=true;
obj_loop();
}
}
file f;
f.open("maps/"+atomic_bombs[i].map+".map", "r");
string mdata=f.read();
f.close();
string[] p1=delinear(mdata);
for(uint ii=0; ii<p1.length(); ii++){
string[] parsed=string_split(p1[ii], ":", true);
if(parsed[0]=="travelpoint"&&parsed.length()>8){
string newmap=parsed[7];
for(uint i2=0; i2 < players.length(); i2++){
if(players[i2].map==newmap&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false){
players[i2].health=0;
players[i2].lasthit="bombaatomica_"+atomic_bombs[i].char_name_nome;
}
}
for(uint i3=0; i3<objs.length(); i3++){
if(newmap==objs[i3].map){
objs[i3].obtainable=false;
objs[i3].delete=true;
obj_loop();
}
}
}
}
atomic_bombs.remove_at(i);
}
}
}
void spawn_atomic_bomb(int x, int y, string map, string char_name_nome){
if(!pvp)return;
atomic_bomb c(x, y, map, char_name_nome);
atomic_bombs.insert_last(c);
send_packet(0,"play atomicaativada.ogg "+x+" "+y+" "+map,map);
}
