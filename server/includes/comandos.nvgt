string hit_by;
string map;
timer dog_timer;
timer shoot_time;
timer sound_timer;
int sound_interval=4000;
int dog_time=290;
attack_dog(int cx, int cy, string cmap)
{
x=cx;
y=cy;
map=cmap;
}
}
void dog_loop()
{
for(uint i=0; i<attack_dogs.length(); i++){
if(attack_dogs[i].health_points<=0){
uint total=0;
send_packet(0,"play animales_cachorro_morreu.ogg "+attack_dogs[i].x+" "+attack_dogs[i].y+" "+attack_dogs[i].map,attack_dogs[i].map);
string hitter=attack_dogs[i].hit_by;
if(string_contains(hitter, "magnet_", 1)>-1){
hitter=string_replace(hitter, "magnet_", "", true);
send_reliable(0, "msg2 one; ;Dog; ;morreu no; ;Magnetic_item; ;From; ;"+hitter+";!", 3);
}
else{
send_reliable(0, "msg2 "+hitter+"; ;killed a; ;Dog;!", 3);
}
int xx=get_player_index_from(hitter);
if(xx>-1){
players[xx].inv_add_item("dog_corpse", 1);
gain_xp(players[xx].charname, random(100, 200));
}
attack_dogs.remove_at(i);
break;
}
if(attack_dogs[i].sound_timer.elapsed>=attack_dogs[i].sound_interval+random(1000, 3200)){
attack_dogs[i].sound_timer.restart();
string ss="animales_cachorronervoso"+random(1, 5)+".ogg";
send_packet(0,"play "+ss+" "+attack_dogs[i].x+" "+attack_dogs[i].y+" "+attack_dogs[i].map,attack_dogs[i].map);
}
if(attack_dogs[i].dog_timer.elapsed>=attack_dogs[i].dog_time)
{
attack_dogs[i].dog_timer.restart();
for(uint i2=0; i2 < players.length(); i2++){
if(attack_dogs[i].y!=players[i2].y&&players[i2].jumping==0){
int _cd=climb_dir(attack_dogs[i].map, attack_dogs[i].x, attack_dogs[i].y, players[i2].x, players[i2].y, attack_dogs[i].y_up, attack_dogs[i].y_down);
if(_cd==3&&get_tile_at(attack_dogs[i].x, attack_dogs[i].y+1, attack_dogs[i].map)!=""&&string_contains(get_tile_at(attack_dogs[i].x, attack_dogs[i].y+1, attack_dogs[i].map), "wall", 1)<0){attack_dogs[i].y++;send_packet(0,"play "+get_tile_at(attack_dogs[i].x, attack_dogs[i].y, attack_dogs[i].map)+"step"+random(1, 5)+".ogg "+attack_dogs[i].x+" "+attack_dogs[i].y, attack_dogs[i].map);break;}
else if(_cd==4&&get_tile_at(attack_dogs[i].x, attack_dogs[i].y-1, attack_dogs[i].map)!=""&&string_contains(get_tile_at(attack_dogs[i].x, attack_dogs[i].y-1, attack_dogs[i].map), "wall", 1)<0){attack_dogs[i].y--;send_packet(0,"play "+get_tile_at(attack_dogs[i].x, attack_dogs[i].y, attack_dogs[i].map)+"step"+random(1, 5)+".ogg "+attack_dogs[i].x+" "+attack_dogs[i].y, attack_dogs[i].map);break;}
else if(_cd==1&&get_tile_at(attack_dogs[i].x-1, attack_dogs[i].y, attack_dogs[i].map)!=""&&string_contains(get_tile_at(attack_dogs[i].x-1, attack_dogs[i].y, attack_dogs[i].map), "wall", 1)<0){attack_dogs[i].x--;send_packet(0,"play "+get_tile_at(attack_dogs[i].x, attack_dogs[i].y, attack_dogs[i].map)+"step"+random(1, 5)+".ogg "+attack_dogs[i].x+" "+attack_dogs[i].y, attack_dogs[i].map);break;}
else if(_cd==2&&get_tile_at(attack_dogs[i].x+1, attack_dogs[i].y, attack_dogs[i].map)!=""&&string_contains(get_tile_at(attack_dogs[i].x+1, attack_dogs[i].y, attack_dogs[i].map), "wall", 1)<0){attack_dogs[i].x++;send_packet(0,"play "+get_tile_at(attack_dogs[i].x, attack_dogs[i].y, attack_dogs[i].map)+"step"+random(1, 5)+".ogg "+attack_dogs[i].x+" "+attack_dogs[i].y, attack_dogs[i].map);break;}
}
if(attack_dogs[i].x>players[i2].x+2&&players[i2].in_safe_zone==false&&players[i2].map==attack_dogs[i].map&&players[i2].newbie==false&&players[i2].afk==false&&players[i2].peaceful==0){
attack_dogs[i].x-=2;
string ss=get_tile_at(attack_dogs[i].x, attack_dogs[i].y, attack_dogs[i].map);
send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+attack_dogs[i].x+" "+attack_dogs[i].y+" "+attack_dogs[i].map,attack_dogs[i].map);
attack_dogs[i].dog_timer.restart();
break;
}
else if(attack_dogs[i].x<players[i2].x-2&&players[i2].in_safe_zone==false&&attack_dogs[i].map==players[i2].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false){
attack_dogs[i].x+=2;
string ss=get_tile_at(attack_dogs[i].x, attack_dogs[i].y, attack_dogs[i].map);
send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+attack_dogs[i].x+" "+attack_dogs[i].y+" "+attack_dogs[i].map,attack_dogs[i].map);
attack_dogs[i].dog_timer.restart();
break;
}
if(get_dog_distance(attack_dogs[i], players[i2])>-1&&get_dog_distance(attack_dogs[i],players[i2])<=2&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&attack_dogs[i].shoot_time.elapsed>=500&&attack_dogs[i].shots>0){
attack_dogs[i].shoot_time.restart();
send_packet(0,"play animales_cachorrobater.ogg "+attack_dogs[i].x+" "+attack_dogs[i].y+" "+attack_dogs[i].map,attack_dogs[i].map);
int r=reflect_damage(i2, "cachorro", attack_dogs[i].x, attack_dogs[i].y, random(300, 500));
if(r>0){attack_dogs[i].health_points-=r;attack_dogs[i].hit_by=players[i2].charname;break;}
players[i2].health-=random(300, 500);
send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
players[i2].lasthit="cachorro";
attack_dogs[i].shots--;
break;
}
if(attack_dogs[i].shots<=0){
attack_dogs[i].shots=1;
attack_dogs[i].shoot_time.restart();
}
}
}
}
netloop();
}
