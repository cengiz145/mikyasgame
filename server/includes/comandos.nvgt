else if(_cd==1&&get_tile_at(monkeys[i].x-1, monkeys[i].y, monkeys[i].map)!=""&&string_contains(get_tile_at(monkeys[i].x-1, monkeys[i].y, monkeys[i].map), "wall", 1)<0){monkeys[i].x--;send_packet(0,"play "+get_tile_at(monkeys[i].x, monkeys[i].y, monkeys[i].map)+"step"+random(1, 5)+".ogg "+monkeys[i].x+" "+monkeys[i].y, monkeys[i].map);break;}
else if(_cd==2&&get_tile_at(monkeys[i].x+1, monkeys[i].y, monkeys[i].map)!=""&&string_contains(get_tile_at(monkeys[i].x+1, monkeys[i].y, monkeys[i].map), "wall", 1)<0){monkeys[i].x++;send_packet(0,"play "+get_tile_at(monkeys[i].x, monkeys[i].y, monkeys[i].map)+"step"+random(1, 5)+".ogg "+monkeys[i].x+" "+monkeys[i].y, monkeys[i].map);break;}
}
if(monkeys[i].x>players[i2].x+1&&players[i2].in_safe_zone==false&&players[i2].map==monkeys[i].map&&players[i2].newbie==false&&players[i2].afk==false&&players[i2].peaceful==0&&monkeys[i].flee_mode==false){
