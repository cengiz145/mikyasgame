megadragonsauro@[] megadragonsauros;
class megadragonsauro
{
bool y_up=true, y_down=true; // y_up: may follow UP the Y axis; y_down: may follow DOWN. false on either still allows X movement.
int x;
int y;
uint shots=1;
int health_points;
string hit_by;
string map;
timer megadragonsaur_timer, tbotar;
timer shoot_time;
timer sound_timer;
int sound_interval=4000;
int megadragonsaur_time=700;
bool flee_mode=false;
megadragonsauro(int cx, int cy, string cmap, int cvida){
x=cx;
y=cy;
map=cmap;
health_points=cvida;
}
}
void megadragonsaur_loop()
{
for(uint i=0; i<megadragonsauros.length(); i++)
{
if(megadragonsauros[i].health_points<=0){
uint total=0;
send_packet(0,"play m_dragonsauro.ogg "+megadragonsauros[i].x+" "+megadragonsauros[i].y+" "+megadragonsauros[i].map,megadragonsauros[i].map);
string hitter=megadragonsauros[i].hit_by;
send_reliable(0, "msg2 "+hitter+"; ;killed a; ;mega;dragonsaur;!", 3);
int xx=get_player_index_from(hitter);
if(xx>-1){
players[xx].inv_add_item("megadragonsaurus_corpse", 1);
gain_xp(players[xx].charname, random(5000, 8000), random(2000000, 3000000));
}
megadragonsauros.remove_at(i);
break;
}
if(megadragonsauros[i].sound_timer.elapsed>=megadragonsauros[i].sound_interval+random(1000, 2000)){
megadragonsauros[i].sound_timer.restart();
string ss="dragonsauro"+random(1, 3)+".ogg";
send_packet(0,"play "+ss+" "+megadragonsauros[i].x+" "+megadragonsauros[i].y+" "+megadragonsauros[i].map,megadragonsauros[i].map);
}
if(megadragonsauros[i].shots<=0){
megadragonsauros[i].shots=1;
megadragonsauros[i].shoot_time.restart();
}
if(megadragonsauros[i].megadragonsaur_timer.elapsed>=megadragonsauros[i].megadragonsaur_time)
{
megadragonsauros[i].megadragonsaur_timer.restart();
int has_moved=0;
for(uint i2=0; i2 < players.length(); i2++){
if(get_megadragonsaur_distance(megadragonsauros[i], players[i2])>-1&&get_megadragonsaur_distance(megadragonsauros[i],players[i2])<=7&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&megadragonsauros[i].shoot_time.elapsed>=500&&megadragonsauros[i].shots>0){
has_moved=1;
megadragonsauros[i].shoot_time.restart();
send_packet(0,"play dragonsaurobater.ogg "+megadragonsauros[i].x+" "+megadragonsauros[i].y+" "+megadragonsauros[i].map,megadragonsauros[i].map);
int r=reflect_damage(i2, "dragonsauro", megadragonsauros[i].x, megadragonsauros[i].y, random(800, 2800));
if(r>0){megadragonsauros[i].health_points-=r;megadragonsauros[i].hit_by=players[i2].charname;break;}
players[i2].health-=random(800, 2800);
send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
players[i2].lasthit="megadragonsauro";
megadragonsauros[i].shots--;
return;
}
if(megadragonsauros[i].y!=players[i2].y&&players[i2].jumping==0){
int _cd=climb_dir(megadragonsauros[i].map, megadragonsauros[i].x, megadragonsauros[i].y, players[i2].x, players[i2].y, megadragonsauros[i].y_up, megadragonsauros[i].y_down);
if(_cd==3&&get_tile_at(megadragonsauros[i].x, megadragonsauros[i].y+1, megadragonsauros[i].map)!=""&&string_contains(get_tile_at(megadragonsauros[i].x, megadragonsauros[i].y+1, megadragonsauros[i].map), "wall", 1)<0){megadragonsauros[i].y++;send_packet(0,"play "+get_tile_at(megadragonsauros[i].x, megadragonsauros[i].y, megadragonsauros[i].map)+"step"+random(1, 5)+".ogg "+megadragonsauros[i].x+" "+megadragonsauros[i].y, megadragonsauros[i].map);break;}
else if(_cd==4&&get_tile_at(megadragonsauros[i].x, megadragonsauros[i].y-1, megadragonsauros[i].map)!=""&&string_contains(get_tile_at(megadragonsauros[i].x, megadragonsauros[i].y-1, megadragonsauros[i].map), "wall", 1)<0){megadragonsauros[i].y--;send_packet(0,"play "+get_tile_at(megadragonsauros[i].x, megadragonsauros[i].y, megadragonsauros[i].map)+"step"+random(1, 5)+".ogg "+megadragonsauros[i].x+" "+megadragonsauros[i].y, megadragonsauros[i].map);break;}
else if(_cd==1&&get_tile_at(megadragonsauros[i].x-1, megadragonsauros[i].y, megadragonsauros[i].map)!=""&&string_contains(get_tile_at(megadragonsauros[i].x-1, megadragonsauros[i].y, megadragonsauros[i].map), "wall", 1)<0){megadragonsauros[i].x--;send_packet(0,"play "+get_tile_at(megadragonsauros[i].x, megadragonsauros[i].y, megadragonsauros[i].map)+"step"+random(1, 5)+".ogg "+megadragonsauros[i].x+" "+megadragonsauros[i].y, megadragonsauros[i].map);break;}
else if(_cd==2&&get_tile_at(megadragonsauros[i].x+1, megadragonsauros[i].y, megadragonsauros[i].map)!=""&&string_contains(get_tile_at(megadragonsauros[i].x+1, megadragonsauros[i].y, megadragonsauros[i].map), "wall", 1)<0){megadragonsauros[i].x++;send_packet(0,"play "+get_tile_at(megadragonsauros[i].x, megadragonsauros[i].y, megadragonsauros[i].map)+"step"+random(1, 5)+".ogg "+megadragonsauros[i].x+" "+megadragonsauros[i].y, megadragonsauros[i].map);break;}
}
if(megadragonsauros[i].x>players[i2].x+3&&players[i2].in_safe_zone==false&&players[i2].map==megadragonsauros[i].map&&players[i2].newbie==false&&players[i2].afk==false&&players[i2].peaceful==0&&megadragonsauros[i].flee_mode==false&&has_moved==0){
has_moved=1;
megadragonsauros[i].x--;
string ss=get_tile_at(megadragonsauros[i].x, megadragonsauros[i].y, megadragonsauros[i].map);
send_packet(0,"play "+ss+" "+megadragonsauros[i].x+" "+megadragonsauros[i].y+" "+megadragonsauros[i].map,megadragonsauros[i].map);
megadragonsauros[i].megadragonsaur_timer.restart();
}
else if(megadragonsauros[i].x<players[i2].x-3&&players[i2].in_safe_zone==false&&megadragonsauros[i].map==players[i2].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&megadragonsauros[i].flee_mode==false&&has_moved==0){
has_moved=1;
megadragonsauros[i].x++;
string ss=get_tile_at(megadragonsauros[i].x, megadragonsauros[i].y, megadragonsauros[i].map);
send_packet(0,"play "+ss+" "+megadragonsauros[i].x+" "+megadragonsauros[i].y+" "+megadragonsauros[i].map,megadragonsauros[i].map);
megadragonsauros[i].megadragonsaur_timer.restart();
}
}
}
}
netloop();
}
