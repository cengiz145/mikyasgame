fire_bombs[i].enabled=true;
send_packet(0, "play bombadefogoexplode.ogg "+fire_bombs[i].x+" "+fire_bombs[i].y, fire_bombs[i].map);
fire_bombs[i].spa=spawn_splay("boladefogo.ogg", fire_bombs[i].map);
