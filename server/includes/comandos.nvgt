int xx=get_player_index_from(hitter);
if(xx>-1){
players[xx].inv_add_item("rabbit_fur", 1);
gain_xp(players[xx].charname, random(10, 20), random(100, 500));
}
rabbits.remove_at(i);
break;
}
if(rabbits[i].sound_timer.elapsed>=rabbits[i].no_sound&&rabbits[i].morrendo==0&&rabbits[i].died==0){
rabbits[i].no_sound=random(800, 2300);
send_packet(0, "play coelho"+random(1, 2)+".ogg "+rabbits[i].x+" "+rabbits[i].y, rabbits[i].map_data);
rabbits[i].sound_timer.restart();
}
if(rabbits[i].walk_timer.elapsed>=130&&rabbits[i].morrendo==0&&rabbits[i].died==0){
rabbits[i].walk_timer.restart();
int i2=get_player_index_from(rabbits[i].njogador);
if(i2>-1){
if(players[i2].afk||players[i2].map!=rabbits[i].map_data)i2=-1;
}
if(i2<0)rabbits[i].njogador=select_player_menu(rabbits[i].map_data);
i2=get_player_index_from(rabbits[i].njogador);
if(i2>-1){
if(players[i2].afk||players[i2].map!=rabbits[i].map_data)i2=-1;
}
if(i2<0)break;
int walk=1;
if(rabbits[i].y!=players[i2].y&&players[i2].jumping==0){
int _cd=climb_dir(rabbits[i].map_data, rabbits[i].x, rabbits[i].y, players[i2].x, players[i2].y, rabbits[i].y_up, rabbits[i].y_down);
if(_cd==3&&get_tile_at(rabbits[i].x, rabbits[i].y+1, rabbits[i].map_data)!=""&&string_contains(get_tile_at(rabbits[i].x, rabbits[i].y+1, rabbits[i].map_data), "wall", 1)<0){rabbits[i].y++;send_packet(0,"play "+get_tile_at(rabbits[i].x, rabbits[i].y, rabbits[i].map_data)+"step"+random(1, 5)+".ogg "+rabbits[i].x+" "+rabbits[i].y, rabbits[i].map_data);break;}
else if(_cd==4&&get_tile_at(rabbits[i].x, rabbits[i].y-1, rabbits[i].map_data)!=""&&string_contains(get_tile_at(rabbits[i].x, rabbits[i].y-1, rabbits[i].map_data), "wall", 1)<0){rabbits[i].y--;send_packet(0,"play "+get_tile_at(rabbits[i].x, rabbits[i].y, rabbits[i].map_data)+"step"+random(1, 5)+".ogg "+rabbits[i].x+" "+rabbits[i].y, rabbits[i].map_data);break;}
else if(_cd==1&&get_tile_at(rabbits[i].x-1, rabbits[i].y, rabbits[i].map_data)!=""&&string_contains(get_tile_at(rabbits[i].x-1, rabbits[i].y, rabbits[i].map_data), "wall", 1)<0){rabbits[i].x--;send_packet(0,"play "+get_tile_at(rabbits[i].x, rabbits[i].y, rabbits[i].map_data)+"step"+random(1, 5)+".ogg "+rabbits[i].x+" "+rabbits[i].y, rabbits[i].map_data);break;}
else if(_cd==2&&get_tile_at(rabbits[i].x+1, rabbits[i].y, rabbits[i].map_data)!=""&&string_contains(get_tile_at(rabbits[i].x+1, rabbits[i].y, rabbits[i].map_data), "wall", 1)<0){rabbits[i].x++;send_packet(0,"play "+get_tile_at(rabbits[i].x, rabbits[i].y, rabbits[i].map_data)+"step"+random(1, 5)+".ogg "+rabbits[i].x+" "+rabbits[i].y, rabbits[i].map_data);break;}
}
if(rabbits[i].x>players[i2].x-1&&!players[i2].afk&&string_contains(get_tile_at(rabbits[i].x-1, rabbits[i].y, rabbits[i].map_data), "wall", 1)<0&&walk==1){
rabbits[i].x--;
//send_packet(0, "play "+get_tile_at(coelhos[i].x, coelhos[i].y, coelhos[i].mapa)+"step"+random(1, 5)+".ogg "+coelhos[i].x+" "+coelhos[i].y, coelhos[i].mapa);
walk=0;
break;
}
else if(rabbits[i].x<players[i2].x+1&&!players[i2].afk&&string_contains(get_tile_at(rabbits[i].x+1, rabbits[i].y, rabbits[i].map_data), "wall", 1)<0&&walk==1){
rabbits[i].x++;
//send_packet(0, "play "+get_tile_at(coelhos[i].x, coelhos[i].y, coelhos[i].mapa)+"step"+random(1, 5)+".ogg "+coelhos[i].x+" "+coelhos[i].y, coelhos[i].mapa);
walk=0;
break;
}
}
}
