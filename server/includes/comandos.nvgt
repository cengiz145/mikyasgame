players[i2].lasthit="macaco";
monkeys[i].shots--;
break;
}
if(monkeys[i].shots<=0){
monkeys[i].shots=1;
monkeys[i].shoot_time.restart();
}
}
for(uint za=0;za<objs.length();za++){
if(monkeys[i].map==objs[za].map&&monkeys[i].y<objs[za].y){
if(objs[za].item=="banana"||objs[za].item=="Apple"||objs[za].item=="fig"||objs[za].item=="strawberry"||objs[za].item=="guava"||objs[za].item=="pear"||objs[za].item=="jabuticaba"||objs[za].item=="persimmon"||objs[za].item=="blackberry"){
