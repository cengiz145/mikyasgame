// wolf
wolf@[] wolves;
class wolf
{
bool y_up=true, y_down=true; // y_up: may follow UP the Y axis; y_down: may follow DOWN. false on either still allows X movement.
int x, y, ladoandar=2;
uint shots=1;
int health_points=random(3000, 3300);
string hit_by;
string map;
timer wolf_timer;
timer shoot_time;
timer sound_timer;
int sound_interval=4000;
int wolf_time=290;
wolf(int cx, int cy, string cmap)
{
x=cx;
y=cy;
map=cmap;
}
}
void wolf_loop()
{
for(uint i=0; i<wolves.length(); i++)
{
if(wolves[i].health_points<=0){
uint total=0;
send_packet(0,"play m_lobo.ogg "+wolves[i].x+" "+wolves[i].y+" "+wolves[i].map,wolves[i].map);
string hitter=wolves[i].hit_by;
if(string_contains(hitter, "magnet_", 1)>-1){
hitter=string_replace(hitter, "magnet_", "", true);
send_reliable(0, "msg2 one; ;lobo ;morreu no; ;Magnetic_item; ;From; ;"+hitter+";!", 3);
}
else{
send_reliable(0, "msg2 "+hitter+"; ;killed a; ;lobo;!", 3);
}
int xx=get_player_index_from(hitter);
if(xx>-1){
players[xx].inv_add_item("wolf_corpse", 1);
gain_xp(players[xx].charname, random(20, 30));
}
wolves.remove_at(i);
break;
}
if(wolves[i].sound_timer.elapsed>=wolves[i].sound_interval+random(1000, 3200)){
wolves[i].sound_timer.restart();
string ss="lobonervoso"+random(1, 5)+".ogg";
send_packet(0,"play "+ss+" "+wolves[i].x+" "+wolves[i].y+" "+wolves[i].map,wolves[i].map);
}
if(wolves[i].wolf_timer.elapsed>=wolves[i].wolf_time)
{
wolves[i].wolf_timer.restart();
for(uint i2=0; i2 < players.length(); i2++){
if(wolves[i].y!=players[i2].y&&players[i2].jumping==0){
int _cd=climb_dir(wolves[i].map, wolves[i].x, wolves[i].y, players[i2].x, players[i2].y, wolves[i].y_up, wolves[i].y_down);
if(_cd==3&&get_tile_at(wolves[i].x, wolves[i].y+1, wolves[i].map)!=""&&string_contains(get_tile_at(wolves[i].x, wolves[i].y+1, wolves[i].map), "wall", 1)<0){wolves[i].y++;send_packet(0,"play "+get_tile_at(wolves[i].x, wolves[i].y, wolves[i].map)+"step"+random(1, 5)+".ogg "+wolves[i].x+" "+wolves[i].y, wolves[i].map);break;}
else if(_cd==4&&get_tile_at(wolves[i].x, wolves[i].y-1, wolves[i].map)!=""&&string_contains(get_tile_at(wolves[i].x, wolves[i].y-1, wolves[i].map), "wall", 1)<0){wolves[i].y--;send_packet(0,"play "+get_tile_at(wolves[i].x, wolves[i].y, wolves[i].map)+"step"+random(1, 5)+".ogg "+wolves[i].x+" "+wolves[i].y, wolves[i].map);break;}
else if(_cd==1&&get_tile_at(wolves[i].x-1, wolves[i].y, wolves[i].map)!=""&&string_contains(get_tile_at(wolves[i].x-1, wolves[i].y, wolves[i].map), "wall", 1)<0){wolves[i].x--;send_packet(0,"play "+get_tile_at(wolves[i].x, wolves[i].y, wolves[i].map)+"step"+random(1, 5)+".ogg "+wolves[i].x+" "+wolves[i].y, wolves[i].map);break;}
else if(_cd==2&&get_tile_at(wolves[i].x+1, wolves[i].y, wolves[i].map)!=""&&string_contains(get_tile_at(wolves[i].x+1, wolves[i].y, wolves[i].map), "wall", 1)<0){wolves[i].x++;send_packet(0,"play "+get_tile_at(wolves[i].x, wolves[i].y, wolves[i].map)+"step"+random(1, 5)+".ogg "+wolves[i].x+" "+wolves[i].y, wolves[i].map);break;}
}
if(wolves[i].x>players[i2].x+2&&players[i2].in_safe_zone==false&&players[i2].map==wolves[i].map&&players[i2].newbie==false&&players[i2].afk==false&&players[i2].peaceful==0){
wolves[i].x-=2;
string ss=get_tile_at(wolves[i].x, wolves[i].y, wolves[i].map);
send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+wolves[i].x+" "+wolves[i].y+" "+wolves[i].map,wolves[i].map);
wolves[i].wolf_timer.restart();
break;
}
else if(wolves[i].x<players[i2].x-2&&players[i2].in_safe_zone==false&&wolves[i].map==players[i2].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false){
wolves[i].x+=2;
string ss=get_tile_at(wolves[i].x, wolves[i].y, wolves[i].map);
send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+wolves[i].x+" "+wolves[i].y+" "+wolves[i].map,wolves[i].map);
wolves[i].wolf_timer.restart();
break;
}
if(get_wolf_distance(wolves[i], players[i2])>-1&&get_wolf_distance(wolves[i],players[i2])<=2&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&wolves[i].shoot_time.elapsed>=500&&wolves[i].shots>0){
wolves[i].shoot_time.restart();
send_packet(0,"play lobobater.ogg "+wolves[i].x+" "+wolves[i].y+" "+wolves[i].map,wolves[i].map);
int r=reflect_damage(i2, "lobo", wolves[i].x, wolves[i].y, random(300, 500));
if(r>0){wolves[i].health_points-=r;wolves[i].hit_by=players[i2].charname;break;}
players[i2].health-=random(300, 500);
send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
players[i2].lasthit="lobo";
wolves[i].shots--;
break;
}
if(wolves[i].shots<=0){
wolves[i].shots=1;
wolves[i].shoot_time.restart();
}
}
}
}
}
void spawn_wolf(int x, int y, string map){
wolf c(x, y, map);
wolves.insert_last(c);
}
// Shark
shark@[] sharks;
class shark
{
bool y_up=true, y_down=true; // y_up: may follow UP the Y axis; y_down: may follow DOWN. false on either still allows X movement.
int x;
int y;
uint shots=1;
int health_points=random(2200, 2800);
string hit_by, sound_name;
string map;
timer shark_timer;
timer shoot_time;
timer sound_timer;
int sound_interval=4000;
int shark_time=200;
bool flee_mode=false;
shark(int cx, int cy, string cmap)
{
x=cx;
y=cy;
map=cmap;
sound_name=spawn_moving_sound("tubarãoloop.ogg", x, y, map);
}
}
void shark_loop()
{
for(uint i=0; i<sharks.length(); i++)
{
if(sharks[i].health_points<=0){
send_packet(0,"play m_tubarao.ogg "+sharks[i].x+" "+sharks[i].y+" "+sharks[i].map,sharks[i].map);
send_reliable(0, "msg2 "+sharks[i].hit_by+"; ;killed a; ;Shark;!", 3);
int xx=get_player_index_from(sharks[i].hit_by);
if(xx>-1){
players[xx].inv_add_item("shark_corpse", 1);
gain_xp(players[xx].charname, random(100, 150));
}
destroy_moving_sound(sharks[i].sound_name);
sharks.remove_at(i);
 break;
}
if(sharks[i].sound_timer.elapsed>=sharks[i].sound_interval+random(1000, 1200)){
sharks[i].sound_timer.restart();
string ss="tubarao"+random(1, 3)+".ogg";
send_packet(0,"play "+ss+" "+sharks[i].x+" "+sharks[i].y+" "+sharks[i].map,sharks[i].map);
}
if(sharks[i].shark_timer.elapsed>=sharks[i].shark_time)
{
sharks[i].shark_timer.restart();
for(uint i2=0; i2 < players.length(); i2++){
if(sharks[i].y!=players[i2].y&&players[i2].jumping==0){
int _cd=climb_dir(sharks[i].map, sharks[i].x, sharks[i].y, players[i2].x, players[i2].y, sharks[i].y_up, sharks[i].y_down);
if(_cd==3&&get_tile_at(sharks[i].x, sharks[i].y+1, sharks[i].map)!=""&&string_contains(get_tile_at(sharks[i].x, sharks[i].y+1, sharks[i].map), "wall", 1)<0){sharks[i].y++;send_packet(0,"play "+get_tile_at(sharks[i].x, sharks[i].y, sharks[i].map)+"step"+random(1, 5)+".ogg "+sharks[i].x+" "+sharks[i].y, sharks[i].map);break;}
else if(_cd==4&&get_tile_at(sharks[i].x, sharks[i].y-1, sharks[i].map)!=""&&string_contains(get_tile_at(sharks[i].x, sharks[i].y-1, sharks[i].map), "wall", 1)<0){sharks[i].y--;send_packet(0,"play "+get_tile_at(sharks[i].x, sharks[i].y, sharks[i].map)+"step"+random(1, 5)+".ogg "+sharks[i].x+" "+sharks[i].y, sharks[i].map);break;}
else if(_cd==1&&get_tile_at(sharks[i].x-1, sharks[i].y, sharks[i].map)!=""&&string_contains(get_tile_at(sharks[i].x-1, sharks[i].y, sharks[i].map), "wall", 1)<0){sharks[i].x--;send_packet(0,"play "+get_tile_at(sharks[i].x, sharks[i].y, sharks[i].map)+"step"+random(1, 5)+".ogg "+sharks[i].x+" "+sharks[i].y, sharks[i].map);break;}
else if(_cd==2&&get_tile_at(sharks[i].x+1, sharks[i].y, sharks[i].map)!=""&&string_contains(get_tile_at(sharks[i].x+1, sharks[i].y, sharks[i].map), "wall", 1)<0){sharks[i].x++;send_packet(0,"play "+get_tile_at(sharks[i].x, sharks[i].y, sharks[i].map)+"step"+random(1, 5)+".ogg "+sharks[i].x+" "+sharks[i].y, sharks[i].map);break;}
}
if(sharks[i].x>players[i2].x+2&&players[i2].in_safe_zone==false&&players[i2].map==sharks[i].map&&players[i2].newbie==false&&players[i2].afk==false&&players[i2].peaceful==0&&sharks[i].flee_mode==false){
sharks[i].x--;
update_moving_sound(sharks[i].sound_name, sharks[i].x, sharks[i].y);
sharks[i].shark_timer.restart();
break;
}
else if(sharks[i].x<players[i2].x-2&&players[i2].in_safe_zone==false&&sharks[i].map==players[i2].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&sharks[i].flee_mode==false){
sharks[i].x++;
sharks[i].shark_timer.restart();
update_moving_sound(sharks[i].sound_name, sharks[i].x, sharks[i].y);
break;
}
else if(sharks[i].y>players[i2].y&&sharks[i].map==players[i2].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&players[i2].in_safe_zone==false&&sharks[i].flee_mode==false){
sharks[i].y--;
update_moving_sound(sharks[i].sound_name, sharks[i].x, sharks[i].y);
sharks[i].shark_timer.restart();
break;
}
else if(sharks[i].y<players[i2].y&&sharks[i].map==players[i2].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&players[i2].in_safe_zone==false&&sharks[i].flee_mode==false&&sharks[i].y<50){
sharks[i].y++;
update_moving_sound(sharks[i].sound_name, sharks[i].x, sharks[i].y);
sharks[i].shark_timer.restart();
break;
}
if(get_shark_distance(sharks[i], players[i2])>-1&&get_shark_distance(sharks[i],players[i2])<=2&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&sharks[i].shoot_time.elapsed>=random(1000, 3000)&&sharks[i].shots>0){
sharks[i].shoot_time.restart();
send_packet(0,"play tubaraobater.ogg "+sharks[i].x+" "+sharks[i].y+" "+sharks[i].map,sharks[i].map);
int r=reflect_damage(i2, "tubarao", sharks[i].x, sharks[i].y, random(1800, 2800));
if(r>0){sharks[i].health_points-=r;sharks[i].hit_by=players[i2].charname;break;}
players[i2].health-=random(1800, 2800);
send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
players[i2].lasthit="a shark";
sharks[i].shots--;
break;
}
if(sharks[i].shots<=0){
sharks[i].shots=1;
}
}
}
}
}
void spawn_shark(int x, int y, string map){
if(!pvp)return;
shark c(x, y, map);
sharks.insert_last(c);
}
