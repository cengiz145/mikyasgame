}
void projectile_loop()
{
for(uint i=0; i<projeteis.length(); i++){
if(projeteis[i].projectile_timer.elapsed>=projeteis[i].projectile_time){
int i2=get_player_index_from(projeteis[i].njogador);
if(i2>-1){
if(players[i2].peaceful==1||get_safezone_at(players[i2].x, players[i2].y, players[i2].map)==true||players[i2].afk||players[i2].map!=projeteis[i].map)i2=-1;
}
if(i2<0)projeteis[i].njogador=select_player_menu(projeteis[i].map);
i2=get_player_index_from(projeteis[i].njogador);
if(i2>-1){
if(players[i2].peaceful==1||get_safezone_at(players[i2].x, players[i2].y, players[i2].map)==true||players[i2].afk||players[i2].map!=projeteis[i].map)i2=-1;
}
if(i2<0)break;
if(projeteis[i].x>players[i2].x&&players[i2].in_safe_zone==false&&projeteis[i].char_name_nome!=players[i2].charname&&players[i2].map==projeteis[i].map&&players[i2].newbie==false&&players[i2].afk==false&&players[i2].peaceful==0&&in_team(players[i2].charname, projeteis[i].char_name_nome)==false){
projeteis[i].x--;
update_moving_sound(projeteis[i].projectile_sound,projeteis[i].x,projeteis[i].y);
projeteis[i].projectile_timer.restart();
}
else if(projeteis[i].x<players[i2].x&&players[i2].in_safe_zone==false&&projeteis[i].char_name_nome!=players[i2].charname&&projeteis[i].map==players[i2].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&in_team(players[i2].charname, projeteis[i].char_name_nome)==false){
projeteis[i].x++;
update_moving_sound(projeteis[i].projectile_sound,projeteis[i].x,projeteis[i].y);
projeteis[i].projectile_timer.restart();
}
else if(projeteis[i].y>players[i2].y&&projeteis[i].char_name_nome!=players[i2].charname&&projeteis[i].map==players[i2].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&players[i2].in_safe_zone==false&&in_team(players[i2].charname, projeteis[i].char_name_nome)==false){
projeteis[i].y--;
update_moving_sound(projeteis[i].projectile_sound,projeteis[i].x,projeteis[i].y);
projeteis[i].projectile_timer.restart();
}
else if(projeteis[i].y<players[i2].y&&projeteis[i].char_name_nome!=players[i2].charname&&projeteis[i].map==players[i2].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&players[i2].in_safe_zone==false&&in_team(players[i2].charname, projeteis[i].char_name_nome)==false){
projeteis[i].y++;
update_moving_sound(projeteis[i].projectile_sound,projeteis[i].x,projeteis[i].y);
projeteis[i].projectile_timer.restart();
}
else if(projeteis[i].x==players[i2].x&&players[i2].in_safe_zone==false&&projeteis[i].y==players[i2].y&&players[i2].charname!=projeteis[i].char_name_nome&&players[i2].map==projeteis[i].map&&players[i2].newbie==false&&players[i2].afk==false&&players[i2].peaceful==0&&in_team(players[i2].charname, projeteis[i].char_name_nome)==false){
send_reliable(players[i2].peer_id, "stopmoving", 0);
players[i2].health-=random(100, 200);
players[i2].paralyzed_timer.restart();
players[i2].paralyzed=true;
players[i2].paralyzed_count+=10000;
send_packet(0,"play projetilacerta.ogg "+players[i2].x+" "+players[i2].y+" "+players[i2].map,players[i2].map);
send_packet(0,"inithurt "+players[i2].charname+" "+players[i2].x+" "+players[i2].y+" "+players[i2].voice+" "+players[i2].pitch+" "+players[i2].map,players[i2].map);
players[i2].lasthit="projetei_"+projeteis[i].char_name_nome;
destroy_moving_sound(projeteis[i].projectile_sound);
projeteis.remove_at(i);
break;
}
}
}
