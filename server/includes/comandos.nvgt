babysaur@[] babysaurs;
class babysaur{
bool y_up=true, y_down=true; // y_up: may follow UP the Y axis; y_down: may follow DOWN. false on either still allows X movement.
int x, y;
uint shots=1;
int health_points=random(50000, 100000);
string hit_by;
string map;
timer babysaur_timer, tnascendo;
timer shoot_time;
timer sound_timer;
int sound_interval=4000;
int babysaur_time=410;
bool born=false;
babysaur(int cx, int cy, string cmap){
x=cx;
y=cy;
map=cmap;
}
}
void babysaur_loop(){
for(uint i=0; i<babysaurs.length(); i++){
int walk=1;
if(babysaurs[i].health_points<=0){
uint total=0;
send_packet(0,"play animales_bbsauro_morreu.ogg "+babysaurs[i].x+" "+babysaurs[i].y,babysaurs[i].map);
string hitter=babysaurs[i].hit_by;
send_reliable(0, "msg2 "+hitter+"; ;killed a; ;bebê_sauro;!", 3);
int xx=get_player_index_from(hitter);
if(xx>-1){
gain_xp(players[xx].charname, random(200, 400));
players[xx].inv_add_item("bebesaurus_corpse", 1);
}
babysaurs.remove_at(i);
break;
}
if(babysaurs[i].tnascendo.elapsed>=6500&&babysaurs[i].born==false){
babysaurs[i].born=true;
babysaurs[i].tnascendo.force(0);
babysaurs[i].tnascendo.pause();
}
if(babysaurs[i].born){
if(babysaurs[i].sound_timer.elapsed>=babysaurs[i].sound_interval+random(1000, 2000)){
babysaurs[i].sound_timer.restart();
string ss="bbsauro"+random(1, 2)+".ogg";
send_packet(0,"play "+ss+" "+babysaurs[i].x+" "+babysaurs[i].y,babysaurs[i].map);
}
if(babysaurs[i].babysaur_timer.elapsed>=babysaurs[i].babysaur_time){
babysaurs[i].babysaur_timer.restart();
for(uint i2=0; i2 < players.length(); i2++){
if(get_babysaur_distance(babysaurs[i], players[i2])>-1&&get_babysaur_distance(babysaurs[i],players[i2])<=4&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false){
babysaurs[i].shoot_time.restart();
send_packet(0,"play animales_bbsauro_bater"+random(1, 2)+".ogg "+babysaurs[i].x+" "+babysaurs[i].y,babysaurs[i].map);
int r=reflect_damage(i2, "bbsauro", babysaurs[i].x, babysaurs[i].y, random(300, 1000));
if(r>0){babysaurs[i].health_points-=r;babysaurs[i].hit_by=players[i2].charname;break;}
players[i2].health-=random(300, 1000);
send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
players[i2].lasthit="bebê_sauro";
babysaurs[i].shots--;
walk=0;
break;
}
if(babysaurs[i].y!=players[i2].y&&players[i2].jumping==0){
int _cd=climb_dir(babysaurs[i].map, babysaurs[i].x, babysaurs[i].y, players[i2].x, players[i2].y, babysaurs[i].y_up, babysaurs[i].y_down);
if(_cd==3&&get_tile_at(babysaurs[i].x, babysaurs[i].y+1, babysaurs[i].map)!=""&&string_contains(get_tile_at(babysaurs[i].x, babysaurs[i].y+1, babysaurs[i].map), "wall", 1)<0){babysaurs[i].y++;send_packet(0,"play "+get_tile_at(babysaurs[i].x, babysaurs[i].y, babysaurs[i].map)+"step"+random(1, 5)+".ogg "+babysaurs[i].x+" "+babysaurs[i].y, babysaurs[i].map);break;}
else if(_cd==4&&get_tile_at(babysaurs[i].x, babysaurs[i].y-1, babysaurs[i].map)!=""&&string_contains(get_tile_at(babysaurs[i].x, babysaurs[i].y-1, babysaurs[i].map), "wall", 1)<0){babysaurs[i].y--;send_packet(0,"play "+get_tile_at(babysaurs[i].x, babysaurs[i].y, babysaurs[i].map)+"step"+random(1, 5)+".ogg "+babysaurs[i].x+" "+babysaurs[i].y, babysaurs[i].map);break;}
else if(_cd==1&&get_tile_at(babysaurs[i].x-1, babysaurs[i].y, babysaurs[i].map)!=""&&string_contains(get_tile_at(babysaurs[i].x-1, babysaurs[i].y, babysaurs[i].map), "wall", 1)<0){babysaurs[i].x--;send_packet(0,"play "+get_tile_at(babysaurs[i].x, babysaurs[i].y, babysaurs[i].map)+"step"+random(1, 5)+".ogg "+babysaurs[i].x+" "+babysaurs[i].y, babysaurs[i].map);break;}
else if(_cd==2&&get_tile_at(babysaurs[i].x+1, babysaurs[i].y, babysaurs[i].map)!=""&&string_contains(get_tile_at(babysaurs[i].x+1, babysaurs[i].y, babysaurs[i].map), "wall", 1)<0){babysaurs[i].x++;send_packet(0,"play "+get_tile_at(babysaurs[i].x, babysaurs[i].y, babysaurs[i].map)+"step"+random(1, 5)+".ogg "+babysaurs[i].x+" "+babysaurs[i].y, babysaurs[i].map);break;}
}
if(babysaurs[i].x>players[i2].x+3&&players[i2].in_safe_zone==false&&players[i2].map==babysaurs[i].map&&players[i2].newbie==false&&players[i2].afk==false&&players[i2].peaceful==0&&walk==1){
babysaurs[i].x--;
string ss=get_tile_at(babysaurs[i].x, babysaurs[i].y, babysaurs[i].map);
if(ss!="")send_packet(0,"play "+ss+" "+babysaurs[i].x+" "+babysaurs[i].y,babysaurs[i].map);
walk=0;
}
else if(babysaurs[i].x<players[i2].x-3&&players[i2].in_safe_zone==false&&babysaurs[i].map==players[i2].map&&players[i2].afk==false&&players[i2].peaceful==0&&players[i2].newbie==false&&walk==1){
babysaurs[i].x++;
string ss=get_tile_at(babysaurs[i].x, babysaurs[i].y, babysaurs[i].map);
if(ss!="")send_packet(0,"play "+ss+" "+babysaurs[i].x+" "+babysaurs[i].y,babysaurs[i].map);
}
if(babysaurs[i].shots<=0){
babysaurs[i].shots=1;
babysaurs[i].shoot_time.restart();
}
}
}
}
}
}
void spawn_babysaur(int x, int y, string map){
if(!pvp)return;
babysaur c(x, y, map);
babysaurs.insert_last(c);
send_packet(0, "play animales_osauro.ogg "+x+" "+y, map);
}
guard_walk@[]guards_walk;
class guard_walk{
bool y_up=true, y_down=true; // y_up: may follow UP the Y axis; y_down: may follow DOWN. false on either still allows X movement.
int x, y, gastar=0, nbater=210, nandar=180, health_points=30000;
timer hit_timer, walk;
string map_data, kill_npc;
guard_walk(int gx, int gy, string g_map, string kill_count){
x=gx;
y=gy;
map_data=g_map;
kill_npc=kill_count;
}
}
void walking_guard_loop(){
for(uint i=0;i<guards_walk.length();i++){

int walk=1;
if(guards_walk[i].health_points<=0){
guards_walk.remove_at(i);
break;
}
if(guards_walk[i].hit_timer.elapsed>=guards_walk[i].nbater){
for(uint i2=0;i2<players.length();i2++){
if(g_dist(guards_walk[i], players[i2])>-1&&g_dist(guards_walk[i], players[i2])<=4&&guards_walk[i].hit_timer.elapsed>=guards_walk[i].nbater){
guards_walk[i].hit_timer.restart();
players[i2].lasthit=guards_walk[i].kill_npc;
players[i2].health-=random(players[i2].maxhealth/20,players[i2].maxhealth/10);
string[] armas;
armas.insert_last("espadahit.ogg");
armas.insert_last("espada_curtahit.ogg");
send_packet(0, "play "+armas[random(0, armas.length()-1)]+" "+guards_walk[i].x+" "+guards_walk[i].y, guards_walk[i].map_data);
walk=0;
send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
break;
}
}
}
if(guards_walk[i].walk.elapsed>=guards_walk[i].nandar&&walk==1){
guards_walk[i].walk.restart();
for(uint i2=0;i2<players.length();i2++){
if(guards_walk[i].y!=players[i2].y&&players[i2].jumping==0){
int _cd=climb_dir(guards_walk[i].map_data, guards_walk[i].x, guards_walk[i].y, players[i2].x, players[i2].y, guards_walk[i].y_up, guards_walk[i].y_down);
if(_cd==3&&get_tile_at(guards_walk[i].x, guards_walk[i].y+1, guards_walk[i].map_data)!=""&&string_contains(get_tile_at(guards_walk[i].x, guards_walk[i].y+1, guards_walk[i].map_data), "wall", 1)<0){guards_walk[i].y++;send_packet(0,"play "+get_tile_at(guards_walk[i].x, guards_walk[i].y, guards_walk[i].map_data)+"step"+random(1, 5)+".ogg "+guards_walk[i].x+" "+guards_walk[i].y, guards_walk[i].map_data);break;}
else if(_cd==4&&get_tile_at(guards_walk[i].x, guards_walk[i].y-1, guards_walk[i].map_data)!=""&&string_contains(get_tile_at(guards_walk[i].x, guards_walk[i].y-1, guards_walk[i].map_data), "wall", 1)<0){guards_walk[i].y--;send_packet(0,"play "+get_tile_at(guards_walk[i].x, guards_walk[i].y, guards_walk[i].map_data)+"step"+random(1, 5)+".ogg "+guards_walk[i].x+" "+guards_walk[i].y, guards_walk[i].map_data);break;}
else if(_cd==1&&get_tile_at(guards_walk[i].x-1, guards_walk[i].y, guards_walk[i].map_data)!=""&&string_contains(get_tile_at(guards_walk[i].x-1, guards_walk[i].y, guards_walk[i].map_data), "wall", 1)<0){guards_walk[i].x--;send_packet(0,"play "+get_tile_at(guards_walk[i].x, guards_walk[i].y, guards_walk[i].map_data)+"step"+random(1, 5)+".ogg "+guards_walk[i].x+" "+guards_walk[i].y, guards_walk[i].map_data);break;}
else if(_cd==2&&get_tile_at(guards_walk[i].x+1, guards_walk[i].y, guards_walk[i].map_data)!=""&&string_contains(get_tile_at(guards_walk[i].x+1, guards_walk[i].y, guards_walk[i].map_data), "wall", 1)<0){guards_walk[i].x++;send_packet(0,"play "+get_tile_at(guards_walk[i].x, guards_walk[i].y, guards_walk[i].map_data)+"step"+random(1, 5)+".ogg "+guards_walk[i].x+" "+guards_walk[i].y, guards_walk[i].map_data);break;}
}
if(guards_walk[i].x>players[i2].x+2&&guards_walk[i].map_data==players[i2].map&&walk==1){
guards_walk[i].x--;
string ss=get_tile_at(guards_walk[i].x, guards_walk[i].y, guards_walk[i].map_data);
send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+guards_walk[i].x+" "+guards_walk[i].y+" "+guards_walk[i].map_data,guards_walk[i].map_data);
walk=0;
break;
}
else if(guards_walk[i].x<players[i2].x-2&&guards_walk[i].map_data==players[i2].map&&walk==1){
guards_walk[i].x++;
string ss=get_tile_at(guards_walk[i].x, guards_walk[i].y, guards_walk[i].map_data);
send_packet(0,"play "+ss+"step"+random(1, 5)+".ogg "+guards_walk[i].x+" "+guards_walk[i].y+" "+guards_walk[i].map_data,guards_walk[i].map_data);
walk=0;
break;
}
}
}
}
netloop();
}
