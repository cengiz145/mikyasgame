// Helicopter
helicopter@[] helicopters;
class helicopter{
int x, y, health_points;
string map, soundhelicoptero;
timer helicopter_timer, tbomba;
timer shoot_time;
int helicopter_time=100;
bool exit_game=false;
helicopter(int cx, int cy, string cmap, int cv){
x=cx;
y=cy;
map=cmap;
soundhelicoptero=spawn_moving_sound("helicopteroloop.ogg",x,y,map);
health_points=cv;
}
}
void helicopter_loop(){
for(uint i=0; i<helicopters.length(); i++){
if(helicopters[i].health_points<=0){
send_packet(0,"play bombaatomicaexplode.ogg "+helicopters[i].x+" "+helicopters[i].y+" "+helicopters[i].map, helicopters[i].map);
send_reliable(0, "msgnormal An helicopter has been takedown", 0);
string[] jitens, jitens2;
jitens.insert_last("5.56mm");
jitens.insert_last("7.62mm");
jitens.insert_last("reais");
jitens2.insert_last("mp5");
jitens2.insert_last("ar15");
jitens2.insert_last("ak47");
jitens2.insert_last("mega_laser");
int item_qty=random(1000, 2000);
int item_qty2=random(1, 3);
for(uint c=0;c<jitens.length();c++){
spawn_obj(random(1, 200),0, jitens[c], item_qty,helicopters[i].map);
}
for(uint c=0;c<jitens2.length();c++){
spawn_obj(random(1, 100),6, jitens2[c], item_qty2,helicopters[i].map);
}
destroy_moving_sound(helicopters[i].soundhelicoptero);
helicopters.remove_at(i);
break;
}
if(TIME_HOUR>19&&helicopters[i].map=="city1"&&helicopters[i].exit_game==false||TIME_HOUR>19&&helicopters[i].map=="city2"&&helicopters[i].exit_game==false)helicopters[i].exit_game=true;
if(helicopters[i].tbomba.elapsed>=random(40000, 70000)){
helicopters[i].tbomba.restart();
int a=random(1, 3);
if(a<=2)spawn_maxbomb(helicopters[i].x,0, helicopters[i].map, "Helicopter");
else spawn_atomic_bomb(helicopters[i].x, helicopters[i].y, helicopters[i].map, "helicopter");
}
if(helicopters[i].helicopter_timer.elapsed>=helicopters[i].helicopter_time)
{
if(helicopters[i].exit_game==false){
for(uint i2=0;i2<players.length();i2++){
if(players[i2].x==helicopters[i].x&&players[i2].map==helicopters[i].map&&helicopters[i].shoot_time.elapsed>=random(800, 1000))
{
helicopters[i].shoot_time.restart();
players[i2].health-=random(600, 1000);
send_packet(0,"play helicopteroarma"+random(1, 3)+".ogg "+players[i2].x+" "+players[i2].y+" "+players[i2].map,players[i2].map);
send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
players[i2].lasthit="helicoptero";
}
if(players[i2].x>helicopters[i].x&&players[i2].map==helicopters[i].map&&players[i2].newbie==false&&players[i2].afk==false){
helicopters[i].x++;
update_moving_sound(helicopters[i].soundhelicoptero,helicopters[i].x,helicopters[i].y);
helicopters[i].helicopter_timer.restart();
break;
}
if(players[i2].x<helicopters[i].x&&players[i2].map==helicopters[i].map&&players[i2].newbie==false&&players[i2].afk==false){
helicopters[i].x--;
update_moving_sound(helicopters[i].soundhelicoptero,helicopters[i].x,helicopters[i].y);
helicopters[i].helicopter_timer.restart();
break;
}
}
}
else if(helicopters[i].exit_game){
helicopters[i].x++;
update_moving_sound(helicopters[i].soundhelicoptero,helicopters[i].x,helicopters[i].y);
if(helicopters[i].x>380){
helicopters.remove_at(i);
break;
}
}
}
}
}
