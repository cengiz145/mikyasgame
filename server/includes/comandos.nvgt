armored_car@[] armored_cars;
class armored_car{
int x, y=0, health_points, natirar1=random(100, 140), natirar2=random(150, 190);
string map_data, s, hit_by;
timer walk_timer, tatirar1, tatirar2;
armored_car(int cx, int cy, string cm, int cv){
x=cx;
y=cy;
map_data=cm;
s=spawn_moving_sound("car2.ogg", x, y, map_data);
health_points=cv;
}
~armored_car(){
destroy_moving_sound(s);
}
}
void armored_car_loop(){
for(uint i=0;i<armored_cars.length();i++){
if(armored_cars[i].health_points<=0){
string hitter=armored_cars[i].hit_by;
send_reliable(0, "msg2 "+hitter+"; ;destroyed an armored car;!", 3);
int xx=get_player_index_from(hitter);
if(xx>-1){
gain_xp(players[xx].charname, random(5000, 8000), random(250000, 500000));
give_reais(players[xx].charname, random(1000, 2000));
}
armored_cars.remove_at(i);
break;
}
if(armored_cars[i].x>=240){
armored_cars.remove_at(i);
break;
}
if(armored_cars[i].walk_timer.elapsed>=230){
armored_cars[i].walk_timer.restart();
armored_cars[i].x++;
update_moving_sound(armored_cars[i].s, armored_cars[i].x, armored_cars[i].y);
}
if(armored_cars[i].tatirar1.elapsed>=armored_cars[i].natirar1){
armored_cars[i].natirar1=random(100, 160);
armored_cars[i].tatirar1.restart();
for(uint i2=0;i2<players.length();i2++){
if(players[i2].peaceful==0&&!players[i2].afk&&g_armored_car(armored_cars[i], players[i2])>-1&&g_armored_car(armored_cars[i], players[i2])<=20){
send_packet(0, "play mk1.ogg "+armored_cars[i].x+" "+armored_cars[i].y, armored_cars[i].map_data);
players[i2].lasthit="carro_forte";
players[i2].health-=310;
break;
}
}
}
if(armored_cars[i].tatirar2.elapsed>=armored_cars[i].natirar2){
armored_cars[i].natirar1=random(130, 170);
armored_cars[i].tatirar2.restart();
for(uint i2=0;i2<players.length();i2++){
if(players[i2].peaceful==0&&!players[i2].afk&&g_armored_car(armored_cars[i], players[i2])>-1&&g_armored_car(armored_cars[i], players[i2])<=20){
send_packet(0, "play ak48.ogg "+armored_cars[i].x+" "+armored_cars[i].y, armored_cars[i].map_data);
players[i2].lasthit="carro_forte";
players[i2].health-=400;
break;
}
}
}
}
}
void place_armored_car(int x, int y, string map_data, int health_points=50000){
armored_car c(x, y, map_data, health_points);
armored_cars.insert_last(c);
}
cobra@[] cobras;
class cobra{
int x, y, landar=1;
string map_data, s;
timer t;
cobra(int cx, int cy, string cm){
x=cx;
y=cy;
map_data=cm;
s=spawn_moving_sound("cobraloop.ogg", x, y, map_data);
}
~cobra(){
destroy_moving_sound(s);
}
}
void create_snake(int x, int y, string map_data){
cobra c(x, y, map_data);
cobras.insert_last(c);
}
void snake_loop(){
for(uint i=0;i<cobras.length();i++){
if(cobras[i].t.elapsed>=150){
for(uint i2=0;i2<players.length();i2++){
if(cobras[i].x==players[i2].x&&cobras[i].y==players[i2].y&&cobras[i].map_data==players[i2].map&&cobras[i].t.elapsed>=150){
send_packet(0, "play cobramorde.ogg "+cobras[i].x+" "+cobras[i].y, cobras[i].map_data);
send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
players[i2].health-=random(1000, 2000);
players[i2].lasthit="cobra";
cobras[i].t.restart();
break;
}
}
if(cobras[i].landar==1){
cobras[i].t.restart();
cobras[i].x--;
update_moving_sound(cobras[i].s, cobras[i].x, cobras[i].y);
}
else if(cobras[i].landar==2){
cobras[i].t.restart();
cobras[i].y++;
update_moving_sound(cobras[i].s, cobras[i].x, cobras[i].y);
}
}
if(cobras[i].landar==1&&string_contains(get_tile_at(cobras[i].x-1, cobras[i].y, cobras[i].map_data), "walldirt", 1)>-1)cobras[i].landar=2;
else if(cobras[i].landar==2&&string_contains(get_tile_at(cobras[i].x+1, cobras[i].y, cobras[i].map_data), "walldirt", 1)>-1)cobras[i].landar=1;
}
}
