// === Monster stair pathfinding: route a monster to the nearest staircase that connects its
// current Y level toward the player, then climb/descend it. Lets monsters actually reach a
// player who is up/down stairs instead of getting stuck below at the player's X. ===
dictionary _stair_cache;
string _get_stairs(string map){
	if(_stair_cache.exists(map)){ string r; _stair_cache.get(map, r); return r; }
	string res="";
	if(file_exists("maps/"+map+".map")){
		file f; f.open("maps/"+map+".map", "rb");
		string[] lines=delinear(f.read()); f.close();
		for(uint i=0;i<lines.length();i++){
			string[] p=string_split(lines[i], ":", false);
			if(p[0]=="staircase" && p.length()>=5) res+=p[1]+","+p[2]+","+p[3]+","+p[4]+"|";
		}
	}
	_stair_cache.set(map, res);
	return res;
}
// 0=no move (same level / no usable stair), 1=move left, 2=move right, 3=climb up, 4=climb down.
int climb_dir(string map, int mx, int my, int px, int py, bool y_up, bool y_down){
	if(py==my) return 0;
	bool going_up = py>my;
	if(going_up && !y_up) return 0;
	if(!going_up && !y_down) return 0;
	string[] recs=string_split(_get_stairs(map), "|", false);
	int best_x=-1, bestdist=2147483647; bool at_stair=false;
	for(uint i=0;i<recs.length();i++){
		if(recs[i]=="") continue;
		string[] c=string_split(recs[i], ",", false);
		int minx=string_to_number(c[0]), maxx=string_to_number(c[1]), miny=string_to_number(c[2]), maxy=string_to_number(c[3]);
		if(miny<=my && my<=maxy && (going_up ? (maxy>my) : (miny<my))){
			if(mx>=minx && mx<=maxx){ at_stair=true; break; }
			int tx=(mx<minx)?minx:maxx;
			int d=(mx<minx)?(minx-mx):(mx-maxx);
			if(d<bestdist){ bestdist=d; best_x=tx; }
		}
	}
	if(at_stair) return going_up?3:4;
	if(best_x<0) return 0;
	return (best_x<mx)?1:2;
}

// === Custom monsters created from the dev menu (defined here, spawned at runtime). ===
// Configurable: name (used for NAME_attackN.ogg and NAME_death.ogg sounds), spawn x/y, map, hp,
// speed (ms between steps; lower = faster), damage, attack_count (how many NAME_attackN.ogg files
// it has, picked at random), respawn_time (ms after death to respawn at the spawn point; 0 = never),
// and y_up/y_down (whether it follows the player up/down stairs).
class custom_monster{
	string name, map_data, hit_by, drop_item;
	int x, y, sx, sy, health_points, max_vida, speed, damage, attack_count, respawn_time, xp_min, xp_max, drop_min, drop_max;
	bool y_up=true, y_down=true, dead=false;
	timer walk_timer, respawn_timer;
	custom_monster(string n, int cx, int cy, string m, int hp, int sp, int dmg, int atk, int resp, bool yu, bool yd, int xp_min_val, int xp_max_val, string drop_item_id, int drop_min_val, int drop_max_val){
		name=n; x=cx; y=cy; sx=cx; sy=cy; map_data=m; health_points=hp; max_vida=hp; speed=sp; damage=dmg; attack_count=atk; respawn_time=resp; y_up=yu; y_down=yd; xp_min=xp_min_val; xp_max=xp_max_val; drop_item=drop_item_id; drop_min=drop_min_val; drop_max=drop_max_val;
	}
}
custom_monster@[] custom_monsters;
void spawn_custom_monster(string n, int cx, int cy, string m, int hp, int sp, int dmg, int atk, int resp, bool yu, bool yd, int xp_min_val=0, int xp_max_val=0, string drop_item_id="", int drop_min_val=0, int drop_max_val=0){
	custom_monster cm(n, cx, cy, m, hp, sp, dmg, atk, resp, yu, yd, xp_min_val, xp_max_val, drop_item_id, drop_min_val, drop_max_val);
	custom_monsters.insert_last(cm);
}
void custom_monster_loop(){
	for(uint i=0;i<custom_monsters.length();i++){
		if(custom_monsters[i].dead){
			if(custom_monsters[i].respawn_timer.elapsed>=custom_monsters[i].respawn_time){
				custom_monsters[i].dead=false;
				custom_monsters[i].health_points=custom_monsters[i].max_vida;
				custom_monsters[i].x=custom_monsters[i].sx;
				custom_monsters[i].y=custom_monsters[i].sy;
			}
			continue;
		}
		if(custom_monsters[i].health_points<=0){
			send_packet(0, "play "+custom_monsters[i].name+"_death.ogg "+custom_monsters[i].x+" "+custom_monsters[i].y, custom_monsters[i].map_data);
			if(custom_monsters[i].hit_by!=""){
				send_reliable(0, "msg2 "+custom_monsters[i].hit_by+"; ;killed a; ;"+custom_monsters[i].name+";!", 3);
				int xx=get_player_index_from(custom_monsters[i].hit_by);
				if(xx>-1){
					if(custom_monsters[i].xp_max>0) gain_xp(players[xx].charname, random(custom_monsters[i].xp_min, custom_monsters[i].xp_max));
					if(custom_monsters[i].drop_item!="") players[xx].inv_add_item(custom_monsters[i].drop_item, random(custom_monsters[i].drop_min, custom_monsters[i].drop_max));
				}
			}
			if(custom_monsters[i].respawn_time>0){
				custom_monsters[i].dead=true;
				custom_monsters[i].respawn_timer.restart();
				custom_monsters[i].hit_by="";
			}
			else custom_monsters.remove_at(i);
			break;
		}
		if(custom_monsters[i].walk_timer.elapsed>=custom_monsters[i].speed){
			custom_monsters[i].walk_timer.restart();
			for(uint i2=0;i2<players.length();i2++){
				if(players[i2].in_safe_zone==false&&players[i2].map==custom_monsters[i].map_data&&players[i2].newbie==false&&players[i2].afk==false&&players[i2].peaceful==0){
					int adx=custom_monsters[i].x-players[i2].x; if(adx<0)adx=-adx;
					int ady=custom_monsters[i].y-players[i2].y; if(ady<0)ady=-ady;
					if(adx+ady<=1){
						int r=reflect_damage(i2, custom_monsters[i].name, custom_monsters[i].x, custom_monsters[i].y, custom_monsters[i].damage);
						if(r>0){custom_monsters[i].health_points-=r; custom_monsters[i].hit_by=players[i2].charname; break;}
						players[i2].health-=custom_monsters[i].damage;
						players[i2].lasthit=custom_monsters[i].name;
						send_packet(0,"play "+custom_monsters[i].name+"_attack"+(custom_monsters[i].attack_count<1?1:random(1, custom_monsters[i].attack_count))+".ogg "+custom_monsters[i].x+" "+custom_monsters[i].y, custom_monsters[i].map_data);
						send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
						break;
					}
					if(custom_monsters[i].y!=players[i2].y&&players[i2].jumping==0){
						int _cd=climb_dir(custom_monsters[i].map_data, custom_monsters[i].x, custom_monsters[i].y, players[i2].x, players[i2].y, custom_monsters[i].y_up, custom_monsters[i].y_down);
						if(_cd==3&&get_tile_at(custom_monsters[i].x, custom_monsters[i].y+1, custom_monsters[i].map_data)!=""&&string_contains(get_tile_at(custom_monsters[i].x, custom_monsters[i].y+1, custom_monsters[i].map_data), "wall", 1)<0){custom_monsters[i].y++;send_packet(0,"play "+get_tile_at(custom_monsters[i].x, custom_monsters[i].y, custom_monsters[i].map_data)+"step"+random(1, 5)+".ogg "+custom_monsters[i].x+" "+custom_monsters[i].y, custom_monsters[i].map_data);break;}
						else if(_cd==4&&get_tile_at(custom_monsters[i].x, custom_monsters[i].y-1, custom_monsters[i].map_data)!=""&&string_contains(get_tile_at(custom_monsters[i].x, custom_monsters[i].y-1, custom_monsters[i].map_data), "wall", 1)<0){custom_monsters[i].y--;send_packet(0,"play "+get_tile_at(custom_monsters[i].x, custom_monsters[i].y, custom_monsters[i].map_data)+"step"+random(1, 5)+".ogg "+custom_monsters[i].x+" "+custom_monsters[i].y, custom_monsters[i].map_data);break;}
						else if(_cd==1&&get_tile_at(custom_monsters[i].x-1, custom_monsters[i].y, custom_monsters[i].map_data)!=""&&string_contains(get_tile_at(custom_monsters[i].x-1, custom_monsters[i].y, custom_monsters[i].map_data), "wall", 1)<0){custom_monsters[i].x--;send_packet(0,"play "+get_tile_at(custom_monsters[i].x, custom_monsters[i].y, custom_monsters[i].map_data)+"step"+random(1, 5)+".ogg "+custom_monsters[i].x+" "+custom_monsters[i].y, custom_monsters[i].map_data);break;}
						else if(_cd==2&&get_tile_at(custom_monsters[i].x+1, custom_monsters[i].y, custom_monsters[i].map_data)!=""&&string_contains(get_tile_at(custom_monsters[i].x+1, custom_monsters[i].y, custom_monsters[i].map_data), "wall", 1)<0){custom_monsters[i].x++;send_packet(0,"play "+get_tile_at(custom_monsters[i].x, custom_monsters[i].y, custom_monsters[i].map_data)+"step"+random(1, 5)+".ogg "+custom_monsters[i].x+" "+custom_monsters[i].y, custom_monsters[i].map_data);break;}
					}
					if(custom_monsters[i].x>players[i2].x&&string_contains(get_tile_at(custom_monsters[i].x-1, custom_monsters[i].y, custom_monsters[i].map_data), "wall", 1)<0){custom_monsters[i].x--;send_packet(0,"play "+get_tile_at(custom_monsters[i].x, custom_monsters[i].y, custom_monsters[i].map_data)+"step"+random(1, 5)+".ogg "+custom_monsters[i].x+" "+custom_monsters[i].y, custom_monsters[i].map_data);break;}
					else if(custom_monsters[i].x<players[i2].x&&string_contains(get_tile_at(custom_monsters[i].x+1, custom_monsters[i].y, custom_monsters[i].map_data), "wall", 1)<0){custom_monsters[i].x++;send_packet(0,"play "+get_tile_at(custom_monsters[i].x, custom_monsters[i].y, custom_monsters[i].map_data)+"step"+random(1, 5)+".ogg "+custom_monsters[i].x+" "+custom_monsters[i].y, custom_monsters[i].map_data);break;}
				}
			}
		}
	}
}
// ==== CUSTOM_MONSTER_DEFINITIONS (add_monster.py inserts colocar_<name>() functions below this line) ====
void place_test(int x, int y, string m){ spawn_custom_monster("test", x, y, m, 1000000, 800, 100000, 3, 20000, false, false, 2000000, 2500000, "coins", 100000000, 500000000); }
