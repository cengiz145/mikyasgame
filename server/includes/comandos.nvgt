string select_player_menu(string map_data){
string[] names;
for(uint i=0;i<players.length();i++){
if(players[i].map==map_data)names.insert_last(players[i].charname);
}
if(names.length()==0)return "";
return names[random(0, names.length()-1)];
}
int reflect_damage(int index, string char_name_nome, int x, int y, int damage_value){
if(!players[index].star2)return 0;
send_packet_unreliable(0, players[index].x, "play lih.ogg "+players[index].x+" "+players[index].y, players[index].map);
send_packet_unreliable(0, x,"rico "+char_name_nome+"apanhando1.ogg "+x+" "+y, players[index].map);
return damage_value;
}
