sequestrador2@[] sequestrador2s;
class sequestrador2{
bool y_up=true, y_down=true; // y_up: may follow UP the Y axis; y_down: may follow DOWN. false on either still allows X movement.
int x, y, health_points=random(3000, 6000), morrendo=0, died=0, narma, ndist=50, ndano=random(2000, 4000), natirar=5560;
string map_data, hit_by, njogador;
timer walk_timer, tmorreu, sound_timer, tatirar;
string[] tipoarma={"", "ar15", "m4a1", "sniper"};
sequestrador2(int zx, int zy, string m, int tn){
x=zx;
y=zy;
map_data=m;
tmorreu.force(0);
tmorreu.pause();
narma=tn;
if(tn==3){
ndist=350;
natirar=random(800, 1400);
ndano=random(3000, 8000);
}
}
}
void place_kidnapper2(int x, int y, string m, int nn=random(1, 2)){
sequestrador2 z(x, y, m, nn);
sequestrador2s.insert_last(z);
}
