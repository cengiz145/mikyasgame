paje@[] pajes;
class paje
{
int x;
int y;
string map;
timer shaman_timer, tempotambor;
int shaman_time=60000;
int drum_interval=random(20000, 30000);
paje(int cx, int cy, string cmap)
{
x=cx;
y=cy;
map=cmap;
}
}
void shaman_loop()
{
for(uint i=0; i<pajes.length(); i++)
{
if(pajes[i].shaman_timer.elapsed>=pajes[i].shaman_time)
{
if(pajes[i].x<=4){
pajes[i].shaman_timer.restart();
int walk=random(2, 5);
pajes[i].x+walk;
string surface=get_tile_at(pajes[i].x,pajes[i].y,pajes[i].map);
send_packet(0,"play "+surface+"step"+random(1, 5)+".ogg "+pajes[i].x+" "+pajes[i].y+" "+pajes[i].map,pajes[i].map);
}
else if(pajes[i].x>=195){
pajes[i].shaman_timer.restart();
int walk=random(2, 5);
pajes[i].x-walk;
string surface=get_tile_at(pajes[i].x,pajes[i].y,pajes[i].map);
send_packet(0,"play "+surface+"step"+random(1, 5)+".ogg "+pajes[i].x+" "+pajes[i].y+" "+pajes[i].map,pajes[i].map);
}
else if(pajes[i].x>4&&pajes[i].x<=194){
pajes[i].shaman_timer.restart();
int walk=random(2, 8);
pajes[i].x+walk;
string surface=get_tile_at(pajes[i].x,pajes[i].y,pajes[i].map);
send_packet(0,"play "+surface+"step"+random(1, 5)+".ogg "+pajes[i].x+" "+pajes[i].y+" "+pajes[i].map,pajes[i].map);
}
else if(pajes[i].x<199&&pajes[i].x>4){
pajes[i].shaman_timer.restart();
int walk=random(2, 8);
pajes[i].x-walk;
string surface=get_tile_at(pajes[i].x,pajes[i].y,pajes[i].map);
send_packet(0,"play "+surface+"step"+random(1, 5)+".ogg "+pajes[i].x+" "+pajes[i].y+" "+pajes[i].map,pajes[i].map);
}
}
if(pajes[i].tempotambor.elapsed>=pajes[i].drum_interval){
pajes[i].drum_interval=random(20000, 30000);
pajes[i].tempotambor.restart();
send_packet(0,"play tamboraldeia.ogg "+pajes[i].x+" "+pajes[i].y+" "+pajes[i].map,pajes[i].map);
}
}
