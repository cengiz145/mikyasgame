send_packet(0,"play "+ss+" "+monkeys[i].x+" "+monkeys[i].y+" "+monkeys[i].map,monkeys[i].map);
break;
}
}
if(monkeys[i].map==objs[za].map&&monkeys[i].x>objs[za].x){
if(objs[za].item=="banana"||objs[za].item=="Apple"||objs[za].item=="fig"||objs[za].item=="strawberry"||objs[za].item=="guava"||objs[za].item=="pear"||objs[za].item=="jabuticaba"||objs[za].item=="persimmon"||objs[za].item=="blackberry"){
