robo_coletores[i].sound_timer.restart();
}
if(robo_coletores[i].walk_timer.elapsed>=210&&robo_coletores[i].morrendo==0&&robo_coletores[i].died==0){
robo_coletores[i].walk_timer.restart();
int i2=get_player_index_from(robo_coletores[i].njogador);
if(i2>-1){
if(players[i2].peaceful==1||get_safezone_at(players[i2].x, players[i2].y, players[i2].map)==true||players[i2].afk||players[i2].map!=robo_coletores[i].map_data)i2=-1;
}
if(i2<0)robo_coletores[i].njogador=select_player_menu(robo_coletores[i].map_data);
i2=get_player_index_from(robo_coletores[i].njogador);
if(i2>-1){
if(players[i2].peaceful==1||get_safezone_at(players[i2].x, players[i2].y, players[i2].map)==true||players[i2].afk||players[i2].map!=robo_coletores[i].map_data)i2=-1;
}
if(i2<0)break;
int walk=1;
if(g_collector_robot(robo_coletores[i], players[i2])>-1&&g_collector_robot(robo_coletores[i], players[i2])<=2&&players[i2].afk==false&&players[i2].peaceful==0&&get_safezone_at(players[i2].x, players[i2].y, players[i2].map)==false){
walk=0;
players[i2].health-=random(3000, 4000);
players[i2].lasthit="Collector_robot";
send_packet(0, "play robobater"+random(1, 2)+".ogg "+players[i2].x+" "+players[i2].y, players[i2].map);
}
if(robo_coletores[i].y!=players[i2].y&&players[i2].jumping==0){
int _cd=climb_dir(robo_coletores[i].map_data, robo_coletores[i].x, robo_coletores[i].y, players[i2].x, players[i2].y, robo_coletores[i].y_up, robo_coletores[i].y_down);
if(_cd==3&&get_tile_at(robo_coletores[i].x, robo_coletores[i].y+1, robo_coletores[i].map_data)!=""&&string_contains(get_tile_at(robo_coletores[i].x, robo_coletores[i].y+1, robo_coletores[i].map_data), "wall", 1)<0){robo_coletores[i].y++;send_packet(0,"play "+get_tile_at(robo_coletores[i].x, robo_coletores[i].y, robo_coletores[i].map_data)+"step"+random(1, 5)+".ogg "+robo_coletores[i].x+" "+robo_coletores[i].y, robo_coletores[i].map_data);break;}
else if(_cd==4&&get_tile_at(robo_coletores[i].x, robo_coletores[i].y-1, robo_coletores[i].map_data)!=""&&string_contains(get_tile_at(robo_coletores[i].x, robo_coletores[i].y-1, robo_coletores[i].map_data), "wall", 1)<0){robo_coletores[i].y--;send_packet(0,"play "+get_tile_at(robo_coletores[i].x, robo_coletores[i].y, robo_coletores[i].map_data)+"step"+random(1, 5)+".ogg "+robo_coletores[i].x+" "+robo_coletores[i].y, robo_coletores[i].map_data);break;}
else if(_cd==1&&get_tile_at(robo_coletores[i].x-1, robo_coletores[i].y, robo_coletores[i].map_data)!=""&&string_contains(get_tile_at(robo_coletores[i].x-1, robo_coletores[i].y, robo_coletores[i].map_data), "wall", 1)<0){robo_coletores[i].x--;send_packet(0,"play "+get_tile_at(robo_coletores[i].x, robo_coletores[i].y, robo_coletores[i].map_data)+"step"+random(1, 5)+".ogg "+robo_coletores[i].x+" "+robo_coletores[i].y, robo_coletores[i].map_data);break;}
else if(_cd==2&&get_tile_at(robo_coletores[i].x+1, robo_coletores[i].y, robo_coletores[i].map_data)!=""&&string_contains(get_tile_at(robo_coletores[i].x+1, robo_coletores[i].y, robo_coletores[i].map_data), "wall", 1)<0){robo_coletores[i].x++;send_packet(0,"play "+get_tile_at(robo_coletores[i].x, robo_coletores[i].y, robo_coletores[i].map_data)+"step"+random(1, 5)+".ogg "+robo_coletores[i].x+" "+robo_coletores[i].y, robo_coletores[i].map_data);break;}
}
if(robo_coletores[i].x>players[i2].x-1&&!players[i2].afk&&string_contains(get_tile_at(robo_coletores[i].x-1, robo_coletores[i].y, robo_coletores[i].map_data), "wall", 1)<0&&walk==1){
robo_coletores[i].x--;
update_moving_sound(robo_coletores[i].s,robo_coletores[i].x,robo_coletores[i].y);
send_packet(0, "play "+get_tile_at(robo_coletores[i].x, robo_coletores[i].y, robo_coletores[i].map_data)+"step"+random(1, 5)+".ogg "+robo_coletores[i].x+" "+robo_coletores[i].y, robo_coletores[i].map_data);
walk=0;
break;
}
else if(robo_coletores[i].x<players[i2].x+1&&!players[i2].afk&&string_contains(get_tile_at(robo_coletores[i].x+1, robo_coletores[i].y, robo_coletores[i].map_data), "wall", 1)<0&&walk==1){
robo_coletores[i].x++;
update_moving_sound(robo_coletores[i].s,robo_coletores[i].x,robo_coletores[i].y);
send_packet(0, "play "+get_tile_at(robo_coletores[i].x, robo_coletores[i].y, robo_coletores[i].map_data)+"step"+random(1, 5)+".ogg "+robo_coletores[i].x+" "+robo_coletores[i].y, robo_coletores[i].map_data);
walk=0;
break;
}
}
}
