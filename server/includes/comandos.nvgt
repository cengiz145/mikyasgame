}
if(tabaluss[i].x>players[i2].x+1&&players[i2].in_safe_zone==false&&players[i2].map==tabaluss[i].map&&players[i2].newbie==false&&players[i2].afk==false&&players[i2].peaceful==0&&tabaluss[i].flee_mode==false){
