// caveman
hcaverna@[] hcavernas;
class hcaverna{
int x, y, health_points=random(100000, 300000), morrendo=0, died=0, narma, ndist=7, ndano=random(2000, 4000), natirar=1232, no_sound=5000;
string map_data, hit_by, njogador;
timer walk_timer, tmorreu, sound_timer, tatirar;
string[] tipoarma={"", "spear", "espada_curta", "sword"};
hcaverna(int zx, int zy, string m, int tn){
x=zx;
y=zy;
map_data=m;
tmorreu.force(0);
tmorreu.pause();
narma=tn;
if(tn==3){
ndist=10;
natirar=random(800, 1400);
ndano=random(5000, 8000);
}
}
~hcaverna(){
for(uint i=0;i<walls.length();i++){
if(walls[i].map==map_data)walls[i].health_points=-1;
}
}
}
void place_caveman(int x, int y, string m, int nn=random(1, 2)){
hcaverna z(x, y, m, nn);
hcavernas.insert_last(z);
place_wall(97, m, 1000000000);
}
void caveman_loop(){
for(uint i=0;i<hcavernas.length();i++){
int has_left=0;
if(hcavernas[i].health_points<=0&&hcavernas[i].died==1&&hcavernas[i].tmorreu.elapsed>=4450){
send_packet(0, "play "+get_tile_at(hcavernas[i].x, hcavernas[i].y, hcavernas[i].map_data)+"harland.ogg "+hcavernas[i].x+" "+hcavernas[i].y,
hcavernas[i].map_data);
string hitter=hcavernas[i].hit_by;
send_reliable(0, "msg2 "+hitter+"; ;killed a; ;homem_das_cavernas;!", 3);
int xx=get_player_index_from(hitter);
if(xx>-1){
players[xx].inv_add_item("antidote", 1);
gain_xp(players[xx].charname, random(500, 1000));
}
hcavernas.remove_at(i);
has_left=1;
return;
}
if(has_left==1)break;
else if(hcavernas[i].died==0&&hcavernas[i].health_points<=0){
send_packet(0, "play v1morte1.ogg "+hcavernas[i].x+" "+hcavernas[i].y, hcavernas[i].map_data);
hcavernas[i].tmorreu.restart();
hcavernas[i].died=1;
}
if(hcavernas[i].sound_timer.elapsed>=hcavernas[i].no_sound&&hcavernas[i].morrendo==0&&hcavernas[i].died==0){
hcavernas[i].no_sound=random(2000, 6200);
send_packet(0, "play uga"+random(1, 2)+".ogg "+hcavernas[i].x+" "+hcavernas[i].y, hcavernas[i].map_data);
hcavernas[i].sound_timer.restart();
}
if(has_left==1)break;
int walk=1;
if(hcavernas[i].tatirar.elapsed>=hcavernas[i].natirar&&hcavernas[i].died==0){
hcavernas[i].tatirar.restart();
int i2=get_player_index_from(hcavernas[i].njogador);
if(i2>-1){
if(players[i2].peaceful==1||get_safezone_at(players[i2].x, players[i2].y, players[i2].map)==true||players[i2].afk||players[i2].map!=hcavernas[i].map_data)i2=-1;
}
if(i2<0)hcavernas[i].njogador=select_player_menu(hcavernas[i].map_data);
i2=get_player_index_from(hcavernas[i].njogador);
if(i2>-1){
if(players[i2].peaceful==1||get_safezone_at(players[i2].x, players[i2].y, players[i2].map)==true||players[i2].afk||players[i2].map!=hcavernas[i].map_data)i2=-1;
}
if(i2<0)break;
if(g(hcavernas[i].x, hcavernas[i].y, players[i2].x, players[i2].y)<=hcavernas[i].ndist&&players[i2].afk==false&&players[i2].peaceful==0&&get_safezone_at(players[i2].x, players[i2].y,players[i2].map)==false){
walk=0;
send_packet(0, "play "+hcavernas[i].tipoarma[hcavernas[i].narma]+".ogg "+hcavernas[i].x+" "+hcavernas[i].y, hcavernas[i].map_data);
players[i2].health-=hcavernas[i].ndano;
send_packet(0, "play uga_bater"+random(1, 2)+".ogg "+hcavernas[i].x+" "+hcavernas[i].y, hcavernas[i].map_data);
players[i2].lasthit="homem_das_cavernas";
break;
}
}
walk=0;
if(hcavernas[i].walk_timer.elapsed>=210&&hcavernas[i].morrendo==0&&hcavernas[i].died==0&&walk==1&&hcavernas[i].narma<3){
hcavernas[i].walk_timer.restart();
int i2=get_player_index_from(hcavernas[i].njogador);
if(i2>-1){
if(players[i2].peaceful==1||get_safezone_at(players[i2].x, players[i2].y, players[i2].map)==true||players[i2].afk||players[i2].map!=hcavernas[i].map_data)i2=-1;
}
if(i2<0)hcavernas[i].njogador=select_player_menu(hcavernas[i].map_data);
i2=get_player_index_from(hcavernas[i].njogador);
if(i2>-1){
if(players[i2].peaceful==1||get_safezone_at(players[i2].x, players[i2].y, players[i2].map)==true||players[i2].afk||players[i2].map!=hcavernas[i].map_data)i2=-1;
}
if(i2<0)break;
bool has_moved_hu = false;

// Movement along X (left/right)
if(hcavernas[i].x > players[i2].x && string_contains(get_tile_at(hcavernas[i].x-1, hcavernas[i].y, hcavernas[i].map_data), "wall", 1) < 0) {
    hcavernas[i].x--;
    has_moved_hu = true;
}
else if(hcavernas[i].x < players[i2].x && string_contains(get_tile_at(hcavernas[i].x+1, hcavernas[i].y, hcavernas[i].map_data), "wall", 1) < 0) {
    hcavernas[i].x++;
    has_moved_hu = true;
}

// Movement along Y (up/down) - THIS FIXES THE BUG YOU REPORTED
if(hcavernas[i].y > players[i2].y && string_contains(get_tile_at(hcavernas[i].x, hcavernas[i].y-1, hcavernas[i].map_data), "wall", 1) < 0) {
    hcavernas[i].y--;
    has_moved_hu = true;
}
else if(hcavernas[i].y < players[i2].y && string_contains(get_tile_at(hcavernas[i].x, hcavernas[i].y+1, hcavernas[i].map_data), "wall", 1) < 0) {
    hcavernas[i].y++;
    has_moved_hu = true;
}

if(has_moved_hu) {
    send_packet(0, "play " + get_tile_at(hcavernas[i].x, hcavernas[i].y, hcavernas[i].map_data) + "step" + random(1, 5) + ".ogg " + hcavernas[i].x + " " + hcavernas[i].y, hcavernas[i].map_data);
    walk = 0;
}
}
for(uint i2=0;i2<players.length();i2++){
if(players[i2].map==hcavernas[i].map_data&&players[i2].afk==false&&players[i2].peaceful==0&&g(hcavernas[i].x, hcavernas[i].y, players[i2].x, players[i2].y)<=hcavernas[i].ndist){
hcavernas[i].njogador=players[i2].charname;
break;
}
}
}
}
