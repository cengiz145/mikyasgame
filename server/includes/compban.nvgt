string get_comp_bans(){
if(banidos.length()==0)return "There's no banned users.";
string ret="Banidos: ";
string[] b;
for(uint i=0;i<banidos.length();i++){
string[] dd=string_split(banidos[i], ":", false);
b.insert_last(dd[0]);
}
return "Banidos: "+linear(b);
}
bool comp_ban(string username){
int ban_index=get_player_index_from(username);
if(ban_index>-1){
string b=username+":"+players[ban_index].computer_id+":"+net.get_peer_address(players[ban_index].peer_id);
banidos.insert_last(b);
send_reliable(0,"msgdepois "+players[ban_index].charname+" was banned"+".",0);
send_reliable(players[ban_index].peer_id,"kill",0);
return true;
}
else
{
return false;
}
}
bool comp_unban(string username){
bool banned_flag=false;
for(uint i=0;i<banidos.length();i++){
string[] d=string_split(banidos[i], ":", false);
if(d[0]==username){
banidos.remove_at(i);
banned_flag=true;
}
}
return banned_flag;
}
bool is_banned(string id){
for(uint i=0;i<banidos.length();i++){
string[] ver=string_split(banidos[i], ":", false);
if(ver.length()>1){
if(string_contains(ver[1], id, 1)>-1)return true;
}
}
return false;
}
