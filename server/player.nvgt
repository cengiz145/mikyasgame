bool is_admin()
{
return this.dev||this.admin;
}
void inv_add_item(string itemname, double itemvalue, bool send=true)
{
string content=inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] values;
for(double i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
if(inv_item_exists(itemname))
{
double orgval;
if(inv_item(itemname) > -1)
{
orgval=string_to_number(values[inv_item(itemname)]);
}
else
{
return;
}
if(orgval+itemvalue < 1)
{
inv_delete_item(itemname);
if (string_contains(itemname,"mm",1)==0 and string_contains(itemname,"food",1)==-1 and itemname!="mina"&&itemname!="xp")
send_reliable(peer_id,itemvalue+" "+itemname,4);
}
else
{
values[inv_item(itemname)]=(orgval+itemvalue);
string tempinv;
for(double i=0; i<peramitors.length(); i++)
{
tempinv+=peramitors[i]+"="+values[i]+"\r\n";
}
inv=tempinv;
}
}
else
{
if(itemvalue > 0)
{
inv+=itemname+"="+itemvalue+"\r\n";
if (string_contains(itemname,"mm",1)==0 and string_contains(itemname,"food",1)==-1 and itemname!="mina"&&itemname!="xp")
send_reliable(peer_id,itemvalue+" "+itemname,4);
}
}
if(send==true){
send_reliable(peer_id,"inv "+inv,0);
string[] invsec;
if(inv_item_number("fishing_rod")>0)invsec.insert_last("fishing_rod");
if(inv_item_number("dart")>0)invsec.insert_last("dart");
if(inv_item_number("poisoned_dart")>0)invsec.insert_last("poisoned_dart");
if(inv_item_number("explosive_tape")>0)invsec.insert_last("explosive_tape");
if(invsec.length()>0)send_reliable(peer_id, "invsec "+linear(invsec), 0);
}
}
bool inv_item_exists(string itemname)
{
string content=inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] values;
for(double i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
for(double i=0; i<peramitors.length(); i++)
{
if(peramitors[i]==itemname)
{
return true;
}
}
return false;
}
double inv_item_number(string itemname)
{
string content=inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] values;
for(double i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
for(double i=0; i<peramitors.length(); i++)
{
if(peramitors[i]==itemname)
{
return string_to_number(values[i]);
}
}
return 0;
}
double inv_item(string itemname)
{
string content=inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] values;
for(double i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
for(double i=0; i<peramitors.length(); i++)
{
if(peramitors[i]==itemname)
{
return i;
}
}
return -1;
}
void inv_delete_item(string itemname)
{
string content=inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] values;
for(double i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
for(double i=0; i<peramitors.length(); i++)
{
if(peramitors[i]==itemname)
{
inv=string_replace(inv, itemname+"="+values[i]+"\r\n", "", false);
}
}
}
bool has_muted(string name)
{
string[] m=string_split(muted,"\r\n",false);
for (double i=0; i<m.length(); i++)
{
if (m[i]==name)
{
return true;
}
}
return false;
}
void add_muted(string name)
{
muted+="\r\n"+name;
write_to(charname,"muted.usr",muted);
}
bool remove_muted(string name)
{
string[] m=string_split(muted,"\r\n",false);
string newmuted;
bool succeeded;
for (double i=0; i<m.length(); i++)
{
if (m[i]!=name)
newmuted+="\r\n"+m[i];
else
succeeded=true;
}
muted=newmuted;
write_to(charname,"muted.usr",muted);
return succeeded;
}
}
void spawn_player(double id, string name, string version_str, string thebanid){
player player1(id, name, version_str,thebanid);
players.insert_last(player1);
}
double get_player_distance(player@ p1, player@ p2)
{
if(p1.map!=p2.map) return -1;
double dx,dy;
if(p1.x<=p2.x) dx=p2.x-p1.x;
else dx=p1.x-p2.x;
if(p1.y<=p2.y) dy=p2.y-p1.y;
else dy=p1.y-p2.y;
return dx+dy;
}
double get_bullet_y_distance(bullet@ p1, player@ p2){
if(p1.mapname!=p2.map) return -1;
int dy;
if(p1.y<=p2.y) dy=p2.y-p1.y;
else dy=p1.y-p2.y;
return dy;
}

