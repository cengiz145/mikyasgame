}
else if(me.x>=max.x){
me.x=max.x-1;
send_reliable(peer_id,"move "+me.x+" "+me.y,0);
}
else if(me.y<0){
me.y=1;
send_reliable(peer_id,"move "+me.x+" "+me.y,0);
}
else if(me.y>=max.y){
me.y=max.y-2;
send_reliable(peer_id,"move "+me.x+" "+me.y,0);
}
}
if(echotimer.elapsed>=echotime&&echo==true)
{
echocheck(facing);
}
}
