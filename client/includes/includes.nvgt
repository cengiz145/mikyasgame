int addpos;
add@[] adds;
class add{
int active=1;
int pos;
string name;
string[] items;
add(string n){
name=n;
}
}
void create_add(string bname){
add b1(bname);
adds.insert_last(b1);
}
void firstadd(){
addpos=0;
speakfocusedadd();
}
void lastadd(){
addpos=adds.length()-1;
speakfocusedadd();
}
void addleft(){
if (addpos<=0)addpos=0;
else{
addpos-=1;
speakfocusedadd();
}
}
void addright(){
if (addpos>=(adds.length()-1)){
if (adds.length()>0)addpos=adds.length()-1;
}
else{
addpos+=1;
speakfocusedadd();
}
}
void nextadditem(){
if (adds[addpos].pos<(adds[addpos].items.length()-1)){
adds[addpos].pos+=1;
speak(pu.get_value(adds[addpos].items[adds[addpos].pos]));
}
}
void prevadditem(){
if (adds[addpos].pos>0){
adds[addpos].pos-=1;
speak(pu.get_value(adds[addpos].items[adds[addpos].pos]));
}
}
void topadditem(){
if (adds[addpos].items.length()>0){
adds[addpos].pos=0;
speak(pu.get_value(adds[addpos].items[adds[addpos].pos]));
}
}
void bottomadditem(){
if (adds[addpos].items.length()>0){
adds[addpos].pos=(adds[addpos].items.length()-1);
speak(pu.get_value(adds[addpos].items[adds[addpos].pos]));
}
}
void add_add_item(string addname, string item,bool speakitem=true){
for (uint i=0; i<adds.length(); i++) {
if (adds[i].name==addname||adds[i].name=="tudo"){
if (speakitem&&adds[i].name!="tudo")speak(item, 0);
adds[i].items.insert_last(item);
}
}
}
void speakfocusedadd(){
if (adds[addpos].items.length()>0)speak(pu.get_value(adds[addpos].name)+". "+(adds[addpos].pos+1)+" "+pu.get_value("de")+" "+adds[addpos].items.length()+".");
else speak(pu.get_value(adds[addpos].name)+". "+pu.get_value("Vazio."));
}
int add_active(string addname){
for (uint i=0; i<adds.length(); i++){
if (adds[i].name==addname)return adds[i].active;
}
return 0;
}
ambiente@[] ambientes;
sound_pool ambientepool;
class ambiente{
string id;
int ambiente_sound;
int lx;
int rx;
int miny;
int maxy;
string soundfile;
ambiente(int ambiente_lx, int ambiente_rx, int ambiente_miny, int ambiente_maxy, string file, string sid){
id=sid;
lx=ambiente_lx;
rx = ambiente_rx;
miny=ambiente_miny;
maxy= ambiente_maxy;
soundfile=file;
ambiente_sound=ambientepool.play_2d(soundfile, me.x, me.y, lx, miny, true);
ambientepool.update_sound_range_2d(ambiente_sound, (me.x-lx), (rx-lx), (me.y-miny), (maxy-miny));
}
}
void ambientecheckloop(){
for (uint i=0; i<ambientes.length(); i++){
ambientepool.update_sound_2d(ambientes[i].ambiente_sound, ambientes[i].lx, ambientes[i].miny);
ambientepool.update_sound_range_2d(ambientes[i].ambiente_sound, (me.x-ambientes[i].lx), (ambientes[i].rx-ambientes[i].lx), (me.y-ambientes[i].miny), (ambientes[i].maxy-ambientes[i].miny));
}
}
void destroy_ambiente(int s)
{
ambientepool.destroy_sound(ambientes[s].ambiente_sound);
ambientes.remove_at(s);
}
void destroy_all_ambientes(bool delete=true){
for(uint i=0; i<ambientes.length(); i++){
ambientepool.destroy_sound(ambientes[i].ambiente_sound);
}
ambientes.resize(0);
}
void spawn_ambiente(int ambiente_lx, int ambiente_rx, int ambiente_miny, int ambiente_maxy, string soundfile,string id){
soundfile=string_replace(soundfile,".ogg",".ogg",true);
ambiente ambiente1(ambiente_lx, ambiente_rx, ambiente_miny, ambiente_maxy, soundfile,id);
ambientes.insert_last(ambiente1);
}
//DJT
class bass{
	library bass;
	long init_bass(){
		bass.load("bass.dll");
		dictionary s=bass.call("void BASS_Init(long, long, long, float, float);",-1, 44100, 0, 0, 0);
		long handle;
		s.get("0",handle);
		return handle;
	}
	long load(string url){
		dictionary s=bass.call("long BASS_StreamCreateURL(char*,long,long,int,int);",url,0,0,0,0);
		long h;
		s.get(0,h);
		return h;
	}
	void play(long handle){
		bass.call("void BASS_ChannelPlay(long,long);",handle,0);
	}
	void stop(long handle){
		bass.call("void BASS_ChannelStop(long);",handle);
	}
	void volume(long set_volume)
	{
		bass.call("void BASS_SetConfig(long, long);", 5, set_volume);
	}
}
class lancha{
int x, y, saindo=0;
int nalancha=0;
timer tligando, tandar;
sound liga, loops, desliga;
string id;
int andando=0;
bool ligando=false, desligando=false, ligou=false;
void sair(){
send_reliable(peer_id, "lancha d", 0);
desliga.play();
while(desliga.playing){
wait(5);
mainloop();
}
}
void loop(){
nalancha=1;
liga.load("lanchal.ogg");
desliga.load("lanchad.ogg");
loops.load("lanchaloop.ogg");
liga.volume=-100;
andando=0;
send_reliable(peer_id, "lancha n", 0);
while(true){
wait(5);
if(saindo==1){
saindo=0;
nalancha=0;
break;
}
mainloop();
secundario();
if(key_pressed(KEY_ESCAPE)&&!desligando&&!ligou){
nalancha=0;
saindo=1;
break;
}
if(key_pressed(KEY_S))send_reliable(peer_id, "lancha s", 0);
if(key_down(KEY_RIGHT))facing=Right;
if(key_down(KEY_LEFT))facing=Left;
if(key_pressed(KEY_E)&&get_tile_at(me.x, me.y)!="water2"){
if(tenter.elapsed>=2500||mapname=="mina_de_ouro"&&tenter.elapsed>=410||mapname=="pesqueiro"&&tenter.elapsed>=1000){
tenter.restart();
send_reliable(peer_id, "imenu", 0);
}
}
for(uint i=0;i<msounds.length();i++){
if(msounds[i].id==id){
p.update_sound_2d(msounds[i].loopint,me.x,me.y);
}
}
if(key_pressed(KEY_UP)&&!desligando){
if(!ligou){
send_reliable(peer_id, "lancha l", 0);
liga.play();
tligando.restart();
ligando=true;
desligando=false;
while(liga.playing){
wait(5);
if(tligando.elapsed>=7184){
send_reliable(peer_id, "lancha ll", 0);
tligando.force(0);
tligando.pause();
}
mainloop();
}
ligou=true;
}
else if(andando==0)andando=1;
}
if(key_pressed(KEY_DOWN)&&!liga.playing){
if(andando==1)andando=0;
else if(ligou){
send_reliable(peer_id, "lancha d", 0);
desliga.play();
while(desliga.playing){
wait(5);
mainloop();
}
ligou=false;
}
}
if(ligou){
if(tandar.elapsed>=150&&andando==1){
if(facing==Right){
string d=get_tile_at(me.x+1, me.y);
if(d!=""&&string_contains(d, "mud", 1)<0){
tandar.restart();
me.x++;
send_reliable(peer_id, "move3 "+me.x+" "+me.y, 0);
}
}
else if(facing==Left){
string d=get_tile_at(me.x-1, me.y);
if(d!=""&&string_contains(d, "mud", 1)<0){
tandar.restart();
me.x--;
send_reliable(peer_id, "move3 "+me.x+" "+me.y, 0);
}
}
}
}
}
}
}
itembonus@[] itensbonus;
class itembonus{
int x, s, pitch=100;
timer tficar, tmudar;
itembonus(int bx){
x=bx;
p.play_extended_2d("objcaindo.ogg", me.x, me.y, x, 0, 0, 0, 0, 0, true, 0.0, 0.0, 0.0, tficar.elapsed/5);
}
}
void cbonus(int x){
itembonus b(x);
itensbonus.insert_last(b);
}
void bonusloop(){
for(uint i=0;i<itensbonus.length();i++){
if(itensbonus[i].tmudar.elapsed>=10){
itensbonus[i].pitch--;
itensbonus[i].tmudar.restart();
}
p.update_sound_2d(itensbonus[i].s,itensbonus[i].x,0);
p.update_sound_start_values(itensbonus[i].s, 0, -1, itensbonus[i].pitch);
if(itensbonus[i].tficar.elapsed>=1000){
p.destroy_sound(itensbonus[i].s);
itensbonus.remove_at(i);
break;
}
if(itensbonus[i].x==me.x){
p.destroy_sound(itensbonus[i].s);
itensbonus.remove_at(i);
send_reliable(peer_id, "gbonus", 0);
p.play_stationary("get_raw.ogg", false);
break;
}
}
}
void rtudobonus(){
for(uint i=00;i<itensbonus.length();i++){
p.destroy_sound(itensbonus[i].s);
itensbonus.remove_at(i);
}
}
class telefone
{
string input(string text)
{
int cursor;
bool caiu;
string message;
if(text!="")speak(pu.get_value(text));
cursor=0;
caiu=false;
string[] ms;
get_characters();
sound telefonecaiu;
telefonecaiu.load("telefone2.ogg");
send_reliable(peer_id, "playsocial telefonetirandogancho.ogg", 0);
while(true)
{
mainloop();
if(caiu==true){
telefonecaiu.play_looped();
}
string char=get_characters();
for (uint i=0; i<char.length(); i++) {
string chars=char[i];
if(chars!=""&&chars!="1"&&chars!="2"&&chars!="3"&&chars!="4"&&chars!="5"&&chars!="6"&&chars!="7"&&chars!="8"&&chars!="9"&&chars!="0"&&chars!="-"&&chars!="#"&&chars!="*"&&caiu==false){
caiu=true;
}
else if(caiu==false){
if(chars=="1")
p.play_stationary("1.ogg", false);
if(chars=="2")
p.play_stationary("2.ogg", false);
if(chars=="3")
p.play_stationary("3.ogg", false);
if(chars=="4")
p.play_stationary("4.ogg", false);
if(chars=="5")
p.play_stationary("5.ogg", false);
if(chars=="6")
p.play_stationary("6.ogg", false);
if(chars=="7")
p.play_stationary("7.ogg", false);
if(chars=="8")
p.play_stationary("8.ogg", false);
if(chars=="9")
p.play_stationary("9.ogg", false);
if(chars=="0")
p.play_stationary("0.ogg", false);
if(chars=="*")
p.play_stationary("asterisco.ogg", false);
if(chars=="#")
p.play_stationary("#.ogg", false);
ms.insert_at(cursor,char);
cursor+=1;
}
}
if(key_pressed(KEY_ESCAPE))
{
send_reliable(peer_id, "playsocial telefonecolocandogancho.ogg", 0);
return "";
}
else if(key_pressed(KEY_RETURN))
{
if (ms.length() > 0)
{
sound s;
for (uint i=0; i<ms.length(); i++)
{
message+=ms[i];
s.load(ms[i]+".ogg");
s.play_wait();
}
return message;
}
else if (ms.length()==0)
{
send_reliable(peer_id, "playsocial telefonecolocandogancho.ogg", 0);
return "";
}
}
}
return "";
}
}
carro@[] carros;
