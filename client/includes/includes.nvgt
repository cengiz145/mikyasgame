void gladiadoresmenu()
{
speak(pu.get_value("Menu de gladiadores. Selecione um gladiador com as setas, e F1 para ajuda."));
key_hold ileft(KEY_LEFT,500,50);
key_hold iright(KEY_RIGHT,500,50);
key_hold iup(KEY_UP,500,50);
key_hold idown(KEY_DOWN,500,50);
key_hold idell(KEY_DELETE,500,50);
get_characters();
string cl;
int counter=0;
string[] peramitors=gladiadores;
string[] peramitors2;
while(true)
{
cl=get_characters();
wait(5);
mainloop();
peramitors.resize(0);
peramitors2.resize(0);
peramitors2=gladiadores;
for(uint i=0;i<peramitors2.length();i++){
string[] gla=string_split(peramitors2[i], ":", false);
peramitors.insert_last(gla[0]);
}
if(counter > peramitors.length())
{
counter=peramitors.length()-1;
}
if(cl!="" and cl!=" " and cl.length()==1 and peramitors.length()>0)
{
int f=0;
int oc=counter;
for(uint i=counter; i<peramitors.length(); i++)
{
if(i==counter)
{
continue;
}
if(peramitors[i][0]==cl)
{
counter=i;
p.play_stationary("invclick.ogg",false);
speak(pu.get_value(peramitors[counter]));
cl="";
f=1;
break;
}
}
if(f==0)
{
counter=0;
for(uint i=counter; i<peramitors.length(); i++)
{
if(peramitors[i][0]==cl)
{
counter=i;
p.play_stationary("invclick.ogg",false);
speak(pu.get_value(peramitors[counter]));
cl="";
f=1;
break;
}
}
}
if(f==0){
counter=oc;
}
}
if(key_pressed(KEY_F1))add_add_item("variado", pu.get_value("Selecione o gladiador desejado com as setas, e use uma destas opções: Enter: Inicia a luta contra o gladiador selecionado, caso esteja na patente requerida. CTRL+L: Mostra a patente necessária para lutar contra o gladiador selecionado. CTRL+b: Mostra quantos coins você tem que pagar para lutar. CTRL+ENTER: Mostra a descrição do gladiador."));
if(key_down(KEY_RCONTROL)&&key_pressed(KEY_B)||key_down(KEY_LCONTROL)&&key_pressed(KEY_B)){
for(uint i=0;i<gladiadores.length();i++){
string[] gla=string_split(gladiadores[i], ":", false);
if(gla[0]==peramitors[counter]) add_add_item("variado", pu.get_value("Você precisa de")+" "+gla[3]+" "+pu.get_value("coins para poder lutar contra esse gladiador."));
}
}
if(key_down(KEY_LCONTROL)&&key_pressed(KEY_RETURN)||key_down(KEY_RCONTROL)&&key_pressed(KEY_RETURN)&&peramitors.length()>0)desc2(peramitors[counter]);
else if(key_pressed(KEY_RETURN)&&peramitors.length()>0&&counter < peramitors.length())
{
interact2(peramitors[counter]);
}
else if(key_down(KEY_LCONTROL)&&key_pressed(KEY_L)||key_down(KEY_RCONTROL)&&key_pressed(KEY_L))pnivelgladiador(peramitors[counter]);
else if (key_down(KEY_LCONTROL) and key_pressed(KEY_C) and peramitors.length()>0 or key_down(KEY_RCONTROL) and key_pressed(KEY_C) and peramitors.length()>0)
{
clipboard_copy_text(peramitors[counter]);
speak("copied");
}
if(key_pressed(KEY_HOME) and peramitors.length()>0)
{
counter=0;
p.play_stationary("invclick.ogg",false);
speak(pu.get_value(peramitors[counter]));
}
if(key_pressed(KEY_END) and peramitors.length()>0)
{
counter=peramitors.length()-1;
p.play_stationary("invclick.ogg",false);
speak(pu.get_value(peramitors[counter]));
}
if(iup.pressing())
{
if(peramitors.length()==1)
{
p.play_stationary("invclick.ogg",false);
speak(pu.get_value(peramitors[counter]));
counter=0;
}
else if(counter > 0)
{
counter--;
p.play_stationary("invclick.ogg",false);
speak(pu.get_value(peramitors[counter]));
}
}
if(idown.pressing())
{
if(peramitors.length()==1)
{
p.play_stationary("invclick.ogg",false);
speak(pu.get_value(peramitors[counter]));
counter=0;
}
else if(counter < peramitors.length()-1)
{
counter++;
p.play_stationary("invclick.ogg",false);
speak(pu.get_value(peramitors[counter]));
}
}
if(key_pressed(KEY_ESCAPE))
{
return;
}
}
}
class googletranslateclient{
private http req;
private string from;
private string to;
private string phpscript_url;
bool selecionar_url(string phpscript){
this.phpscript_url=url_encode(phpscript);
this.phpscript_url=string_replace(this.phpscript_url, "%3a", ":", true);
this.phpscript_url=string_replace(this.phpscript_url, "%2f", "/", true);
return this.phpscript_url!="";
}
bool selecionar_linguagem_origem(string lang){
this.from=lang;
return this.from==lang;
}
bool selecionar_linguagem_destino(string lang){
this.to=lang;
return this.to==lang;
}
string traduzir(string texto){
string t="origem="+from+"&destino="+to+"&texto="+texto;
string trans=this.req.post(this.phpscript_url, t);
if(trans==""){
if(get_last_error()==0){
while(this.req.progress){
mainloop();
trans+=this.req.request();
}
string textotxt=trans;
if(textotxt!="")return textotxt;
else return "";
}
}
return "";
}
}
obj@[] objs;
class obj{
int num;
string item;
string map;
int x,y;
timer looptimer;
int loop=random(135, 136);
obj(int ox, int oy, string what, int amount){
x=ox;
y=oy;
item=what;
num=amount;
}
}
void spawn_obj(int x=random(0,200), int y=0, string what="knife", int amount=1){
if (objs.length()<=600){
obj obj1(x,y,what,amount);
objs.insert_last(obj1);
}
}
void objsloop(){
for(uint i=0;i<objs.length();i++){
if(get_tile_at(objs[i].x, objs[i].y)==""||string_contains(get_tile_at(objs[i].x, objs[i].y), "branch", 1)>-1&&objs[i].y>0) objs[i].y--;
if (objs[i].x>=me.x-15&&objs[i].x<=me.x+15&&objs[i].looptimer.elapsed>=objs[i].loop){
objs[i].looptimer.restart();
pobjs.play_extended_2d("item.ogg",me.x,me.y,objs[i].x,objs[i].y,0,0,0,0,false,0,0,0, random(100, 101));
}
}
}
class jogoparouimpar{
int moedas, quantidade;
string tescolha;;
sound s, ambiente;
void fim(){
s.close();
ambiente.close();
}
void jogar(){
if(ausente)return;
if(inv_item_number("coins")<500) return;
add_add_item("variado", pu.get_value("Par ou ímpar!"));
ambiente.load("musica14.ogg");
ambiente.volume=-20;
ambiente.play_looped();
while(true){
mainloop();
if(ausente){
fim();
break;
}
moedas=inv_item_number("coins");
if(moedas<=0){
p.play_stationary("notify_died.ogg", false);
send_reliable(0, "draw notify_died.ogg", 0);
fim();
break;
}
if(key_pressed(KEY_ESCAPE)){
p.play_stationary("menuvolta.ogg", false);
fim();
break;
}
if(key_pressed(KEY_H)){
add_add_item("variado", pu.get_value("Para definir a quantidade de coins que deseja apostar, pressione 1, digite o valor e enter."));
}
if(key_pressed(KEY_C)) add_add_item("variado", pu.get_value("Você tem")+" "+moedas+" "+pu.get_value("coins para apostar."));
if(key_pressed(KEY_1)){
string quanto=v.input("Quantos coins você quer apostar?");
quantidade=string_to_number(quanto);
if(quantidade>moedas){
add_add_item("variado", pu.get_value("Você não tem")+" "+quantidade+" "+pu.get_value("coins para apostar."));
quantidade=0;
}
if(quantidade<500||quantidade>1000){
add_add_item("variado", pu.get_value("O valor para apostar tem que ser de 500 à 1000."));
quantidade=0;
}
}
if(key_pressed(KEY_2)){
setupmenu();
m.add_item_tts(pu.get_value("Par"), "Par");
m.add_item_tts(pu.get_value("Ímpar"), "Ímpar");
m.add_item_tts(pu.get_value("Voltar"), "voltar");
int mres=m.run(pu.get_value("Escolha o tipo  de número que deseja apostar."), true);
if(m.get_item_name(mres)!="voltar") tescolha=m.get_item_name(mres);
}
if(key_pressed(KEY_RETURN))
{
if(quantidade<500||quantidade>1000 || tescolha=="") add_add_item("variado", pu.get_value("Você deve definir a quantia e escolher o tipo de número que irá apostar!"));
else
{
add_add_item("variado", pu.get_value("Randomisando os números de 1 à 10..."));
s.close();
s.load("dado1.ogg");
s.play();
send_reliable(0, "draw dado1.ogg", 0);
while(s.playing)
{
wait(5);
mainloop();
}
int resultado=random(1, 10);
if(resultado==1||resultado==3||resultado==5||resultado==7||resultado==9)
{
if(tescolha=="Ímpar")
{
add_add_item("variado", pu.get_value("Boa, o número é ímpar!"));
send_reliable(0, "acoins "+quantidade, 2);
tescolha="";
fim();
break;
}
else if(tescolha=="Par")
{
add_add_item("variado", pu.get_value("O número é ímpar, eu ganhei!"));
send_reliable(0, "acoins -"+quantidade, 2);
tescolha="";
fim();
break;
}
}
else if(resultado==2||resultado==4||resultado==6||resultado==8||resultado==10)
{
if(tescolha=="Par")
{
add_add_item("variado", pu.get_value("Boa, o número é par!"));
send_reliable(0, "acoins "+quantidade, 2);
tescolha="";
fim();
break;
}
else if(tescolha=="Ímpar")
{
add_add_item("variado", pu.get_value("O número é par, eu ganhei!"));
send_reliable(0, "acoins -"+quantidade, 2);
tescolha="";
fim();
break;
}
}
}
}
}//fim do while
}//Fim do void
}
