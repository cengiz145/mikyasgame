class jogopoker{
int num1,num2, quantidade=0, moedas;
bool at=true;
sound s;
void jogar(){
s.load("musica11.ogg");
s.play_looped();
add_add_item("variado", pu.get_value("Escolha 1 para pedra, 2 para papel, 3 para tesoura ou ESC para sair. Espaço para definir a quantidade que irá apostar, entre 100 à 1000 coins."));
while(true){
wait(5);
mainloop();
if(ausente){
break;
}
moedas=inv_item_number("coins");
if(at==true){
num2=random(1,3);
at=false;
}
if(key_pressed(KEY_ESCAPE)){
s.close();
p.play_stationary("menuvolta.ogg", false);
break;
}
if(key_pressed(KEY_SPACE)&&quantidade<=0){
string quanto=v.input(pu.get_value("Quantos coins você quer apostar?"));
quantidade=string_to_number(quanto);
if(quantidade<100||quantidade>1000){
add_add_item("variado", pu.get_value("O valor para apostar tem que ser de")+" 100 "+pu.get_value("até")+" 1000.");
quantidade=0;
}
if(quantidade>moedas){
add_add_item("variado", pu.get_value("Você não tem")+" "+quantidade+" "+pu.get_value("coins para apostar."));
quantidade=0;
}
}
if(key_pressed(KEY_1)&&quantidade>0){
num1=1;
checar();
}
else if(key_pressed(KEY_2)&&quantidade>0){
num1=2;
checar();
}
else if(key_pressed(KEY_3)&&quantidade>0){
num1=3;
checar();
}
}
}
void checar(){
if(num1==1&&num2==1)
{
add_add_item("variado", pu.get_value("Uou! pedra e pedra! é um impate!"));
}
else if(num1==2&&num2==2)
{
add_add_item("variado", pu.get_value("Uou! papel e papel! é um impate!"));
}
else if(num1==3&&num2==3)
{
add_add_item("variado", pu.get_value("Uou! tesoura e tesoura! é um impate!"));
}
else
{
if(num1==1)
{
if(num2==2)
{
add_add_item("variado", pu.get_value("Rá! papel embrulha pedra! eu ganhei! você não é de nada!"));
send_reliable(0, "acoins -"+quantidade, 2);
}
else if(num2==3)
{
add_add_item("variado", pu.get_value("Ops, pedra quebra tesoura, parabéns, você ganhou!"));
send_reliable(0, "acoins "+quantidade, 0);
}
}
if(num1==2)
{
if(num2==1)
{
add_add_item("variado", pu.get_value("Ops, papel embrulha pedra, parabéns! você ganhou!"));
send_reliable(0, "acoins "+quantidade, 2);
}
else if(num2==3)
{
add_add_item("variado", pu.get_value("Rá! tesoura corta papel! eu ganhei! você não é de nada!"));
send_reliable(0, "acoins -"+quantidade, 2);
}
}
else if(num1==3)
{
if(num2==1)
{
add_add_item("variado", pu.get_value("Rá! pedra quebra tesoura! eu ganhei! você não é de nada!"));
send_reliable(0, "acoins -"+quantidade, 2);
}
else if(num2==2)
{
add_add_item("variado", pu.get_value("Ops, tesoura corta papel, parabéns, você ganhou!"));
send_reliable(0, "acoins "+quantidade, 2);
}
}
}
at=true;
}
}
class jogofarkle{
bool iniciou=false, turno1=false, vaijogar=false;//Não iniciou ainda, nenhum turno aconteceu e ninguém vai jogar
int seudado=0, dadocomputador=0, quemjoga=0, ganhou=0;//Seu dado, o dádo da máquina, quem joga e ganhou em zero.
int quantidade=0, moedas;
sound ambiente;
void fim(){
ambiente.close();
}
void jogar(){
sound d1, d2, d3;
d1.load("dado1.ogg");
d2.load("dado2.ogg");
d3.load("dado3.ogg");
ambiente.load("musica12.ogg");
ambiente.volume=-15;
ambiente.play_looped();
while(true){
wait(5);
mainloop();
if(ausente){
fim();
break;
}
moedas=inv_item_number("coins");
if(moedas<=0){
p.play_stationary("notify_died.ogg", false);
send_reliable(0, "draw notify_died.ogg", 0);
fim();
break;
}
if(key_pressed(KEY_ESCAPE)){
fim();
p.play_stationary("menuvolta.ogg", false);
break;
}
if(key_pressed(KEY_1)){
string quanto=v.input("Quantos coins você quer apostar?");
quantidade=string_to_number(quanto);
if(quantidade>moedas){
add_add_item("variado", pu.get_value("Você não tem")+" "+quantidade+" "+pu.get_value("coins para apostar."));
quantidade=0;
}
if(quantidade<1000||quantidade>5000){
add_add_item("variado", pu.get_value("O valor para apostar tem que ser de")+" 1000 "+pu.get_value("até")+" 5000.");
quantidade=0;
}
}
if(key_pressed(KEY_RETURN)){
if(quantidade<=0)add_add_item("variado", pu.get_value("Defina a quantidade que vai apostar primeiro!"));
else{
if(!iniciou){//Se não jogou ainda
add_add_item("variado", pu.get_value("Jogo dos dados. Jogue contra mim e veja se é forte o suficiente para vencer esta batalha!"));
iniciou=true;//define que o jogo iniciou.
}
}
}
if(iniciou&&!turno1){
turno1=true;
add_add_item("variado", pu.get_value("Atenção! Chegou a hora de decidir quem irá começar..."));
wait(2000);
p.play_stationary("dado3.ogg", false);
wait(300);
p.play_stationary("dado3.ogg", false);
wait(100);
p.play_stationary("dado3.ogg", false);
int a=random(1, 2);
if(a==1){
add_add_item("variado", pu.get_value("Você começa!"));
quemjoga=1;
}
else if(a==2){
add_add_item("variado", pu.get_value("Eu começo!"));
quemjoga=2;
}
vaijogar=true;
}
if(vaijogar==true){
if(quemjoga==1){
add_add_item("variado", pu.get_value("Sua vez."));
while(true){
wait(5);
if(ausente){
fim();
break;
}
moedas=inv_item_number("coins");
mainloop();
if(moedas<=0){
p.play_stationary("notify_died.ogg", false);
send_reliable(0, "draw notify_died.ogg", 0);
fim();
break;
}
if(key_pressed(KEY_ESCAPE)){
fim();
p.play_stationary("menuvolta.ogg", false);
return;
}
if(key_pressed(KEY_RETURN)&&ganhou<=0){
int a=random(1, 6);
send_reliable(0, "draw dado1.ogg", 0);
d1.play_wait();
d2.play();
add_add_item("variado", pu.get_value("Você lançou o dado, e caiu em")+" "+a+". "+pu.get_value("Anda")+" "+a+".");
wait(1000);
for(uint i=0;i<a;i++){
d3.play_wait();
wait(300);
}
seudado+=a;
if(seudado>50)seudado=50;
add_add_item("variado", pu.get_value("Você está em")+" "+seudado+".");
if(seudado==50){
send_reliable(0, "acoins "+quantidade, 2);
add_add_item("variado", pu.get_value("Você ganhou o jogo!!!"));
ganhou=1;
}
quemjoga=2;
break;
}
}
if(ganhou>0){
fim();
break;
}
}
if(quemjoga==2&&ganhou<=0){
add_add_item("variado", pu.get_value("Minha vez..."));
wait(1000);
int a=random(1, 6);
send_reliable(0, "draw dado1.ogg", 0);
d1.play_wait();
d2.play();
add_add_item("variado", pu.get_value("Eu joguei o dado, e caiu em")+" "+a+". "+pu.get_value("Ando")+" "+a+".");
for(uint i=0;i<a;i++){
d3.play_wait();
wait(300);
}
dadocomputador+=a;
if(dadocomputador>50)dadocomputador=50;
add_add_item("variado", pu.get_value("Estou em")+" "+dadocomputador+".");
if(dadocomputador==50){
send_reliable(0, "acoins -"+quantidade, 2);
add_add_item("variado", pu.get_value("Eu ganhei mais uma vez... Como eu disse, você não é de nada!!!"));
ganhou=2;
}
quemjoga=1;
}
if(ganhou>0){
fim();
break;
}
}
}
}
}
class jogoblackjack{
string[] cartas;//Matriz de cartas
int seuspontos=0, pontoscomputador=0, quemjoga=0, ganhou=0, quantidade=0;//Variáveis em zero pois não começou nada
int vparou=0, pparou=0;//Você e o computador não pararam de jogar.
int moedas;//moedas
bool iniciou=false, parou=false;//Não iniciou e não parou
sound carta;//Som da carta
sound ambiente;
void fim(){
cartas.resize(0);
carta.close();
ambiente.close();
iniciou=false;parou=false;
seuspontos=0; pontoscomputador=0; quemjoga=0; ganhou=0; quantidade=0;
vparou=0; pparou=0;
garbage_collect();
}
void jogar(){
carta.load("pegar_carta.ogg");
ambiente.load("musica15.ogg");
ambiente.volume=-20;
ambiente.play_looped();
add_add_item("variado", pu.get_value("Jogo Black Jack, ou 21!"));
while(true){
mainloop();
if(ausente){
fim();
break;
}
moedas=inv_item_number("coins");
if(moedas<=0){
p.play_stationary("notify_died.ogg", false);
send_reliable(0, "draw notify_died.ogg", 0);
fim();
break;
}
if(key_pressed(KEY_ESCAPE)){
p.play_stationary("menuvolta.ogg", false);
fim();
break;
}
if(iniciou==false&&quantidade>0){
wait(1500);
//Limpa matriz
cartas.resize(0);
//Começa a adição de cartas
cartas.insert_last("ás de ouros");
cartas.insert_last("2 de ouros");
cartas.insert_last("3 de ouros");
cartas.insert_last("4 de ouros");
cartas.insert_last("5 de ouros");
cartas.insert_last("6 de ouros");
cartas.insert_last("7 de ouros");
