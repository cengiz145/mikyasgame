sound dlgaudio;
void dlgplay(string dlgsound, bool dlgfade=false, int fadespeed=30){
	dlgaudio.load(dlgsound);
	dlgaudio.play();
	while(dlgaudio.playing){
		wait(5);
		mainloop();
		if(key_pressed(KEY_RETURN)){
			if (dlgfade==true)fade(dlgaudio, -80, fadespeed);
			dlgaudio.stop();
			break;
		}
	}
}
void dlg(string message){
	speak(pu.get_value(message));
	emchat=true;
	while(true){
		wait(5);
		mainloop();
		if (key_pressed(KEY_LEFT)||key_pressed(KEY_RIGHT)||key_pressed(KEY_UP)||key_pressed(KEY_DOWN))speak(pu.get_value(message)+"\r\n"+pu.get_value("Pressione enter para continuar."));
		if(key_pressed(KEY_C)) clipboard_copy_text(message);
		if (key_pressed(KEY_RETURN)||key_pressed(KEY_ESCAPE)||key_pressed(KEY_SPACE)){
			emchat=false;
			break;
		}
	}
}
void dispositivosai()
{
string [] dispositivos;
dynamic_menu_pro meumenu;
int resultadomenu;
dispositivos=list_sound_devices();
if (dispositivos.length()==0){
alert (pu.get_value("Erro!"),pu.get_value("Nenhum dispositivo de áudio encontrado."));
exit();
}
else if (dispositivos.length()==1){
alert (pu.get_value("Informação"),pu.get_value("Só existe um dispositivo de áudio ativo e este continuará sendo usado"));
exit();
}
else
{
setupmenu();
uint contador=0;
while (contador<dispositivos.length()){
m.add_item_tts(dispositivos[contador]);
contador++;
}
resultadomenu=m.run(pu.get_value("Escolha um dispositivo de saída de áudio"),true);
numero_dispositivo=resultadomenu-1;
if (resultadomenu==-1){
speak(pu.get_value("Erro ao exibir o menú"));
exit();
}
else if (resultadomenu==0){
speak(pu.get_value("Cancelado"));
exit();
}
writeprefs();
dlg(pu.get_value("O jogo precisa ser reiniciado para novas alterações."));
run("Desafio Mortal.exe", "", false, false);
exit();
}
}
