enum NSSpeechParams{
	NSSP_VOLUME, NSSP_VOLUME_MAX, NSSP_VOLUME_MIN,  NSSP_VOLUME_SUPPORTED,
	NSSP_RATE, NSSP_RATE_MAX, NSSP_RATE_MIN, NSSP_RATE_SUPPORTED,
	NSSP_PITCH, NSSP_PITCH_MAX, NSSP_PITCH_MIN, NSSP_PITCH_SUPPORTED,
	NSSP_INFLEXION, NSSP_INFLEXION_MAX, NSSP_INFLEXION_MIN, NSSP_INFLEXION_SUPPORTED,
	NSSP_PAUSED, NSSP_PAUSE_SUPPORTED, 
	NSSP_BUSY, NSSP_BUSY_SUPPORTED, 
	NSSP_WAIT, NSSP_WAIT_SUPPORTED,
	NSSP_ENABLE_NATIVE_SPEECH = 0xFFFF, 
	NSSP_VOICE = 0x10000,
	NSSP_LANGUAGE = 0x20000,
	NSSP_SUBENGINE = 0x30000,
	NSSP_ENGINE = 0x40000,
	NSSP_ENGINE_AVAILABLE = 0x50000,
	NSSP_AUTO_ENGINE = 0xFFFE,
	NSSP_USER_PARAM = 0x1000000
};
class nss_speech {
	library dll;
	string strip, speak, display, enablesapi, swait, setval, sstop, swaittime;
	nss_speech() {
		strip=SCRIPT_EXECUTABLE;
		string[] stripout=string_split(strip, "\\", true);
		strip=string_replace(stripout[stripout.length()-1], ".exe","", true);
		speak="int speechSayA(char*, int);";
		display="int brailleDisplayA(char*);";
		enablesapi="int speechSetValue (int, int);";
		swait="int speechSetValue (int, int);";
		swaittime="int speechGetValue(int);";
		setval="int speechSetValue (int, int);";
		sstop="int speechStop();";
		if (!file_exists("leitura/UniversalSpeech.dll")) {
			alert("erro", "Os componentes vitais estão faltando.");
			exit();
		}
		if (!dll.load("leitura/UniversalSpeech.dll")) {
			alert ("erro","Não é possível inicializar componentes vitais.");
			exit();
		}
		dll.call(enablesapi, NSSP_ENABLE_NATIVE_SPEECH, 1);
	}
	void say(string s, bool interrupt=false, bool sapiwait=false) {
		dll.call(speak, s, interrupt);
		dll.call(display, s);
		if (sapiwait) {
			dll.call(swait, NSSP_WAIT, gwt());
		}
	}
	void braille(string s) {
		dll.call(display, s);
	}
	void pause() {
		dll.call(setval, NSSP_PAUSED, 1);
	}
	void unpause() {
		dll.call(setval, NSSP_PAUSED, 0);
	}
	void stop() {
		if (screen_reader_is_running(1))
		say("", true);
		else
		dll.call(sstop);
	}
	int gwt() {
		dictionary waitrez;
		waitrez=dll.call(swaittime, NSSP_WAIT);
		int o;
		waitrez.get("0", o);
		return o;
	}
}class virtualizer
{
string input(string text)
{
emchat=true;
int cursor;
string message;
speak(pu.get_value(text));
cursor=0;
string[] ms;
get_characters();
while(true)
{
wait(5);
if(ausente){
emchat=false;
break;
}
if(connected) mainloop();
string char=get_characters();
if (key_down(KEY_LCONTROL) or key_down(KEY_RCONTROL))
{
if (key_pressed(KEY_V))
{
speak(pu.get_value("Texto colado"));
string cl=clipboard_read_text();
for (uint i=0; i<cl.length(); i++)
{
ms.insert_at(cursor,cl[i]);
cursor+=1;
}
}
if (key_pressed(KEY_C))
{
string a;
for (uint i=0; i<ms.length(); i++)
{
a+=ms[i];
}
speak(pu.get_value("texto Copiado"));
clipboard_copy_text(a);
}
}
if (key_pressed(KEY_F2))
{
if(falarteclas==1)
{
speak(pu.get_value("não falando teclas digitadas."));
falarteclas=0;
}
else
{
speak(pu.get_value("falando teclas digitadas."));
falarteclas=1;
}
}
if(char!="")
{
if(char==" ")
spool.play_stationary("keyspace.ogg", false);
else
spool.play_stationary("key"+random(1, 5)+".ogg", false);
if(falarteclas==1)
{
speak(char);
}
ms.insert_at(cursor,char);
cursor+=1;
}
if(key_pressed(KEY_BACK) and ms.length() > 0 and cursor>=1)
{
if(key_down(KEY_LSHIFT)||key_down(KEY_RSHIFT))
{
ms.resize(0);
cursor=0;
speak(pu.get_value("texto limpo"));
}
else
{
spool.play_stationary("keydelete.ogg", false);
string char=ms[cursor-1];
speak(char);
ms.remove_at(cursor-1);
cursor-=1;
}
}
if(key_pressed(KEY_TAB))
{
ms.resize(0);
cursor=0;
speak(pu.get_value("texto limpo"));
}
if(key_pressed(KEY_DELETE) and ms.length() > 0 and cursor>=0 and cursor<ms.length())
{
spool.play_stationary("keydelete.ogg", false);
string char=ms[cursor];
speak(char);
ms.remove_at(cursor);
}
if(key_pressed(KEY_DOWN) or key_pressed(KEY_UP))
{
string a;
for (uint i=0; i<ms.length(); i++)
{
a+=ms[i];
}
speak(a);
}
if(key_pressed(KEY_LEFT) and cursor>0)
{
if(ms.length()>0)
{
cursor-=1;
if (cursor>=ms.length())
{
speak(pu.get_value("em branco"));
}
else
{
speak(ms[cursor]);
}
}
else
speak(pu.get_value("em branco"));
}
if(key_pressed(KEY_RIGHT) and cursor<ms.length())
{
if(ms.length() > 0)
{
cursor+=1;
if (cursor>=ms.length())
speak(pu.get_value("em branco"));
else
speak(ms[cursor]);
}
else
speak(pu.get_value("em branco"));
}
if(key_pressed(KEY_HOME))
{
if(ms.length() > 0)
{
cursor=0;
if (cursor>=ms.length())
speak(pu.get_value("em branco"));
else
speak(ms[cursor]);
}
else
speak(pu.get_value("em branco"));
}
if(key_pressed(KEY_END))
{
if(ms.length() > 0)
{
cursor=ms.length();
if (cursor>=ms.length())
speak(pu.get_value("em branco"));
else
speak(ms[cursor]);
}
else
speak(pu.get_value("em branco"));
}
if(key_pressed(KEY_ESCAPE))
{
speak(pu.get_value("Cancelado."));
emchat=false;
return "";
}
else if(key_pressed(KEY_RETURN))
{
if (ms.length() > 0)
{
for (uint i=0; i<ms.length(); i++)
{
message+=ms[i];
}
spool.play_stationary("keyreturn.ogg", false);
emchat=false;
return message;
}
else if (ms.length()==0)
{
speak(pu.get_value("cancelado"));
emchat=false;
return "";
}
}
}
emchat=false;
return "";
}
}
