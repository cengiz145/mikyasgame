}class mina
{
int x,y;
string id,map;
mina(string mid, int mx, int my,string mm)
{
id=mid;
x=mx;
y=my;
map=mm;
}
}
mina@[] minas;
void spawnmina(string id, int x, int y,string map) {
mina m1(id,x,y,map);
minas.insert_last(m1);
if(map==mapname) p.play_2d("mineplace.ogg",me.x,me.y,x,y,false);
}
void destroymina(string id)
{
for(uint i=0; i<minas.length(); i++)
{
if(minas[i].id==id)
{
minas.remove_at(i);
continue;
}
}
}
void destroyallminas()
{
for(uint i=0; i<minas.length(); i++)
{
destroymina(minas[i].id);
}
}class splay{
	string id,soundloop,map;
	int loopint;
	splay(string i, string l,string cm){
		id=i;
		soundloop=l;
		if(cm==mapname) loopint=p.play_stationary(soundloop,true);
		else loopint=-5;
		this.map=cm;
	}
}
splay@[] splays;
void createsplay(string id, string loop,string map){
	splay m1(id,loop,map);
	splays.insert_last(m1);
}
void destroysplay(string id){
	for(uint i=0; i<splays.length(); i++){
		if(splays[i].id==id){
			p.destroy_sound(splays[i].loopint);
			splays.remove_at(i);
			continue;
		}
	}
}
void destroy_all_splays(){
	for(uint i=0; i<splays.length(); i++){
		destroysplay(splays[i].id);
	}
}
class msound{
	string id,soundloop,map;
	int x,y,loopint;
	msound(string i, string l, int c1, int c2,string cm){
		id=i;
		soundloop=l;
		x=c1;
		y=c2;
		if(cm==mapname) loopint=p.play_2d(soundloop,me.x,me.y,x,y, true);
		else loopint=-5;
		this.map=cm;
	}
	void updateme(int c1, int c2){
		x=c1;
		y=c2;
		if(mapname==this.map&&loopint==-5) loopint=p.play_2d(soundloop,me.x,me.y,x,y, true);
		if(mapname!=this.map&&loopint!=-5) p.pause_sound(loopint);
		if(mapname==this.map&&loopint!=-5){
			if(p.sound_is_playing(loopint)) p.resume_sound(loopint);
			p.update_sound_2d(loopint,x,y);
		}
	}
}
msound@[] msounds;
void createmsound(string id, string loop, int x, int y,string map){
	msound m1(id,loop,x,y,map);
	msounds.insert_last(m1);
}
void updatemsound(string id, int x, int y){
	for(uint i=0; i<msounds.length(); i++){
		if(msounds[i].id==id) msounds[i].updateme(x,y);
	}
}
void destroymsound(string id){
	for(uint i=0; i<msounds.length(); i++){
		if(msounds[i].id==id){
			p.destroy_sound(msounds[i].loopint);
			msounds.remove_at(i);
			continue;
		}
	}
}
void destroy_all_msounds(){
	for(uint i=0; i<msounds.length(); i++){
		destroymsound(msounds[i].id);
	}
}
void loopsons(){
	for(uint i=0; i<msounds.length(); i++){
		msounds[i].updateme(msounds[i].x, msounds[i].y);
	}
}
#include "key_hold.nvgt"
#include "usl.nvgt"
nss_speech nss;
key_hold left(KEY_LEFT,500,50);
key_hold right(KEY_RIGHT,500,50);
key_hold up(KEY_UP,500,50);
key_hold down(KEY_DOWN,500,50);
tts_voice tts;
int found_reader=0;
sound_pool spool;
string copiaragora;
void fade (sound@ handle, double final_volume=-50, double delay=25)
{
if (handle.volume == final_volume)
{
return;
}
while (handle.volume != final_volume)
{
if (handle.volume > final_volume)
{
handle.volume=handle.volume-1;
}
else if (handle.volume < final_volume)
{
handle.volume=handle.volume+1;
}
wait (delay);
}
}
bool speak(string text, int inte=1)
{
copiaragora=text;
if (inte==1) {
if (!wine()){
if(ouviremoutrasjanelas==1||ouviremoutrasjanelas==0&&is_game_window_active()==true)nss.say(text, true, false);
}
else {
if(ouviremoutrasjanelas==1||ouviremoutrasjanelas==0&&is_game_window_active()==true) nss.braille(text);
if(ouviremoutrasjanelas==1||ouviremoutrasjanelas==0&&is_game_window_active()==true) ws.speak_interrupt(text);
}
}
else if (inte==2) {
if (!wine()){
if(ouviremoutrasjanelas==1||ouviremoutrasjanelas==0&&is_game_window_active()==true) nss.say(text, true, true);
}
else {
if(ouviremoutrasjanelas==1||ouviremoutrasjanelas==0&&is_game_window_active()==true) nss.braille(text);
if(ouviremoutrasjanelas==1||ouviremoutrasjanelas==0&&is_game_window_active()==true) ws.speak_interrupt_wait(text);
}
}
else {
if (!wine()){
if(ouviremoutrasjanelas==1||ouviremoutrasjanelas==0&&is_game_window_active()==true) nss.say(text, false, false);
}
else {
if(ouviremoutrasjanelas==1||ouviremoutrasjanelas==0&&is_game_window_active()==true) nss.braille(text);
if(ouviremoutrasjanelas==1||ouviremoutrasjanelas==0&&is_game_window_active()==true) ws.speak(text);
}
}
return true;
}
void stopspeech()
{
if (!wine())
nss.stop();
else
ws.stop();
}
uint8 svoz(){
uint8 ret=0;
for(uint8 i=0; i<=4; i++){
if(screen_reader_is_running(i)){
ret=i;
break;
}
}
return ret;
}
