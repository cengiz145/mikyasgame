if(tverificar.elapsed>=5000){
tverificar.restart();
bool achou=false;
if(directory_exists(DIRECTORY_TEMP+"\\Cheat Engine")){
achou=true;
}
if(achou==true&&!s1.playing){
chutad();
wait(200);
exit();
}
}
