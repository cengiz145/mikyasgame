int able_to_jump2;
staircase@[] staircases;
bool on_staircase;
class staircase{
bool able_to_jump;
int minx, maxx, miny, maxy;
string tile;
int staircase_sound;
staircase(int cx, int cx2, int fmin_y,int fmax_y,string playsound){
minx=cx;
maxx=cx2;
miny=fmin_y;
maxy=fmax_y;
tile=playsound;
spawn_tiles(minx,maxx,miny,maxy,tile);
}
}
void staircase_check_loop(){
for (uint i=0; i<staircases.length(); i++){
if (me.x>=staircases[i].minx&&me.x<=staircases[i].maxx&&me.y>=staircases[i].miny&&me.y<=staircases[i].maxy){
on_staircase=true;
if (me.y==staircases[i].maxy)staircases[i].able_to_jump=true;
else staircases[i].able_to_jump=false;
}
else{
on_staircase=false;
staircases[i].able_to_jump=true;
}
if(key_down(KEY_UP)&&moveable&&key_down(KEY_G)==false&&key_down(KEY_LSHIFT)==false&&key_down(KEY_RSHIFT)==false&&!centado&&!key_down(KEY_F)){
if (on_staircase==true&&walktimer.elapsed>=walk_speed&&me.y<staircases[i].maxy){
walktimer.restart();
p.play_stationary(staircases[i].tile+"step"+random(1,5)+".ogg", false);
me.y+=1;
send_reliable(peer_id,"move "+me.x+" "+me.y,0);
if(string_contains(get_tile_at(me.x, me.y), "mud", 1)>-1){
int vv=random(0, 1);
if(vv==1)me.y--;
}
}
}
if (key_down(KEY_DOWN)&&moveable&&key_down(KEY_G)==false&&key_down(KEY_RSHIFT)==false&&key_down(KEY_LSHIFT)==false&&!centado&&!key_down(KEY_F)){
if (on_staircase==true&&walktimer.elapsed>=walk_speed&&me.y>staircases[i].miny){
walktimer.restart();
p.play_stationary(staircases[i].tile+"step"+random(1,5)+".ogg", false);
me.y-=1;
send_reliable(peer_id,"move "+me.x+" "+me.y,0);
if(string_contains(get_tile_at(me.x, me.y), "mud", 1)>-1){
int vv=random(0, 1);
if(vv==1)me.y++;
}
}
}
}
}
void spawn_staircase(int fmin_x, int fmax_x, int fmin_y, int fmax_y,string staircase_tile, string id){
staircase staircase1(fmin_x,fmax_x,fmin_y, fmax_y,staircase_tile);
staircases.insert_last(staircase1);
}
void destroy_all_staircases(){
staircases.resize(0);
}
void staircase_jump_check(){
if (staircases.length()<=0)able_to_jump2=1;
else{
for (uint i=0; i<staircases.length(); i++){
if (staircases[i].able_to_jump==false){
able_to_jump2=0;
break;
}
else if (staircases[i].able_to_jump==true||on_staircase==false){
able_to_jump2+=1;
}
else if (i>=staircases.length()-1&&staircases.length()>0&&staircases[i].able_to_jump==true){
able_to_jump2=1;
break;
}
else if (i>=staircases.length()-1&&staircases.length()>0&&staircases[i].able_to_jump==false){
able_to_jump2=0;
break;
}
}
}
}
