void mtext(string mensagem){
string[] mmensagem=string_split(mensagem,"\r\n",true);
string[] bla=string_split(mmensagem[0], ":", false);
string z=v.input(pu.get_value(bla[0]));
if(z!=""){
send_reliable(peer_id, bla[1]+" "+z, 0);
}
}
