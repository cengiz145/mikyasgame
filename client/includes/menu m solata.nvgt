if(z.length()>1)m.add_item_tts(pu.get_value(z[0]), z[1]);
}
m.add_item_tts(pu.get_value("Voltar"), "0");
int mres=m.run(pu.get_value(bla[0]), true);
if(m.get_item_name(mres)!="0"){
send_reliable(peer_id, bla[1]+" "+m.get_item_name(mres), 0);
}
}
