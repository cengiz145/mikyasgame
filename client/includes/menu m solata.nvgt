void perfio(){
setupmenu();
m.add_item_tts(pu.get_value("Selecionar voz"), "voz");
if(ouvirmortes==1)m.add_item_tts(pu.get_value("Desativar avisos de mortes"), "mortes");
else if(ouvirmortes==0)m.add_item_tts(pu.get_value("Ativar avisos de mortes"), "mortes");
if(avisanivel==1)m.add_item_tts(pu.get_value("Desativar aviso quando um jogador subir de nível"), "nivel");
else if(avisanivel==0)m.add_item_tts(pu.get_value("Ativar aviso quando um jogador subir de nível"), "nivel");
if(mdor==0)m.add_item_tts(pu.get_value("Não ouvindo grunidos"), "grunido");
else if(mdor==1)m.add_item_tts(pu.get_value("Ouvindo grunidos"), "grunido");
if(ouvirpassos==1)
m.add_item_tts(pu.get_value("Ouvindo passos de outros jogadores"), "passos");
if(ouvirpassos==0)
m.add_item_tts(pu.get_value("Não ouvindo passos de outros jogadores"), "passos");
if(ouvirleilao==1)
m.add_item_tts(pu.get_value("Desativar leilão"), "leilão");
if(ouvirleilao==0)
m.add_item_tts(pu.get_value("Ativar leilão"), "leilão");
m.add_item_tts(pu.get_value("Voltar"), "voltar");
int mres=m.run(pu.get_value("Opções do perfil"), true);
if(m.get_item_name(mres)=="voz")
{
voicemenu();
}
else if(m.get_item_name(mres)=="mortes"){
if(ouvirmortes==0)ouvirmortes=1;
else if(ouvirmortes==1)ouvirmortes=0;
readprefs();
perfio();
}
else if(m.get_item_name(mres)=="nivel"){
if(avisanivel==1)avisanivel=0;
else if(avisanivel==0)avisanivel=1;
writeprefs();
perfio();
}
else if(m.get_item_name(mres)=="grunido"){
if(mdor==0){
mdor=1;
}
else if(mdor==1){
mdor=0;
}
writeprefs();
perfio();
}
else if(m.get_item_name(mres)=="passos"){
if(ouvirpassos==0){
ouvirpassos=1;
}
else if(ouvirpassos==1){
ouvirpassos=0;
}
readprefs();
perfio();
}
else if(m.get_item_name(mres)=="leilão"){
if(ouvirleilao==0){
ouvirleilao=1;
}
else if(ouvirleilao==1){
ouvirleilao=0;
}
readprefs();
perfio();
}
else
{
optionsmenu();
}
}
