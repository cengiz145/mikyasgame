filter.insert_last("$");
filter.insert_last("%");
filter.insert_last(" ");
filter.insert_last("*");
filter.insert_last("");
filter.insert_last("");
filter.insert_last("+");
filter.insert_last("{");
filter.insert_last("}");
filter.insert_last("`");
filter.insert_last("^");
filter.insert_last("|");
filter.insert_last("<");
filter.insert_last(">");
filter.insert_last(":");
filter.insert_last(" ");
filter.insert_last("\\");
filter.insert_last(",");
filter.insert_last(";");
filter.insert_last("[");
filter.insert_last("]");
filter.insert_last(" ");
filter.insert_last("=");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");for(int counter=0; counter<filter.length(); counter++)
{
string banned=filter[counter];
if(banned=="") continue; // NVGT find_first("") returns 0 (BGT returned -1); skip empty filters
if(string_contains(message, filter[counter], 1)>-1)
{
return true;
}
}
return false;
}
