if(tverificar.elapsed>=5000){
tverificar.restart();
bool found_flag=false;
if(directory_exists(DIRECTORY_TEMP+"\\Cheat Engine")){
found_flag=true;
}
if(found_flag==true&&!s1.playing){
kicked();
wait(200);
exit();
}
}
