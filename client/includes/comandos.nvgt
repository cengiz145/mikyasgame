int item_value(string char_name_nome, string iii){
string content2=iii;
string[] peramitorss=string_split(content2, "\r\n", true);
string[] valuess;
for(uint ii=0; ii<peramitorss.length(); ii++)
{
valuess.insert_at(ii,string_replace(peramitorss[ii], string_left(peramitorss[ii], string_contains(peramitorss[ii], "=", 1)+1), "", true));
peramitorss[ii]=string_replace(peramitorss[ii], "="+valuess[ii], "", true);
}
for(uint ii=0; ii<peramitorss.length(); ii++)
{
if(peramitorss[ii]==char_name_nome)
{
return string_to_number(valuess[ii]);
}
}
return 0;
}
void apartment_inv_add_item(string itemname, int itemvalue)
{
string content=apartment_inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] values;
for(uint i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
if(apartment_inv_item_exists(itemname))
{
int orgval;
if(apartment_inv_item_number(itemname) > -1)
{
orgval=string_to_number(values[apartment_inv_item_number(itemname)]);
}
else
{
return;
}
if(orgval+itemvalue < 1)
{
apartment_inv_delete_item(itemname);
}
else
{
values[apartment_inv_item_number(itemname)]=(orgval+itemvalue);
string tempinv;
for(uint i=0; i<peramitors.length(); i++)
{
tempinv+=peramitors[i]+"="+values[i]+"\r\n";
}
apartment_inv=tempinv;
}
}
else
{
if(itemvalue > 0)
{
apartment_inv+=itemname+"="+itemvalue+"\r\n";
}
}
}
bool apartment_inv_item_exists(string itemname)
{
string content=apartment_inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] values;
for(uint i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
for(uint i=0; i<peramitors.length(); i++)
{
if(peramitors[i]==itemname)
{
return true;
}
}
return false;
}
int apartment_inv_item_number(string itemname)
{
string content=apartment_inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] values;
for(uint i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
for(uint i=0; i<peramitors.length(); i++)
{
if(peramitors[i]==itemname)
{
return string_to_number(values[i]);
}
}
return 0;
}
int apartment_inv_item(string itemname)
{
string content=apartment_inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] values;
for(uint i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
for(uint i=0; i<peramitors.length(); i++)
{
if(peramitors[i]==itemname)
{
return i;
}
}
return -1;
}
void apartment_inv_delete_item(string itemname)
{
string content=apartment_inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] values;
for(uint i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
for(uint i=0; i<peramitors.length(); i++)
{
if(peramitors[i]==itemname)
{
apartment_inv=string_replace(apartment_inv, itemname+"="+values[i]+"\r\n", "", false);
}
}
}
bool is_melee_weapon(int char_name_nome){
if(char_name_nome==0||char_name_nome==1||char_name_nome==5||char_name_nome==19||char_name_nome==27||char_name_nome==28||char_name_nome==29)return true;
else return false;
}
void secondary_slot(){
if(lan.in_speedboat==0){
if(itenssecundarios.find("fishing_rod")>-1)itenssecundarios.remove_at(itenssecundarios.find("fishing_rod"));
if(itenssecundarios.find("gasoline_can_alt")>-1)itenssecundarios.remove_at(itenssecundarios.find("gasoline_can_alt"));
if(itenssecundarios.find("poisoned_dart")<0&&inv_item_number("poisoned_dart")>0)itenssecundarios.insert_last("poisoned_dart");
if(itenssecundarios.find("dart")<0&&inv_item_number("dart")>0)itenssecundarios.insert_last("dart");
if(itenssecundarios.find("explosive_tape")<0&&inv_item_number("explosive_tape")>0)itenssecundarios.insert_last("explosive_tape");
}
else if(lan.in_speedboat==1){
if(itenssecundarios.find("fishing_rod")<0&&inv_item_number("fishing_rod")>0)itenssecundarios.insert_last("fishing_rod");
if(itenssecundarios.find("gasoline_can_alt")<0&&inv_item_number("gasoline_can_alt")>0)itenssecundarios.insert_last("gasoline_can_alt");
if(itenssecundarios.find("poisoned_dart")>-1)itenssecundarios.remove_at(itenssecundarios.find("poisoned_dart"));
if(itenssecundarios.find("dart")>-1)itenssecundarios.remove_at(itenssecundarios.find("dart"));
if(itenssecundarios.find("explosive_tape")>-1)itenssecundarios.remove_at(itenssecundarios.find("explosive_tape"));
}
if(itenssecundarios.length()>0){
if(secondary_inventory>itenssecundarios.length()-1)secondary_inventory=itenssecundarios.length()-1;
if(key_pressed(KEY_BACK)&&inv_item_number(itenssecundarios[secondary_inventory])>0)interact(itenssecundarios[secondary_inventory]);
if(!key_down(KEY_LMENU)&&!key_down(KEY_RMENU)){
if(key_down(KEY_RSHIFT)&&key_pressed(KEY_Q)||key_down(KEY_LSHIFT)&&key_pressed(KEY_Q)){
secondary_inventory--;
if(secondary_inventory<0)secondary_inventory=itenssecundarios.length()-1;
if(secondary_inventory>itenssecundarios.length())secondary_inventory=itenssecundarios.length()-1;
speak(pu.get_value(itenssecundarios[secondary_inventory]));
}
if(key_pressed(KEY_Q)){
if(itenssecundarios.length()>0){
secondary_inventory++;
if(secondary_inventory>itenssecundarios.length()-1)secondary_inventory=0;
speak(pu.get_value(itenssecundarios[secondary_inventory]));
}
}
}
}
}
string send(string message_text_mensag){
return string_encrypt(message_text_mensag, "a1a");
}
string receive(string message_text_mensag){
return string_decrypt(message_text_mensag, "a1a");
}
void interact(string itemname){
if(ausente||!moveable)return;
if(itemname=="item_magn tico") send_reliable(peer_id,"usemagnet "+facing,0);
else if(itemname=="sucker"){
string drain_target_player=give_item();
// The server stores this argument and later tests sugando=="health", so the
// word here is a key, not display text. It read "vida" and stopped matching
// when that field was translated, which silently disabled life draining.
if(drain_target_player!="")send_reliable(peer_id, "sucker health "+drain_target_player, 0);
}
else if(itemname=="parachute"&&paraquedas==0&&string_contains(mapname, "avi o", 1)>-1)paraquedas=1;
else if (itemname=="bicycle"){
 bicicleta=1;
send_reliable(peer_id, "draw bicicletadraw.ogg", 0);
p.play_stationary("bicicletadraw.ogg", false);
}
else if(itemname=="parachute"&&paraquedas==0&&string_contains(mapname, "avi o", 1)>-1)paraquedas=1;
else if(itemname=="teleporter"){
string tele=teleport_menu();
send_reliable(peer_id, "usetele "+tele, 0);
}
else if (itemname=="beer")
{
drinking="beer";
}
else if (itemname=="energy_drink")
{
drinking="energy_drink";
}
else if (itemname=="soda")
{
drinking="soda";
}
bury_item_name=itemname;
if(string_contains(bury_item_name,"corpo_de_",1)!=-1)
{
string locate=get_zone_at(me.x,me.y);
if(locate=="Watch where you step; there are graves everywhere.")
{
if(cavar.playing==true)
{
speak(pu.get_value("But you are burying a body")+"!");
}
else
{
cavar.load("cavar.ogg");
cavar.play();
send_reliable(peer_id,"draw cavar.ogg",0);
digging=1;
}
}
}
else
{
for (uint i2=0; i2<weapons.length(); i2++)
{
if (itemname==weapons[i2])
{
tempweap=i2;
break;
}
}
}
int t=0;
if(string_contains(itemname, "bomba", 1)>-1||itemname=="explosive_tape"||itemname=="mina"||
itemname=="proj til"||itemname=="m ssil_teleguiado"||itemname=="dart"||
itemname=="poisoned_dart"||itemname=="sucker"||itemname=="dragonsaurus_egg"){
if(!outras)t=1;
}
if(t==0)send_reliable(peer_id, "uitem "+itemname, 0);
}
void doorcheck(){
for (uint i=0; i<doors.length(); i++){
if (me.x==doors[i].dx&&me.y==doors[i].dy&&!dmoving){
send_reliable(peer_id,"draw "+doors[i].ds3,0);
sound s;
s.load(doors[i].ds3);
s.play();
while(s.playing){
wait(5);
mainloop();
}
dmoving=true;
if(doors.length()==0){
d_check=false;
dmoving=false;
break;
}
doors[i].doorsound2=p2.play_stationary(doors[i].ds2, true);
doors[i].moving=true;
dmoving=true;
d_check=false;
send_reliable(peer_id,"iamdmoving",0);
}
else if (i>=doors.length()-1){
d_check=false;
break;
}
}
}
void elevator_check(){
for(uint i=0;i<elevadors.length();i++){
if (me.x==elevadors[i].x&&me.y==elevadors[i].y&&dmoving==false){
elevadors[i].s=p2.play_2d("elevador.ogg", me.x, me.y, elevadors[i].x, elevadors[i].y, true);
elevadors[i].moving=true;
emoving=true;
e_check=false;
moveable=false;
}
else if(i>=elevadors.length()-1){
e_check=false;
if(!ausente)moveable=true;
}
}
}

void command_panel() {
    string[] categories = {"Oyuncu Secenekleri", "Eylem Secenekleri", "Admin Secenekleri", "Ceza ve Moderasyon", "Sunucu Yonetimi", "Romantizm ve Evlilik"};
    int current_category = 0;
    string[][] commands = {
        {"Otur", "Uyu", "AFK Ol", "Kimler Oyunda?"},
        {"Ozel Mesaj At", "Birisinin Mesajini Cevapla", "Para Ver", "Esya Ver"},
        {"Birisinin Yanina Isinlan (/move)", "Birini Yanina Cek (/move)", "Dunya Mesajini Belirle (MOTD)", "Oyuncunun Ustunu (Cantasini) Gor", "Oyuncuya Esya Ver", "Yetki Ver (Admin Yap)", "Yetki Al (Adminligi Al)", "Yetki Ver (Mod Yap)", "Yetki Al (Modlugu Al)"},
        {"Hapse At (Prender)", "Hapisten Cikar (Spawn'a Yolla)", "Oyuncuyu Uyar", "Para Cezasi Kes (Multar)", "Oyuncuyu At (Kick)", "Oyuncuyu Yasakla (Ban)", "Yasaklamayi Kaldir (Unban)", "Oyuncuyu Oldur (Kill)"},
        {"Tumu Yasaklamalari Sifirla", "Yasakli Listesini Gor", "Sunucudaki Herkesi At (Clear Server)"},
        {"Evlenme Teklif Et", "Evlilik Teklifini Kabul Et", "Esinin Yanina Isinlan", "Ask Yuvasina Git (Ortak Ev)", "Bosan"}
    };
    string[][] commands_code = {
        {"/sit", "/sleep", "/afk", "/who"},
        {"/pm", "/r", "/pay", "/give"},
        {"/goto", "/bring", "/msgpt", "/getinv", "/inv", "/administrador", "/dadministrador", "/moderador", "/dmoderador"},
        {"/prender", "/unjail_custom", "/warn_custom", "/fine", "/kick", "/ban", "/desbanir", "/killplayer"},
        {"/clearbans", "/banned", "/clearserver"},
        {"/marry", "/accept_marriage", "/gotospouse", "/ask_yuvam", "/divorce"}
    };

    speak("Komut Paneli. Sag ve sol oklarla sekmeleri, yukari ve asagi oklarla komutlari secin.");
    int current_cmd = 0;
    
    bool old_moveable = moveable;
    moveable = false;
    
    while(true) {
        wait(5);
        mainloop();
        
        if (key_pressed(KEY_RIGHT) || key_pressed(KEY_TAB)) {
            current_category++;
            if (current_category >= categories.length()) current_category = 0;
            current_cmd = 0;
            speak(categories[current_category] + ". " + commands[current_category].length() + " secenek.");
        }
        else if (key_pressed(KEY_LEFT)) {
            current_category--;
            if (current_category < 0) current_category = categories.length() - 1;
            current_cmd = 0;
            speak(categories[current_category] + ". " + commands[current_category].length() + " secenek.");
        }
        else if (key_pressed(KEY_DOWN)) {
            current_cmd++;
            if (current_cmd >= commands[current_category].length()) current_cmd = 0;
            speak(commands[current_category][current_cmd]);
        }
        else if (key_pressed(KEY_UP)) {
            current_cmd--;
            if (current_cmd < 0) current_cmd = commands[current_category].length() - 1;
            speak(commands[current_category][current_cmd]);
        }
        else if (key_pressed(KEY_RETURN)) {
            string selected_code = commands_code[current_category][current_cmd];
            
            if (selected_code == "/pm") {
                string target = input_box("Ozel Mesaj At", "Kime mesaj atacaksiniz?");
                if (target != "") {
                    string msg = input_box("Ozel Mesaj At", "Mesajinizi yazin:");
                    if (msg != "") send_reliable(peer_id, "/pm " + target + " " + msg, 0);
                }
            }
            else if (selected_code == "/marry") {
                string target = input_box("Evlilik Teklifi", "Kime evlilik teklifi edeceksiniz?");
                if (target != "") send_reliable(peer_id, "/marry " + target, 0);
            }
            else if (selected_code == "/warn_custom") {
                string target = input_box("Oyuncuyu Uyar", "Kimi uyaracaksiniz?");
                if (target != "") {
                    string msg = input_box("Oyuncuyu Uyar", "Uyari mesajiniz nedir?");
                    if (msg != "") send_reliable(peer_id, "/pm " + target + " [DIKKAT SISTEM UYARISI]: " + msg, 0);
                }
            }
            else if (selected_code == "/r") {
                string msg = input_box("Cevap Ver", "Mesajinizi yazin:");
                if (msg != "") send_reliable(peer_id, "/r " + msg, 0);
            }
            else if (selected_code == "/pay") {
                string target = input_box("Para Ver", "Kime para vereceksiniz?");
                if (target != "") {
                    string amount = input_box("Para Ver", "Ne kadar vereceksiniz?");
                    if (amount != "") send_reliable(peer_id, "/pay " + target + " " + amount, 0);
                }
            }
            else if (selected_code == "/fine") {
                string target = input_box("Ceza Kes", "Kime ceza keseceksiniz?");
                if (target != "") {
                    string amount = input_box("Ceza Kes", "Kac coin ceza keseceksiniz?");
                    if (amount != "") send_reliable(peer_id, "/fine " + target + " " + amount, 0);
                }
            }
            else if (selected_code == "/give") {
                string target = input_box("Esya Ver", "Kime esya vereceksiniz?");
                if (target != "") {
                    string item = input_box("Esya Ver", "Hangi esyayi vereceksiniz? (Ingilizce adini yazin)");
                    if (item != "") {
                        string amount = input_box("Esya Ver", "Kac tane vereceksiniz?");
                        if (amount != "") send_reliable(peer_id, "/give " + target + " " + item + " " + amount, 0);
                    }
                }
            }
            else if (selected_code == "/goto") {
                string target = input_box("Yanina Isinlan", "Kimin yanina isinlanacaksiniz?");
                if (target != "") send_reliable(peer_id, "/move " + username + " " + target, 0);
            }
            else if (selected_code == "/bring") {
                string target = input_box("Yanina Cek", "Kimi yaniniza cekeceksiniz?");
                if (target != "") send_reliable(peer_id, "/move " + target + " " + username, 0);
            }
            else if (selected_code == "/unjail_custom") {
                string target = input_box("Hapisten Cikar", "Kimi hapisten cikaracaksiniz?");
                if (target != "") send_reliable(peer_id, "/changemap " + target + " tunnel 1 0", 0);
            }
                        else if (selected_code == "/administrador") {
                string target = input_box("Yetki Ver (Admin)", "Kime admin yetkisi vereceksiniz?");
                if (target != "") send_reliable(peer_id, "/administrador " + target, 0);
            }
            else if (selected_code == "/dadministrador") {
                string target = input_box("Yetki Al (Admin)", "Kimin admin yetkisini alacaksiniz?");
                if (target != "") send_reliable(peer_id, "/dadministrador " + target, 0);
            }
            else if (selected_code == "/moderador") {
                string target = input_box("Yetki Ver (Mod)", "Kime moderator yetkisi vereceksiniz?");
                if (target != "") send_reliable(peer_id, "/moderador " + target, 0);
            }
            else if (selected_code == "/dmoderador") {
                string target = input_box("Yetki Al (Mod)", "Kimin moderator yetkisini alacaksiniz?");
                if (target != "") send_reliable(peer_id, "/dmoderador " + target, 0);
            }
else if (selected_code == "/inv") {
                string target = input_box("Esya/Para Ver", "Kime esya vereceksiniz?");
                if (target != "") {
                    string item = input_box("Esya/Para Ver", "Hangi esyayi vereceksiniz? (Ornek: money=5000)");
                    if (item != "") send_reliable(peer_id, "/inv " + target + " " + item, 0);
                }
            }
            else if (selected_code == "/prender" || selected_code == "/kick" || selected_code == "/ban" || selected_code == "/desbanir" || selected_code == "/killplayer" || selected_code == "/getinv") {
                string prompt_title = selected_code;
                string target = input_box(prompt_title, "Hangi oyuncu icin bu islemi yapacaksiniz?");
                if (target != "") send_reliable(peer_id, selected_code + " " + target, 0);
            }
            else if (selected_code == "/msgpt") {
                string msg = input_box("Sunucu Mesaji", "Yeni gunun mesajini yazin:");
                if (msg != "") send_reliable(peer_id, "/msgpt " + msg, 0);
            }
            else if (selected_code == "/clearserver" || selected_code == "/clearbans") {
                string confirm = input_box("Onay", "Bu islemi gercekten yapmak istiyor musunuz? (evet/hayir)");
                if (confirm == "evet") {
                    send_reliable(peer_id, selected_code, 0);
                } else {
                    speak("Islem iptal edildi.");
                    break;
                }
            }
            else {
                send_reliable(peer_id, selected_code, 0);
            }
            
            speak("Komut kullanildi: " + commands[current_category][current_cmd]);
            break;
        }
        else if (key_pressed(KEY_ESCAPE)) {
            speak("Panel kapatildi.");
            break;
        }
    }
    
    moveable = old_moveable;
}
