bool hear_xp=true, emchat=false;
string player_name;
sound s1;
timer look_x;
timer connected_time;
timer not_you_timer;
int close_chest_flag=0;
bool shift_pressed(){
if(key_down(KEY_RSHIFT)||key_down(KEY_LSHIFT))return true;
return false;
}
void players_menu(){
if(players.length()==0||ausente)return;
reset_all_forced_keys();
key_hold iup(KEY_UP,500,50);
key_hold idown(KEY_DOWN,500,50);
get_characters();
string cl;
int counter=0;
string[] peramitors;
string[] peramitors2;
for(uint i=0; i<players.length(); i++){
peramitors2.insert_last(players[i].charname);
}
speak(peramitors2[0]);
emchat=true;
while(true){
wait(5);
mainloop();
if(ausente)break;
peramitors.resize(0);
peramitors2.resize(0);
for(uint i=0; i<players.length(); i++){
if(players[i].beeping==1||developer_dm==1)peramitors.insert_last(players[i].charname);
}
if(counter > peramitors.length()-1)counter=peramitors.length()-1;
if(counter<0)counter=0;
cl=get_characters();
if(cl!=""&&cl!=" "&&cl.length()==1&&peramitors.length()>0){
int f=0;
int oc=counter;
for(uint i=counter; i<peramitors.length(); i++){
if(i==counter){
continue;
}
if(peramitors[i][0]==cl){
counter=i;
speak(peramitors[counter]);
cl="";
f=1;
break;
}
}
if(f==0){
counter=0;
for(uint i=counter; i<peramitors.length(); i++){
if(peramitors[i][0]==cl){
counter=i;
speak(peramitors[counter]);
cl="";
f=1;
break;
}
}
}
}
if(key_pressed(KEY_HOME)&&peramitors.length()>0){
counter=0;
speak(peramitors[counter]);
}
if(key_pressed(KEY_END) and peramitors.length()>0)
{
counter=peramitors.length()-1;
speak(peramitors[counter]);
}
if(iup.pressing())
{
if(peramitors.length()==1)
{
speak(peramitors[0]);
counter=0;
}
else if(counter > 0)
{
counter--;
speak(peramitors[counter]);
}
}
if(idown.pressing())
{
if(peramitors.length()==1)
{
speak(peramitors[0]);
counter=0;
}
else if(counter < peramitors.length()-1)
{
counter++;
speak(peramitors[counter]);
}
}
if(key_pressed(KEY_RETURN)){
string msg=v.input(pu.get_value("Type your message to")+" "+peramitors[counter]);
if(msg!="")send_reliable(peer_id, "/pm "+peramitors[counter]+" "+msg, 1);
}
if(key_pressed(KEY_F1))send_reliable(peer_id, "j1 "+peramitors[counter], 0);
if(key_pressed(KEY_F2))send_reliable(peer_id, "j2 "+peramitors[counter], 0);
if(key_pressed(KEY_F3))send_reliable(peer_id, "j3 "+peramitors[counter], 0);
if(key_pressed(KEY_F4))send_reliable(peer_id, "j4 "+peramitors[counter], 0);
if(key_down(KEY_LCONTROL)||key_down(KEY_RCONTROL)){
if(key_pressed(KEY_C)){
clipboard_copy_text(peramitors[counter]);
speak(peramitors[counter]+" "+pu.get_value("copiado."));
}
if(developer_dm==1){
if(key_pressed(KEY_M))send_reliable(peer_id, "/killplayer "+peramitors[counter], 1);
if(key_pressed(KEY_E))send_reliable(peer_id, "/expulsar "+peramitors[counter], 1);
if(key_pressed(KEY_B))send_reliable(peer_id, "/ban "+peramitors[counter], 1);
if(key_pressed(KEY_Z)){
nolhar=peramitors[counter];
int n=get_player(nolhar);
if(nolhar>-1){
speak(pu.get_value("Pronto."));
olhar_x=players[n].x;
olhar_y=players[n].y;
send_reliable(peer_id, "olhar "+nolhar, 0);
moveable=false;
in_safe_zone_inansz=true;
}
}
}
}
if(key_pressed(KEY_ESCAPE)){
emchat=false;
return;
}
}
}
void computer_menu(){
if(ausente)return;
int counter=0;
string content=pc_options;
string[] peramitors=string_split(content, "\r\n", true);
string[] peramitors2;
for(uint i=0; i<peramitors.length(); i++){
peramitors[i]=string_split(peramitors[i],"=",true)[0];
}
speak(pu.get_value(peramitors[0]));
while(true){
wait(5);
mainloop();
if(ausente||mapname=="t nel")break;
peramitors.resize(0);
peramitors2.resize(0);
content=pc_options;
peramitors2=string_split(content, "\r\n", true);
for(uint i=0; i<peramitors2.length(); i++)
{
peramitors2[i]=string_split(peramitors2[i],"=",true)[0];
int pwn=0;
peramitors.insert_last(peramitors2[i]);
}
if(counter > peramitors.length())
{
counter=peramitors.length()-1;
}
if(key_pressed(KEY_RETURN)){
copy_now="";
send_reliable(peer_id, "pc "+peramitors[counter], 0);
}
if(key_pressed(KEY_HOME) and peramitors.length()>0&&digging==0)
{
counter=0;
speak(pu.get_value(peramitors[counter]));
copy_now=pu.get_value(peramitors[counter]);
}
if(key_pressed(KEY_END) and peramitors.length()>0&&digging==0)
{
counter=peramitors.length()-1;
speak(pu.get_value(peramitors[counter]));
copy_now=pu.get_value(peramitors[counter]);
}
if(key_pressed(KEY_UP)){
if(peramitors.length()==1)
{
counter=0;
speak(pu.get_value(peramitors[counter]));
copy_now=pu.get_value(peramitors[counter]);
}
else if(counter > 0)
{
counter--;
speak(pu.get_value(peramitors[counter]));
copy_now=pu.get_value(peramitors[counter]);
}
}
if(key_pressed(KEY_DOWN)){
if(peramitors.length()==1)
{
counter=0;
speak(pu.get_value(peramitors[counter]));
copy_now=pu.get_value(peramitors[counter]);
}
else if(counter < peramitors.length()-1)
{
counter++;
speak(pu.get_value(peramitors[counter]));
copy_now=pu.get_value(peramitors[counter]);
}
}
if(key_pressed(KEY_ESCAPE)){
copy_now="";
return;
}
}
}
void apartment_menu(){
if(ausente)return;
get_characters();
string cl;
int counter=0;
string content=apartment_inv;
string[] peramitors=string_split(content, "\r\n", true);
string[] peramitors2;
for(uint i=0; i<peramitors.length(); i++){
peramitors[i]=string_split(peramitors[i],"=",true)[0];
}
if(close_chest_flag==1)close_chest_flag=0;
while(true){
wait(5);
mainloop();
if(ausente||mapname=="t nel")break;
peramitors.resize(0);
peramitors2.resize(0);
content=apartment_inv;
peramitors2=string_split(content, "\r\n", true);
for(uint i=0; i<peramitors2.length(); i++)
{
peramitors2[i]=string_split(peramitors2[i],"=",true)[0];
int pwn=0;
peramitors.insert_last(peramitors2[i]);
}
if(counter > peramitors.length())counter=peramitors.length()-1;
if(close_chest_flag==1){
close_chest_flag=0;
break;
}
if(key_pressed(KEY_RETURN)){
int n=string_to_number(v.input(pu.get_value("Quantos voc  quer pegar?")));
if(n>apartment_inv_item_number(peramitors[counter])||n<=0)p.play_stationary("erro.ogg", false);
else send_reliable(peer_id, "papartamento "+peramitors[counter]+" "+n, 0);
}
if(key_pressed(KEY_HOME) and peramitors.length()>0&&digging==0)
{
counter=0;
p.play_stationary("invclick.ogg",false);
speak(pu.get_value(peramitors[counter])+", "+apartment_inv_item_number(peramitors[counter]));
}
if(key_pressed(KEY_END) and peramitors.length()>0&&digging==0)
{
counter=peramitors.length()-1;
p.play_stationary("invclick.ogg",false);
speak(pu.get_value(peramitors[counter])+", "+apartment_inv_item_number(peramitors[counter]));
}
if(key_pressed(KEY_UP)){
if(peramitors.length()==1)
{
counter=0;
p.play_stationary("invclick.ogg",false);
speak(pu.get_value(peramitors[counter])+", "+apartment_inv_item_number(peramitors[counter]));
}
else if(counter > 0)
{
counter--;
p.play_stationary("invclick.ogg",false);
speak(pu.get_value(peramitors[counter])+", "+apartment_inv_item_number(peramitors[counter]));
}
}
if(key_pressed(KEY_DOWN)){
if(peramitors.length()==1)
{
counter=0;
p.play_stationary("invclick.ogg",false);
speak(pu.get_value(peramitors[counter])+", "+apartment_inv_item_number(peramitors[counter]));
}
else if(counter < peramitors.length()-1)
{
counter++;
p.play_stationary("invclick.ogg",false);
speak(pu.get_value(peramitors[counter])+", "+apartment_inv_item_number(peramitors[counter]));
}
}
if(key_pressed(KEY_ESCAPE)){
p.play_stationary("fba .ogg", false);
send_reliable(peer_id, "draw fba .ogg", 0);
send_reliable(peer_id, "fba ", 0);
return;
}
}
}
void readprefs(){
string content=string_decrypt(pf.read(),"todososvaosefodercomessaincriptacaododesafiomortalfoda");
// A prefs file written by the old BGT client uses BGT's proprietary (non-reproducible)
// encryption, so NVGT cannot decrypt it and string_decrypt returns empty/garbage. Detect
// that and keep defaults; the next writeprefs() will rewrite a valid NVGT prefs file.
if(content=="" || string_contains(content, "=", 1)<0) return;
content=string_replace(content, "\r\n", "\n", true); // tolerate either line ending
string[] peramitors=string_split(content, "\n", true);
string[] values;
for(uint i=0; i<peramitors.length(); i++)
{
values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
}
if(peramitors.find("mlang")!=-1)
{
mainlang=values[peramitors.find("mlang")];
}
if(peramitors.find("ouvirhits")!=-1)
{
hear_hits=string_to_number(values[peramitors.find("ouvirhits")]);
}
if(peramitors.find("ouvirpassos")!=-1)
{
hear_footsteps=string_to_number(values[peramitors.find("ouvirpassos")]);
}
if(peramitors.find("ouviremoutrasjanelas")!=-1)
{
ouviremoutrasjanelas=string_to_number(values[peramitors.find("ouviremoutrasjanelas")]);
}
if(peramitors.find("musicamenu")!=-1)
{
musicamenu=string_to_number(values[peramitors.find("musicamenu")]);
}
if(peramitors.find("idiomaorigem")!=-1)
{
source_language=values[peramitors.find("idiomaorigem")];
}
if(peramitors.find("tradutorativo")!=-1)
{
tradutorativo=string_to_number(values[peramitors.find("tradutorativo")]);
}
if(peramitors.find("primeiravez")!=-1)
{
first_time=string_to_number(values[peramitors.find("primeiravez")]);
}
if(peramitors.find("cmfinal")!=-1)
{
language_file_path=values[peramitors.find("cmfinal")];
}
if(peramitors.find("idiomachat")!=-1)
{
chat_language=values[peramitors.find("idiomachat")];
}
if(peramitors.find("atu")!=-1)atu=string_to_number(values[peramitors.find("atu")]);
if(peramitors.find("rcontrol")!=-1)rcontrol=string_to_number(values[peramitors.find("rcontrol")]);
if(peramitors.find("ouvirmortes")!=-1)hear_deaths=string_to_number(values[peramitors.find("ouvirmortes")]);
if(peramitors.find("nalancha")!=-1)lan.in_speedboat=string_to_number(values[peramitors.find("nalancha")]);
if(peramitors.find("un")!=-1){
un=values[peramitors.find("un")];
}
if(peramitors.find("pw")!=-1){
pw=values[peramitors.find("pw")];
}
if(peramitors.find("ttsrate")!=-1)
{
ttsrate=string_to_number(values[peramitors.find("ttsrate")]);
ws.rate=ttsrate;
}
if(peramitors.find("voice")!=-1)
{
voice=string_to_number(values[peramitors.find("voice")]);
}
if(peramitors.find("wineask")!=-1)
{
wineask=string_to_number(values[peramitors.find("wineask")]);
}
if(peramitors.find("beaconing")!=-1)
{
beaconing=string_to_number(values[peramitors.find("beaconing")]);
}
if(peramitors.find("interrupt")!=-1)
{
interrupt=string_to_number(values[peramitors.find("interrupt")]);
}
if(peramitors.find("avisadesconectou")!=-1)
{
warn_disconnected=string_to_number(values[peramitors.find("avisadesconectou")]);
}
if(peramitors.find("usalogo")!=-1)
{
use_logo=string_to_number(values[peramitors.find("usalogo")]);
}
if(peramitors.find("numero_dispositivo")!=-1)
{
device_number=string_to_number(values[peramitors.find("numero_dispositivo")]);
}
if(peramitors.find("atualizar")!=-1)
{
do_update=string_to_number(values[peramitors.find("atualizar")]);
}
if(peramitors.find("volumejogo")!=-1)
{
game_volume=string_to_number(values[peramitors.find("volumejogo")]);
}
if(peramitors.find("asktoexit")!=-1)
{
asktoexit=string_to_number(values[peramitors.find("asktoexit")]);
}
if(peramitors.find("avisanivel")!=-1)
{
avisanivel=string_to_number(values[peramitors.find("avisanivel")]);
}
if(peramitors.find("f1")!=-1)
{
f1=string_to_number(values[peramitors.find("f1")]);
}
if(peramitors.find("f2")!=-1)
{
f2=string_to_number(values[peramitors.find("f2")]);
}
if(peramitors.find("f3")!=-1)
{
f3=string_to_number(values[peramitors.find("f3")]);
}
if(peramitors.find("f4")!=-1)
{
f4=string_to_number(values[peramitors.find("f4")]);
}
if(peramitors.find("f5")!=-1)
{
f5=string_to_number(values[peramitors.find("f5")]);
}
if(peramitors.find("f6")!=-1)
{
f6=string_to_number(values[peramitors.find("f6")]);
}
if(peramitors.find("f7")!=-1)
{
f7=string_to_number(values[peramitors.find("f7")]);
}
if(peramitors.find("f8")!=-1)
{
f8=string_to_number(values[peramitors.find("f8")]);
}
if(peramitors.find("f9")!=-1)
{
f9=string_to_number(values[peramitors.find("f9")]);
}
if(peramitors.find("f0")!=-1)
{
f0=string_to_number(values[peramitors.find("f0")]);
}
}
void writeprefs() {
if(!portable)pf.open(prefsdir+"/DM5.0.dat","wb");
else pf.open("DM5.0.dat","wb");
string s;
s="mlang="+mainlang+"\r\n"+
"tradutorativo="+tradutorativo+"\r\n"+
"idiomaorigem="+source_language+"\r\n"+
"idiomachat="+chat_language+"\r\n"+
"atu="+atu+"\r\n"+
"ouvirmortes="+hear_deaths+"\r\n"+
"rcontrol="+rcontrol+"\r\n"+
"nalancha="+lan.in_speedboat+"\r\n"+
"un="+un+"\r\n"+
"pw="+pw+"\r\n"+
"voice="+voice+"\r\n"+
"volumejogo="+game_volume+"\r\n"+
"ttsrate="+ttsrate+"\r\n"+
"cmfinal="+language_file_path+"\r\n"+
"avisadesconectou="+warn_disconnected+"\r\n"+
"ouvirhits="+hear_hits+"\r\n"+
"primeiravez="+first_time+"\r\n"+
"numero_dispositivo="+device_number+"\r\n"+
"usalogo="+use_logo+"\r\n"+
"atualizar="+do_update+"\r\n"+
"ouvirpassos="+hear_footsteps+"\r\n"+
"ouviremoutrasjanelas="+ouviremoutrasjanelas+"\r\n"+
"musicamenu="+musicamenu+"\r\n"+
"beaconing="+beaconing+"\r\n"+
"wineask="+wineask+"\r\n"+
"interrupt="+interrupt+"\r\n"+
"falarteclas="+speak_keys+"\r\n"+
"asktoexit="+asktoexit+"\r\n"+
"avisanivel="+avisanivel+"\r\n"+
"f1="+f1+"\r\n"+
"f2="+f2+"\r\n"+
"f3="+f3+"\r\n"+
"f4="+f4+"\r\n"+
"f5="+f5+"\r\n"+
"f6="+f6+"\r\n"+
"f7="+f7+"\r\n"+
"f8="+f8+"\r\n"+
"f9="+f9+"\r\n"+
"f0="+f0+"\r\n";
s=string_encrypt(s,"todososvaosefodercomessaincriptacaododesafiomortalfoda");
pf.write(s);
pf.close();
}
void describe_item (string itemname){
send_reliable(peer_id,"desc "+itemname,2);
}
void copy(){
if(copy_now!=""){
clipboard_copy_text(copy_now);
copy_now="";
speak(pu.get_value("Texto copiado."));
}
else if(adds[addpos].items.length()>0){
clipboard_copy_text(adds[addpos].items[adds[addpos].pos]);
speak(pu.get_value("Texto copiado."));
}
}
void local_loop(){
string locate=get_zone_at(me.x,me.y);
if(locate=="Gramado"&&grass==0){
send_reliable(peer_id,"/multar",2);
grass=1;
}
else if(locate!="Gramado"&&grass==1){
grass=0;
}
else if(locate=="Refrigerador."&&freezing==0){
tempocongelando.restart();
freezing=1;
}
else if(locate!="Refrigerador."&&freezing==1){
freezing=0;
}
if(locate=="Rio"||locate=="Deep part of the lake."){
if(life_vest==0&&mapname!="fishing_spot"||mapname=="fishing_spot"&&lan.in_speedboat==0){
if(drowning==0&&!bubble_air&&lan.in_speedboat==0){
drowning=1;
drowning_sound.load("afogando.ogg");
drowning_sound.play_wait();
send_reliable(peer_id,"terminouafogando",0);
}
}
}
else if(cavar.playing==false&&digging==1)
{
digging=0;
send_reliable(peer_id, "enterrar "+bury_item_name, 0);
}
else if(tempocongelando.elapsed>freezing_number&&locate=="Refrigerador."){
tempocongelando.restart();
send_reliable(peer_id,"congelou",0);
}
else if (carregartimer.elapsed>=reload_time&&reloading==1){
carregartimer.restart();
reloading=0;
}
else if (shooting==1&&weapontimer.elapsed>=weapontime){
weapontimer.restart();
shooting=0;
}
}
void check_enter(){
string locate=get_zone_at(me.x,me.y);
if(locate=="Ticket purchase counter."&&string_contains(mapname, "airport", 1)>-1){
string m=buy_plane_ticket();
if(m!="")
{
send_reliable(peer_id, "passagema "+m,2);
}
}
else if(locate=="Painel."){
string nn=v.input("Enter the floor number");
if(nn=="")return;
int n=string_to_number(nn);
int current_value=(me.y/20);
if(current_value==20&&n==0)current_value=0;
if(n>50){
speak("The floor is too high for this building. Look somewhere else!");
return;
}
if(n==current_value){
speak(pu.get_value("Voc  j  est  neste andar!"));
return;
}
else nandar=n;
}
if(string_contains(locate, "This is the centre of the Roman colosseum.", 1)>-1) gladiators_menu();
// These two used to read "esta  o" and "rodovi ria" - "estaÃ§Ã£o" and
// "rodoviÃ¡ria" with the accented letters lost to a bad encoding round-trip, so
// they matched no map even before the rename and tickets could never be bought.
// The maps are now belick_station / santa_bertalina_station and
// bus_station / bus_station_belick.
else if(locate=="Ticket purchase counter."&&(mapname=="belick_station"||mapname=="santa_bertalina_station")){
string m=buy_plane_ticket2();
if(m!="")
{
send_reliable(peer_id, "passagemb "+m,2);
}
}
else if(locate=="Ticket purchase counter."&&(mapname=="bus_station"||mapname=="bus_station_belick")){
send_reliable(peer_id, "passagemo", 2);
}
else if(locate=="Pet Roulette!") roleta_animais.throw_item();
else if(locate=="Par ou  mpar!")parouimpar.throw_item();
else if(locate=="Black Jack, ou 21!")blackjack.throw_item();
else if(locate=="Pedra, papel, tesoura!")poker.throw_item();
else if(locate=="Farkle!") farkle.throw_item();
else if(locate=="lucky dice") dadosorte.throw_item();
else if(locate=="Orelh o."||locate=="Cabine telef nica."){
bool already_has=false;
for(uint i=0;i<players.length();i++){
if(players[i].charname!=un&&players[i].x==me.x&&players[i].y==me.y){
already_has=true;
break;
}
}
if(already_has==true){
add_add_item("variado", pu.get_value("Someone is already using the phone!"));
}
else if(already_has==false){
string phone_number_input=tel.input("");
if(phone_number_input=="95941354"){
moveable=false;
sound s;
s.load("telefone.ogg");
int a=random(2, 9);
for(int i=0;i<a;i++){
s.play();
while(s.playing){
mainloop();
wait(5);
}
}
s.load("v"+voice+"questcapacete.ogg");
s.play();
while(s.playing){
wait(5);
mainloop();
}
moveable=true;
send_reliable(peer_id, "/quest filha_desaparecida", 1);
}
send_reliable(peer_id, "tocar telefonecolocandogancho.ogg", 0);
}
}
else if(locate=="Tomada.") send_reliable(peer_id, "checarcarregar "+taser_shots, 2);
else if(mapname=="imobili ria"&&locate=="Balc o de atendimento.") send_reliable(peer_id, "comprarcasa", 0);
else if(mapname=="casa_de_interc mbio"&&locate=="Balc o de atendimento.") convert_menu();
else if(mapname=="departamento_da_pol cia_federal"&&locate=="Balc o de atendimento.") send_reliable(peer_id, "tirarpassaporte", 0);
}
void exitgame(){
if(exiting)return;
speak(pu.get_value("Disconnecting from server..."));
writeprefs();
send_reliable(peer_id, "close", 0);
exittimer.restart();
exiting=true;
connected=false;
connect=false;
}
void check_shop(){
string locate=get_zone_at(me.x,me.y);
if(locate=="Clothing store") clothing();
else if(mapname=="explosives_shop") explosives();
else if(locate=="Hunting equipment section.")bertalina_weapons();
else if(locate=="Fishing equipment section.")fishing();
// "farm cia", "loja_de_eletr nicos", "zona_de_segurigad" and
// "Pra a de alimenta  o" were "farmÃ¡cia", "loja_de_eletrÃ´nicos",
// "zona_de_seguridad" and "PraÃ§a de alimentaÃ§Ã£o" with their accents lost to a
// bad encoding round-trip - they matched nothing even before the rename, so
// these shops could never be opened. Now matched against the real names.
else if(string_contains(mapname, "pharmacy", 1)>-1)pharmacy();
else if(mapname=="general_items_shop") various_items();
else if(mapname=="store") virtual_shop();
else if(mapname=="electronics_shop") buy_electronics();
else if(mapname=="safe_zone"||mapname=="safe_zone_es") send_reliable(peer_id,"store",0);
else if(mapname=="jewelry_shop") jewelry_shop();
else if(string_contains(string_to_lower_case(locate), "lanchonete.", 1)>-1||string_contains(locate, "PraÃ§a de alimentaÃ§Ã£o", 1)>-1) snack_bar();
}
void remove (string itemname)
{
if(itemname=="bicycle"){
send_reliable(peer_id, "draw bicicletadraw.ogg", 0);
p.play_stationary("bicicletadraw.ogg", false);
bicicleta=0;
}
if(itemname=="parachute"&&get_tile_at(me.x, me.y)!=""&&get_zone_at(me.x, me.y)!="")paraquedas=0;
send_reliable(peer_id,"retirar "+itemname,0);
}
void others_loop(){
if(!outras&&is_melee_weapon(tempweap)==false||tempweap!=0&&tempweap!=27&&!inv_item_exists(weapons[tempweap])){
tempweap=0;
}
if(look_x.elapsed>=3000){
if(me.x<=0){
me.x=1;
send_reliable(peer_id,"move "+me.x+" "+me.y,0);
}
else if(me.x>=max.x){
me.x=max.x-1;
send_reliable(peer_id,"move "+me.x+" "+me.y,0);
}
else if(me.y<0){
me.y=1;
send_reliable(peer_id,"move "+me.x+" "+me.y,0);
}
else if(me.y>=max.y){
me.y=max.y-2;
send_reliable(peer_id,"move "+me.x+" "+me.y,0);
}
}
if(echotimer.elapsed>=echotime&&echo==true)
{
echocheck(facing);
}
}
bool message_invalid(string message)
{
message=string_to_lower_case(message);
string[] filter;
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last("~");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
filter.insert_last(" ");
