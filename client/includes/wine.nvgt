void toggle_wine()
{
if (!file_exists(DIRECTORY_TEMP+"/zsap.id"))
{
file f;
f.open(DIRECTORY_TEMP+"/zsap.id","wb");
f.close();
}
else
{
file_delete(DIRECTORY_TEMP+"/zsap.id");
}
}
bool wine()
{
if (file_exists(DIRECTORY_TEMP+"/zsap.id"))
{
return true;
}
return false;
}
void wine_ask(int asked=0)
{
if (asked==0)
{
tts_voice tts;
int w=question(pu.get_value("Do you want to use SAPI speech?"),"");
                if (w==1)
toggle_wine();
asked=1;
}
}
