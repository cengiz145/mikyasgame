void profile_menu(){
setupmenu();
m.add_item_tts(pu.get_value("Selecionar voz"), "voz");
if(hear_deaths==1)m.add_item_tts(pu.get_value("Disable death warnings"), "mortes");
else if(hear_deaths==0)m.add_item_tts(pu.get_value("Enable death warnings"), "mortes");
if(avisanivel==1)m.add_item_tts(pu.get_value("Disable level up sound"), "nivel");
else if(avisanivel==0)m.add_item_tts(pu.get_value("Enable level up sound"), "nivel");
if(mdor==0)m.add_item_tts(pu.get_value("Not hearing grunts"), "grunido");
else if(mdor==1)m.add_item_tts(pu.get_value("Ouvindo grunidos"), "grunido");
if(hear_footsteps==1)
m.add_item_tts(pu.get_value("hearing to other player steps"), "passos");
if(hear_footsteps==0)
m.add_item_tts(pu.get_value("no hearing to other player steps"), "passos");
if(hear_auction==1)
m.add_item_tts(pu.get_value("Disable auctions"), "Auction");
if(hear_auction==0)
m.add_item_tts(pu.get_value("Enable auctions"), "Auction");
m.add_item_tts(pu.get_value("Go Back"), "voltar");
int menu_result=m.run(pu.get_value("Profile settings."), true);
if(m.get_item_name(menu_result)=="voz")
{
voice_menu();
}
else if(m.get_item_name(menu_result)=="mortes"){
if(hear_deaths==0)hear_deaths=1;
else if(hear_deaths==1)hear_deaths=0;
readprefs();
profile_menu();
}
else if(m.get_item_name(menu_result)=="nivel"){
if(avisanivel==1)avisanivel=0;
else if(avisanivel==0)avisanivel=1;
writeprefs();
profile_menu();
}
else if(m.get_item_name(menu_result)=="grunido"){
if(mdor==0){
mdor=1;
}
else if(mdor==1){
mdor=0;
}
writeprefs();
profile_menu();
}
else if(m.get_item_name(menu_result)=="passos"){
if(hear_footsteps==0){
hear_footsteps=1;
}
else if(hear_footsteps==1){
hear_footsteps=0;
}
readprefs();
profile_menu();
}
else if(m.get_item_name(menu_result)=="Auction"){
if(hear_auction==0){
hear_auction=1;
}
else if(hear_auction==1){
hear_auction=0;
}
readprefs();
profile_menu();
}
else
{
options_menu();
}
}
