// Every map on the server, as a menu. Requested with the "maplist" packet from
// the builder menu; picking one teleports the admin straight there, which
// previously meant typing /changemap yourname mapname by hand.
void map_list_menu(string maps)
{
	string[] names=string_split(maps,"\r\n",true);
	if(names.length()==0){
		speak(pu.get_value("The server reported no maps."));
		return;
	}
	setupmenu();
	for(uint i=0;i<names.length();i++){
		if(names[i]=="") continue;
		m.add_item_tts(names[i], names[i]);
	}
	m.add_item_tts(pu.get_value("Go Back"), "back");
	int menu_result=m.run(pu.get_value("Choose a map to go to."), true);
	string sel=m.get_item_name(menu_result);
	if(menu_result==0||sel=="back"||sel=="") return;
	send_reliable(peer_id, "/changemap "+un+" "+sel, 1);
}
// The map the admin is standing on, one line per list item, so a single wrong
// line can be corrected or removed without retyping the map. Requested with
// the "mapsrc" packet; saving sends the lines back as "mapsave".
//
// The first line of what the server sends is the map name, kept out of the
// editable list and returned with the save so the server can refuse to write
// one map's code into another.
void map_source_editor(string payload)
{
	int cut=string_contains(payload, "\r\n", 1);
	if(cut<0){
		speak(pu.get_value("The server sent no map data."));
		return;
	}
	string mapname=string_left(payload, cut);
	// Cut the name off by length, not by replacing it: the name occurs again in
	// the map's own "map:<name>" header, and a replace-all deletes that too,
	// fusing the header with the line after it as map:maxx:100.
	string[] lines=string_split(string_trim_left(payload, cut+2), "\r\n", true);
	// Map files end with a newline, and some use a bare carriage return, so
	// drop the blanks rather than offering empty rows to edit.
	for(uint i=0;i<lines.length();i++){
		if(lines[i]==""){
			lines.remove_at(i);
			i--;
		}
	}
	audio_form mf;
	mf.create_window("", false, false);
	emchat=true;
	int mf_list=mf.create_list(pu.get_value("Lines of")+" "+mapname+". "+pu.get_value("Press enter to change a line, delete to remove it, control plus up or down to move it."),0);
	for(uint i=0;i<lines.length();i++) mf.add_list_item(mf_list, lines[i], -1);
	// The largest map runs to 600 lines, so let a letter jump to the first line
	// starting with it - typing p reaches the platforms without arrowing there.
	// Safe because this editor's own keys are enter, delete and control+arrows.
	mf.set_list_multinavigation(mf_list, true, true, false);
	int mf_edit=mf.create_input_box(pu.get_value("Line text. Change it here, then press the change button."),"","",0,false,false);
	int mf_change=mf.create_button(pu.get_value("change line"), false, false);
	int mf_add=mf.create_button(pu.get_value("add line"), false, false);
	int mf_save=mf.create_button(pu.get_value("save"), false, false);
	int mf_cancel=mf.create_button(pu.get_value("cancel"), false, true);
	mf.focus(mf_list);
	while(true){
		wait(5);
		mainloop();
		int pos=mf.get_list_position(mf_list);
		// Read before monitor() so the form's own alt and arrow handling does
		// not consume these first.
		if(mf.get_current_focus()==mf_list&&lines.length()>0){
			// Enter copies the line into the edit box, which is how a line
			// gets changed: BC's input prompt cannot be pre-filled with the
			// old text, so retyping it from scratch would be the only option.
			if(key_pressed(KEY_RETURN)&&pos>-1){
				mf.set_text(mf_edit, lines[pos]);
				mf.focus(mf_edit);
				speak(pu.get_value("Editing")+" "+lines[pos]);
			}
			if(key_pressed(KEY_DELETE)&&pos>-1){
				string gone=lines[pos];
				lines.remove_at(pos);
				mf.delete_list_item(mf_list, pos, true, false);
				speak(pu.get_value("Removed")+" "+gone);
			}
			if((key_down(KEY_LCTRL)||key_down(KEY_RCTRL))&&pos>0&&key_pressed(KEY_UP)){
				string tmp=lines[pos];
				lines[pos]=lines[pos-1];
				lines[pos-1]=tmp;
				mf.edit_list_item(mf_list, lines[pos], pos);
				mf.edit_list_item(mf_list, lines[pos-1], pos-1);
				mf.set_list_position(mf_list, pos-1, true);
			}
			if((key_down(KEY_LCTRL)||key_down(KEY_RCTRL))&&pos<int(lines.length())-1&&key_pressed(KEY_DOWN)){
				string tmp=lines[pos];
				lines[pos]=lines[pos+1];
				lines[pos+1]=tmp;
				mf.edit_list_item(mf_list, lines[pos], pos);
				mf.edit_list_item(mf_list, lines[pos+1], pos+1);
				mf.set_list_position(mf_list, pos+1, true);
			}
		}
		mf.monitor();
		if(mf.is_pressed(mf_change)){
			string t=mf.get_text(mf_edit);
			if(pos>-1&&pos<int(lines.length())&&t!=""){
				lines[pos]=t;
				mf.edit_list_item(mf_list, t, pos);
				speak(pu.get_value("Line changed."));
			}
			else speak(pu.get_value("Pick a line first, then type the new text."));
			mf.focus(mf_list);
		}
		if(mf.is_pressed(mf_add)){
			string t=mf.get_text(mf_edit);
			if(t!=""){
				lines.insert_last(t);
				mf.add_list_item(mf_list, t, -1);
				mf.set_list_position(mf_list, lines.length()-1, false);
				mf.set_text(mf_edit, "");
				speak(pu.get_value("Line added."));
			}
			else speak(pu.get_value("Type the new line in the line text box first."));
			mf.focus(mf_list);
		}
		if(mf.is_pressed(mf_save)){
			string result;
			for(uint i=0;i<lines.length();i++) result+=lines[i]+"\r\n";
			emchat=false;
			mf.reset();
			send_reliable(peer_id, "mapsave "+mapname+"\r\n"+result, 2);
			break;
		}
		if(mf.is_pressed(mf_cancel)||key_pressed(KEY_ESCAPE)){
			emchat=false;
			mf.reset();
			speak(pu.get_value("Cancelled, nothing was saved."));
			break;
		}
	}
}
void time_machine_menu(string animals)
{
menu2();
string[] manimais=string_split(animals,"\r\n",true);
for (uint i=0; i<manimais.length(); i++)
{
string[] z=string_split(manimais[i], ":", false);
m.add_item_tts(pu.get_value(z[0]), z[1]);
}
int menu_result=m.run(pu.get_value("Choose the world you want to try to go."), true);
if(m.get_item_name(menu_result)!="0"){
send_reliable(peer_id, "smaquina "+m.get_item_name(menu_result), 0);
}
}
void normal_menu(string message_text_mensag)
{
setupmenu();
string[] mmensagem=string_split(message_text_mensag,"\r\n",true);
string[] bla=string_split(mmensagem[0], ":", false);
for (uint i=1; i<mmensagem.length(); i++)
{
string[] z=string_split(mmensagem[i], ":", false);
m.add_item_tts(pu.get_value(z[0]), z[1]);
}
m.add_item_tts(pu.get_value("Go Back"), "0");
int menu_result=m.run(pu.get_value(bla[0]), true);
if(m.get_item_name(menu_result)!="0"){
send_reliable(peer_id, bla[1]+" "+m.get_item_name(menu_result), 0);
}
}
void normal_menu2(string message_text_mensag){
setupmenu();
string[] mmensagem=string_split(message_text_mensag,"\r\n",true);
string[] bla=string_split(mmensagem[0], bell2, false);
for (uint i=1; i<mmensagem.length(); i++){
string[] z=string_split(mmensagem[i], bell2, false);
if(z.length()>1)m.add_item_tts(pu.get_value(z[0]), z[1]);
}
m.add_item_tts(pu.get_value("Go Back"), "0");
int menu_result=m.run(pu.get_value(bla[0]), true);
if(m.get_item_name(menu_result)!="0"){
send_reliable(peer_id, bla[1]+" "+m.get_item_name(menu_result), 0);
}
}
