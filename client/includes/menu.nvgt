dynamic_menu_pro m;
void main_menu(bool f=true)
{
setupmenu(true);
m.letters_autoactivate=true;
m.add_item_tts(pu.get_value("character menu"),"charmenu");
m.add_item_tts(pu.get_value("test speakers"),"testspeaks");
m.add_item_tts(pu.get_value("Settings"),"options");
m.add_item_tts(pu.get_value("Check for updates"), "checar");
m.add_item_tts(pu.get_value("Exit."), "exit");
int menu_result=m.run(pu.get_value("Menu principal"), true);
if(m.get_item_name(menu_result)=="exit" or menu_result==0)
{
writeprefs();
exit_game();
}
else if(m.get_item_name(menu_result)=="testspeaks")
{
dlgplay("altofalante.ogg");
main_menu();
}
else if(m.get_item_name(menu_result)=="options")
{
options_menu();
}
else if(m.get_item_name(menu_result)=="charmenu")
{
char_menu();
}
}
void voice_menu()
{
menu_silent();
m.add_item("v1nome.ogg","1");
m.add_item("v2nome.ogg","2");
m.add_item("v3nome.ogg","3");
m.add_item("v4nome.ogg", "4");
m.add_item("v5nome.ogg", "5");
m.add_item("v7nome.ogg", "7");
m.add_item("v9nome.ogg", "9");
m.add_item("v10nome.ogg", "10");
m.add_item("v11nome.ogg", "11");
m.add_item("v12nome.ogg", "12");
m.add_item_tts(pu.get_value("Go Back"),"back");
int menu_result=m.run(pu.get_value("Select a voice."),true);
if (m.get_item_name(menu_result)=="back" or menu_result==0)
{
profile_menu();
}
else
{
voice=string_to_number(m.get_item_name(menu_result));
writeprefs();
profile_menu();
}
}
string select_player(string text,bool showall=false)
{
if(mapname=="quadro")return "";
menu2();
for (uint i=0; i<players.length(); i++)
{
if (players[i].map==mapname and players[i].charname!=un and showall==false&&players[i].beeping==1)
m.add_item_tts(players[i].charname,players[i].charname);
else if (showall==true&&players[i].beeping==1)
{
if (players[i].charname!=un&&players[i].beeping==1)
m.add_item_tts(players[i].charname,players[i].charname);
}
}
int menu_result=m.run(pu.get_value(text),true);
return m.get_item_name(menu_result);
}
void map_players_menu(int peaceful=0, string modify="Choose a player:;missil"){
if(ausente||!moveable)return;
setupmenu();
string[] d=string_split(modify, ";", false);
for (uint i=0; i<players.length(); i++){
if (players[i].map==mapname&&players[i].charname!=un&&players[i].beeping==1&&players[i].peaceful==peaceful)m.add_item_tts(players[i].charname,players[i].charname);
}
int menu_result=m.run(pu.get_value(d[0]),true);
if(menu_result>-1)send_reliable(peer_id, d[1]+" "+m.get_item_name(menu_result), 0);
}
void char_menu()
{
setupmenu(true);
m.letters_autoactivate=true;
m.add_item_tts(pu.get_value("login"),"logar");
m.add_item_tts(pu.get_value("create account"),"create");
m.add_item_tts(pu.get_value("Set up existing account"),"personagem");
m.add_item_tts(pu.get_value("Go Back"),"back");
int menu_result=m.run(pu.get_value("character menu."), true);
if(m.get_item_name(menu_result)=="logar")
{
m.fade_music(1);
speak(pu.get_value("Connecting to the server..."));
do_login();
}
//if(m.get_item_name(mres) == "back") {
if (m.get_item_name(menu_result)=="back" or menu_result==0)
{
    main_menu();
    return;
}
else if(m.get_item_name(menu_result)=="create")
{
creating=true;
create();
}
if(m.get_item_name(menu_result)=="checar") check_update(false);
else if(m.get_item_name(menu_result)=="personagem")
{
string sz=v.input(pu.get_value("Enter your username."));
string entered_password=v.input(pu.get_value("Enter your password."));
if (entered_password=="")
{
char_menu();
}
else
{
pw=entered_password;
un=sz;
}
writeprefs();
char_menu();
}
else if(m.get_item_name(menu_result)=="back")
{
main_menu();
}
}
void options_menu()
{
setupmenu();
m.add_item_tts(pu.get_value("Global Settings"), "gerais");
m.add_item_tts(pu.get_value("profile settings"), "perfio");
m.add_item_tts(pu.get_value("Select a language file"), "idioma");
m.add_item_tts(pu.get_value("Go Back"),"back");
int menu_result=m.run(pu.get_value("Options menu, select an option"), true);
if(m.get_item_name(menu_result)=="gerais")
{
general_settings();
}
else if(m.get_item_name(menu_result)=="idioma")
{
string a=languages();
if(a==""){
options_menu();
}
else{
language_file_path="lang/"+a;
writeprefs();
pu.set_file(language_file_path);
options_menu();
}
}
else if(m.get_item_name(menu_result)=="perfio")
{
profile_menu();
}
else
{
main_menu();
}
}
void options_menu2(){
setupmenu(false);
m.add_item_tts(pu.get_value("Change password"), "password");
if(tradutorativo==1){
m.add_item_tts(pu.get_value("Disable translator"), "tradutor");
m.add_item_tts(pu.get_value("Select the source language"), "selidioma");
}
else if(tradutorativo==0)m.add_item_tts(pu.get_value("Enable translator"), "tradutor");
if(interrupt==0){
m.add_item_tts(pu.get_value("Enable	 screen reader interruption"), "interrupt");
}
else if(interrupt==1){
m.add_item_tts(pu.get_value("Disable screen reader interruption."), "interrupt");
}
m.add_item_tts(pu.get_value("Go Back"),"back");
int menu_result=m.run(pu.get_value("Game options menu, select an option."), true);
if(m.get_item_name(menu_result)=="wine")
{
toggle_wine();
options_menu2();
}
else if(m.get_item_name(menu_result)=="voz")
{
voice_menu();
options_menu2();
}
else if(m.get_item_name(menu_result)=="ad")
{
asktoexit=0;
writeprefs();
options_menu2();
}
else if(m.get_item_name(menu_result)=="ae")
{
asktoexit=1;
writeprefs();
options_menu2();
}
else if(m.get_item_name(menu_result)=="password"){
string new_password=v.input("Type your new password.");
if(message_invalid(new_password)||new_password.length()<8){
dlg(pu.get_value("Invalid password. This may be because it contains less than 8 characters, has special symbols or spaces."));
}
else{
string new_password_confirm=v.input("Retype your new password.");
if(message_invalid(new_password_confirm)||new_password_confirm.length()<8){
dlg(pu.get_value("Invalid password. This may be because it contains less than 8 characters, has special symbols or spaces."));
}
else if(new_password_confirm!=new_password){
dlg("The passwords don't match.");
options_menu2();
}
else{
add_add_item("variado", pu.get_value("Changing password..."));
send_reliable(peer_id, "/changepassword "+pw+" "+new_password, 1);
}
}
}
else if(m.get_item_name(menu_result)=="selidioma")source_language_menu();
else if(m.get_item_name(menu_result)=="tradutor"){
if(tradutorativo==0)tradutorativo=1;
else if(tradutorativo==1)tradutorativo=0;
readprefs();
options_menu2();
}
else if(m.get_item_name(menu_result)=="interrupt")
{
if (interrupt==1)
interrupt=0;
else
interrupt=1;
options_menu2();
}
}
void exit_menu()
{
if (asktoexit==1)
{
setupmenu();
m.add_item_tts(pu.get_value("Yes"),"yes");
m.add_item_tts(pu.get_value("No"),"in");
int menu_result=m.run(pu.get_value("Wold you like to exit?"),true);
if (menu_result==1)
{
exitgame();
}
}
else
{
exitgame();
}
}
void store(string storeitems)
{
if(ausente||!moveable)return;
setupmenu();
string[] items=string_split(storeitems,"\r\n",true);
for (uint i=0; i<items.length(); i++)
{
string[] item=string_split(items[i]," ",true);
string it=string_replace(item[0],",","",true);
m.add_item_tts(items[i],it);
}
int menu_result=m.run(pu.get_value("Shop menu. Here you have")+" "+items.length()+" "+pu.get_value("items")+".",true);
if (menu_result!=0)
{
string amount=v.input(pu.get_value("How much")+" "+m.get_item_name(menu_result)+"?");
send_reliable(peer_id,"/buy123321123 "+amount+" "+m.get_item_name(menu_result),1);
}
}
// Dev menu option: create a custom monster (defined server-side in comandos.nvgt). Uses menu2() for the yes/no prompts.
void createmonster(){
string name=v.input(pu.get_value("Monster name (also used for its NAME_attackN.ogg and NAME_death.ogg sounds, no spaces)"));
if(name==""||string_contains(name, " ", 1)>-1){ speak(pu.get_value("Invalid monster name.")); return; }
string hp=v.input(pu.get_value("HP (health points)"));
string speed=v.input(pu.get_value("Speed (milliseconds between steps, lower is faster)"));
string damage=v.input(pu.get_value("Damage per hit"));
string attack_count_val=v.input(pu.get_value("Number of attack sound files (e.g. 4 for NAME_attack1.ogg to NAME_attack4.ogg)"));
string respawn=v.input(pu.get_value("Respawn time in milliseconds after it dies (0 = it does not respawn)"));
if(hp==""||speed==""||damage==""||attack_count_val==""||respawn==""){ return; }
string map_name_short=v.input(pu.get_value("Map name for the monster (leave blank for your current map)"));
if(map_name_short=="") map_name_short=mapname;
string sx=v.input(pu.get_value("Spawn X position (leave blank for your current X)"));
if(sx=="") sx=""+me.x;
string sy=v.input(pu.get_value("Spawn Y position (leave blank for your current Y)"));
if(sy=="") sy=""+me.y;
menu2();
m.add_item_tts(pu.get_value("Yes"), "1");
m.add_item_tts(pu.get_value("No"), "0");
int r1=m.run(pu.get_value("Can the monster follow the player UP the stairs?"), true);
string follow_up_stairs=m.get_item_name(r1);
if(follow_up_stairs!="1"&&follow_up_stairs!="0"){ return; }
menu2();
m.add_item_tts(pu.get_value("Yes"), "1");
m.add_item_tts(pu.get_value("No"), "0");
int r2=m.run(pu.get_value("Can the monster follow the player DOWN the stairs?"), true);
string follow_down_stairs=m.get_item_name(r2);
if(follow_down_stairs!="1"&&follow_down_stairs!="0"){ return; }
send_reliable(peer_id, "spawnmonster "+name+" "+sx+" "+sy+" "+map_name_short+" "+hp+" "+speed+" "+damage+" "+attack_count_val+" "+respawn+" "+follow_up_stairs+" "+follow_down_stairs, 2);
speak(pu.get_value("Monster created."));
}
void dev_menu()
{
menu2();
m.add_item_tts(pu.get_value("Clear server"), "cs");
m.add_item_tts(pu.get_value("Force update for all clients"),"fup");
m.add_item_tts(pu.get_value("Close this menu"),"closemenu");
int menu_result=m.run(pu.get_value("Developer menu"),true);
if(menu_result==0) return;
string ret=m.get_item_name(menu_result);
if(ret=="closemenu") return;
if(ret=="fup") send_reliable(peer_id,"fup",0);
if(ret=="cs")
send_reliable(1, "/clearserver", 1);
}
int menu_callback_loop(dynamic_menu_pro@ j, string dat)
{
if(connected) mainloop();
return 0;
}
void spell_menu(string data)
{
if(ausente||!moveable)return;
string[] spells=string_split(data,"\r\n",false);
menu2();
for(uint i=0; i<spells.length(); i++)
{
string[] parsed=string_split(spells[i],":",false);
m.add_item_tts(pu.get_value(spells[i]),parsed[0]);
}
int menu_result=m.run(pu.get_value("Choose a spell to Throw."),true);
if(menu_result==0) return;
else
{
string spell=m.get_item_name(menu_result);
send_reliable(peer_id,"spellcast "+spell+" "+facing,0);
}
}
void update_menu()
{
setupmenu(false);
m.add_item_tts(pu.get_value("Yes"),"y");
m.add_item_tts(pu.get_value("No"),"n");
int menu_result=m.run(game_name+" "+vernova+" "+pu.get_value("Was found! Description")+" "+pu.get_value(description)+"\r\n"+pu.get_value("Do you want do download it?"),true);
if (m.get_item_name(menu_result)=="y")
{
download_update();
}
else
main_menu();
}
