animals[45]="vulture";
animals[46]="vulture";
animals[47]="vulture";
animals[48]="alligator";
animals[49]="alligator";
animals[50]="alligator";
add_add_item("variado", pu.get_value("Welcome to the game of animals! Bet, spin the roulette And trust in the luck!"));
ambience.load("musica14.ogg");
ambience.volume=-20;
ambience.play_looped();
while(true){
mainloop();
if(ausente){
finish_fim();
break;
}
coins=inv_item_number("coins");
if(coins<=0){
p.play_stationary("notify_died.ogg", false);
send_reliable(0, "draw notify_died.ogg", 0);
finish_fim();
break;
}
if(key_pressed(KEY_ESCAPE)){
p.play_stationary("menuvolta.ogg", false);
finish_fim();
break;
}
if(key_pressed(KEY_H)){
add_add_item("variado", pu.get_value("To set the amount of coins you want to bet, press 1, enter the value and press enter. To choose the animal that you will play, press 2, choose with the arrows the animal and press enter."));
}
if(key_pressed(KEY_C)) add_add_item("variado", pu.get_value("You have")+" "+coins+" "+pu.get_value("Coins to bet"));
if(key_pressed(KEY_1)){
string how_much=v.input("How many coins do you wish to bet ?");
amount_value=string_to_number(how_much);
if(amount_value>coins){
add_add_item("variado", pu.get_value("You don't have")+" "+amount_value+" "+pu.get_value("Coins to bet"));
amount_value=0;
}
