class jogoparouimpar{
int coins, amount_value;
string choice_type;;
sound s, ambience;
void finish_fim(){
s.close();
ambience.close();
}
void throw_item(){
if(ausente)return;
if(inv_item_number("coins")<500) return;
add_add_item("variado", pu.get_value("Even or odd!"));
ambience.load("musica14.ogg");
ambience.volume=-20;
ambience.play_looped();
while(true){
mainloop();
if(ausente){
finish_fim();
break;
}
coins=inv_item_number("coins");
if(coins<=0){
p.play_stationary("notify_died.ogg", false);
send_reliable(0, "draw notify_died.ogg", 0);
finish_fim();
break;
}
if(key_pressed(KEY_ESCAPE)){
p.play_stationary("menuvolta.ogg", false);
finish_fim();
break;
}
if(key_pressed(KEY_H)){
add_add_item("variado", pu.get_value("To choose the amount of coins that you wish to bet, press 1, type the amount and confirm with enter."));
}
if(key_pressed(KEY_C)) add_add_item("variado", pu.get_value("You have")+" "+coins+" "+pu.get_value("Coins to bet"));
if(key_pressed(KEY_1)){
string how_much=v.input("How many coins do you wish to bet ?");
amount_value=string_to_number(how_much);
if(amount_value>coins){
add_add_item("variado", pu.get_value("You don't have")+" "+amount_value+" "+pu.get_value("Coins to bet"));
amount_value=0;
}
if(amount_value<500||amount_value>1000){
add_add_item("variado", pu.get_value("The bet value must be between 500 to 1000."));
amount_value=0;
}
}
if(key_pressed(KEY_2)){
setupmenu();
m.add_item_tts(pu.get_value("Par"), "Par");
m.add_item_tts(pu.get_value("Odd"), "Odd");
m.add_item_tts(pu.get_value("Go Back"), "voltar");
int menu_result=m.run(pu.get_value("Choose the type of number you want to bet."), true);
if(m.get_item_name(menu_result)!="voltar") choice_type=m.get_item_name(menu_result);
}
if(key_pressed(KEY_RETURN))
{
if(amount_value<500||amount_value>1000 || choice_type=="") add_add_item("variado", pu.get_value("You must set the amount and choose the type of number you will bet!"));
else
{
add_add_item("variado", pu.get_value("Randomizing the numbers from 1 to 10..."));
s.close();
s.load("dado1.ogg");
s.play();
send_reliable(0, "draw dado1.ogg", 0);
while(s.playing)
{
wait(5);
mainloop();
}
int result_value=random(1, 10);
if(result_value==1||result_value==3||result_value==5||result_value==7||result_value==9)
{
if(choice_type=="Odd")
{
add_add_item("variado", pu.get_value("Nice, the number is odd!"));
send_reliable(0, "acoins "+amount_value, 2);
choice_type="";
finish_fim();
break;
}
else if(choice_type=="Par")
{
add_add_item("variado", pu.get_value("The number is odd, I won!"));
send_reliable(0, "acoins -"+amount_value, 2);
choice_type="";
finish_fim();
break;
}
}
else if(result_value==2||result_value==4||result_value==6||result_value==8||result_value==10)
{
if(choice_type=="Par")
{
add_add_item("variado", pu.get_value("Nice, the number is even!"));
send_reliable(0, "acoins "+amount_value, 2);
choice_type="";
finish_fim();
break;
}
else if(choice_type=="Odd")
{
add_add_item("variado", pu.get_value("The number is even, I won!"));
send_reliable(0, "acoins -"+amount_value, 2);
choice_type="";
finish_fim();
break;
}
}
}
}
}// end of the while
}// End of the void
}
class dadodasorte{
int chances=0, coins, amount_value, nescolhido;
sound s, ambience;
void finish_fim(){
s.close();
ambience.close();
}
void throw_item(){
if(inv_item_number("coins")<500) return;
add_add_item("variado", pu.get_value("Wellcome to the lucky dice!"));
nescolhido=random(1, 6);
add_add_item("variado", pu.get_value("The number you will have to get is:")+" "+nescolhido);
chances=2;
ambience.load("musica14.ogg");
ambience.volume=-20;
ambience.play_looped();
while(true){
mainloop();
if(ausente){
finish_fim();
break;
}
coins=inv_item_number("coins");
if(coins<=0){
p.play_stationary("notify_died.ogg", false);
send_reliable(0, "draw notify_died.ogg", 0);
finish_fim();
break;
}
if(key_pressed(KEY_ESCAPE)){
p.play_stationary("menuvolta.ogg", false);
finish_fim();
break;
}
if(key_pressed(KEY_H)){
add_add_item("variado", pu.get_value("To choose the amount of coins that you wish to bet, press 1, type the amount and confirm with enter."));
}
if(key_pressed(KEY_C)) add_add_item("variado", pu.get_value("You have")+" "+coins+" "+pu.get_value("Coins to bet"));
if(key_pressed(KEY_1)){
string how_much=v.input("How many coins do you wish to bet ?");
amount_value=string_to_number(how_much);
if(amount_value>coins){
add_add_item("variado", pu.get_value("You don't have")+" "+amount_value+" "+pu.get_value("Coins to bet"));
amount_value=0;
}
if(amount_value<500||amount_value>1000){
add_add_item("variado", pu.get_value("The bet value must be between 500 to 1000."));
amount_value=0;
}
}
if(key_pressed(KEY_RETURN)){
if(amount_value<500||amount_value>1000) add_add_item("variado", pu.get_value("You must choose the value that you wish to bet."));
else{
add_add_item("variado", pu.get_value("Launching the dices..."));
s.close();
s.load("dado1.ogg");
s.play();
send_reliable(0, "draw dado1.ogg", 0);
while(s.playing){
wait(5);
mainloop();
}
int result_value=random(1, 6);
add_add_item("variado", pu.get_value(result_value));
if(result_value==nescolhido)
{
s.close();
s.load("dado2.ogg");
s.play();
add_add_item("variado", pu.get_value("Good! You're right!"));
send_reliable(0, "acoins "+amount_value, 2);
p.play_stationary("menuvolta.ogg", false);
wait(200);
finish_fim();
break;
}
else if(result_value!=nescolhido){
s.close();
s.load("dado2.ogg");
s.play();
add_add_item("variado", pu.get_value("you missed"));
if(chances>0){
add_add_item("variado", pu.get_value("You have other chance"));
chances-=1;
}
else if(chances<=0){
add_add_item("variado", pu.get_value("You don't have other chance"));
send_reliable(0, "acoins -"+amount_value, 2);
amount_value=0;
p.play_stationary("menuvolta.ogg", false);
wait(200);
finish_fim();
break;
}
}

}
}
}// end of the while
}// End of the void
}
