	stream.stop(streamurl);
ausente=false;
lan.in_speedboat=0;
dveloz=0;
developer_dm=0;
instructor=0;
nolhar="";
falhou=0;
pulou=0;
destroy_all_doors();
destroy_all_msounds();
destroy_all_elevators();
bubble_air=false;
connected=false;
connect=false;
term=false;
exiting=false;
objs.resize(0);
players.resize(0);
star=false;
moveable=true;
floating=false;
jumpheight=5;
destroy_all_sources();
destroy_all_ambiences();
chuvatelhado.close();
reloading_taser.close();
is_newbie=0;
map.resize(0);
