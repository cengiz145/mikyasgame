if (key_down(KEY_LMENU) or key_down(KEY_RMENU)&&jumping==0&&dveloz==0&&bicicleta==0||key_down(KEY_LMENU)&&jumping==0&&dveloz==0&&bicicletaativa==0)
{
walktime=run_speed;
}
else if (jumping==1)
{
walktime=jump_speed;
}
else if(bicicleta==1&&inv_item_exists("bicycle")&&jumping==0&&bicicletaativa==1) walktime=bicicletaveloc;
else if(jumping==0&&bicicleta==0&&dveloz==1)walktime=velo2;
else
{
walktime=walk_speed;
}
if(key_pressed(KEY_ESCAPE))
{
exit_menu();
}
}
}
void admin_chat(){
	string msg=v.input(pu.get_value("Enter your message."));
	if(msg!="")send_reliable(peer_id, "adm "+msg, 0);
}
