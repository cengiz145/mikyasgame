                }
                else if(action == "fasttravel") {
                    string mlist = "";
                    string[] fl = find_files("maps/*.map");
                    for(uint i=0; i<fl.length(); i++) mlist += string_replace(fl[i], ".map", "", true) + ", ";
                    string dest = v.input("Nereye isinlanmak istiyorsunuz? Mevcut Haritalar: " + mlist);
