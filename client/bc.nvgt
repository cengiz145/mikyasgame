else if(m.get_item_name(menu_result)=="door_opt"){
// One form for the whole door: five coordinates, two sound names typed as
// text, and the opening/closing sounds picked from lists of everything in
// sounds.dat whose name contains "door". Alt+space previews the highlighted
// sound without leaving the field.
//
// This replaces seven v.input boxes followed by two hand-rolled key loops.
// Those loops had two bugs: the first spun on `continue` once every field was
// filled, so only enter could end it, and the second never broke on escape, so
// there was no way out but to complete the door.
pack_file pa;
pa.open("sounds.dat");
string[] all_sounds=pa.list_files();
pa.close();
string[] sound_doors;
for(uint i=0;i<all_sounds.length();i++){
if(string_contains(all_sounds[i], "door", 1)>-1) sound_doors.insert_last(all_sounds[i]);
}
if(sound_doors.length()==0){
speak(pu.get_value("No door sounds were found in the sound pack."));
}
else{
audio_form df;
df.create_window("", false, false);
emchat=true;
int d_x=df.create_input_box(pu.get_value("Door location, X coordinate"),"","",0,false,false);
int d_y=df.create_input_box(pu.get_value("Door location, Y coordinate"),"","",0,false,false);
int d_dx=df.create_input_box(pu.get_value("Destination X coordinate"),"","",0,false,false);
int d_dy=df.create_input_box(pu.get_value("Destination Y coordinate"),"","",0,false,false);
int d_speed=df.create_input_box(pu.get_value("Transport speed (MS, type numbers only here)"),"","",0,false,false);
int d_near=df.create_input_box(pu.get_value("Sound played when approaching the door, type none to use no sound"),"none","",0,false,false);
int d_through=df.create_input_box(pu.get_value("Sound played when going through the door, type none to use no sound"),"none","",0,false,false);
int d_open=df.create_list(pu.get_value("Opening sound. Press alt plus space to hear it."),0);
int d_close=df.create_list(pu.get_value("Closing sound. Press alt plus space to hear it."),0);
for(uint i=0;i<sound_doors.length();i++){
df.add_list_item(d_open,sound_doors[i],-1);
df.add_list_item(d_close,sound_doors[i],-1);
}
int d_ok=df.create_button("ok", true, false);
int d_cancel=df.create_button("cancel", false, true);
df.focus(d_x);
while(true){
wait(5);
mainloop();
// Preview whichever sound list is focused, the way the old loop let space do.
if((key_down(KEY_LMENU)||key_down(KEY_RMENU))&&key_pressed(KEY_SPACE)){
int f=df.get_current_focus();
if(f==d_open||f==d_close){
p.destroy_sound(slot);
slot=p.play_stationary(df.get_list_item(f, df.get_list_position(f)), false);
}
}
df.monitor();
if(df.is_pressed(d_ok)){
string s1=df.get_text(d_x);
string s2=df.get_text(d_y);
string s3=df.get_text(d_dx);
string s4=df.get_text(d_dy);
string s5=df.get_text(d_speed);
string s6=df.get_text(d_near);
string s7=df.get_text(d_through);
string s8=df.get_list_item(d_open, df.get_list_position(d_open));
string s9=df.get_list_item(d_close, df.get_list_position(d_close));
emchat=false;
df.reset();
if(s1==""||s2==""||s3==""||s4==""||s5==""||s6==""||s7==""){
speak(pu.get_value("Every field has to be filled in."));
break;
}
string[] map_data=map2;
map_data.remove_at(map_data.length()-1);
map_data.remove_at(map_data.length()-1);
map_data.insert_last("door:"+s1+":"+s2+":"+s3+":"+s4+":"+s5+":"+s6+":"+s7+":"+s8+":"+s9);
send_reliable(peer_id, "/rawdata "+linear(map_data), 1);
break;
}
if(df.is_pressed(d_cancel)||key_pressed(KEY_ESCAPE)){
emchat=false;
df.reset();
speak(pu.get_value("Cancelled."));
break;
}
}
}
}
else if(m.get_item_name(menu_result)=="platform_opt"){
// One form instead of 3 separate prompts: tab moves between
// the fields, a typo can be corrected before committing, and escape
// cancels the whole thing rather than leaving it half entered.
audio_form bf;
bf.create_window("", false, false);
emchat=true;
int bf_0=bf.create_input_box(pu.get_value("Start of the X coordinate"),"","",0,false,false);
int bf_1=bf.create_input_box(pu.get_value("End of the X coordinate"),"","",0,false,false);
int bf_2=bf.create_input_box(pu.get_value("Platform height"),"","",0,false,false);
int bf_ok=bf.create_button("ok", true, false);
int bf_cancel=bf.create_button("cancel", false, true);
bf.focus(bf_0);
string s1, s2, s3;
bool bf_done=false;
while(true){
wait(5);
mainloop();
bf.monitor();
if(bf.is_pressed(bf_ok)){
s1=bf.get_text(bf_0);
s2=bf.get_text(bf_1);
s3=bf.get_text(bf_2);
emchat=false;
bf.reset();
bf_done=true;
break;
}
if(bf.is_pressed(bf_cancel)||key_pressed(KEY_ESCAPE)){
emchat=false;
bf.reset();
speak(pu.get_value("Cancelled."));
break;
}
}
string s4;
pack_file pa;
pa.open("sounds.dat");
string[] lista=pa.list_files();
string[] plataformas;
for(uint i=0;i<lista.length();i++){
if(string_contains(lista[i], "step1", 1)>-1)plataformas.insert_last(lista[i]);
}
int selected=0;
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_ESCAPE)){
s4="";
break;
}
if(key_pressed(KEY_UP)&&selected>0){
selected--;
p.destroy_sound(slot);
slot=p.play_stationary(plataformas[selected], false);
}
if(key_pressed(KEY_DOWN)&&selected<plataformas.length()-1){
selected++;
p.destroy_sound(slot);
slot=p.play_stationary(plataformas[selected], false);
}
if(key_pressed(KEY_RETURN)){
s4=plataformas[selected];
break;
}
if(key_pressed(KEY_SPACE)){
p.destroy_sound(slot);
slot=p.play_stationary(plataformas[selected], false);
}
}
if(bf_done&&s1!=""&&s2!=""&&s3!=""&&s4!=""){
s4=string_replace(s4, "step1.ogg", "", false);
string[] map_data=map2;
map_data.remove_at(map_data.length()-1);
map_data.remove_at(map_data.length()-1);
map_data.insert_last("platform:"+s1+":"+s2+":"+s3+":"+s4);
send_reliable(peer_id, "/rawdata "+linear(map_data), 1);
}
}
