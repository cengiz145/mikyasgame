void checkloc()
{
if (get_zone_at(me.x,me.y)!="")
{
string locate=get_zone_at(me.x,me.y);
if (locate!=currentloc)
{
if (zonestatus==1)
if(locate!=".")speak(pu.get_value(locate));
currentloc=locate;
}
}
else
{
if (currentloc!="")
{
if (zonestatus==1)
speak(pu.get_value("Exploration area"));
currentloc="";
}
}
}
void track_thing(int x, int y)
{
tracker.x=x;
tracker.y=y;
}
void tell_where(int x, int y)
{
if (me.x<=x)
{
go_direction="direita";
go=x-me.x;
}
else if (me.x>=x)
{
go_direction="esquerda";
go=me.x-x;
}
if (me.y<=y)
{
godir2="acima";
go2=y-me.y;
}
else if (me.y>=y)
{
godir2="abaixo";
go2=me.y-y;
}
speak(pu.get_value(go_direction)+" "+go+" "+pu.get_value("e")+" "+pu.get_value(godir2)+" "+go2);
}
bool stepcheck(double val)
{
return true;
}
bool movecheck(double val)
{
string v=val;
v+="=";
if (string_contains(v,".5=",1)>-1)
{
return true;
}
else
{
return false;
}
}
bool abletomove(){
string locate=get_zone_at(me.x,me.y);
if(weapon==23&&vulcan_active==1||locate=="Elevador."||dmoving||!moveable||paraquedas==1)return false;
else if (facing==Left){
if (string_contains(get_tile_at((me.x-1),me.y),"wall",1)>-1){
if(cloaked==false){
string walltype;
string tile=get_tile_at((me.x-1),me.y);
walltype=string_replace(tile,"wall","",true);
if (onwall==false){
p.play_stationary("wall"+walltype+".ogg",false);
send_reliable(peer_id,"draw wall"+walltype+".ogg",0);
onwall=true;
return false;
}
}
else{
p.play_stationary("spell_cloak_throughwall.ogg",false);
send_reliable(peer_id,"draw spell_cloak_throughwall.ogg",0);
return true;
}
}
else{
onwall=false;
return true;
}
}
else if (facing==Right){
if (string_contains(get_tile_at((me.x+1),me.y),"wall",1)>-1){
if(cloaked==false){
string walltype;
string tile=get_tile_at((me.x+1),me.y);
walltype=string_replace(tile,"wall","",true);
if (onwall==false){
p.play_stationary("wall"+walltype+".ogg",false);
send_reliable(peer_id,"draw wall"+walltype+".ogg",0);
onwall=true;
return false;
}
}
else{
p.play_stationary("spell_cloak_throughwall.ogg",false);
send_reliable(peer_id,"draw spell_cloak_throughwall.ogg",0);
return true;
}
}
else{
onwall=false;
return true;
}
}
else if (facing==Forward){
if (string_contains(get_tile_at(me.x,(me.y+1)),"wall",1)>-1){
string walltype;
string tile=get_tile_at(me.x,(me.y+1));
walltype=string_replace(tile,"wall","",true);
if (onwall==false){
p.play_stationary("wall"+walltype+".ogg",false);
send_reliable(peer_id,"draw wall"+walltype+".ogg",0);
onwall=true;
return false;
}
}
else{
onwall=false;
return true;
}
}
else if (facing==Back){
if (string_contains(get_tile_at(me.x,(me.y-1)),"wall",1)>-1){
string walltype;
string tile=get_tile_at(me.x,(me.y-1));
walltype=string_replace(tile,"wall","",true);
if (onwall==false){
p.play_stationary("wall"+walltype+".ogg",false);
send_reliable(peer_id,"draw wall"+walltype+".ogg",0);
onwall=true;
return false;
}
}
else{
onwall=false;
return true;
}
}
return onwall==true ? false : true;
}
void checkforplatforms()
{
if (get_my_tile()!=""){
if(fallheight<20&&get_zone_at(me.x, me.y)!="Painel.")p.play_stationary(""+get_my_tile()+"land.ogg",false);
else if(fallheight>=20&&get_zone_at(me.x, me.y)!="Painel.")p.play_stationary(""+get_my_tile()+"hardland.ogg",false);
jumping=0;
falling=false;
fall_speed=default_fall_speed;
send_reliable(peer_id,"move "+me.x+" "+me.y,0);
if(get_zone_at(me.x, me.y)!="Painel.")send_reliable(peer_id,"land "+fallheight,0);
fallheight=0;
canijumptimer.restart();
}
}
void checkforwalls()
{
if (get_my_tile()!="" and string_contains(get_my_tile(),"wall",1)>-1)
{
p.play_stationary(get_my_tile()+".ogg",false);
ascending=false;
jumptimer.restart();
atapex=true;
}
}
void fallloop()
{
if (falltimer.elapsed>=fall_speed)
{
falltimer.restart();
me.y-=1;
if (fall_speed>12)
fall_speed-=1;
fallheight+=1;
checkforplatforms();
}
}
void playcamera()
{
for (uint i=0; i<players.length(); i++)
{
if (players[i].x==camera.x and players[i].y==camera.y and players[i].map==mapname&&players[i].beeping==1)
{
p.play_extended_2d("beacon.ogg", me.x, me.y, camera.x, camera.y, 0, 0, 0, 0, false, 0.0, 0.0, 0.0, 200.0);
}
}
for (uint i=0; i<objs.length(); i++)
{
if (objs[i].x==camera.x and objs[i].y==camera.y)
{
p.play_extended_2d("item.ogg", me.x, me.y, camera.x, camera.y, 0, 0, 0, 0, false, 0.0, 0.0, 0.0, 200.0);
}
}
if (get_camera_tile()=="")
{
p.play_2d("cameraair.ogg",me.x,me.y,camera.x,camera.y,false);
}
else if (get_camera_tile()=="hazard")
{
p.play_2d("camerahazard.ogg",me.x,me.y,camera.x,camera.y,false);
}
else if (string_contains(get_camera_tile(),"wall",1)>-1)
{
p.play_extended_2d(get_camera_tile()+".ogg", me.x, me.y, camera.x, camera.y, 0, 0, 0, 0, false, 0.0, 0.0, 0.0, 200.0);
}
else
{
p.play_extended_2d(get_camera_tile()+"step"+random(1, 5)+".ogg", me.x, me.y, camera.x, camera.y, 0, 0, 0, 0, false, 0.0, 0.0, 0.0, 200.0);
}
}
void playcameracustom(int x, int y)
{
string gt=get_tile_at(x,y);
if (gt=="")
{
p.play_2d("cameraair.ogg",me.x,me.y,x,y,false);
}
else if (gt=="hazard")
{
p.play_2d("camerahazard.ogg",me.x,me.y,x,y,false);
}
else if (gt=="wall")
{
p.play_2d("camerawall.ogg",me.x,me.y,x,y,false);
}
else
{
p.play_2d("cameratile.ogg",me.x,me.y,x,y,false);
}
}
void mainloop()
{
if(!emchat&&not_you_timer.elapsed>=2000)main_keys();
checking();
if(connected)netloop();
if (term==true and termtimer.elapsed>=termtime)
{
term=false;
termtimer.restart();
reset();
main_menu();
}
if (exiting==true and exittimer.elapsed>=exittime)
{
exittimer.restart();
exiting=false;
reset();
main_menu();
}
if(nolhar!=""){
int n=get_player(nolhar);
if(n>-1){
olhar_x=players[n].x;
olhar_y=players[n].y;
}
else{
olhar_x=me.x;
olhar_y=me.y;
nolhar="";
send_reliable(peer_id, "volhar", 0);
}
}
else if(nolhar==""){
olhar_x=me.x;
olhar_y=me.y;
}
p.update_listener_2d(olhar_x, olhar_y);
p2.update_listener_2d(olhar_x, olhar_y);
pobjs.update_listener_2d(olhar_x, olhar_y);
pcomputador.update_listener_2d(olhar_x, olhar_y);
sourcepool.update_listener_2d(olhar_x, olhar_y);
checkloc();
source_check_loop();
if (playertrack!="" and get_player(playertrack)>-1)
{
if (players[get_player(playertrack)].map!=mapname)
{
speak(playertrack+" "+pu.get_value("is not in")+" "+pu.get_value(mapname)+". "+pu.get_value("Rastreamento desligado."));
playertrack="";
}
}
if(get_tile_at(me.x,me.y)==""&&!falling&&!dmoving&&jumping==0&&connected&&moveable&&!floating&&not_you_timer.elapsed>=1000)falling=true;
if(falling&&connected)fallloop();
if (jumping==1)
{
if (atapex==true and jumptimer.elapsed>=apextime)
{
jumptimer.restart();
atapex=false;
}
if (ascending==false and jumptimer.elapsed>=jumptime2 and atapex==false)
{
jumptimer.restart();
me.y-=1;
if (me.y<=ty1)
{
me.y=ty1;
p.play_stationary(""+get_my_tile()+"land.ogg",false);
send_reliable(peer_id,"move "+me.x+" "+me.y,0);
send_reliable(peer_id,"land",0);
jumping=0;
canijumptimer.restart();
}
if (jumping!=0)
checkforplatforms();
}
if (ascending==true and jumptimer.elapsed>=jumptime)
{
jumptimer.restart();
me.y+=1;
send_reliable(peer_id,"move2 "+me.x+" "+me.y,0);
checkforwalls();
if (me.y>=ty2)
{
ascending=false;
jumptimer.restart();
atapex=true;
}
}
}
if(key_down(KEY_A)&&key_pressed(KEY_UP)&&wine()){
if (wsindex<2) speak(pu.get_value("Nenhuma voz."));
else if (ws_voice_index<wsindex) {
ws_voice_index++;
if (ws.set_current_voice(ws_voice_index))
speak(wslist[ws_voice_index]);
}
}
if(key_down(KEY_A)&&key_down(KEY_RIGHT)&&wine()==true){
if(ttsrate<10) {
ttsrate++;
ws.rate=ttsrate;
speak(pu.get_value("Velocidade SAP:")+" "+ttsrate);
writeprefs();
}
}
if (key_down(KEY_A)&&key_pressed(KEY_DOWN)&&wine()){
if (wsindex<2) speak(pu.get_value("Nenhuma voz."));
else if (ws_voice_index>0) {
ws_voice_index--;
if (ws.set_current_voice(ws_voice_index))
speak(wslist[ws_voice_index]);
}
}
if(key_down(KEY_A)&&key_down(KEY_LEFT)&&wine()==true){
if (ttsrate>-10) {
ttsrate-=1;
ws.rate=ttsrate;
speak(pu.get_value("Velocidade SAP:")+" "+ttsrate);
writeprefs();
}
}
if (key_pressed(KEY_RCONTROL))
{
stop_speech();
}
if (key_pressed(KEY_LCONTROL))
{
stop_speech();
}
if (beaconing==1)
{
looping=false;
beacon_loop();
}
if (get_player_idx(playertrack)==-1 and looping==true)
{
speak("Loop off");
looping=false;
}
if (looping==true and looptimer.elapsed>=looptime)
{
looptimer.restart();
p.play_2d("beacon.ogg",me.x,me.y,players[get_player_idx(playertrack)].x,players[get_player_idx(playertrack)].y,false);
}
}
