            else if(action == "cat_admin") current_category = 2;
            else if(action == "cat_event") current_category = 3;
            else if(action == "cat_ceza") current_category = 4;
            else if(action == "cat_server") current_category = 5;
            else if(action == "cat_item") current_category = 6;
            else if(action == "cat_garage") current_category = 8;
            else if(action == "cat_bank") current_category = 9;
