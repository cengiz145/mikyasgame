if((key_pressed(KEY_F9) || open_builder) && developer_dm==1){
open_builder = false;
int slot=-1;
setupmenu();
m.add_item_tts(pu.get_value("New map"), "newmap_opt");
m.add_item_tts(pu.get_value("Maps"), "maps_opt");
m.add_item_tts(pu.get_value("Edit map"), "editmap_opt");
m.add_item_tts(pu.get_value("Zone"), "zone_opt");
m.add_item_tts(pu.get_value("Text"), "text");
m.add_item_tts(pu.get_value("Protected zone"), "safezone_opt");
m.add_item_tts(pu.get_value("Ambience"), "ambience_opt");
m.add_item_tts(pu.get_value("URL"), "url");
m.add_item_tts(pu.get_value("Platform"), "platform_opt");
m.add_item_tts(pu.get_value("Staircase"), "staircase_opt");
m.add_item_tts(pu.get_value("Tall wall"), "tallwall_opt");
m.add_item_tts(pu.get_value("Wide wall"), "widewall_opt");
m.add_item_tts(pu.get_value("High basin wall"), "highbasin_opt");
m.add_item_tts(pu.get_value("wide basin wall"), "widebasin_opt");
m.add_item_tts(pu.get_value("Travel point"), "travelpoint_opt");
m.add_item_tts(pu.get_value("Door"), "door_opt");
m.add_item_tts(pu.get_value("Map door"), "mapdoor");
m.add_item_tts(pu.get_value("Elevator"), "elevator");
m.add_item_tts(pu.get_value("Freeze zone"), "freeze");
m.add_item_tts(pu.get_value("Suffocation zone"), "suffocate");
m.add_item_tts(pu.get_value("Burning zone"), "burn_opt");
m.add_item_tts(pu.get_value("shifting arena"), "quicksand_opt");
m.add_item_tts(pu.get_value("Disable feature"), "disable");
m.add_item_tts(pu.get_value("Disable rain"), "rain_opt");
m.add_item_tts(pu.get_value("update map"), "updatemap_opt");
m.add_item_tts(pu.get_value("Get map code"), "mapcode_opt");
m.add_item_tts(pu.get_value("Clear map (Not recommended)"), "clearmap_opt");
m.add_item_tts(pu.get_value("undo last modification"), "undo_opt");
m.add_item_tts(pu.get_value("Create monster"), "createmonster");
m.add_item_tts(pu.get_value("More options"), "more_opt");
m.add_item_tts(pu.get_value("close this menu"), "closemenu_opt");
int menu_result=m.run(pu.get_value("Builder menu. use carefully."), true);
if(m.get_item_name(menu_result)=="closemenu_opt"){
mainloop();
}
if(m.get_item_name(menu_result)=="maps_opt"){
// Ask the server for its map list; the reply arrives as a "maplist" packet and
// opens map_list_menu, which teleports on selection.
send_reliable(peer_id, "maplist", 2);
}
if(m.get_item_name(menu_result)=="editmap_opt"){
// Ask for this map's own text; the reply arrives as a "mapsrc" packet and
// opens map_source_editor, one list row per line. "Get map code" only ever
// dumped the same text into the message queue, where it cannot be changed.
send_reliable(peer_id, "mapsrc", 2);
}
if(m.get_item_name(menu_result)=="newmap_opt"){
// Creating a map was only ever possible by typing /newmap name width height
// floor by hand - it had no menu entry at all. The floor list is the surfaces
// that actually appear across the existing maps.
// wallnone is deliberately absent: it means "no wall" and has no step sound
// of its own, so it is not a floor a player could ever walk on.
string[] floors={"grass","dirt","dirt2","sand","snow","mud","marsh","rocks",
"gravel","cement","concrete","concrete2","concrete3","concrete4","concrete5",
"calcada","carpet","carpet2","wood","beam","water2","shallow","caverna"};
audio_form nf;
nf.create_window("", false, false);
emchat=true;
int nf_name=nf.create_input_box(pu.get_value("Map name"),"","",0,false,false);
int nf_w=nf.create_input_box(pu.get_value("Width, 6 to 1000"),"100","",0,false,false);
int nf_h=nf.create_input_box(pu.get_value("Height, 6 to 1000"),"20","",0,false,false);
int nf_floor=nf.create_list(pu.get_value("Floor material. Hold alt and press space to hear a footstep, or L to hear a landing."),0);
for(uint i=0;i<floors.length();i++) nf.add_list_item(nf_floor,floors[i],-1);
int nf_ok=nf.create_button("ok", true, false);
int nf_cancel=nf.create_button("cancel", false, true);
nf.focus(nf_name);
while(true){
wait(5);
mainloop();
// Preview the surface before committing to it. Checked before monitor() so
// the form's own alt handling does not swallow the keypress, and every floor
// in the list above has step1 to step5 plus a land sound in the pack.
if((key_down(KEY_LALT)||key_down(KEY_RALT))&&nf.get_current_focus()==nf_floor){
string tile=nf.get_list_item(nf_floor, nf.get_list_position(nf_floor));
if(key_pressed(KEY_SPACE)) p.play_stationary(tile+"step"+random(1,5)+".ogg", false);
if(key_pressed(KEY_L)) p.play_stationary(tile+"land.ogg", false);
}
nf.monitor();
if(nf.is_pressed(nf_ok)){
string nm=nf.get_text(nf_name);
string w=nf.get_text(nf_w);
string h=nf.get_text(nf_h);
string fl=nf.get_list_item(nf_floor, nf.get_list_position(nf_floor));
emchat=false;
nf.reset();
// The server silently ignores a bad size or a name already taken, so the
// reasons are checked here where they can be spoken.
if(nm==""){
speak(pu.get_value("The map needs a name."));
break;
}
if(string_contains(nm, " ", 1)>-1){
speak(pu.get_value("The map name cannot contain spaces."));
break;
}
if(string_to_number(w)<6||string_to_number(w)>1000){
speak(pu.get_value("Width must be between 6 and 1000."));
break;
}
if(string_to_number(h)<6||string_to_number(h)>1000){
speak(pu.get_value("Height must be between 6 and 1000."));
break;
}
send_reliable(peer_id, "/newmap "+nm+" "+w+" "+h+" "+fl, 1);
break;
}
if(nf.is_pressed(nf_cancel)||key_pressed(KEY_ESCAPE)){
emchat=false;
nf.reset();
speak(pu.get_value("Cancelled."));
break;
}
}
}
