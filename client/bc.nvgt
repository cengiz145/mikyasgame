{
}
int inter()
{
return interrupt;
}
void echocheck(int dir)
{
string player_tile=get_tile_at(me.x, me.y);
if(player_tile==""&&jumping==0&&pulou==0&&mapname!="tunnel"&&!d_check&&!e_check&&moveable==true)
{
echotimer.restart();
pulou=1;
echo=false;
send_reliable(peer_id, "draw caiu.ogg", 0);
p.play_stationary("caiu.ogg", false);
return;
}
}
